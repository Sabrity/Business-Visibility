<!doctype html>
<html lang="en">
<head>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#0f766e">
<meta name="description" content="ShopWatch — read-only business dashboard">
<meta name="mobile-web-app-capable" content="yes">
<meta name="application-name" content="ShopWatch">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="ShopWatch">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
<link rel="icon" type="image/png" sizes="48x48" href="favicon-48.png">
<link rel="icon" href="favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="icons/icon-180.png">
<title>ShopWatch — Client</title>
<style>
*,*::before,*::after{box-sizing:border-box}
html{width:100%;min-width:0;overflow-x:hidden;-webkit-text-size-adjust:100%;text-size-adjust:100%;background:#f4f7f7}
body{margin:0;width:100%;min-width:0;min-height:100vh;overflow-x:hidden;background:#f4f7f7;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#17202a}
.app{width:100%;max-width:520px;min-width:0;margin:0 auto;min-height:100vh;padding-bottom:max(28px,env(safe-area-inset-bottom));visibility:hidden;overflow-x:hidden}
.dashboardHeader{width:100%;min-width:0;background:#0f766e;color:#fff;padding:20px 16px 22px;padding-top:max(20px,env(safe-area-inset-top));border-radius:0 0 22px 22px;overflow:hidden}
.brand{font-size:20px;font-weight:800}.sub{font-size:12px;opacity:.82;margin-top:3px}
.headerMeta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:3px}.headerMeta .sub{margin-top:0}.headerActionRow{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:11px}.headerActionRow .readonly{margin-top:0}.headerActionRow .installBtn{margin-top:0;margin-left:0;}
.installBtn{display:none;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:8px 11px;font-size:11px;font-weight:800;cursor:pointer}.installBtn.show{display:block;width:max-content}.logoutBtn{display:inline-block;border:1px solid rgba(255,255,255,.55);background:#fff;color:#0f766e;border-radius:10px;padding:8px 11px;font-size:11px;font-weight:850;cursor:pointer}.readonly{display:inline-block;margin-top:11px;background:rgba(255,255,255,.14);border-radius:99px;padding:6px 10px;font-size:10px;font-weight:800}
main.dashboard{width:100%;min-width:0;padding:14px}
.panel,.card,.list{min-width:0;background:#fff;border:1px solid #e1e7e9;border-radius:16px;box-shadow:0 2px 10px rgba(15,23,42,.05)}
.panel{padding:13px;margin-bottom:14px}
.rangeTitle,.sectionTitle{display:flex;justify-content:space-between;align-items:center}
.rangeTitle strong,.sectionTitle h2{font-size:15px;margin:0}.rangeTitle span,.sectionTitle span{font-size:11px;color:#68737d}
select,input{width:100%;margin-top:7px;padding:11px;border:1px solid #dce3e6;border-radius:10px;background:#fff;font-size:16px}
.rangeControls{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}.rangeControl{min-width:0}.rangeControl select{min-width:0}.customDates{display:none;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.customDates.show{display:grid}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;min-width:0}
.card{padding:14px;min-width:0;overflow:hidden}
.value{font-size:clamp(16px,5vw,21px);font-weight:850;line-height:1.15;margin-top:5px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.subvalue{font-size:11px;line-height:1.3;color:#68737d;margin-top:4px;overflow-wrap:anywhere}
.green{color:#047857}.red{color:#b91c1c}.teal{color:#0f766e}
.clickable{cursor:pointer}.clickable:active{transform:scale(.99)}
.hint{font-size:10px;color:#0f766e;margin-top:7px}
.sectionTitle{margin:18px 2px 9px;min-width:0}
.fullCard{margin-bottom:9px}
.productSalesCard{width:100%;min-width:0;margin:10px 0 14px;padding:10px;overflow:hidden}.productSalesTableWrap{width:100%;max-width:100%;overflow:visible}.productSalesTable{width:100%;max-width:100%;table-layout:fixed;border-collapse:collapse;font-size:11px;min-width:0}.productSalesTable th,.productSalesTable td{padding:8px 4px;border-bottom:1px solid #e7ecee;text-align:left;vertical-align:top;overflow-wrap:anywhere;word-break:normal}.productSalesTable th{font-size:10px;color:#68737d;background:#f7f9f9;white-space:normal}.productSalesTable th:first-child,.productSalesTable td:first-child{width:50%;font-weight:750}.productSalesTable th:nth-child(2),.productSalesTable td:nth-child(2){width:18%;text-align:right}.productSalesTable th:nth-child(3),.productSalesTable td:nth-child(3){width:32%;text-align:right}.productSalesTable td.num{white-space:normal;font-variant-numeric:tabular-nums}.list{overflow:hidden}
.row{display:flex;justify-content:space-between;gap:12px;padding:13px;border-bottom:1px solid #e7ecee}
.row:last-child{border-bottom:0}
.left{min-width:0}.name{font-size:13px;font-weight:750}.meta{font-size:11px;color:#68737d;margin-top:3px}.amount{font-weight:800;white-space:nowrap}
.link{border:0;background:none;color:#0f766e;font-weight:800;font-size:12px;padding:0;cursor:pointer}
.empty{text-align:center;padding:22px;color:#68737d;font-size:13px}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.48);z-index:20;align-items:flex-end}
.modal.open{display:flex}
.sheet{width:100%;max-width:520px;margin:auto;background:#fff;border-radius:20px 20px 0 0;max-height:88vh;overflow:auto;padding:16px}
.sheetHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.close,.backBtn{border:0;background:#eef2f3;border-radius:50%;width:40px;height:40px;cursor:pointer}.backBtn{border-radius:10px;width:auto;padding:0 12px;font-weight:800;color:#0f766e}
.detailTotal{font-size:23px;font-weight:850;margin:7px 0 12px}
.detailCard{border:1px solid #e1e7e9;border-radius:13px;padding:12px;margin-bottom:8px}
.detailGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.detailItem{background:#f7f9f9;border-radius:9px;padding:9px}.detailLabel{font-size:10px;color:#68737d}.detailValue{font-size:13px;font-weight:750;margin-top:2px}
.customerBtn{border:0;background:none;padding:0;color:#0f766e;font:inherit;font-weight:800;text-align:left;cursor:pointer}.salesSummary{font-size:12px;font-weight:800;color:#17202a;margin:-3px 2px 9px}.salesSummary span{display:block;margin-top:3px;font-weight:700}
.stockCards{grid-template-columns:1fr 1fr}.salesPage{margin-top:18px}.salesPage .sectionTitle{margin-top:0}.businessMetaExtra{display:block;margin-top:3px;font-size:11px;opacity:.82}
@media(max-width:360px){
  .dashboardHeader{padding-left:13px;padding-right:13px;padding-bottom:19px;border-radius:0 0 18px 18px}
  main.dashboard{padding:10px}
  .panel,.card{border-radius:14px}
  .panel{padding:11px}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}
  .card{padding:11px}
  .rangeTitle strong,.sectionTitle h2{font-size:14px}
  .rangeTitle span,.sectionTitle span{font-size:10px}
  .label{font-size:11px;line-height:1.2}
  .value{font-size:16px}
  .subvalue{font-size:10px}
  .hint{font-size:9px;line-height:1.25}
  .rangeControls{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:7px}.rangeTitle strong{font-size:12px}.rangeTitle span{max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rangeControl select{padding:10px 7px;font-size:14px}.customDates{grid-template-columns:1fr 1fr}
}
@media(orientation:landscape) and (max-height:600px){
  .dashboardHeader{padding-top:max(12px,env(safe-area-inset-top));padding-bottom:14px}
  main.dashboard{padding:10px 12px 14px}
  .panel{padding:11px;margin-bottom:10px}
  .sectionTitle{margin-top:12px}
  .card{padding:11px}
  .cards{gap:8px}
}
@media(min-width:521px){
  .app{box-shadow:0 0 28px rgba(15,23,42,.06)}
}
.contact-modal{padding:12px}.msg-list{display:flex;flex-direction:column;gap:8px;max-height:48vh;overflow:auto;padding:4px 2px}.msg{max-width:88%;padding:9px 11px;border-radius:12px;font-size:12px;line-height:1.4}.msg.client{align-self:flex-end;background:#e6fffb;border:1px solid #b7eee7}.msg.admin{align-self:flex-start;background:#f3f4f6;border:1px solid #e5e7eb}.msg-meta{font-size:9px;color:#68737d;margin-top:4px}.msg-compose{display:flex;gap:7px;margin-top:10px}.msg-compose textarea{flex:1;min-height:62px;resize:none;border:1px solid #dce3e6;border-radius:10px;padding:9px;font:inherit;font-size:12px}.msg-send{border:0;background:#0f766e;color:#fff;border-radius:10px;padding:9px 12px;font-weight:800}.msg-empty{text-align:center;color:#68737d;padding:18px;font-size:12px}</style>
</head>
<body>
<div class="app">
<header class="dashboardHeader">
  <div class="brand" id="businessName">Connecting…</div>
  <div class="headerMeta">
    <div class="sub" id="headerCustomName"></div>
    <div class="sub" id="headerSubtitle"></div>
  </div>
  <div class="headerActionRow">
    <div class="readonly" id="headerReadonly" style="display:none"></div>
    <div style="display:flex;gap:7px;align-items:center;flex-wrap:wrap;justify-content:flex-end"><button id="clientReportBtn" class="installBtn" type="button">Reports</button><button id="installBtn" class="installBtn" type="button">Contact Admin</button><button id="logoutBtn" class="logoutBtn" type="button">Logout</button></div>
  </div>
</header>

<main class="dashboard">
<section class="panel">
  <div class="rangeControls">
    <div class="rangeControl"><div class="rangeTitle"><strong>Report Period</strong><span id="periodLabel">Choose period</span></div>
    <select id="periodSelect">
      <option value="today">Today</option>
      <option value="week">This Week</option>
      <option value="month">This Month</option>
      <option value="lastmonth">Last Month</option>
      <option value="custom">Custom</option>
    </select></div>
    <div class="rangeControl"><div class="rangeTitle"><strong>Branch</strong><span id="branchLabel">All Branches</span></div>
    <select id="branchSelect"></select></div>
  </div>
  <div class="customDates" id="customDates">
    <label style="font-size:11px;color:#68737d">Start Date<input id="startDate" type="date"></label>
    <label style="font-size:11px;color:#68737d">End Date<input id="endDate" type="date"></label>
  </div>
</section>

<div class="sectionTitle"><h2>Business Overview</h2><span id="rangeText"></span></div>
<section class="cards">
  <div class="card clickable" id="salesCard">
    <div class="label">Total Sale</div>
    <div class="value" id="totalSales">₦0</div>
    <div class="subvalue" id="transactionCount">0 transactions</div>
    <div class="hint">Tap to view sales details</div>
  </div>

  <div class="card clickable" id="expensesCard">
    <div class="label">Expenses</div>
    <div class="value" id="totalExpenses">₦0</div>
    <div class="hint">Tap to view expense details</div>
  </div>

  <div class="card clickable" id="cashCard">
    <div class="label">Cash Received</div>
    <div class="value teal" id="cashReceived">₦0</div>
    <div class="subvalue" id="debtorPaymentNote"></div>
    <div class="hint">Tap to view cash details</div>
  </div>

  <div class="card" id="creditSalesCard">
    <div class="label">Total Credit Sales</div>
    <div class="subvalue" id="creditSalesCount">0 credit sales</div>
    <div class="value red" id="creditSalesTotal">₦0</div>
  </div>
</section>

<section class="card clickable fullCard" id="debtCard">
  <div class="label">Customers Owing</div>
  <div class="subvalue" id="owingCount">0 customers owing</div>
  <div class="value red" id="debtTotal">₦0</div>
  <div class="hint">Tap to view debtors list</div>
</section>

<section class="card productSalesCard" id="productSalesSection">
  <div class="sectionTitle" style="margin:0 0 5px"><h2>Products Sold in Selected Date Range</h2></div>
  <div id="productSalesList"><div class="empty">No products sold in this date range.</div></div>
</section>

<div class="sectionTitle"><h2>Stock</h2></div>
<section class="cards stockCards">
  <div class="card clickable" id="availableStockCard">
    <div class="label">Available Stock</div>
    <div class="value" id="availableStockCount">0</div>
    <div class="hint">Tap to view available-stock items</div>
  </div>
  <div class="card clickable" id="lowStockCard">
    <div class="label">Low Stock Items</div>
    <div class="value" id="lowStockCount">0</div>
    <div class="hint">Tap to view low-stock items</div>
  </div>
</section>


</main>
<section id="salesPage" class="salesPage" style="display:none;padding:14px">
  <div class="sectionTitle"><h2>Sales Details</h2><button class="link" id="backSalesPage">← Back</button></div>
  <div class="salesSummary" id="salesSummary">0 Transactions<br><span><b class="green">0 Cash</b> • <b class="red">0 Credit</b></span></div>
  <section class="list" id="salesList"></section>
</section>
</div>

<div class="modal" id="modal">
  <div class="sheet">
    <div class="sheetHead">
      <div style="display:flex;align-items:center;gap:8px"><button class="backBtn" id="backModal">← Back</button><div><strong id="modalTitle">Details</strong><div class="meta" id="modalSubtitle"></div></div></div>
      <button class="close" id="closeModal">✕</button>
    </div>
    <div id="modalBody"></div>
  </div>
</div>


<div id="connectGate" style="display:flex;min-height:100dvh;align-items:flex-start;justify-content:center;padding:4px 8px max(8px,env(safe-area-inset-bottom));background:#f4f7f7;color:#17202a"><div id="connectGateCard" style="width:100%;max-width:420px;margin:0 auto;background:#fff;border:1px solid #e1e7e9;border-radius:14px;padding:10px;box-shadow:0 4px 18px rgba(15,23,42,.08)"></div></div>

<script>
const CLIENT_CONFIG_KEY='tbc_client_v7_connection';
const CLIENT_LOCK_KEY='tbc_client_v7_local_password';
const CLIENT_LOGOUT_KEY='tbc_client_v7_manual_logout';
let clientLoggedOut=false;
const SUPABASE_URL='https://qgaocesvzqpqkecjotly.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_PTtJexVGkqdkV4QrlFMJsg_32iXPcWo';

let onlineMode=false;
let onlineTimer=null;
let deferredInstallPrompt=null;
let activeClientBranchId='all';
const installBtn=document.getElementById('installBtn');
const installHelp=document.getElementById('installHelp');
let installEligibilityTimer=null;
installBtn.addEventListener('click',()=>openContactAdmin());
document.getElementById('logoutBtn').addEventListener('click',handleClientLogout);
function normalizeUrl(u){return String(u||'').trim().replace(/\/$/,'').replace(/\/rest\/v1$/,'');}
function savedClientConfig(){try{return JSON.parse(localStorage.getItem(CLIENT_CONFIG_KEY))||null}catch(e){return null}}
function clientConfig(){const saved=savedClientConfig();return {url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:String(saved?.feedId||'').trim()};}
function hideConnectGate(){document.getElementById('connectGate').style.display='none';document.querySelector('.app').style.visibility='visible';}
function showConnectGate(mode='setup',message=''){
  document.querySelector('.app').style.visibility='hidden';
  const gate=document.getElementById('connectGate');gate.style.display='flex';
  const card=document.getElementById('connectGateCard');
  const saved=savedClientConfig();
  const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();
  if((mode==='unlock'||mode==='setupPassword'||mode==='forgotPassword')&&saved&&(lock?.hash||lock?.requiresPasswordSetup||mode==='forgotPassword')){
    if(mode==='setupPassword'||lock?.requiresPasswordSetup){
      card.innerHTML=`<div style="font-size:22px;font-weight:850;margin-bottom:7px">Create Your App Password</div><p style="font-size:13px;color:#68737d;line-height:1.5">Before you can log in again, create a password of at least 8 characters. You will need it each time you log in on this device.</p>${message?`<div style="padding:10px;background:#fff1f2;color:#9f1239;border-radius:9px;font-size:12px;margin:10px 0">${escHtml(message)}</div>`:''}<form id="clientCreatePasswordForm"><label style="display:block;font-size:12px;font-weight:750;margin-top:14px">Create Password<input id="createPassword" type="password" minlength="8" autocomplete="off" data-lpignore="true" data-1p-ignore="true" autocapitalize="off" spellcheck="false" required style="width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px"></label><label style="display:block;font-size:12px;font-weight:750;margin-top:10px">Confirm Password<input id="confirmCreatePassword" type="password" minlength="8" autocomplete="off" data-lpignore="true" data-1p-ignore="true" autocapitalize="off" spellcheck="false" required style="width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px"></label><button type="submit" style="width:100%;margin-top:14px;padding:12px;border:0;border-radius:10px;background:#0f766e;color:white;font-weight:800">Save Password</button></form>`;
      document.getElementById('clientCreatePasswordForm').addEventListener('submit',async e=>{e.preventDefault();const pass=document.getElementById('createPassword').value,confirm=document.getElementById('confirmCreatePassword').value;if(pass.length<8||pass!==confirm){showConnectGate('setupPassword',pass.length<8?'Use a password with at least 8 characters.':'The passwords do not match.');return}try{const record=await makeLocalPassword(pass);record.lastActiveAt=0;localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(record));localStorage.removeItem(CLIENT_LOGOUT_KEY);showConnectGate('unlock','Password saved. Enter it to log in.')}catch(err){showConnectGate('setupPassword',err.message||'Could not save password.')}});
      return;
    }
    if(mode==='forgotPassword'){
      card.innerHTML=`<div style="font-size:22px;font-weight:850;margin-bottom:7px">Forgot Password?</div><p style="font-size:13px;color:#68737d;line-height:1.5">Password recovery by SMS requires a verified phone number linked to this client account. This app's current connection does not yet have that verified phone-to-client mapping configured.</p>${message?`<div style="padding:10px;background:#fff1f2;color:#9f1239;border-radius:9px;font-size:12px;margin:10px 0">${escHtml(message)}</div>`:''}<p style="font-size:13px;line-height:1.5">Please contact your business administrator to verify your identity and arrange a secure reset. Do not share your Client Feed ID or password.</p><button id="backToUnlock" type="button" style="width:100%;margin-top:14px;padding:12px;border:0;border-radius:10px;background:#0f766e;color:white;font-weight:800">Back to Login</button>`;
      document.getElementById('backToUnlock').onclick=()=>showConnectGate('unlock');return;
    }
    if(mode==='unlock'&&lock?.hash){
      card.innerHTML=`<div style="font-size:22px;font-weight:850;margin-bottom:7px">ShopWatch</div><p style="font-size:13px;color:#68737d;line-height:1.5">Enter your app password to log in to the connected business dashboard.</p>${message?`<div style="padding:10px;background:#fff1f2;color:#9f1239;border-radius:9px;font-size:12px;margin:10px 0">${escHtml(message)}</div>`:''}<form id="clientUnlockForm"><label style="display:block;font-size:12px;font-weight:750;margin-top:14px">App Password<input id="unlockPassword" type="password" autocomplete="current-password" data-lpignore="true" data-1p-ignore="true" autocapitalize="off" spellcheck="false" required style="width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px"></label><button type="submit" style="width:100%;margin-top:14px;padding:12px;border:0;border-radius:10px;background:#0f766e;color:white;font-weight:800">Log In</button></form><button id="forgotClientPassword" type="button" style="margin-top:12px;padding:4px 0;border:0;background:transparent;color:#0f766e;text-decoration:underline;font-weight:750">Forgot Password?</button>`;
      document.getElementById('clientUnlockForm').addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget,btn=form.querySelector('button[type=submit]'),pass=document.getElementById('unlockPassword').value;if(btn.disabled)return;btn.disabled=true;btn.textContent='Logging in…';try{if(await verifyLocalPassword(pass,lock)){const fresh={...lock,lastActiveAt:Date.now()};localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(fresh));localStorage.removeItem(CLIENT_LOGOUT_KEY);clientLoggedOut=false;const ok=await loadOnline({url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:saved.feedId});if(!ok){clientLoggedOut=true;showConnectGate('unlock',window.__lastClientConnectError||'Unable to reconnect. Check your internet connection or change the Client Feed ID.');}}else showConnectGate('unlock','Incorrect password. Please try again.')}catch(err){showConnectGate('unlock',err.message||'Login failed. Please try again.')}finally{const current=document.getElementById('clientUnlockForm')?.querySelector('button[type=submit]');if(current){current.disabled=false;current.textContent='Log In';}}});
      document.getElementById('forgotClientPassword').onclick=()=>showConnectGate('forgotPassword');
      return;
    }
  }
  card.innerHTML=`<div style="font-size:22px;font-weight:850;margin-bottom:7px">Connect Your Business</div><p style="font-size:13px;color:#68737d;line-height:1.5;margin:0 0 8px">Enter the Client Feed ID supplied by your business administrator. This app contains no sample business or demo records.</p>${message?`<div style="padding:10px;background:#fff1f2;color:#9f1239;border-radius:9px;font-size:12px;margin:10px 0">${escHtml(message)}</div>`:''}<form id="clientConnectForm"><label style="display:block;font-size:12px;font-weight:750">Client Feed ID<input id="feedIdInput" type="text" autocomplete="off" autocapitalize="characters" placeholder="Enter Client Feed ID" required style="width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px"></label><label style="display:flex;align-items:flex-start;gap:9px;margin-top:9px;font-size:13px;font-weight:750;line-height:1.35"><input id="enableClientPassword" type="checkbox" style="width:18px;height:18px;margin:1px 0 0;flex:0 0 auto"> I want to protect this app with a password</label><div id="clientPasswordFields" style="display:none;margin-top:10px"><label style="display:block;font-size:12px;font-weight:750">Create Password (at least 8 characters)<input id="newClientPassword" type="password" autocomplete="off" data-lpignore="true" data-1p-ignore="true" autocapitalize="off" spellcheck="false" minlength="8" style="width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px"></label><label style="display:block;font-size:12px;font-weight:750;margin-top:10px">Confirm Password<input id="confirmClientPassword" type="password" autocomplete="off" data-lpignore="true" data-1p-ignore="true" autocapitalize="off" spellcheck="false" minlength="8" style="width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px"></label><p style="font-size:11px;color:#68737d;line-height:1.45">You create this password yourself. It is requested after six hours of app inactivity.</p></div><button id="connectSubmit" type="submit" style="width:100%;margin-top:10px;padding:11px;border:0;border-radius:10px;background:#0f766e;color:white;font-weight:800">Connect to Business</button></form><p style="font-size:11px;color:#68737d;line-height:1.45;margin-top:14px">If you do not select the password option, the app opens directly on this device after connecting. Keep your Client Feed ID private.</p>`;
  const check=document.getElementById('enableClientPassword');check.onchange=()=>{document.getElementById('clientPasswordFields').style.display=check.checked?'block':'none'};
  document.getElementById('clientConnectForm').addEventListener('submit',async e=>{e.preventDefault();const feedId=document.getElementById('feedIdInput').value.trim();const wantsPassword=check.checked;const pass=document.getElementById('newClientPassword')?.value||'';const confirmPass=document.getElementById('confirmClientPassword')?.value||'';if(!feedId){showConnectGate('setup','Enter your Client Feed ID.');return}if(wantsPassword&&(pass.length<8||pass!==confirmPass)){showConnectGate('setup',pass.length<8?'Use a password with at least 8 characters.':'The passwords do not match.');document.getElementById('enableClientPassword').checked=true;document.getElementById('clientPasswordFields').style.display='block';return}const btn=document.getElementById('connectSubmit');btn.disabled=true;btn.textContent='Checking Client Feed…';try{const cfg={url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId};const ok=await loadOnline(cfg,{lockPassword:wantsPassword?pass:'',clearLock:!wantsPassword});if(!ok)throw new Error(window.__lastClientConnectError||'Unable to connect to this Client Feed ID.');}catch(err){showConnectGate('setup',err.message||'Unable to connect. Check the Client Feed ID and internet connection.')}});
}
async function handleClientLogout(){
  if(clientLoggedOut)return;
  clientLoggedOut=true;
  if(onlineTimer){clearInterval(onlineTimer);onlineTimer=null;}
  stopClientMessageRealtime();
  onlineMode=false;data=emptyClientData();filtered=[];
  try{localStorage.setItem(CLIENT_LOGOUT_KEY,'1');}catch(e){}
  document.querySelector('.app').style.visibility='hidden';
  const saved=savedClientConfig();
  let lock=null;try{lock=JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){}
  if(!lock?.hash){
    try{localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify({requiresPasswordSetup:true,lastActiveAt:0}));}catch(e){}
    showConnectGate('setupPassword');
  }else{
    lock.lastActiveAt=0;localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(lock));
    showConnectGate('unlock');
  }
}
function emptyClientData(){return {business:'',businessInfo:{name:'',type:'',phone:'',address:'',currency:'NGN'},businessId:'',header:null,branches:[],products:[],sales:[],payments:[],expenses:[]}}
function toBase64(bytes){let s='';for(const b of bytes)s+=String.fromCharCode(b);return btoa(s)}
function fromBase64(s){return Uint8Array.from(atob(s),c=>c.charCodeAt(0))}
async function deriveLocalPassword(password,salt){if(!crypto?.subtle)throw new Error('Secure password protection is not available in this browser. Update Chrome and try again.');const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(password),'PBKDF2',false,['deriveBits']);const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt,iterations:150000,hash:'SHA-256'},key,256);return toBase64(new Uint8Array(bits))}
async function makeLocalPassword(password){const salt=crypto.getRandomValues(new Uint8Array(16));return {salt:toBase64(salt),hash:await deriveLocalPassword(password,salt),iterations:150000,algorithm:'PBKDF2-SHA-256',lastActiveAt:Date.now()}}
async function verifyLocalPassword(password,record){if(!record?.salt||!record?.hash)return false;return await deriveLocalPassword(password,fromBase64(record.salt))===record.hash}
async function fetchOnlineSnapshot(cfg){
  const base=normalizeUrl(cfg.url);
  if(!base||!cfg.key||!cfg.feedId) throw new Error('Client connection is not configured.');
  const url=base+'/rest/v1/client_feeds?select=payload,business_name,updated_at&feed_id=eq.'+encodeURIComponent(cfg.feedId)+'&limit=1';
  const r=await fetch(url,{headers:{'apikey':cfg.key,'Authorization':'Bearer '+cfg.key,'Accept':'application/json'}});
  if(!r.ok){let t='';try{t=await r.text()}catch(e){};throw new Error(r.status+': '+(t||'Connection failed'));}
  const rows=await r.json();
  if(!rows.length) throw new Error('This Client Feed ID was not found.');
  return rows[0].payload;
}
function adaptOnlinePayload(p){
  if(typeof p==='string'){ try{ p=JSON.parse(p); }catch(e){ p={}; } }
  p=p||{};
  const branches=(p.branches||[]).map(b=>({id:b.id,name:b.name||'Branch',address:b.address||'',stockMode:b.stockMode||'shared',stockSharedWith:b.stockSharedWith||null}));
  const customerMap={};(p.customers||[]).forEach(c=>customerMap[c.id]=c.name);
  const productMap={};(p.products||[]).forEach(x=>productMap[x.id]=x);
  const sales=(p.sales||[]).map(s=>{
    const total=Number(s.total||0);
    const paid=Math.max(0,Math.min(total,Number(s.paid||0)));
    const outstanding=Math.max(0,total-paid);
    const payment=paid<=0?'Credit':(paid>=total?'Cash':'Partly Credit');
    return {id:s.id,branchId:s.branchId||'',date:s.date,entryDate:s.entryDate||s.createdAt||'',invoiceNo:s.invoiceNo||'',customer:customerMap[s.customerId]||'Customer',customerId:s.customerId||'',payment,paid,outstanding,items:(s.items||[]).map(i=>({product:productMap[i.productId]?.name||i.product||'Item',productId:i.productId||i.product_id||'',qty:Number(i.quantity??i.qty??0),unit:Number(i.unitPrice??i.unit??i.price??0),measure:i.unitName||i.unitOfMeasure||i.measure||productMap[i.productId]?.unit||productMap[i.productId]?.unitName||'',stockBefore:i.stockBefore??i.stock_before??i.quantityBefore??i.qtyBefore??null,stockAfter:i.stockAfter??i.stock_after??i.quantityAfter??i.qtyAfter??null})),total};
  });
  const payments=(p.payments||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.paymentDate||x.date,customer:customerMap[x.customerId]||'Customer',amount:Number(x.amount||0)}));
  const expenses=(p.expenses||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.expenseDate||x.date,description:x.description||'Expense',amount:Number(x.amount||0)}));
  const products=(p.products||[]).map(x=>({id:x.id,branchId:x.branchId||'',branchIds:Array.isArray(x.branchIds)?x.branchIds:[],name:x.name,qty:Number(x.qty??x.quantity??0),branchQty:x.branchQty||{},reorder:Number(x.reorder??x.reorderLevel??0),cost:Number(x.costPrice??x.cost??0)}));
  const business=p.business||{};
  return {business:business.name||p.business_name||'',businessInfo:{name:business.name||p.business_name||'',type:business.type||'',phone:business.phone||'',address:business.address||'',currency:business.currency||'NGN'},businessId:business.id||p.business_id||'',header:p.header||null,clientReport:p.clientReport||business.clientReport||null,branches,products,sales,payments,expenses};
}

async function loadOnline(requestedCfg=null,options={}){
  const cfg=requestedCfg||clientConfig();
  try{
    const snap=await fetchOnlineSnapshot(cfg);
    const adapted=adaptOnlinePayload(snap);
    if(!adapted.business&&!adapted.businessInfo?.name)throw new Error('This Client Feed has no published business information yet. Ask the administrator to publish the business.');
    const newLock=options.lockPassword?await makeLocalPassword(options.lockPassword):null;
    if(options.saveConfig!==false)localStorage.setItem(CLIENT_CONFIG_KEY,JSON.stringify({feedId:cfg.feedId}));
    if(newLock)localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(newLock));
    else if(options.clearLock===true)localStorage.removeItem(CLIENT_LOCK_KEY);
    localStorage.removeItem('trader_v5_data');
    data=adapted;onlineMode=true;window.__lastClientConnectError='';hideConnectGate();render();
    if(onlineTimer)clearInterval(onlineTimer);
    onlineTimer=setInterval(()=>loadOnline(clientConfig(),{saveConfig:false}),5000);
    return true;
  }catch(e){window.__lastClientConnectError=e.message||'Connection failed';onlineMode=false;console.error(e);return false;}
}
async function connectClient(){return loadOnline();}

let clientMessagesChannel=null;
let clientMessagePollTimer=null;
function stopClientMessageRealtime(){if(clientMessagesChannel){try{clientMessagesChannel.unsubscribe()}catch(e){} clientMessagesChannel=null}if(clientMessagePollTimer){clearInterval(clientMessagePollTimer);clientMessagePollTimer=null}}
function startClientMessageRealtime(){
  stopClientMessageRealtime();if(clientMessagePollTimer)clearInterval(clientMessagePollTimer);clientMessagePollTimer=setInterval(()=>{if(document.getElementById('msgList'))loadClientMessages()},5000);
  const cfg=clientConfig();
  if(!cfg.url||!cfg.key||!cfg.feedId||!window.supabase)return;
  const cid=clientMessageId();
  clientMessagesChannel=window.supabase.createClient(cfg.url,cfg.key).channel('client-messages-'+cid)
    .on('postgres_changes',{event:'INSERT',schema:'public',table:'client_messages',filter:'feed_id=eq.'+cfg.feedId},payload=>{
      const row=payload?.new||{};
      if(row.client_id===cid){loadClientMessages()}
    })
    .subscribe((status,err)=>{if(status==='CHANNEL_ERROR'||status==='TIMED_OUT')console.error('Client message realtime:',status,err)})
}
const CLIENT_MESSAGE_ID_KEY='tbc_client_message_id';
function clientMessageId(){let x=localStorage.getItem(CLIENT_MESSAGE_ID_KEY);if(!x){x='client-'+(crypto.randomUUID?crypto.randomUUID():(Date.now().toString(36)+Math.random().toString(36).slice(2)));localStorage.setItem(CLIENT_MESSAGE_ID_KEY,x)}return x}
function messageBranchId(){return activeClientBranchId==='all'?(data?.branches?.[0]?.id||null):activeClientBranchId}
async function messagesRequest(path,opts={}){
  const cfg=clientConfig();const base=normalizeUrl(cfg.url);
  if(!base||!cfg.key||!cfg.feedId)throw new Error('Client connection is not configured.');
  return fetch(base+path,{...opts,headers:{apikey:cfg.key,Authorization:'Bearer '+cfg.key,'Content-Type':'application/json',Accept:'application/json',...(opts.headers||{})}})
}
async function fetchClientMessages(){
  const cfg=clientConfig();
  const url='/rest/v1/client_messages?select=id,sender_type,sender_name,message,created_at,read_at,reply_to&feed_id=eq.'+encodeURIComponent(cfg.feedId)+'&client_id=eq.'+encodeURIComponent(clientMessageId())+'&order=created_at.asc';
  const r=await messagesRequest(url);if(!r.ok)throw new Error(await r.text());return await r.json()
}
function openContactAdmin(){
  openModal('Contact Admin','',false);
  const body=document.getElementById('modalBody');
  body.innerHTML='<div class="contact-modal"><div id="msgList" class="msg-list"><div class="msg-empty">Loading conversation…</div></div><div class="msg-compose"><textarea id="clientMessageInput" maxlength="2000" placeholder="Type your message to Admin…"></textarea><button class="msg-send" id="sendClientMessage">Send</button></div></div>';
  loadClientMessages();
  startClientMessageRealtime();
  document.getElementById('sendClientMessage').onclick=sendClientMessage;
}
async function loadClientMessages(){
  const list=document.getElementById('msgList');if(!list)return;
  try{const rows=await fetchClientMessages();const unreadAdmin=rows.filter(x=>x.sender_type==='admin'&&!x.read_at);if(unreadAdmin.length){await Promise.all(unreadAdmin.map(x=>messagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(x.id),{method:'PATCH',body:JSON.stringify({read_at:new Date().toISOString()})}))) }list.innerHTML=rows.length?rows.map(x=>`<div class="msg ${x.sender_type==='client'?'client':'admin'}"><div>${escHtml(x.message)}</div><div class="msg-meta">${x.sender_type==='client'?'You':'Admin'} • ${new Date(x.created_at).toLocaleString()}</div></div>`).join(''):'<div class="msg-empty">No messages yet. Send a message to Admin.</div>';list.scrollTop=list.scrollHeight}
  catch(e){list.innerHTML='<div class="msg-empty">Unable to load messages. Please check your connection.</div>'}
}
async function sendClientMessage(){
  const input=document.getElementById('clientMessageInput'), message=input?.value.trim();if(!message)return;
  const cfg=clientConfig();const payload={feed_id:cfg.feedId,client_id:clientMessageId(),branch_id:messageBranchId(),sender_type:'client',sender_name:'Client',message};
  const r=await messagesRequest('/rest/v1/client_messages',{method:'POST',headers:{Prefer:'return=minimal'},body:JSON.stringify(payload)});
  if(!r.ok){alert('Unable to send message: '+(await r.text()));return}
  input.value='';loadClientMessages();
}
function escHtml(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
const money=n=>'₦'+Math.round(Number(n||0)).toLocaleString('en-NG');
const pad=n=>String(n).padStart(2,'0');
const dateStr=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const fmt=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'short',year:'numeric'});
const fmtLong=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'long',year:'numeric'});

const fallback=emptyClientData();

let data=null;
let selectedStart,selectedEnd,filtered=[];

function normalizeSale(s){
  if(Array.isArray(s.items)&&s.items.length){
    const items=s.items.map(i=>Array.isArray(i)?{product:i[0],qty:Number(i[1]||0),unit:Number(i[2]||0)}:{product:i.product,qty:Number(i.qty||0),unit:Number(i.unit||i.unitPrice||0)});
    return {...s,items,total:Number(s.total||items.reduce((a,i)=>a+i.qty*i.unit,0))};
  }
  return {...s,items:[{product:s.product||'Item',qty:Number(s.qty||0),unit:Number(s.unit||0)}],total:Number(s.total||0)};
}
function salePaid(s){const total=saleTotal(s);return Math.max(0,Math.min(total,Number(s?.paid||0)));}
function saleOutstanding(s){return Math.max(0,saleTotal(s)-salePaid(s));}
function salePaymentStatus(s){const paid=salePaid(s),total=saleTotal(s);return paid<=0?'Credit':(paid>=total?'Cash':'Partly Credit');}
function normalizeData(){ if(!data) return; data.sales=(data.sales||[]).map(normalizeSale).map(s=>({...s,paid:salePaid(s),outstanding:saleOutstanding(s),payment:salePaymentStatus(s)})); if(!Array.isArray(data.payments)) data.payments=[]; if(!Array.isArray(data.expenses)) data.expenses=[]; if(!Array.isArray(data.products)) data.products=[]; }

function getRange(type){
  const now=new Date(); now.setHours(0,0,0,0);
  let s=new Date(now),e=new Date(now);
  if(type==='week') s.setDate(now.getDate()-now.getDay());
  if(type==='month') s.setDate(1);
  if(type==='lastmonth'){s.setMonth(now.getMonth()-1);s.setDate(1);e.setDate(0);}
  return [dateStr(s),dateStr(e)];
}
function showCustom(show){
  document.getElementById('customDates').classList.toggle('show',show);
}
function setPreset(type){
  if(type==='custom'){
    showCustom(true);
    return;
  }
  showCustom(false);
  const [s,e]=getRange(type);
  document.getElementById('startDate').value=s;
  document.getElementById('endDate').value=e;
}
function getSelectedRange(){
  const type=document.getElementById('periodSelect').value;
  if(type==='custom'){
    const s=document.getElementById('startDate').value;
    const e=document.getElementById('endDate').value;
    if(!s||!e||s>e){alert('Please choose a valid start and end date.');return null;}
    return [s,e];
  }
  return getRange(type);
}
function inRange(d){return d>=selectedStart&&d<=selectedEnd;}
function rangeLabel(){
  return selectedStart===selectedEnd ? fmtNumeric(selectedStart) : fmtNumeric(selectedStart)+' - '+fmtNumeric(selectedEnd);
}
function fmtNumeric(d){const x=new Date(d+'T00:00:00');return pad(x.getDate())+'/'+pad(x.getMonth()+1)+'/'+x.getFullYear();}
function branchScope(list){return (list||[]).filter(x=>activeClientBranchId==='all'||(Array.isArray(x.branchIds)&&x.branchIds.includes(activeClientBranchId))||String(x.branchId||'')===String(activeClientBranchId));}
function renderClientReport(){const r=data?.clientReport||{};const btn=document.getElementById('clientReportBtn');if(!btn)return;const reportData=r.publishedContent||r.content||{};const show=!!(r.visible&&r.published&&(r.publishedContent||r.content));btn.classList.toggle('show',show);btn.onclick=()=>{if(!show)return;const x=reportData,mode=r.reportMode||'both',selected=Array.isArray(r.selectedSummaryItems)?r.selectedSummaryItems:['period','transactions','cashSales','creditSales','creditTotal','amountReceived','debtorPayments','expenses','highestSellingProduct','lowestSellingProduct','bestCustomer'];const labels={period:'Reporting period',transactions:'Total sales transactions',cashSales:'Fully paid sales',creditSales:'Sales with outstanding balance',creditTotal:'Total credit sales',amountReceived:'Amount received',debtorPayments:'Debtor payments received',expenses:'Total expenses',highestSellingProduct:'Highest-selling product',lowestSellingProduct:'Lowest-selling product',bestCustomer:'Best customer'};const rows=mode==='written'?[]:selected.filter(k=>labels[k]&&x[k]!==undefined&&x[k]!==null&&x[k]!=='').map(k=>[labels[k],x[k]]);const written=(mode==='written'||mode==='both')?x.writtenReport:'';const body=(written?`<div style="white-space:pre-wrap;line-height:1.55;padding:12px;margin-bottom:10px;background:#f7f9f9;border-radius:10px">${escHtml(written)}</div>`:'')+rows.map(z=>`<div class="row"><div class="left name">${escHtml(z[0])}</div><div class="amount">${escHtml(String(z[1]))}</div></div>`).join('');openModal('Business Report',x.period||'Published by Admin',body||'<div class="empty">No report details have been published.</div>')};}
function refreshBranchSelect(){
  const sel=document.getElementById('branchSelect');
  const label=document.getElementById('branchLabel');
  if(!sel)return;
  const branches=data?.branches||[];
  if(activeClientBranchId!=='all'&&!branches.some(b=>String(b.id)===String(activeClientBranchId)))activeClientBranchId='all';
  sel.innerHTML='<option value="all">All Branches</option>'+branches.map(b=>`<option value="${b.id}">${b.name}</option>`).join('');
  sel.value=activeClientBranchId;
  label.textContent=activeClientBranchId==='all'?'All Branches':(branches.find(b=>String(b.id)===String(activeClientBranchId))?.name||'All Branches');
}
function clientProductStock(p){const branches=data?.branches||[];if(activeClientBranchId&&activeClientBranchId!=='all'){const br=branches.find(x=>String(x.id)===String(activeClientBranchId));if(br?.stockMode==='shared'&&br.stockSharedWith){const source=branches.find(x=>String(x.id)===String(br.stockSharedWith));if(source?.stockMode==='separate')return Number(p.branchQty?.[source.id]||0)}if(br?.stockMode==='separate')return Number(p.branchQty?.[br.id]||0);return Number(p.qty||0)}let total=Number(p.qty||0);const seen=new Set();branches.filter(b=>b.stockMode==='separate').forEach(b=>{const pool=b.id; if(!seen.has(pool)){total+=Number(p.branchQty?.[pool]||0);seen.add(pool)}});return total}
function render(){
  if(!onlineMode){ data=emptyClientData(); }
  if(!data.payments)data.payments=[];
  normalizeData();
  const h=data.header||{};
  document.getElementById('businessName').textContent=data.business||data.businessInfo?.name||'My Business';
  const headerCustomName=document.getElementById('headerCustomName');
  const headerSubtitle=document.getElementById('headerSubtitle');
  const headerReadonly=document.getElementById('headerReadonly');
  headerCustomName.textContent=h.brand||'';
  headerSubtitle.textContent=data.businessInfo?.type||h.sub||'';
  headerCustomName.style.display=h.brand?'block':'none';
  headerSubtitle.style.display=(data.businessInfo?.type||h.sub)?'block':'none';
  headerReadonly.textContent=h.readonly||"OWNER'S VIEW";
  headerReadonly.style.display=h.readonly?'inline-block':'none';
  const installText=h.install||'Chat Admin';
  installBtn.textContent=installText;
  installBtn.classList.toggle('show',h.showInstall===true);
  refreshBranchSelect();
  renderClientReport();

  filtered=branchScope(data.sales).filter(s=>inRange(s.date));
  const expenses=branchScope(data.expenses).filter(x=>inRange(x.date));
  const payments=branchScope(data.payments).filter(x=>inRange(x.date));

  const totalSales=filtered.reduce((a,x)=>a+Number(x.total||0),0);
  const totalExpenses=expenses.reduce((a,x)=>a+Number(x.amount||0),0);
  const debtorPayments=payments.reduce((a,x)=>a+Number(x.amount||0),0);
  const cashReceived=filtered.reduce((a,x)=>a+salePaid(x),0)+debtorPayments;
  const creditSales=filtered.filter(x=>saleOutstanding(x)>0);
  const creditSalesTotal=creditSales.reduce((a,x)=>a+saleOutstanding(x),0);

  document.getElementById('totalSales').textContent=money(totalSales);
  document.getElementById('transactionCount').textContent=filtered.length+' transaction'+(filtered.length===1?'':'s');
  document.getElementById('totalExpenses').textContent=money(totalExpenses);
  document.getElementById('cashReceived').textContent=money(cashReceived);
  document.getElementById('debtorPaymentNote').textContent=payments.length?`${payments.length} debtor${payments.length===1?'':'s'} made payment${payments.length===1?'':'s'}`:'No debtor payments in this period';
  document.getElementById('creditSalesCount').textContent=creditSales.length+' credit sale'+(creditSales.length===1?'':'s');
  document.getElementById('creditSalesTotal').textContent=money(creditSalesTotal);

  // Outstanding balances are calculated from all historical credit sales minus all historical payments.
  const customerBalances={};
  branchScope(data.sales).filter(x=>saleOutstanding(x)>0&&x.customer).forEach(x=>{
    customerBalances[x.customer]=(customerBalances[x.customer]||0)+saleOutstanding(x);
  });
  branchScope(data.payments).forEach(x=>{
    customerBalances[x.customer]=(customerBalances[x.customer]||0)-Number(x.amount||0);
  });
  Object.keys(customerBalances).forEach(k=>{if(customerBalances[k]<=0)delete customerBalances[k];});
  const debtTotal=Object.values(customerBalances).reduce((a,b)=>a+b,0);
  document.getElementById('owingCount').textContent=Object.keys(customerBalances).length+' customer'+(Object.keys(customerBalances).length===1?'':'s')+' owing';
  document.getElementById('debtTotal').textContent=money(debtTotal);

  const scopedProducts=branchScope(data.products);
  const low=scopedProducts.filter(p=>clientProductStock(p)<=Number(p.reorder||0));
  const available=scopedProducts.filter(p=>clientProductStock(p)>Number(p.reorder||0));
  document.getElementById('lowStockCount').textContent=low.length;
  document.getElementById('availableStockCount').textContent=available.length;
  renderProductsSold();

  document.getElementById('periodLabel').textContent=rangeLabel();
  document.getElementById('rangeText').textContent='';

  renderSales();
}

function renderProductsSold(){
  const host=document.getElementById('productSalesList');if(!host)return;
  const totals=new Map();
  (filtered||[]).forEach(s=>(s.items||[]).forEach(i=>{
    const key=String(i.productId||i.product||'Item');
    const product=(data.products||[]).find(p=>String(p.id)===String(i.productId))|| (data.products||[]).find(p=>String(p.name)===String(i.product));
    const name=i.product||product?.name||'Item';
    const unit=i.measure||product?.unit||product?.unitName||'';
    const row=totals.get(key)||{name,qty:0,unit,amount:0,before:[],after:[]};
    row.qty+=Number(i.qty||0);row.amount+=Number(i.qty||0)*Number(i.unit||0);if(!row.unit&&unit)row.unit=unit;
    if(i.stockBefore!==null&&i.stockBefore!==undefined&&i.stockBefore!=='')row.before.push(Number(i.stockBefore));
    if(i.stockAfter!==null&&i.stockAfter!==undefined&&i.stockAfter!=='')row.after.push(Number(i.stockAfter));
    totals.set(key,row);
  }));
  const rows=[...totals.values()].sort((a,b)=>a.name.localeCompare(b.name));
  if(!rows.length){host.innerHTML='<div class="empty">No products sold in this date range.</div>';return;}
  const stockText=arr=>arr.length?arr.join(', '):'Not recorded';
  host.innerHTML='<div class="productSalesTableWrap"><table class="productSalesTable"><thead><tr><th>Product</th><th>Quantity</th><th>Sales Amount</th></tr></thead><tbody>'+rows.map(r=>`<tr><td>${escHtml(r.name)}</td><td>${escHtml(String(r.qty))}</td><td class="num">${money(r.amount)}</td></tr>`).join('')+'</tbody></table></div>';
}

function saleTotal(s){return Number(s.total||s.items.reduce((a,i)=>a+i.qty*i.unit,0));}
function renderSales(showAll=true){
  const cashCount=filtered.filter(x=>salePaymentStatus(x)==='Cash').length;
  const partlyCount=filtered.filter(x=>salePaymentStatus(x)==='Partly Credit').length;
  const creditCount=filtered.filter(x=>salePaymentStatus(x)==='Credit').length;
  document.getElementById('salesSummary').innerHTML=`${filtered.length} Transactions<br><span><b class="green">${cashCount} Cash</b> • <b class="red">${partlyCount} Partly Credit</b> • <b class="red">${creditCount} Credit</b></span>`;
  const list=showAll?filtered:filtered.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4);
  document.getElementById('salesList').innerHTML=list.length?list.map((s,i)=>{
    const customer=s.customer||'Customer';
    const customerHtml=`<button class="customerBtn" data-sale-index="${filtered.indexOf(s)}">${customer}</button>`;
    return `<div class="row">
      <div class="left"><div>${customerHtml}</div><div class="meta">${s.invoiceNo?`Invoice: ${s.invoiceNo} • `:""}${fmt(s.date)}</div></div>
      <div style="text-align:right"><div class="amount">${money(saleTotal(s))}</div><div class="meta ${salePaymentStatus(s)==='Cash'?'green':'red'}">${salePaymentStatus(s)}</div></div>
    </div>`;
  }).join(''):'<div class="empty">No sales in this date range.</div>';
  document.querySelectorAll('.customerBtn').forEach(btn=>btn.onclick=()=>openSaleDetails(Number(btn.dataset.saleIndex)));
}
let modalHistory=[];
function setModal(title,subtitle,body){
  document.getElementById('modalTitle').textContent=title;
  document.getElementById('modalSubtitle').textContent=subtitle||'';
  document.getElementById('modalBody').innerHTML=body;
  document.getElementById('modal').classList.add('open');
}
function openModal(title,subtitle,body){
  if(document.getElementById('modal').classList.contains('open')){
    modalHistory.push({title:document.getElementById('modalTitle').textContent,subtitle:document.getElementById('modalSubtitle').textContent,body:document.getElementById('modalBody').innerHTML});
  }
  setModal(title,subtitle,body);
}
function backModal(){
  if(modalHistory.length){const p=modalHistory.pop();setModal(p.title,p.subtitle,p.body);}
  else closeModal();
}
function closeModal(){stopClientMessageRealtime();modalHistory=[];document.getElementById('modal').classList.remove('open');}

function openExpenses(){
  const rows=branchScope(data.expenses).filter(x=>inRange(x.date)).sort((a,b)=>b.date.localeCompare(a.date));
  const total=rows.reduce((a,x)=>a+Number(x.amount||0),0);
  openModal('Expense Details',`${rows.length} expense record${rows.length===1?'':'s'} • ${fmt(selectedStart)} – ${fmt(selectedEnd)}`,
    `<div class="detailTotal">${money(total)}</div>`+
    (rows.length?rows.map(x=>`<div class="row"><div class="left"><div class="name">${x.description}</div><div class="meta">${fmtLong(x.date)}</div></div><div class="amount">${money(x.amount)}</div></div>`).join(''):'<div class="empty">No expenses in this date range.</div>')
  );
}
function openCash(){
  const saleReceipts=filtered.reduce((a,x)=>a+salePaid(x),0);
  const payments=branchScope(data.payments).filter(x=>inRange(x.date));
  const payTotal=payments.reduce((a,x)=>a+Number(x.amount||0),0);
  openModal('Amount Received',`${fmt(selectedStart)} – ${fmt(selectedEnd)}`,
    `<div class="detailTotal">${money(saleReceipts+payTotal)}</div>
     <div class="detailCard"><div class="name">Payments received with sales</div><div class="detailValue" style="margin-top:6px">${money(saleReceipts)}</div></div>
     <div class="detailCard"><div class="name">Debtor payments</div><div class="detailValue" style="margin-top:6px">${money(payTotal)}</div>
     ${payments.length?payments.map(p=>`<div class="row"><div><div class="name">${p.customer}</div><div class="meta">${fmtLong(p.date)}</div></div><div class="amount">${money(p.amount)}</div></div>`).join(''):'<div class="empty">No debtor payments in this period.</div>'}</div>`
  );
}
function openDebtors(){
  const balances={};
  branchScope(data.sales).filter(x=>saleOutstanding(x)>0&&x.customer).forEach(x=>balances[x.customer]=(balances[x.customer]||0)+saleOutstanding(x));
  branchScope(data.payments).forEach(x=>balances[x.customer]=(balances[x.customer]||0)-Number(x.amount||0));
  Object.keys(balances).forEach(k=>{if(balances[k]<=0)delete balances[k];});
  const names=Object.keys(balances).sort((a,b)=>balances[b]-balances[a]);
  openModal('Customers Owing',`${names.length} customer${names.length===1?'':'s'} currently owing`,
    names.length?names.map(name=>`<div class="row clickable debtorItem" data-name="${encodeURIComponent(name)}"><div class="left"><div class="name">${name}</div><div class="meta">Tap to view transactions</div></div><div class="amount">${money(balances[name])}</div></div>`).join(''):'<div class="empty">No outstanding customers.</div>');
  document.querySelectorAll('.debtorItem').forEach(x=>x.onclick=()=>openDebtorDetails(decodeURIComponent(x.dataset.name)));
}
function openDebtorDetails(name){
  const credit=branchScope(data.sales).filter(x=>saleOutstanding(x)>0&&x.customer===name);
  const payments=branchScope(data.payments).filter(x=>x.customer===name);
  const owed=credit.reduce((a,x)=>a+saleOutstanding(x),0), paid=payments.reduce((a,x)=>a+Number(x.amount||0),0), balance=Math.max(0,owed-paid);
  openModal(name,`Outstanding balance: ${money(balance)}`,
    `<div class="detailTotal">${money(balance)}</div><div class="detailCard"><strong>Credit sales</strong>`+
    (credit.length?credit.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class="row"><div class="left"><div class="name">${fmtLong(x.date)} • ${x.items.length} item${x.items.length===1?'':'s'}</div><div class="meta">${x.items.map(i=>`${i.product} × ${i.qty}`).join(', ')}</div></div><div class="amount">${money(saleTotal(x))}</div></div>`).join(''):'<div class="empty">No credit sales.</div>')+
    `</div><div class="detailCard"><strong>Payments made</strong>`+
    (payments.length?payments.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class="row"><div class="left"><div class="name">Payment</div><div class="meta">${fmtLong(x.date)}</div></div><div class="amount">${money(x.amount)}</div></div>`).join(''):'<div class="empty">No recorded payments.</div>')+`</div>`
  );
}
function openAvailableStock(){
  const available=branchScope(data.products).filter(p=>clientProductStock(p)>Number(p.reorder||0)).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||'')));
  openModal('Available Stock',`${available.length} item${available.length===1?'':'s'}`,
    available.length?available.map(p=>`<div class="row"><div class="left"><div class="name">${p.name}</div><div class="meta">Reorder level: ${p.reorder}</div></div><div class="amount">${clientProductStock(p)}</div></div>`).join(''):'<div class="empty">No available-stock items.</div>');
}
function showSalesPage(){
  document.querySelector('main').style.display='none';
  document.getElementById('salesPage').style.display='block';
  renderSales(true);
  window.scrollTo({top:0,behavior:'smooth'});
}
function hideSalesPage(){
  document.getElementById('salesPage').style.display='none';
  document.querySelector('main').style.display='block';
  window.scrollTo({top:0,behavior:'smooth'});
}
function openLowStock(){
  const low=branchScope(data.products).filter(p=>clientProductStock(p)<=Number(p.reorder||0));
  openModal('Low Stock Items',`${low.length} item${low.length===1?'':'s'}`,
    low.length?low.map(p=>`<div class="row"><div class="name">${p.name}</div><div class="amount">${clientProductStock(p)}</div></div>`).join(''):'<div class="empty">No low-stock items.</div>');
}
function openSaleDetails(index){
  const s=filtered[index]; if(!s)return;
  openModal(s.customer||'Sale Details',`Transaction • ${fmtLong(s.date)}`,
    `<div class="detailCard"><div class="detailGrid">
      <div class="detailItem"><div class="detailLabel">Customer</div><div class="detailValue">${s.customer||'Customer'}</div></div><div class="detailItem"><div class="detailLabel">Invoice No.</div><div class="detailValue">${s.invoiceNo||'—'}</div></div>
      <div class="detailItem"><div class="detailLabel">Payment Status</div><div class="detailValue ${salePaymentStatus(s)==='Cash'?'green':'red'}">${salePaymentStatus(s)}</div></div>
    </div></div>
    <div class="detailCard"><strong>Items Purchased</strong>`+
    s.items.map(i=>`<div class="row"><div class="left"><div class="name">${i.product}</div><div class="meta">Qty: ${i.qty} × ${money(i.unit)}</div></div><div class="amount">${money(i.qty*i.unit)}</div></div>`).join('')+
    `<div class="row"><div class="name">TOTAL</div><div class="amount">${money(saleTotal(s))}</div></div><div class="row"><div class="name">Amount Received</div><div class="amount">${money(salePaid(s))}</div></div><div class="row"><div class="name">Outstanding</div><div class="amount red">${money(saleOutstanding(s))}</div></div></div>`
  );
}

document.getElementById('branchSelect').addEventListener('change',e=>{activeClientBranchId=e.target.value||'all';render();});
document.getElementById('periodSelect').addEventListener('change',e=>{
  const type=e.target.value;
  if(type==='custom'){showCustom(true);}
  else {setPreset(type);}
  const r=getSelectedRange(); if(r){[selectedStart,selectedEnd]=r; render();}
});
document.getElementById('startDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});
document.getElementById('endDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});
document.getElementById('backModal').onclick=backModal;
document.getElementById('salesCard').onclick=showSalesPage;
document.getElementById('expensesCard').onclick=openExpenses;
document.getElementById('cashCard').onclick=openCash;
document.getElementById('debtCard').onclick=openDebtors;
document.getElementById('lowStockCard').onclick=openLowStock;
document.getElementById('availableStockCard').onclick=openAvailableStock;
document.getElementById('backSalesPage').onclick=hideSalesPage;
document.getElementById('closeModal').onclick=closeModal;
document.getElementById('modal').onclick=e=>{if(e.target.id==='modal')closeModal();};

setPreset('today');
[selectedStart,selectedEnd]=getRange('today');

function showOfflineNotice(){document.querySelector('.app').style.visibility='hidden';const gate=document.getElementById('connectGate');gate.style.display='flex';document.getElementById('connectGateCard').innerHTML='<div style="font-size:19px;font-weight:850">Network Connection. Check Your Network Data</div>';}
function touchClientActivity(){if(clientLoggedOut||document.querySelector('.app').style.visibility==='hidden'||document.getElementById('connectGate').style.display!=='none')return;const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();if(lock?.hash){lock.lastActiveAt=Date.now();localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(lock));}}
['pointerdown','keydown','touchstart','click'].forEach(ev=>document.addEventListener(ev,touchClientActivity,{passive:true}));
setInterval(()=>{const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();if(!clientLoggedOut&&lock?.hash&&Date.now()-Number(lock.lastActiveAt||0)>=6*60*60*1000&&document.querySelector('.app').style.visibility!=='hidden'){if(onlineTimer)clearInterval(onlineTimer);showConnectGate('unlock');}},60000);
window.addEventListener('offline',()=>{if(savedClientConfig()?.feedId)showOfflineNotice()});
window.addEventListener('online',()=>{if(clientLoggedOut||localStorage.getItem(CLIENT_LOGOUT_KEY)==='1')return;const saved=savedClientConfig();if(saved?.feedId){const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();if(lock?.hash&&Date.now()-Number(lock.lastActiveAt||0)>=6*60*60*1000)showConnectGate('unlock');else loadOnline({url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:saved.feedId},{saveConfig:false}).then(ok=>{if(!ok)showOfflineNotice()});}});

(function initClientConnection(){
  try{localStorage.removeItem('trader_v5_data');localStorage.removeItem('tbc_client_v6_connection');localStorage.removeItem('tbc_client_v6_local_password')}catch(e){}
  if(window.__TBC_PREVIEW_MODE__&&window.__TBC_PREVIEW_DATA__){data=adaptOnlinePayload(window.__TBC_PREVIEW_DATA__);onlineMode=true;hideConnectGate();render();return;}
  const saved=savedClientConfig();
  let lock=null;try{lock=JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){}
  if(!saved?.feedId){showConnectGate('setup');return;}
  if(localStorage.getItem(CLIENT_LOGOUT_KEY)==='1'){clientLoggedOut=true;if(lock?.requiresPasswordSetup||!lock?.hash)showConnectGate('setupPassword');else showConnectGate('unlock');return;}
  const SIX_HOURS=6*60*60*1000;
  if(!navigator.onLine){showOfflineNotice();return;}
  if(lock?.requiresPasswordSetup){showConnectGate('setupPassword');return;}
  if(lock?.hash && Date.now()-Number(lock.lastActiveAt||0)>=SIX_HOURS){showConnectGate('unlock');return;}
  loadOnline({url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:saved.feedId},{saveConfig:false}).then(ok=>{if(!ok)showOfflineNotice();});
})();

// PWA shell registration: the live business data still comes directly from Supabase.
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js').then(reg=>{
    // Check for a new deployed Client version whenever the app opens.
    reg.update().catch(()=>{});
    if (reg.waiting) reg.waiting.postMessage({type:'SKIP_WAITING'});
    reg.addEventListener('updatefound',()=>{
      const worker=reg.installing;
      if(worker) worker.addEventListener('statechange',()=>{
        if(worker.state==='installed' && navigator.serviceWorker.controller){
          worker.postMessage({type:'SKIP_WAITING'});
        }
      });
    });
  }).catch(()=>{});
  let refreshing=false;
  navigator.serviceWorker.addEventListener('controllerchange',()=>{
    if(refreshing)return;
    refreshing=true;
    window.location.reload();
  });
}
</script>
</body>
</html>
