<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0f766e">
<meta name="description" content="Trader Business Control — read-only business dashboard">
<meta name="mobile-web-app-capable" content="yes">
<meta name="application-name" content="Business Control">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="Business Control">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
<link rel="icon" type="image/png" sizes="48x48" href="favicon-48.png">
<link rel="icon" href="favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="icons/icon-180.png">
<title>Trader Business Control — Client</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f4f7f7;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#17202a}
.app{max-width:520px;margin:auto;min-height:100vh;padding-bottom:28px;visibility:hidden}
header{background:#0f766e;color:#fff;padding:20px 16px 22px;border-radius:0 0 22px 22px}
.brand{font-size:20px;font-weight:800}.sub{font-size:12px;opacity:.82;margin-top:3px}
.installBtn{display:none;margin-top:10px;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:8px 11px;font-size:11px;font-weight:800;cursor:pointer}.installBtn.show{display:inline-block}.readonly{display:inline-block;margin-top:11px;background:rgba(255,255,255,.14);border-radius:99px;padding:6px 10px;font-size:10px;font-weight:800}
main{padding:14px}
.panel,.card,.list{background:#fff;border:1px solid #e1e7e9;border-radius:16px;box-shadow:0 2px 10px rgba(15,23,42,.05)}
.panel{padding:13px;margin-bottom:14px}
.rangeTitle,.sectionTitle{display:flex;justify-content:space-between;align-items:center}
.rangeTitle strong,.sectionTitle h2{font-size:15px;margin:0}.rangeTitle span,.sectionTitle span{font-size:11px;color:#68737d}
select,input{width:100%;margin-top:7px;padding:11px;border:1px solid #dce3e6;border-radius:10px;background:#fff;font-size:16px}
.customDates{display:none;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.customDates.show{display:grid}
.cards{display:grid;grid-template-columns:1fr 1fr;gap:9px}
.card{padding:14px}
.value{font-size:21px;font-weight:850;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.subvalue{font-size:11px;color:#68737d;margin-top:4px}
.green{color:#047857}.red{color:#b91c1c}.teal{color:#0f766e}
.clickable{cursor:pointer}.clickable:active{transform:scale(.99)}
.hint{font-size:10px;color:#0f766e;margin-top:7px}
.sectionTitle{margin:18px 2px 9px}
.fullCard{margin-bottom:9px}
.list{overflow:hidden}
.row{display:flex;justify-content:space-between;gap:12px;padding:13px;border-bottom:1px solid #e7ecee}
.row:last-child{border-bottom:0}
.left{min-width:0}.name{font-size:13px;font-weight:750}.meta{font-size:11px;color:#68737d;margin-top:3px}.amount{font-weight:800;white-space:nowrap}
.link{border:0;background:none;color:#0f766e;font-weight:800;font-size:12px;padding:0;cursor:pointer}
.empty{text-align:center;padding:22px;color:#68737d;font-size:13px}
.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.48);z-index:20;align-items:flex-end}
.modal.open{display:flex}
.sheet{width:100%;max-width:520px;margin:auto;background:#fff;border-radius:20px 20px 0 0;max-height:88vh;overflow:auto;padding:16px}
.sheetHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.close,.backBtn{border:0;background:#eef2f3;border-radius:50%;width:40px;height:40px;cursor:pointer}.backBtn{border-radius:10px;width:auto;padding:0 12px;font-weight:800;color:#0f766e}
.detailTotal{font-size:23px;font-weight:850;margin:7px 0 12px}
.detailCard{border:1px solid #e1e7e9;border-radius:13px;padding:12px;margin-bottom:8px}
.detailGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}
.detailItem{background:#f7f9f9;border-radius:9px;padding:9px}.detailLabel{font-size:10px;color:#68737d}.detailValue{font-size:13px;font-weight:750;margin-top:2px}
.customerBtn{border:0;background:none;padding:0;color:#0f766e;font:inherit;font-weight:800;text-align:left;cursor:pointer}.salesSummary{font-size:12px;font-weight:800;color:#17202a;margin:-3px 2px 9px}.salesSummary span{display:block;margin-top:3px;font-weight:700}
@media(max-width:360px){.cards{grid-template-columns:1fr}.customDates{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
<header>
  <div class="brand" id="businessName">Connecting…</div>
  <div class="sub">Business Control • Owner View</div>
  <div class="readonly">VIEW ONLY • DATA ENTRY DISABLED</div>
  <button id="installBtn" class="installBtn" type="button">Install Business Control</button>
</header>

<main>
<section class="panel">
  <div class="rangeTitle"><strong>Report Period</strong><span id="periodLabel">01/09/2026 - 22/09/2026</span></div>
  <select id="periodSelect">
    <option value="today">Today</option>
    <option value="week">This Week</option>
    <option value="month" selected>This Month</option>
    <option value="lastmonth">Last Month</option>
    <option value="custom">Custom</option>
  </select>
  <div class="rangeTitle" style="margin-top:10px"><strong>Branch</strong><span id="branchLabel">All Branches</span></div>
  <select id="branchSelect"></select>
  <div class="customDates" id="customDates">
    <label style="font-size:11px;color:#68737d">Start Date<input id="startDate" type="date"></label>
    <label style="font-size:11px;color:#68737d">End Date<input id="endDate" type="date"></label>
  </div>
</section>

<div class="sectionTitle"><h2>Business Overview</h2><span id="rangeText"></span></div>
<section class="cards">
  <div class="card">
    <div class="label">Total Sale</div>
    <div class="value" id="totalSales">₦0</div>
    <div class="subvalue" id="transactionCount">0 transactions</div>
  </div>

  <div class="card clickable" id="expensesCard">
    <div class="label">Expenses</div>
    <div class="value" id="totalExpenses">₦0</div>
    <div class="hint">Tap to view expense details</div>
  </div>

  <div class="card clickable" id="cashCard">
    <div class="label">Cash Received</div>
    <div class="value teal" id="cashReceived">₦0</div>
    <div class="subvalue" id="debtorPaymentNote"></div>
    <div class="hint">Tap to view cash details</div>
  </div>

  <div class="card" id="creditSalesCard">
    <div class="label">Total Credit Sales</div>
    <div class="subvalue" id="creditSalesCount">0 credit sales</div>
    <div class="value red" id="creditSalesTotal">₦0</div>
  </div>
</section>

<section class="card clickable fullCard" id="debtCard">
  <div class="label">Customers Owing</div>
  <div class="subvalue" id="owingCount">0 customers owing</div>
  <div class="value red" id="debtTotal">₦0</div>
  <div class="hint">Tap to view debtors list</div>
</section>

<div class="sectionTitle"><h2>Stock</h2></div>
<section class="cards">
  <div class="card clickable" id="lowStockCard">
    <div class="label">Low Stock Items</div>
    <div class="value" id="lowStockCount">0</div>
    <div class="hint">Tap to view low-stock items</div>
  </div>
</section>

<div class="sectionTitle">
  <h2>Sales</h2>
  <button class="link" id="viewAllSales">View All</button>
</div>
<div class="salesSummary" id="salesSummary">0 Transactions<br><span><b class="green">0 Cash</b> • <b class="red">0 Credit</b></span></div>
<section class="list" id="salesList"></section>
</main>
</div>

<div class="modal" id="modal">
  <div class="sheet">
    <div class="sheetHead">
      <div style="display:flex;align-items:center;gap:8px"><button class="backBtn" id="backModal">← Back</button><div><strong id="modalTitle">Details</strong><div class="meta" id="modalSubtitle"></div></div></div>
      <button class="close" id="closeModal">✕</button>
    </div>
    <div id="modalBody"></div>
  </div>
</div>


<div id="connectGate" style="display:flex;min-height:100vh;align-items:center;justify-content:center;padding:24px;text-align:center;color:#68737d;font-size:14px">Connecting to Sabrity…</div>

<script>
const KEY='trader_v5_data';
const CLIENT_CONFIG_KEY='tbc_client_v6_connection';
const SUPABASE_URL='https://qgaocesvzqpqkecjotly.supabase.co';
const SUPABASE_PUBLISHABLE_KEY='sb_publishable_PTtJexVGkqdkV4QrlFMJsg_32iXPcWo';
const DEFAULT_FEED_ID='CLIENT-BUILD-001';
let onlineMode=false;
let onlineTimer=null;
let deferredInstallPrompt=null;
let activeClientBranchId='all';
const installBtn=document.getElementById('installBtn');
const installHelp=document.getElementById('installHelp');
let installEligibilityTimer=null;
window.addEventListener('beforeinstallprompt',e=>{
  e.preventDefault();
  deferredInstallPrompt=e;
  installBtn.classList.add('show');
  if(installHelp) installHelp.style.display='none';
});
window.addEventListener('appinstalled',()=>{
  deferredInstallPrompt=null;
  installBtn.classList.remove('show');
  if(installHelp) installHelp.style.display='none';
});
installBtn.addEventListener('click',async()=>{
  if(!deferredInstallPrompt){
    if(installHelp) installHelp.style.display='block';
    alert('Open this page in Google Chrome. If Chrome shows Install app in its menu, choose it there.');
    return;
  }
  deferredInstallPrompt.prompt();
  try{ await deferredInstallPrompt.userChoice; }catch(e){}
  deferredInstallPrompt=null;
  installBtn.classList.remove('show');
});
function armInstallHelp(){
  if(installEligibilityTimer) clearTimeout(installEligibilityTimer);
  installEligibilityTimer=setTimeout(()=>{
    if(!deferredInstallPrompt && !window.matchMedia('(display-mode: standalone)').matches && !window.navigator.standalone){
      installBtn.classList.add('show');
      if(installHelp) installHelp.style.display='block';
    }
  },35000);
}
armInstallHelp();
function normalizeUrl(u){return String(u||'').trim().replace(/\/$/,'').replace(/\/rest\/v1$/,'');}
function getFeedId(){
  const params=new URLSearchParams(location.search);
  const fromUrl=(params.get('feed')||params.get('feed_id')||'').trim();
  return fromUrl || DEFAULT_FEED_ID;
}
function clientConfig(){return {url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:getFeedId()};}
function showConnectGate(){}
function hideConnectGate(){document.getElementById('connectGate').style.display='none';document.querySelector('.app').style.visibility='visible';}
async function fetchOnlineSnapshot(cfg){
  const base=normalizeUrl(cfg.url);
  if(!base||!cfg.key||!cfg.feedId) throw new Error('Client connection is not configured.');
  const url=base+'/rest/v1/client_feeds?select=payload,business_name,updated_at&feed_id=eq.'+encodeURIComponent(cfg.feedId)+'&limit=1';
  const r=await fetch(url,{headers:{'apikey':cfg.key,'Authorization':'Bearer '+cfg.key,'Accept':'application/json'}});
  if(!r.ok){let t='';try{t=await r.text()}catch(e){};throw new Error(r.status+': '+(t||'Connection failed'));}
  const rows=await r.json();
  if(!rows.length) throw new Error('This Client Feed ID was not found.');
  return rows[0].payload;
}
function adaptOnlinePayload(p){
  if(typeof p==='string'){ try{ p=JSON.parse(p); }catch(e){ p={}; } }
  p=p||{};
  const branches=(p.branches||[]).map(b=>({id:b.id,name:b.name||'Branch',address:b.address||''}));
  const customerMap={};(p.customers||[]).forEach(c=>customerMap[c.id]=c.name);
  const productMap={};(p.products||[]).forEach(x=>productMap[x.id]=x);
  const sales=(p.sales||[]).map(s=>({id:s.id,branchId:s.branchId||'',date:s.date,customer:customerMap[s.customerId]||'Customer',payment:String(s.type||s.payment_type||'cash').toLowerCase()==='cash'?'Cash':'Credit',items:(s.items||[]).map(i=>({product:productMap[i.productId]?.name||i.product||'Item',qty:Number(i.quantity??i.qty??0),unit:Number(i.unitPrice??i.unit??0)})),total:Number(s.total||0)}));
  const payments=(p.payments||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.paymentDate||x.date,customer:customerMap[x.customerId]||'Customer',amount:Number(x.amount||0)}));
  const expenses=(p.expenses||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.expenseDate||x.date,description:x.description||'Expense',amount:Number(x.amount||0)}));
  const products=(p.products||[]).map(x=>({id:x.id,branchId:x.branchId||'',name:x.name,qty:Number(x.qty??x.quantity??0),reorder:Number(x.reorder??x.reorderLevel??0),cost:Number(x.costPrice??x.cost??0)}));
  return {business:p.business?.name||p.business_name||'Sabrity',businessId:p.business?.id||p.business_id||'',branches,products,sales,payments,expenses};
}

async function loadOnline(){
  const cfg=clientConfig();
  try{const snap=await fetchOnlineSnapshot(cfg);localStorage.setItem(CLIENT_CONFIG_KEY,JSON.stringify(cfg));data=adaptOnlinePayload(snap);onlineMode=true;hideConnectGate();render();return true;}
  catch(e){onlineMode=false;console.error(e);return false;}
}
async function connectClient(){return loadOnline();}

const money=n=>'₦'+Math.round(Number(n||0)).toLocaleString('en-NG');
const pad=n=>String(n).padStart(2,'0');
const dateStr=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());
const fmt=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'short',year:'numeric'});
const fmtLong=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'long',year:'numeric'});

const fallback={
  business:'',
  products:[
    {name:'Cement',qty:18,reorder:25,cost:6500},
    {name:'Paint',qty:42,reorder:10,cost:8500},
    {name:'Iron Rod',qty:14,reorder:20,cost:12000},
    {name:'PVC Pipe',qty:30,reorder:15,cost:7000},
    {name:'Plumbing Fittings',qty:9,reorder:12,cost:3200},
    {name:'Ceiling Board',qty:16,reorder:8,cost:6800},
    {name:'Electrical Cable',qty:11,reorder:15,cost:9200},
    {name:'Adhesive',qty:6,reorder:10,cost:4500}
  ],
  sales:[
    {date:'2026-09-02',customer:'Bello Stores',payment:'Credit',items:[{product:'Cement',qty:20,unit:8500},{product:'Iron Rod',qty:10,unit:15000}]},
    {date:'2026-09-05',customer:'Adeyemi Trading',payment:'Credit',items:[{product:'Iron Rod',qty:35,unit:15000},{product:'PVC Pipe',qty:12,unit:7000}]},
    {date:'2026-09-08',customer:'John Ventures',payment:'Cash',items:[{product:'PVC Pipe',qty:18,unit:7000},{product:'Paint',qty:4,unit:8500}]},
    {date:'2026-09-12',customer:'Adeyemi Trading',payment:'Credit',items:[{product:'Cement',qty:25,unit:8500},{product:'Paint',qty:8,unit:8500}]},
    {date:'2026-09-15',customer:'Bello Stores',payment:'Credit',items:[{product:'Paint',qty:8,unit:8500},{product:'PVC Pipe',qty:10,unit:7000}]},
    {date:'2026-09-17',customer:'Kingsway Shop',payment:'Cash',items:[{product:'Cement',qty:10,unit:8500}]},
    {date:'2026-09-18',customer:'John Ventures',payment:'Cash',items:[{product:'Iron Rod',qty:8,unit:15000},{product:'PVC Pipe',qty:10,unit:7000}]},
    {date:'2026-09-20',customer:'Bello Stores',payment:'Credit',items:[{product:'Cement',qty:15,unit:8500},{product:'Iron Rod',qty:20,unit:15000},{product:'Paint',qty:6,unit:8500}]},
    {date:'2026-09-21',customer:'Apex Builders',payment:'Cash',items:[{product:'PVC Pipe',qty:25,unit:7000},{product:'Paint',qty:10,unit:8500}]},
    {date:'2026-09-22',customer:'Royal Homes',payment:'Credit',items:[{product:'Cement',qty:30,unit:8500},{product:'Iron Rod',qty:15,unit:15000}]},
    {date:'2026-09-20',customer:'Midas Enterprises',payment:'Cash',items:[{product:'Cement',qty:8,unit:8500},{product:'PVC Pipe',qty:10,unit:7000}]},
    {date:'2026-09-20',customer:'Topline Hardware',payment:'Credit',items:[{product:'Iron Rod',qty:12,unit:15000},{product:'Plumbing Fittings',qty:4,unit:4200}]},
    {date:'2026-09-19',customer:'Sunrise Stores',payment:'Cash',items:[{product:'Paint',qty:12,unit:8500},{product:'Adhesive',qty:3,unit:4500}]},
    {date:'2026-09-18',customer:'Midas Enterprises',payment:'Credit',items:[{product:'Ceiling Board',qty:6,unit:9000},{product:'Electrical Cable',qty:5,unit:12000}]},
    {date:'2026-09-16',customer:'Topline Hardware',payment:'Cash',items:[{product:'Cement',qty:18,unit:8500},{product:'Paint',qty:5,unit:8500}]},
    {date:'2026-09-14',customer:'Unity Projects',payment:'Credit',items:[{product:'Iron Rod',qty:20,unit:15000},{product:'PVC Pipe',qty:15,unit:7000},{product:'Adhesive',qty:4,unit:4500}]},
    {date:'2026-09-11',customer:'Sunrise Stores',payment:'Cash',items:[{product:'Cement',qty:10,unit:8500},{product:'Ceiling Board',qty:4,unit:9000}]},
    {date:'2026-09-07',customer:'Midas Enterprises',payment:'Credit',items:[{product:'Paint',qty:10,unit:8500},{product:'Electrical Cable',qty:6,unit:12000}]},
    {date:'2026-09-01',customer:'Unity Projects',payment:'Cash',items:[{product:'PVC Pipe',qty:20,unit:7000},{product:'Plumbing Fittings',qty:6,unit:4200}]},
    {date:'2026-08-25',customer:'Topline Hardware',payment:'Credit',items:[{product:'Cement',qty:25,unit:8500},{product:'Iron Rod',qty:8,unit:15000}]},
    {date:'2026-08-28',customer:'Delta Traders',payment:'Credit',items:[{product:'Cement',qty:12,unit:8500}]},
    {date:'2026-08-30',customer:'John Ventures',payment:'Cash',items:[{product:'Paint',qty:5,unit:8500}]}
  ],
  expenses:[
    {date:'2026-09-04',description:'Transport',amount:18000},
    {date:'2026-09-10',description:'Shop power',amount:12000},
    {date:'2026-09-16',description:'Loading',amount:8000},
    {date:'2026-09-18',description:'Diesel and generator fuel',amount:28500},
    {date:'2026-09-20',description:'Packaging and nylon',amount:9500},
    {date:'2026-09-21',description:'Local delivery transport',amount:14000},
    {date:'2026-09-22',description:'Store cleaning and supplies',amount:6500},
    {date:'2026-09-13',description:'Minor equipment repair',amount:22000},
    {date:'2026-09-08',description:'Water and sanitation',amount:5500}
  ],
  payments:[
    {date:'2026-09-18',customer:'Bello Stores',amount:100000},
    {date:'2026-09-20',customer:'Adeyemi Trading',amount:50000},
    {date:'2026-09-21',customer:'Topline Hardware',amount:120000},
    {date:'2026-09-22',customer:'Royal Homes',amount:90000},
    {date:'2026-09-19',customer:'Midas Enterprises',amount:75000},
    {date:'2026-09-15',customer:'Unity Projects',amount:100000},
    {date:'2026-09-12',customer:'Bello Stores',amount:80000}
  ]
};

let data=null;
let selectedStart,selectedEnd,filtered=[];

function normalizeSale(s){
  if(Array.isArray(s.items)&&s.items.length){
    const items=s.items.map(i=>Array.isArray(i)?{product:i[0],qty:Number(i[1]||0),unit:Number(i[2]||0)}:{product:i.product,qty:Number(i.qty||0),unit:Number(i.unit||i.unitPrice||0)});
    return {...s,items,total:Number(s.total||items.reduce((a,i)=>a+i.qty*i.unit,0))};
  }
  return {...s,items:[{product:s.product||'Item',qty:Number(s.qty||0),unit:Number(s.unit||0)}],total:Number(s.total||0)};
}
function normalizeData(){ if(!data) return; data.sales=(data.sales||[]).map(normalizeSale); if(!Array.isArray(data.payments)) data.payments=[]; if(!Array.isArray(data.expenses)) data.expenses=[]; if(!Array.isArray(data.products)) data.products=[]; }

function getRange(type){
  const now=new Date(); now.setHours(0,0,0,0);
  let s=new Date(now),e=new Date(now);
  if(type==='week') s.setDate(now.getDate()-now.getDay());
  if(type==='month') s.setDate(1);
  if(type==='lastmonth'){s.setMonth(now.getMonth()-1);s.setDate(1);e.setDate(0);}
  return [dateStr(s),dateStr(e)];
}
function showCustom(show){
  document.getElementById('customDates').classList.toggle('show',show);
}
function setPreset(type){
  if(type==='custom'){
    showCustom(true);
    return;
  }
  showCustom(false);
  const [s,e]=getRange(type);
  document.getElementById('startDate').value=s;
  document.getElementById('endDate').value=e;
}
function getSelectedRange(){
  const type=document.getElementById('periodSelect').value;
  if(type==='custom'){
    const s=document.getElementById('startDate').value;
    const e=document.getElementById('endDate').value;
    if(!s||!e||s>e){alert('Please choose a valid start and end date.');return null;}
    return [s,e];
  }
  return getRange(type);
}
function inRange(d){return d>=selectedStart&&d<=selectedEnd;}
function rangeLabel(){
  return selectedStart===selectedEnd ? fmtNumeric(selectedStart) : fmtNumeric(selectedStart)+' - '+fmtNumeric(selectedEnd);
}
function fmtNumeric(d){const x=new Date(d+'T00:00:00');return pad(x.getDate())+'/'+pad(x.getMonth()+1)+'/'+x.getFullYear();}
function branchScope(list){return (list||[]).filter(x=>activeClientBranchId==='all'||String(x.branchId||'')===String(activeClientBranchId));}
function refreshBranchSelect(){
  const sel=document.getElementById('branchSelect');
  const label=document.getElementById('branchLabel');
  if(!sel)return;
  const branches=data?.branches||[];
  if(activeClientBranchId!=='all'&&!branches.some(b=>String(b.id)===String(activeClientBranchId)))activeClientBranchId='all';
  sel.innerHTML='<option value="all">All Branches</option>'+branches.map(b=>`<option value="${b.id}">${b.name}</option>`).join('');
  sel.value=activeClientBranchId;
  label.textContent=activeClientBranchId==='all'?'All Branches':(branches.find(b=>String(b.id)===String(activeClientBranchId))?.name||'All Branches');
}
function render(){
  if(!onlineMode){ data=JSON.parse(localStorage.getItem(KEY)||'null')||fallback; }
  if(!data.payments)data.payments=[];
  normalizeData();
  document.getElementById('businessName').textContent=data.business||'My Business';
  refreshBranchSelect();

  filtered=branchScope(data.sales).filter(s=>inRange(s.date));
  const expenses=branchScope(data.expenses).filter(x=>inRange(x.date));
  const payments=branchScope(data.payments).filter(x=>inRange(x.date));

  const totalSales=filtered.reduce((a,x)=>a+Number(x.total||0),0);
  const totalExpenses=expenses.reduce((a,x)=>a+Number(x.amount||0),0);
  const debtorPayments=payments.reduce((a,x)=>a+Number(x.amount||0),0);
  const cashSales=filtered.filter(x=>x.payment==='Cash').reduce((a,x)=>a+Number(x.total||0),0);
  const creditSales=filtered.filter(x=>x.payment==='Credit');
  const creditSalesTotal=creditSales.reduce((a,x)=>a+Number(x.total||0),0);
  const cashReceived=cashSales+debtorPayments;

  document.getElementById('totalSales').textContent=money(totalSales);
  document.getElementById('transactionCount').textContent=filtered.length+' transaction'+(filtered.length===1?'':'s');
  document.getElementById('totalExpenses').textContent=money(totalExpenses);
  document.getElementById('cashReceived').textContent=money(cashReceived);
  document.getElementById('debtorPaymentNote').textContent=payments.length?`${payments.length} debtor${payments.length===1?'':'s'} made payment${payments.length===1?'':'s'}`:'No debtor payments in this period';
  document.getElementById('creditSalesCount').textContent=creditSales.length+' credit sale'+(creditSales.length===1?'':'s');
  document.getElementById('creditSalesTotal').textContent=money(creditSalesTotal);

  // Outstanding balances are calculated from all historical credit sales minus all historical payments.
  const customerBalances={};
  branchScope(data.sales).filter(x=>x.payment==='Credit'&&x.customer).forEach(x=>{
    customerBalances[x.customer]=(customerBalances[x.customer]||0)+Number(x.total||0);
  });
  branchScope(data.payments).forEach(x=>{
    customerBalances[x.customer]=(customerBalances[x.customer]||0)-Number(x.amount||0);
  });
  Object.keys(customerBalances).forEach(k=>{if(customerBalances[k]<=0)delete customerBalances[k];});
  const debtTotal=Object.values(customerBalances).reduce((a,b)=>a+b,0);
  document.getElementById('owingCount').textContent=Object.keys(customerBalances).length+' customer'+(Object.keys(customerBalances).length===1?'':'s')+' owing';
  document.getElementById('debtTotal').textContent=money(debtTotal);

  const low=branchScope(data.products).filter(p=>Number(p.qty||0)<=Number(p.reorder||0));
  document.getElementById('lowStockCount').textContent=low.length;

  document.getElementById('periodLabel').textContent=rangeLabel();
  document.getElementById('rangeText').textContent='';

  renderSales();
}
function saleTotal(s){return Number(s.total||s.items.reduce((a,i)=>a+i.qty*i.unit,0));}
function renderSales(showAll=false){
  const cashCount=filtered.filter(x=>x.payment==='Cash').length;
  const creditCount=filtered.filter(x=>x.payment==='Credit').length;
  document.getElementById('salesSummary').innerHTML=`${filtered.length} Transactions<br><span><b class="green">${cashCount} Cash</b> • <b class="red">${creditCount} Credit</b></span>`;
  const list=showAll?filtered:filtered.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4);
  document.getElementById('salesList').innerHTML=list.length?list.map((s,i)=>{
    const customer=s.customer||'Customer';
    const customerHtml=`<button class="customerBtn" data-sale-index="${filtered.indexOf(s)}">${customer}</button>`;
    return `<div class="row">
      <div class="left"><div>${customerHtml}</div><div class="meta">${fmt(s.date)}</div></div>
      <div style="text-align:right"><div class="amount">${money(saleTotal(s))}</div><div class="meta ${s.payment==='Cash'?'green':'red'}">${s.payment}</div></div>
    </div>`;
  }).join(''):'<div class="empty">No sales in this date range.</div>';
  document.querySelectorAll('.customerBtn').forEach(btn=>btn.onclick=()=>openSaleDetails(Number(btn.dataset.saleIndex)));
}
let modalHistory=[];
function setModal(title,subtitle,body){
  document.getElementById('modalTitle').textContent=title;
  document.getElementById('modalSubtitle').textContent=subtitle||'';
  document.getElementById('modalBody').innerHTML=body;
  document.getElementById('modal').classList.add('open');
}
function openModal(title,subtitle,body){
  if(document.getElementById('modal').classList.contains('open')){
    modalHistory.push({title:document.getElementById('modalTitle').textContent,subtitle:document.getElementById('modalSubtitle').textContent,body:document.getElementById('modalBody').innerHTML});
  }
  setModal(title,subtitle,body);
}
function backModal(){
  if(modalHistory.length){const p=modalHistory.pop();setModal(p.title,p.subtitle,p.body);}
  else closeModal();
}
function closeModal(){modalHistory=[];document.getElementById('modal').classList.remove('open');}

function openExpenses(){
  const rows=branchScope(data.expenses).filter(x=>inRange(x.date)).sort((a,b)=>b.date.localeCompare(a.date));
  const total=rows.reduce((a,x)=>a+Number(x.amount||0),0);
  openModal('Expense Details',`${rows.length} expense record${rows.length===1?'':'s'} • ${fmt(selectedStart)} – ${fmt(selectedEnd)}`,
    `<div class="detailTotal">${money(total)}</div>`+
    (rows.length?rows.map(x=>`<div class="row"><div class="left"><div class="name">${x.description}</div><div class="meta">${fmtLong(x.date)}</div></div><div class="amount">${money(x.amount)}</div></div>`).join(''):'<div class="empty">No expenses in this date range.</div>')
  );
}
function openCash(){
  const cashSales=filtered.filter(x=>x.payment==='Cash');
  const payments=branchScope(data.payments).filter(x=>inRange(x.date));
  const cashSaleTotal=cashSales.reduce((a,x)=>a+Number(x.total||0),0);
  const payTotal=payments.reduce((a,x)=>a+Number(x.amount||0),0);
  openModal('Cash Received',`${fmt(selectedStart)} – ${fmt(selectedEnd)}`,
    `<div class="detailTotal">${money(cashSaleTotal+payTotal)}</div>
     <div class="detailCard"><div class="name">Cash sales</div><div class="detailValue" style="margin-top:6px">${money(cashSaleTotal)}</div></div>
     <div class="detailCard"><div class="name">Debtor payments</div><div class="detailValue" style="margin-top:6px">${money(payTotal)}</div>
     ${payments.length?payments.map(p=>`<div class="row"><div><div class="name">${p.customer}</div><div class="meta">${fmtLong(p.date)}</div></div><div class="amount">${money(p.amount)}</div></div>`).join(''):'<div class="empty">No debtor payments in this period.</div>'}</div>`
  );
}
function openDebtors(){
  const balances={};
  branchScope(data.sales).filter(x=>x.payment==='Credit'&&x.customer).forEach(x=>balances[x.customer]=(balances[x.customer]||0)+saleTotal(x));
  branchScope(data.payments).forEach(x=>balances[x.customer]=(balances[x.customer]||0)-Number(x.amount||0));
  Object.keys(balances).forEach(k=>{if(balances[k]<=0)delete balances[k];});
  const names=Object.keys(balances).sort((a,b)=>balances[b]-balances[a]);
  openModal('Customers Owing',`${names.length} customer${names.length===1?'':'s'} currently owing`,
    names.length?names.map(name=>`<div class="row clickable debtorItem" data-name="${encodeURIComponent(name)}"><div class="left"><div class="name">${name}</div><div class="meta">Tap to view transactions</div></div><div class="amount">${money(balances[name])}</div></div>`).join(''):'<div class="empty">No outstanding customers.</div>');
  document.querySelectorAll('.debtorItem').forEach(x=>x.onclick=()=>openDebtorDetails(decodeURIComponent(x.dataset.name)));
}
function openDebtorDetails(name){
  const credit=branchScope(data.sales).filter(x=>x.payment==='Credit'&&x.customer===name);
  const payments=branchScope(data.payments).filter(x=>x.customer===name);
  const owed=credit.reduce((a,x)=>a+saleTotal(x),0), paid=payments.reduce((a,x)=>a+Number(x.amount||0),0), balance=owed-paid;
  openModal(name,`Outstanding balance: ${money(balance)}`,
    `<div class="detailTotal">${money(balance)}</div><div class="detailCard"><strong>Credit sales</strong>`+
    (credit.length?credit.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class="row"><div class="left"><div class="name">${fmtLong(x.date)} • ${x.items.length} item${x.items.length===1?'':'s'}</div><div class="meta">${x.items.map(i=>`${i.product} × ${i.qty}`).join(', ')}</div></div><div class="amount">${money(saleTotal(x))}</div></div>`).join(''):'<div class="empty">No credit sales.</div>')+
    `</div><div class="detailCard"><strong>Payments made</strong>`+
    (payments.length?payments.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class="row"><div class="left"><div class="name">Payment</div><div class="meta">${fmtLong(x.date)}</div></div><div class="amount">${money(x.amount)}</div></div>`).join(''):'<div class="empty">No recorded payments.</div>')+`</div>`
  );
}
function openLowStock(){
  const low=branchScope(data.products).filter(p=>Number(p.qty||0)<=Number(p.reorder||0));
  openModal('Low Stock Items',`${low.length} item${low.length===1?'':'s'}`,
    low.length?low.map(p=>`<div class="row"><div class="name">${p.name}</div><div class="amount">${p.qty}</div></div>`).join(''):'<div class="empty">No low-stock items.</div>');
}
function openSaleDetails(index){
  const s=filtered[index]; if(!s)return;
  openModal(s.customer||'Sale Details',`Transaction • ${fmtLong(s.date)}`,
    `<div class="detailCard"><div class="detailGrid">
      <div class="detailItem"><div class="detailLabel">Customer</div><div class="detailValue">${s.customer||'Customer'}</div></div>
      <div class="detailItem"><div class="detailLabel">Payment</div><div class="detailValue ${s.payment==='Cash'?'green':'red'}">${s.payment}</div></div>
    </div></div>
    <div class="detailCard"><strong>Items Purchased</strong>`+
    s.items.map(i=>`<div class="row"><div class="left"><div class="name">${i.product}</div><div class="meta">Qty: ${i.qty} × ${money(i.unit)}</div></div><div class="amount">${money(i.qty*i.unit)}</div></div>`).join('')+
    `<div class="row"><div class="name">TOTAL</div><div class="amount">${money(saleTotal(s))}</div></div></div>`
  );
}

document.getElementById('branchSelect').addEventListener('change',e=>{activeClientBranchId=e.target.value||'all';render();});
document.getElementById('periodSelect').addEventListener('change',e=>{
  const type=e.target.value;
  if(type==='custom'){showCustom(true);}
  else {setPreset(type);}
  const r=getSelectedRange(); if(r){[selectedStart,selectedEnd]=r; render();}
});
document.getElementById('startDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});
document.getElementById('endDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});
document.getElementById('backModal').onclick=backModal;
document.getElementById('expensesCard').onclick=openExpenses;
document.getElementById('cashCard').onclick=openCash;
document.getElementById('debtCard').onclick=openDebtors;
document.getElementById('lowStockCard').onclick=openLowStock;
document.getElementById('viewAllSales').onclick=()=>renderSales(true);
document.getElementById('closeModal').onclick=closeModal;
document.getElementById('modal').onclick=e=>{if(e.target.id==='modal')closeModal();};

setPreset('month');
[selectedStart,selectedEnd]=getRange('month');

(function initClientConnection(){
  const cfg=clientConfig();
  if(cfg){
    loadOnline().then(ok=>{
      if(ok){hideConnectGate();if(onlineTimer)clearInterval(onlineTimer);onlineTimer=setInterval(()=>loadOnline(),5000);}
      else { showConnectGate(); }
    });
  }else{showConnectGate();}
})();

// PWA shell registration: the live business data still comes directly from Supabase.
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js').catch(()=>{});
}
</script>
</body>
</html>
