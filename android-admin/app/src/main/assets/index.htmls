<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trader Business Control — Admin App V3</title><style>
:root{--nav:#172033;--nav2:#202b42;--bg:#f4f6fa;--card:#fff;--text:#182230;--muted:#6b7280;--line:#e5e7eb;--accent:#2563eb;--green:#16a34a;--red:#dc2626;--orange:#ea580c;--shadow:0 5px 18px rgba(20,30,50,.07)}*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{display:flex;min-height:100vh}.sidebar{width:245px;background:var(--nav);color:#fff;padding:20px 14px;position:fixed;inset:0 auto 0 0;height:100vh;max-height:100vh;overflow-y:auto;overscroll-behavior:contain;scrollbar-width:thin;scrollbar-color:#64748b #172033;z-index:10}.sidebar::-webkit-scrollbar{width:8px}.sidebar::-webkit-scrollbar-track{background:#172033}.sidebar::-webkit-scrollbar-thumb{background:#64748b;border-radius:8px}.nav{padding-bottom:24px}.brand{font-size:19px;font-weight:800;padding:8px 10px 20px}.brand small{display:block;color:#9ca9bf;font-size:11px;margin-top:4px}.nav button{width:100%;border:0;background:transparent;color:#cbd5e1;text-align:left;padding:11px 13px;border-radius:9px;margin:2px 0}.nav button.active,.nav button:hover{background:var(--nav2);color:#fff}.nav .sep{height:1px;background:#334057;margin:12px 5px}.main{margin-left:245px;width:calc(100% - 245px);padding:22px;max-width:1500px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:12px}.title h1{margin:0;font-size:25px}.title p{margin:5px 0 0;color:var(--muted);font-size:13px}.top-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.badge{padding:7px 10px;border-radius:20px;background:#fff;border:1px solid var(--line);font-size:12px}.period,.business-select{padding:9px 10px;border:1px solid var(--line);border-radius:8px;background:#fff}.business-select{min-width:210px;font-weight:700}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}.card,.section{background:var(--card);border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow)}.card{padding:17px}.label{color:var(--muted);font-size:12px}.value{font-size:25px;font-weight:800;margin-top:7px}.sub{font-size:12px;color:var(--muted);margin-top:6px}.grid2{display:grid;grid-template-columns:1.4fr 1fr;gap:15px}.section{overflow:hidden}.section-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px}.section-head h3{margin:0;font-size:15px}.section-body{padding:15px 17px}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;font-size:13px}.table th,.table td{padding:11px 9px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{color:var(--muted);font-size:11px;text-transform:uppercase}.right{text-align:right!important}.btn{border:0;border-radius:8px;padding:9px 12px;background:var(--accent);color:#fff;font-weight:700;font-size:12px}.btn.secondary{background:#eef2f7;color:#263244}.btn.danger{background:#fee2e2;color:#991b1b}.btn.green{background:#dcfce7;color:#166534}.btn.small{padding:6px 9px}.actions{display:flex;gap:6px;flex-wrap:wrap}.toolbar{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px}.toolbar-left,.toolbar-right{display:flex;gap:8px;flex-wrap:wrap}.search{padding:9px 11px;border:1px solid var(--line);border-radius:8px;min-width:220px;background:#fff}.statline{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:13px}.pill{padding:8px 11px;background:#f8fafc;border:1px solid var(--line);border-radius:8px;font-size:12px}.pill b{font-size:13px}.status{font-size:12px;color:var(--muted);padding:12px 0}.green-text{color:var(--green)}.red-text{color:var(--red)}.orange-text{color:var(--orange)}.page{display:none}.page.active{display:block}.empty{padding:35px;text-align:center;color:var(--muted)}.notice{padding:11px 13px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:9px;font-size:12px;margin-bottom:15px}.warning{padding:11px 13px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;border-radius:9px;font-size:12px;margin-bottom:15px}.modal-back{display:none;position:fixed;inset:0;background:rgba(15,23,42,.52);z-index:30;align-items:center;justify-content:center;padding:15px}.modal-back.open{display:flex}.modal{width:min(760px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.2)}.modal-head{padding:15px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.modal-head h3{margin:0;font-size:16px}.modal-body{padding:18px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:11px;color:var(--muted);font-weight:700}.field input,.field select,.field textarea{padding:10px;border:1px solid #d8dee8;border-radius:8px;background:#fff}.field textarea{min-height:80px;resize:vertical}.modal-foot{padding:13px 18px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}.item-row{display:grid;grid-template-columns:1.4fr .6fr .8fr 36px;gap:7px;align-items:center;margin-bottom:7px}.item-row input,.item-row select{padding:9px;border:1px solid var(--line);border-radius:7px}.remove-item{border:0;background:#fee2e2;color:#991b1b;border-radius:7px;height:34px}.mobile-menu{display:none}.tag{display:inline-block;padding:4px 7px;border-radius:12px;font-size:10px;font-weight:700}.tag.active{background:#dcfce7;color:#166534}.tag.off{background:#fee2e2;color:#991b1b}.tag.major{background:#dbeafe;color:#1d4ed8}.access-list{display:flex;gap:5px;flex-wrap:wrap}.access-chip{background:#eef2ff;color:#3730a3;border-radius:12px;padding:4px 8px;font-size:10px}
@media(max-width:1050px){.cards{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}.business-select{min-width:160px}}@media(max-width:700px){.sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:translateX(0)}.main{margin-left:0;width:100%;padding:14px}.mobile-menu{display:inline-block}.top{align-items:flex-start}.top-right{justify-content:flex-end}.cards{grid-template-columns:1fr 1fr}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.item-row{grid-template-columns:1fr 1fr}.item-row .wide{grid-column:1/-1}}
.status{color:#64748b;line-height:1.5}.badge{padding:5px 9px;border-radius:999px;font-size:11px;font-weight:700}.client-view-shell{background:#fff;border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow);overflow:hidden}.client-view-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}.client-view-head h3{margin:0;font-size:16px}.client-view-head p{margin:5px 0 0;color:var(--muted);font-size:12px}.client-view-meta{display:flex;gap:7px;flex-wrap:wrap}.client-view-frame-wrap{background:#eef2f2;padding:18px;display:flex;justify-content:center;min-height:650px}.client-view-frame{width:min(520px,100%);height:760px;border:1px solid #d9e0e2;border-radius:18px;background:#f4f7f7;box-shadow:0 10px 30px rgba(15,23,42,.12)}.client-view-note{margin:14px 17px 0}@media(max-width:700px){.client-view-frame-wrap{padding:10px}.client-view-frame{height:calc(100vh - 220px);min-height:560px}.client-view-head{align-items:flex-start}}</style><style>
.customer-save-row{margin-top:10px;justify-content:flex-end}
@media(min-width:701px){.inline-form-row{grid-template-columns:repeat(3,minmax(0,1fr))}.inline-five-row{grid-template-columns:repeat(5,minmax(0,1fr))}.inline-note-row{grid-template-columns:auto minmax(0,1fr) auto}.inline-note-row .field{flex-direction:row;align-items:center}.inline-note-row .field label{white-space:nowrap}.customer-save-row{margin-top:0}
}
</style><style>.sale-page{max-width:1100px}.sale-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.ns-customer-scroll{width:100%;overflow-x:auto;padding-bottom:3px}.ns-customer-row{display:grid;grid-template-columns:1.5fr 1fr 1.5fr .667fr 1.334fr;gap:10px;min-width:800px}.ns-customer-row .field input{width:100%;min-width:0}.ns-item-head,.ns-item-row{display:grid;grid-template-columns:minmax(220px,1.8fr) minmax(90px,.65fr) minmax(120px,.9fr) minmax(100px,.8fr) minmax(112px,auto);gap:10px;align-items:center}.ns-item-head{font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;padding:0 8px 8px}.ns-item-row{padding:8px;border-top:1px solid #e2e8f0}.ns-item-row input{min-width:0;width:100%;padding:9px;border:1px solid var(--line);border-radius:7px}.ns-total{font-weight:700;text-align:right}.ns-row-actions{display:flex;align-items:center;justify-content:flex-start;gap:5px;min-width:0}.ns-row-actions .btn{white-space:nowrap}.ns-save-product[hidden]{display:none!important}.sale-summary-scroll{width:100%;overflow-x:auto;margin-top:20px;padding-bottom:4px}.sale-summary{min-width:640px;border-top:1px solid #e2e8f0;padding-top:16px}.sale-summary-top,.sale-summary-bottom{display:grid;grid-template-columns:minmax(180px,1fr) minmax(230px,1.2fr) minmax(130px,auto);gap:16px;align-items:center}.summary-pair{display:flex;align-items:center;justify-content:flex-start;gap:4px;font-size:16px;font-weight:700;min-width:0}.grand-total-pair b{font-size:22px;white-space:nowrap}.paid-pair label{white-space:nowrap}.paid-pair input{width:130px;min-width:100px;margin:0}.summary-full-check{white-space:nowrap}.checkline{display:flex;align-items:center;gap:8px;font-weight:600}.checkline input{width:auto}.sale-summary-bottom{margin-top:12px}.outstanding{grid-column:2;display:flex;align-items:center;justify-content:flex-start;gap:4px;font-size:16px;font-weight:700;margin:0}.outstanding b{white-space:nowrap}.sale-actions{margin-top:14px;justify-content:flex-start}.notice{border:1px solid #cbd5e1;background:#f8fafc;border-radius:10px;padding:10px;color:#334155}@media(max-width:900px){.ns-item-head,.ns-item-row{grid-template-columns:minmax(180px,1.6fr) minmax(75px,.55fr) minmax(100px,.8fr) minmax(85px,.7fr) minmax(110px,auto);gap:7px}.ns-row-actions{gap:4px}.ns-row-actions .btn{padding:6px 7px}}@media(max-width:720px){.ns-item-head{display:none}.ns-item-row{grid-template-columns:minmax(0,1fr) minmax(0,1fr);}.ns-item-row .ns-prod-name{grid-column:1/-1}.ns-item-row .ns-total{text-align:left}.ns-row-actions{grid-column:2;grid-row:auto;flex-wrap:nowrap}.sale-head{align-items:flex-start;flex-direction:row}.ns-customer-row{min-width:800px}}</style><style id="stock-product-row-layout">
.stock-product-form-scroll{width:100%;overflow-x:auto;padding-bottom:4px}
.stock-product-fields{display:grid;grid-template-columns:1.5fr .667fr 1fr 1fr .667fr .667fr;gap:12px;min-width:900px;align-items:end}
.stock-product-fields .field{min-width:0}
.stock-product-fields .field input{width:100%;min-width:0}
.stock-product-actions{display:flex;justify-content:flex-end;align-items:center;gap:14px;margin-top:12px}
.stock-product-actions .status{padding:0;margin:0;text-align:right;white-space:nowrap}
@media(max-width:700px){.stock-product-fields{gap:10px;min-width:900px}.stock-product-actions{justify-content:flex-end}}
</style>
<style>
.sales-filter-grid{display:grid;grid-template-columns:1.05fr 1.4fr 1fr 1fr 1.6fr;gap:10px;margin-bottom:14px;align-items:end}.invoice-control{display:grid;grid-template-columns:28px minmax(0,2fr) 28px;gap:4px;align-items:center}.invoice-control input{width:100%;min-width:0}.invoice-step{height:28px;width:28px;padding:0;font-size:14px;line-height:1;border-radius:6px}
.inline-form-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;align-items:end}
.inline-five-row{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr 1fr;gap:10px;align-items:end}
.inline-note-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;margin-top:10px}
.inline-note-row .field{flex-direction:row;align-items:center;gap:8px}
.inline-note-row .field label{white-space:nowrap}
.inline-form-actions{display:flex;justify-content:flex-end}
@media(max-width:900px){.sales-filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.inline-five-row{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:650px){.sales-filter-grid,.inline-form-row,.inline-five-row{grid-template-columns:1fr}.inline-note-row{grid-template-columns:1fr}.inline-note-row .field{flex-direction:column;align-items:stretch}}

.auth-gate{position:fixed;inset:0;z-index:1000;background:#f4f6fa;display:flex;align-items:center;justify-content:center;padding:20px}.auth-card{width:min(480px,100%);background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 20px 60px rgba(15,23,42,.14);padding:28px}.auth-brand{font-size:22px;font-weight:800;margin-bottom:5px}.auth-sub{font-size:13px;color:var(--muted);margin-bottom:20px}.auth-card .field{margin-bottom:13px}.auth-card .field input{margin-top:6px}.auth-error{display:none;padding:10px 12px;background:#fee2e2;color:#991b1b;border:1px solid #fecaca;border-radius:8px;font-size:12px;margin-bottom:12px}.auth-error.show{display:block}.auth-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}.auth-help{font-size:11px;color:var(--muted);margin-top:13px;line-height:1.45}.auth-perms{border:1px solid var(--line);border-radius:9px;padding:11px;max-height:260px;overflow:auto;background:#f8fafc}.auth-perm-group{margin-bottom:12px}.auth-perm-group:last-child{margin-bottom:0}.auth-perm-title{font-size:11px;font-weight:800;color:#475569;margin-bottom:6px}.auth-perm-item{display:flex;gap:7px;align-items:flex-start;font-size:11px;margin:5px 0}.auth-perm-item input{width:auto;margin:1px 0 0}.password-row{display:flex;gap:8px;align-items:center}.password-row input{flex:1}.auth-user-badge{display:inline-flex;align-items:center;gap:7px;padding:7px 10px;border-radius:20px;background:#fff;border:1px solid var(--line);font-size:12px}.auth-user-badge b{font-size:12px}.auth-temp{padding:12px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a;border-radius:9px;font-size:12px;line-height:1.5}.auth-temp code{font-size:15px;font-weight:800;background:#fff;padding:3px 7px;border-radius:5px}.auth-card h2{margin:0 0 6px;font-size:19px}.auth-card p{margin:0 0 14px;font-size:12px;color:var(--muted)}
</style>
</head><body><div class="auth-gate" id="authGate" style="display:none"><div class="auth-card" id="authGateCard"></div></div>
<div class="app"><aside class="sidebar" id="sidebar"><div class="brand">Trader Business Control<small>ADMIN APP • LOCAL AUTH</small></div><div class="nav" id="nav"><button data-page="dashboard" class="active">Dashboard</button><button data-page="businesses">Businesses</button><button data-page="admins">Admin Access</button><div class="sep"></div><button data-page="sales">Sales</button><button data-page="customers">Customers</button><button data-page="payments">Debtors &amp; Payments</button><button data-page="expenses">Expenses</button><button data-page="stock">Stock</button><button data-page="reports">Reports</button><button data-page="reconciliation">Daily Reconciliation</button><button data-page="audit">Audit Trail</button><button data-page="messages">Client Messages</button><button data-page="clientview">Client App View</button><button data-page="settings">Settings</button></div></aside><main class="main"><div class="top"><div class="title"><button class="btn secondary mobile-menu" id="menuBtn">☰</button><h1 id="pageTitle">Dashboard</h1><p id="periodText">Business overview</p></div><div class="top-right"><span class="badge demo" id="onlineBadge">● Not Connected</span><span class="auth-user-badge" id="authUserBadge" style="display:none"></span><button class="btn secondary small" id="changePasswordBtn" style="display:none">Change Password</button><button class="btn secondary small" id="logoutBtn" style="display:none">Logout</button><select class="business-select" id="businessSelect"></select><select class="period" id="period"><option value="today">Today</option><option value="week">This Week</option><option value="month">This Month</option><option value="lastmonth">Last Month</option><option value="all">All Time</option></select></div></div><section class="page active" id="page-dashboard"></section><section class="page" id="page-businesses"></section><section class="page" id="page-admins"></section><section class="page" id="page-sales"></section><section class="page" id="page-customers"></section><section class="page" id="page-payments"></section><section class="page" id="page-expenses"></section><section class="page" id="page-stock"></section><section class="page" id="page-reports"></section><section class="page" id="page-reconciliation"></section><section class="page" id="page-audit"></section><section class="page" id="page-messages"></section><section class="page" id="page-clientview"></section><section class="page" id="page-settings"></section></main></div><div class="modal-back" id="modal"><div class="modal"><div class="modal-head"><h3 id="modalTitle"></h3><button class="btn secondary small" id="closeModal">Close</button></div><div class="modal-body" id="modalBody"></div><div class="modal-foot" id="modalFoot"></div></div></div>
<script>
'use strict';
const KEY='tbc_admin_v4_clean_start';
const LEGACY_KEY='tbc_admin_v3_multibusiness';
const CLIENT_APP_VIEW_SOURCE="<!doctype html>\n<html lang=\"en\">\n<head>\n<script src=\"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2\"><\/script>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#0f766e\">\n<meta name=\"description\" content=\"Trader Business Control — read-only business dashboard\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"application-name\" content=\"Business Control\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Business Control\">\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"favicon-16.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"favicon-32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"48x48\" href=\"favicon-48.png\">\n<link rel=\"icon\" href=\"favicon.ico\">\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"icons/icon-180.png\">\n<title>Trader Business Control — Client</title>\n<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml{width:100%;min-width:0;overflow-x:hidden;-webkit-text-size-adjust:100%;text-size-adjust:100%;background:#f4f7f7}\nbody{margin:0;width:100%;min-width:0;min-height:100vh;overflow-x:hidden;background:#f4f7f7;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#17202a}\n.app{width:100%;max-width:520px;min-width:0;margin:0 auto;min-height:100vh;padding-bottom:max(28px,env(safe-area-inset-bottom));visibility:hidden;overflow-x:hidden}\n.dashboardHeader{width:100%;min-width:0;background:#0f766e;color:#fff;padding:20px 16px 22px;padding-top:max(20px,env(safe-area-inset-top));border-radius:0 0 22px 22px;overflow:hidden}\n.brand{font-size:20px;font-weight:800}.sub{font-size:12px;opacity:.82;margin-top:3px}\n.headerMeta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:3px}.headerMeta .sub{margin-top:0}.headerActionRow{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:11px}.headerActionRow .readonly{margin-top:0}.headerActionRow .installBtn{margin-top:0;margin-left:0;}\n.installBtn{display:none;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:8px 11px;font-size:11px;font-weight:800;cursor:pointer}.installBtn.show{display:block;width:max-content}.readonly{display:inline-block;margin-top:11px;background:rgba(255,255,255,.14);border-radius:99px;padding:6px 10px;font-size:10px;font-weight:800}\nmain.dashboard{width:100%;min-width:0;padding:14px}\n.panel,.card,.list{min-width:0;background:#fff;border:1px solid #e1e7e9;border-radius:16px;box-shadow:0 2px 10px rgba(15,23,42,.05)}\n.panel{padding:13px;margin-bottom:14px}\n.rangeTitle,.sectionTitle{display:flex;justify-content:space-between;align-items:center}\n.rangeTitle strong,.sectionTitle h2{font-size:15px;margin:0}.rangeTitle span,.sectionTitle span{font-size:11px;color:#68737d}\nselect,input{width:100%;margin-top:7px;padding:11px;border:1px solid #dce3e6;border-radius:10px;background:#fff;font-size:16px}\n.customDates{display:none;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}\n.customDates.show{display:grid}\n.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;min-width:0}\n.card{padding:14px;min-width:0;overflow:hidden}\n.value{font-size:clamp(16px,5vw,21px);font-weight:850;line-height:1.15;margin-top:5px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.subvalue{font-size:11px;line-height:1.3;color:#68737d;margin-top:4px;overflow-wrap:anywhere}\n.green{color:#047857}.red{color:#b91c1c}.teal{color:#0f766e}\n.clickable{cursor:pointer}.clickable:active{transform:scale(.99)}\n.hint{font-size:10px;color:#0f766e;margin-top:7px}\n.sectionTitle{margin:18px 2px 9px;min-width:0}\n.fullCard{margin-bottom:9px}\n.list{overflow:hidden}\n.row{display:flex;justify-content:space-between;gap:12px;padding:13px;border-bottom:1px solid #e7ecee}\n.row:last-child{border-bottom:0}\n.left{min-width:0}.name{font-size:13px;font-weight:750}.meta{font-size:11px;color:#68737d;margin-top:3px}.amount{font-weight:800;white-space:nowrap}\n.link{border:0;background:none;color:#0f766e;font-weight:800;font-size:12px;padding:0;cursor:pointer}\n.empty{text-align:center;padding:22px;color:#68737d;font-size:13px}\n.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.48);z-index:20;align-items:flex-end}\n.modal.open{display:flex}\n.sheet{width:100%;max-width:520px;margin:auto;background:#fff;border-radius:20px 20px 0 0;max-height:88vh;overflow:auto;padding:16px}\n.sheetHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}\n.close,.backBtn{border:0;background:#eef2f3;border-radius:50%;width:40px;height:40px;cursor:pointer}.backBtn{border-radius:10px;width:auto;padding:0 12px;font-weight:800;color:#0f766e}\n.detailTotal{font-size:23px;font-weight:850;margin:7px 0 12px}\n.detailCard{border:1px solid #e1e7e9;border-radius:13px;padding:12px;margin-bottom:8px}\n.detailGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}\n.detailItem{background:#f7f9f9;border-radius:9px;padding:9px}.detailLabel{font-size:10px;color:#68737d}.detailValue{font-size:13px;font-weight:750;margin-top:2px}\n.customerBtn{border:0;background:none;padding:0;color:#0f766e;font:inherit;font-weight:800;text-align:left;cursor:pointer}.salesSummary{font-size:12px;font-weight:800;color:#17202a;margin:-3px 2px 9px}.salesSummary span{display:block;margin-top:3px;font-weight:700}\n.stockCards{grid-template-columns:1fr 1fr}.salesPage{margin-top:18px}.salesPage .sectionTitle{margin-top:0}.businessMetaExtra{display:block;margin-top:3px;font-size:11px;opacity:.82}\n@media(max-width:360px){\n  .dashboardHeader{padding-left:13px;padding-right:13px;padding-bottom:19px;border-radius:0 0 18px 18px}\n  main.dashboard{padding:10px}\n  .panel,.card{border-radius:14px}\n  .panel{padding:11px}\n  .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}\n  .card{padding:11px}\n  .rangeTitle strong,.sectionTitle h2{font-size:14px}\n  .rangeTitle span,.sectionTitle span{font-size:10px}\n  .label{font-size:11px;line-height:1.2}\n  .value{font-size:16px}\n  .subvalue{font-size:10px}\n  .hint{font-size:9px;line-height:1.25}\n  .customDates{grid-template-columns:1fr 1fr}\n}\n@media(orientation:landscape) and (max-height:600px){\n  .dashboardHeader{padding-top:max(12px,env(safe-area-inset-top));padding-bottom:14px}\n  main.dashboard{padding:10px 12px 14px}\n  .panel{padding:11px;margin-bottom:10px}\n  .sectionTitle{margin-top:12px}\n  .card{padding:11px}\n  .cards{gap:8px}\n}\n@media(min-width:521px){\n  .app{box-shadow:0 0 28px rgba(15,23,42,.06)}\n}\n.contact-modal{padding:12px}.msg-list{display:flex;flex-direction:column;gap:8px;max-height:48vh;overflow:auto;padding:4px 2px}.msg{max-width:88%;padding:9px 11px;border-radius:12px;font-size:12px;line-height:1.4}.msg.client{align-self:flex-end;background:#e6fffb;border:1px solid #b7eee7}.msg.admin{align-self:flex-start;background:#f3f4f6;border:1px solid #e5e7eb}.msg-meta{font-size:9px;color:#68737d;margin-top:4px}.msg-compose{display:flex;gap:7px;margin-top:10px}.msg-compose textarea{flex:1;min-height:62px;resize:none;border:1px solid #dce3e6;border-radius:10px;padding:9px;font:inherit;font-size:12px}.msg-send{border:0;background:#0f766e;color:#fff;border-radius:10px;padding:9px 12px;font-weight:800}.msg-empty{text-align:center;color:#68737d;padding:18px;font-size:12px}</style>\n</head>\n<body>\n<div class=\"app\">\n<header class=\"dashboardHeader\">\n  <div class=\"brand\" id=\"businessName\">Connecting…</div>\n  <div class=\"headerMeta\">\n    <div class=\"sub\" id=\"headerCustomName\"></div>\n    <div class=\"sub\" id=\"headerSubtitle\"></div>\n  </div>\n  <div class=\"headerActionRow\">\n    <div class=\"readonly\" id=\"headerReadonly\" style=\"display:none\"></div>\n    <div style=\"display:flex;gap:7px;align-items:center\"><button id=\"clientReportBtn\" class=\"installBtn\" type=\"button\">Reports</button><button id=\"installBtn\" class=\"installBtn\" type=\"button\">Contact Admin</button></div>\n  </div>\n</header>\n\n<main class=\"dashboard\">\n<section class=\"panel\">\n  <div class=\"rangeTitle\"><strong>Report Period</strong><span id=\"periodLabel\">Choose period</span></div>\n  <select id=\"periodSelect\">\n    <option value=\"today\">Today</option>\n    <option value=\"week\">This Week</option>\n    <option value=\"month\">This Month</option>\n    <option value=\"lastmonth\">Last Month</option>\n    <option value=\"custom\">Custom</option>\n  </select>\n  <div class=\"rangeTitle\" style=\"margin-top:10px\"><strong>Branch</strong><span id=\"branchLabel\">All Branches</span></div>\n  <select id=\"branchSelect\"></select>\n  <div class=\"customDates\" id=\"customDates\">\n    <label style=\"font-size:11px;color:#68737d\">Start Date<input id=\"startDate\" type=\"date\"></label>\n    <label style=\"font-size:11px;color:#68737d\">End Date<input id=\"endDate\" type=\"date\"></label>\n  </div>\n</section>\n\n<div class=\"sectionTitle\"><h2>Business Overview</h2><span id=\"rangeText\"></span></div>\n<section class=\"cards\">\n  <div class=\"card clickable\" id=\"salesCard\">\n    <div class=\"label\">Total Sale</div>\n    <div class=\"value\" id=\"totalSales\">₦0</div>\n    <div class=\"subvalue\" id=\"transactionCount\">0 transactions</div>\n    <div class=\"hint\">Tap to view sales details</div>\n  </div>\n\n  <div class=\"card clickable\" id=\"expensesCard\">\n    <div class=\"label\">Expenses</div>\n    <div class=\"value\" id=\"totalExpenses\">₦0</div>\n    <div class=\"hint\">Tap to view expense details</div>\n  </div>\n\n  <div class=\"card clickable\" id=\"cashCard\">\n    <div class=\"label\">Cash Received</div>\n    <div class=\"value teal\" id=\"cashReceived\">₦0</div>\n    <div class=\"subvalue\" id=\"debtorPaymentNote\"></div>\n    <div class=\"hint\">Tap to view cash details</div>\n  </div>\n\n  <div class=\"card\" id=\"creditSalesCard\">\n    <div class=\"label\">Total Credit Sales</div>\n    <div class=\"subvalue\" id=\"creditSalesCount\">0 credit sales</div>\n    <div class=\"value red\" id=\"creditSalesTotal\">₦0</div>\n  </div>\n</section>\n\n<section class=\"card clickable fullCard\" id=\"debtCard\">\n  <div class=\"label\">Customers Owing</div>\n  <div class=\"subvalue\" id=\"owingCount\">0 customers owing</div>\n  <div class=\"value red\" id=\"debtTotal\">₦0</div>\n  <div class=\"hint\">Tap to view debtors list</div>\n</section>\n\n<div class=\"sectionTitle\"><h2>Stock</h2></div>\n<section class=\"cards stockCards\">\n  <div class=\"card clickable\" id=\"availableStockCard\">\n    <div class=\"label\">Available Stock</div>\n    <div class=\"value\" id=\"availableStockCount\">0</div>\n    <div class=\"hint\">Tap to view available-stock items</div>\n  </div>\n  <div class=\"card clickable\" id=\"lowStockCard\">\n    <div class=\"label\">Low Stock Items</div>\n    <div class=\"value\" id=\"lowStockCount\">0</div>\n    <div class=\"hint\">Tap to view low-stock items</div>\n  </div>\n</section>\n\n\n</main>\n<section id=\"salesPage\" class=\"salesPage\" style=\"display:none;padding:14px\">\n  <div class=\"sectionTitle\"><h2>Sales Details</h2><button class=\"link\" id=\"backSalesPage\">← Back</button></div>\n  <div class=\"salesSummary\" id=\"salesSummary\">0 Transactions<br><span><b class=\"green\">0 Cash</b> • <b class=\"red\">0 Credit</b></span></div>\n  <section class=\"list\" id=\"salesList\"></section>\n</section>\n</div>\n\n<div class=\"modal\" id=\"modal\">\n  <div class=\"sheet\">\n    <div class=\"sheetHead\">\n      <div style=\"display:flex;align-items:center;gap:8px\"><button class=\"backBtn\" id=\"backModal\">← Back</button><div><strong id=\"modalTitle\">Details</strong><div class=\"meta\" id=\"modalSubtitle\"></div></div></div>\n      <button class=\"close\" id=\"closeModal\">✕</button>\n    </div>\n    <div id=\"modalBody\"></div>\n  </div>\n</div>\n\n\n<div id=\"connectGate\" style=\"display:flex;min-height:100vh;align-items:center;justify-content:center;padding:24px;background:#f4f7f7;color:#17202a\"><div id=\"connectGateCard\" style=\"width:100%;max-width:420px;background:#fff;border:1px solid #e1e7e9;border-radius:18px;padding:22px;box-shadow:0 4px 18px rgba(15,23,42,.08)\"></div></div>\n\n<script>\nconst CLIENT_CONFIG_KEY='tbc_client_v7_connection';\nconst CLIENT_LOCK_KEY='tbc_client_v7_local_password';\nconst SUPABASE_URL='https://qgaocesvzqpqkecjotly.supabase.co';\nconst SUPABASE_PUBLISHABLE_KEY='sb_publishable_PTtJexVGkqdkV4QrlFMJsg_32iXPcWo';\n\nlet onlineMode=false;\nlet onlineTimer=null;\nlet deferredInstallPrompt=null;\nlet activeClientBranchId='all';\nconst installBtn=document.getElementById('installBtn');\nconst installHelp=document.getElementById('installHelp');\nlet installEligibilityTimer=null;\ninstallBtn.addEventListener('click',()=>openContactAdmin());\nfunction normalizeUrl(u){return String(u||'').trim().replace(/\\/$/,'').replace(/\\/rest\\/v1$/,'');}\nfunction savedClientConfig(){try{return JSON.parse(localStorage.getItem(CLIENT_CONFIG_KEY))||null}catch(e){return null}}\nfunction clientConfig(){const saved=savedClientConfig();return {url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:String(saved?.feedId||'').trim()};}\nfunction hideConnectGate(){document.getElementById('connectGate').style.display='none';document.querySelector('.app').style.visibility='visible';}\nfunction showConnectGate(mode='setup',message=''){\n  document.querySelector('.app').style.visibility='hidden';\n  const gate=document.getElementById('connectGate');gate.style.display='flex';\n  const card=document.getElementById('connectGateCard');\n  const saved=savedClientConfig();\n  const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();\n  if(mode==='unlock'&&saved&&lock?.hash){\n    card.innerHTML=`<div style=\"font-size:22px;font-weight:850;margin-bottom:7px\">Trader Business Control</div><p style=\"font-size:13px;color:#68737d;line-height:1.5\">Enter your app password to open the connected business dashboard.</p>${message?`<div style=\"padding:10px;background:#fff1f2;color:#9f1239;border-radius:9px;font-size:12px;margin:10px 0\">${escHtml(message)}</div>`:''}<form id=\"clientUnlockForm\"><label style=\"display:block;font-size:12px;font-weight:750;margin-top:14px\">App Password<input id=\"unlockPassword\" type=\"password\" autocomplete=\"off\" data-lpignore=\"true\" data-1p-ignore=\"true\" autocapitalize=\"off\" spellcheck=\"false\" required style=\"width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px\"></label><button type=\"submit\" style=\"width:100%;margin-top:14px;padding:12px;border:0;border-radius:10px;background:#0f766e;color:white;font-weight:800\">Unlock Dashboard</button></form><p style=\"font-size:11px;color:#68737d;line-height:1.45;margin-top:14px\">This optional password locks this installation on this device. It is not a password set by the business owner and does not replace database access controls.</p>`;\n    document.getElementById('clientUnlockForm').addEventListener('submit',async e=>{e.preventDefault();const pass=document.getElementById('unlockPassword').value;try{if(await verifyLocalPassword(pass,lock)){lock.lastActiveAt=Date.now();localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(lock));const ok=await loadOnline(saved);if(!ok)showConnectGate('unlock',window.__lastClientConnectError||'Unable to reconnect. Check your internet connection or change the Client Feed ID.')}else showConnectGate('unlock','Incorrect password. Please try again.')}catch(err){showConnectGate('unlock',err.message)}});\n    return;\n  }\n  card.innerHTML=`<div style=\"font-size:22px;font-weight:850;margin-bottom:7px\">Connect Your Business</div><p style=\"font-size:13px;color:#68737d;line-height:1.5;margin:0 0 14px\">Enter the Client Feed ID supplied by your business administrator. This app contains no sample business or demo records.</p>${message?`<div style=\"padding:10px;background:#fff1f2;color:#9f1239;border-radius:9px;font-size:12px;margin:10px 0\">${escHtml(message)}</div>`:''}<form id=\"clientConnectForm\"><label style=\"display:block;font-size:12px;font-weight:750\">Client Feed ID<input id=\"feedIdInput\" type=\"text\" autocomplete=\"off\" autocapitalize=\"characters\" placeholder=\"Enter Client Feed ID\" required style=\"width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px\"></label><label style=\"display:flex;align-items:flex-start;gap:9px;margin-top:15px;font-size:13px;font-weight:750;line-height:1.4\"><input id=\"enableClientPassword\" type=\"checkbox\" style=\"width:18px;height:18px;margin:1px 0 0;flex:0 0 auto\"> I want to protect this app with a password</label><div id=\"clientPasswordFields\" style=\"display:none;margin-top:10px\"><label style=\"display:block;font-size:12px;font-weight:750\">Create Password (at least 8 characters)<input id=\"newClientPassword\" type=\"password\" autocomplete=\"off\" data-lpignore=\"true\" data-1p-ignore=\"true\" autocapitalize=\"off\" spellcheck=\"false\" minlength=\"8\" style=\"width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px\"></label><label style=\"display:block;font-size:12px;font-weight:750;margin-top:10px\">Confirm Password<input id=\"confirmClientPassword\" type=\"password\" autocomplete=\"off\" data-lpignore=\"true\" data-1p-ignore=\"true\" autocapitalize=\"off\" spellcheck=\"false\" minlength=\"8\" style=\"width:100%;padding:12px;border:1px solid #dce3e6;border-radius:10px;margin-top:6px;font-size:16px\"></label><p style=\"font-size:11px;color:#68737d;line-height:1.45\">You create this password yourself. It is requested after six hours of app inactivity.</p></div><button id=\"connectSubmit\" type=\"submit\" style=\"width:100%;margin-top:16px;padding:12px;border:0;border-radius:10px;background:#0f766e;color:white;font-weight:800\">Connect to Business</button></form><p style=\"font-size:11px;color:#68737d;line-height:1.45;margin-top:14px\">If you do not select the password option, the app opens directly on this device after connecting. Keep your Client Feed ID private.</p>`;\n  const check=document.getElementById('enableClientPassword');check.onchange=()=>{document.getElementById('clientPasswordFields').style.display=check.checked?'block':'none'};\n  document.getElementById('clientConnectForm').addEventListener('submit',async e=>{e.preventDefault();const feedId=document.getElementById('feedIdInput').value.trim();const wantsPassword=check.checked;const pass=document.getElementById('newClientPassword')?.value||'';const confirmPass=document.getElementById('confirmClientPassword')?.value||'';if(!feedId){showConnectGate('setup','Enter your Client Feed ID.');return}if(wantsPassword&&(pass.length<8||pass!==confirmPass)){showConnectGate('setup',pass.length<8?'Use a password with at least 8 characters.':'The passwords do not match.');document.getElementById('enableClientPassword').checked=true;document.getElementById('clientPasswordFields').style.display='block';return}const btn=document.getElementById('connectSubmit');btn.disabled=true;btn.textContent='Checking Client Feed…';try{const cfg={url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId};const ok=await loadOnline(cfg,{lockPassword:wantsPassword?pass:'',clearLock:!wantsPassword});if(!ok)throw new Error(window.__lastClientConnectError||'Unable to connect to this Client Feed ID.');}catch(err){showConnectGate('setup',err.message||'Unable to connect. Check the Client Feed ID and internet connection.')}});\n}\nfunction emptyClientData(){return {business:'',businessInfo:{name:'',type:'',phone:'',address:'',currency:'NGN'},businessId:'',header:null,branches:[],products:[],sales:[],payments:[],expenses:[]}}\nfunction toBase64(bytes){let s='';for(const b of bytes)s+=String.fromCharCode(b);return btoa(s)}\nfunction fromBase64(s){return Uint8Array.from(atob(s),c=>c.charCodeAt(0))}\nasync function deriveLocalPassword(password,salt){if(!crypto?.subtle)throw new Error('Secure password protection is not available in this browser. Update Chrome and try again.');const key=await crypto.subtle.importKey('raw',new TextEncoder().encode(password),'PBKDF2',false,['deriveBits']);const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt,iterations:150000,hash:'SHA-256'},key,256);return toBase64(new Uint8Array(bits))}\nasync function makeLocalPassword(password){const salt=crypto.getRandomValues(new Uint8Array(16));return {salt:toBase64(salt),hash:await deriveLocalPassword(password,salt),iterations:150000,algorithm:'PBKDF2-SHA-256',lastActiveAt:Date.now()}}\nasync function verifyLocalPassword(password,record){if(!record?.salt||!record?.hash)return false;return await deriveLocalPassword(password,fromBase64(record.salt))===record.hash}\nasync function fetchOnlineSnapshot(cfg){\n  const base=normalizeUrl(cfg.url);\n  if(!base||!cfg.key||!cfg.feedId) throw new Error('Client connection is not configured.');\n  const url=base+'/rest/v1/client_feeds?select=payload,business_name,updated_at&feed_id=eq.'+encodeURIComponent(cfg.feedId)+'&limit=1';\n  const r=await fetch(url,{headers:{'apikey':cfg.key,'Authorization':'Bearer '+cfg.key,'Accept':'application/json'}});\n  if(!r.ok){let t='';try{t=await r.text()}catch(e){};throw new Error(r.status+': '+(t||'Connection failed'));}\n  const rows=await r.json();\n  if(!rows.length) throw new Error('This Client Feed ID was not found.');\n  return rows[0].payload;\n}\nfunction adaptOnlinePayload(p){\n  if(typeof p==='string'){ try{ p=JSON.parse(p); }catch(e){ p={}; } }\n  p=p||{};\n  const branches=(p.branches||[]).map(b=>({id:b.id,name:b.name||'Branch',address:b.address||'',stockMode:b.stockMode||'shared',stockSharedWith:b.stockSharedWith||null}));\n  const customerMap={};(p.customers||[]).forEach(c=>customerMap[c.id]=c.name);\n  const productMap={};(p.products||[]).forEach(x=>productMap[x.id]=x);\n  const sales=(p.sales||[]).map(s=>{\n    const total=Number(s.total||0);\n    const paid=Math.max(0,Math.min(total,Number(s.paid||0)));\n    const outstanding=Math.max(0,total-paid);\n    const payment=paid<=0?'Credit':(paid>=total?'Cash':'Partly Credit');\n    return {id:s.id,branchId:s.branchId||'',date:s.date,customer:customerMap[s.customerId]||'Customer',customerId:s.customerId||'',payment,paid,outstanding,items:(s.items||[]).map(i=>({product:productMap[i.productId]?.name||i.product||'Item',qty:Number(i.quantity??i.qty??0),unit:Number(i.unitPrice??i.unit??i.price??0)})),total};\n  });\n  const payments=(p.payments||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.paymentDate||x.date,customer:customerMap[x.customerId]||'Customer',amount:Number(x.amount||0)}));\n  const expenses=(p.expenses||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.expenseDate||x.date,description:x.description||'Expense',amount:Number(x.amount||0)}));\n  const products=(p.products||[]).map(x=>({id:x.id,branchId:x.branchId||'',branchIds:Array.isArray(x.branchIds)?x.branchIds:[],name:x.name,qty:Number(x.qty??x.quantity??0),branchQty:x.branchQty||{},reorder:Number(x.reorder??x.reorderLevel??0),cost:Number(x.costPrice??x.cost??0)}));\n  const business=p.business||{};\n  return {business:business.name||p.business_name||'',businessInfo:{name:business.name||p.business_name||'',type:business.type||'',phone:business.phone||'',address:business.address||'',currency:business.currency||'NGN'},businessId:business.id||p.business_id||'',header:p.header||null,clientReport:p.clientReport||business.clientReport||null,branches,products,sales,payments,expenses};\n}\n\nasync function loadOnline(requestedCfg=null,options={}){\n  const cfg=requestedCfg||clientConfig();\n  try{\n    const snap=await fetchOnlineSnapshot(cfg);\n    const adapted=adaptOnlinePayload(snap);\n    if(!adapted.business&&!adapted.businessInfo?.name)throw new Error('This Client Feed has no published business information yet. Ask the administrator to publish the business.');\n    const newLock=options.lockPassword?await makeLocalPassword(options.lockPassword):null;\n    if(options.saveConfig!==false)localStorage.setItem(CLIENT_CONFIG_KEY,JSON.stringify({feedId:cfg.feedId}));\n    if(newLock)localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(newLock));\n    else if(options.clearLock===true)localStorage.removeItem(CLIENT_LOCK_KEY);\n    localStorage.removeItem('trader_v5_data');\n    data=adapted;onlineMode=true;window.__lastClientConnectError='';hideConnectGate();render();\n    if(onlineTimer)clearInterval(onlineTimer);\n    onlineTimer=setInterval(()=>loadOnline(clientConfig(),{saveConfig:false}),5000);\n    return true;\n  }catch(e){window.__lastClientConnectError=e.message||'Connection failed';onlineMode=false;console.error(e);return false;}\n}\nasync function connectClient(){return loadOnline();}\n\nlet clientMessagesChannel=null;\nlet clientMessagePollTimer=null;\nfunction stopClientMessageRealtime(){if(clientMessagesChannel){try{clientMessagesChannel.unsubscribe()}catch(e){} clientMessagesChannel=null}if(clientMessagePollTimer){clearInterval(clientMessagePollTimer);clientMessagePollTimer=null}}\nfunction startClientMessageRealtime(){\n  stopClientMessageRealtime();if(clientMessagePollTimer)clearInterval(clientMessagePollTimer);clientMessagePollTimer=setInterval(()=>{if(document.getElementById('msgList'))loadClientMessages()},5000);\n  const cfg=clientConfig();\n  if(!cfg.url||!cfg.key||!cfg.feedId||!window.supabase)return;\n  const cid=clientMessageId();\n  clientMessagesChannel=window.supabase.createClient(cfg.url,cfg.key).channel('client-messages-'+cid)\n    .on('postgres_changes',{event:'INSERT',schema:'public',table:'client_messages',filter:'feed_id=eq.'+cfg.feedId},payload=>{\n      const row=payload?.new||{};\n      if(row.client_id===cid){loadClientMessages()}\n    })\n    .subscribe((status,err)=>{if(status==='CHANNEL_ERROR'||status==='TIMED_OUT')console.error('Client message realtime:',status,err)})\n}\nconst CLIENT_MESSAGE_ID_KEY='tbc_client_message_id';\nfunction clientMessageId(){let x=localStorage.getItem(CLIENT_MESSAGE_ID_KEY);if(!x){x='client-'+(crypto.randomUUID?crypto.randomUUID():(Date.now().toString(36)+Math.random().toString(36).slice(2)));localStorage.setItem(CLIENT_MESSAGE_ID_KEY,x)}return x}\nfunction messageBranchId(){return activeClientBranchId==='all'?(data?.branches?.[0]?.id||null):activeClientBranchId}\nasync function messagesRequest(path,opts={}){\n  const cfg=clientConfig();const base=normalizeUrl(cfg.url);\n  if(!base||!cfg.key||!cfg.feedId)throw new Error('Client connection is not configured.');\n  return fetch(base+path,{...opts,headers:{apikey:cfg.key,Authorization:'Bearer '+cfg.key,'Content-Type':'application/json',Accept:'application/json',...(opts.headers||{})}})\n}\nasync function fetchClientMessages(){\n  const cfg=clientConfig();\n  const url='/rest/v1/client_messages?select=id,sender_type,sender_name,message,created_at,read_at,reply_to&feed_id=eq.'+encodeURIComponent(cfg.feedId)+'&client_id=eq.'+encodeURIComponent(clientMessageId())+'&order=created_at.asc';\n  const r=await messagesRequest(url);if(!r.ok)throw new Error(await r.text());return await r.json()\n}\nfunction openContactAdmin(){\n  openModal('Contact Admin','',false);\n  const body=document.getElementById('modalBody');\n  body.innerHTML='<div class=\"contact-modal\"><div id=\"msgList\" class=\"msg-list\"><div class=\"msg-empty\">Loading conversation…</div></div><div class=\"msg-compose\"><textarea id=\"clientMessageInput\" maxlength=\"2000\" placeholder=\"Type your message to Admin…\"></textarea><button class=\"msg-send\" id=\"sendClientMessage\">Send</button></div></div>';\n  loadClientMessages();\n  startClientMessageRealtime();\n  document.getElementById('sendClientMessage').onclick=sendClientMessage;\n}\nasync function loadClientMessages(){\n  const list=document.getElementById('msgList');if(!list)return;\n  try{const rows=await fetchClientMessages();const unreadAdmin=rows.filter(x=>x.sender_type==='admin'&&!x.read_at);if(unreadAdmin.length){await Promise.all(unreadAdmin.map(x=>messagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(x.id),{method:'PATCH',body:JSON.stringify({read_at:new Date().toISOString()})}))) }list.innerHTML=rows.length?rows.map(x=>`<div class=\"msg ${x.sender_type==='client'?'client':'admin'}\"><div>${escHtml(x.message)}</div><div class=\"msg-meta\">${x.sender_type==='client'?'You':'Admin'} • ${new Date(x.created_at).toLocaleString()}</div></div>`).join(''):'<div class=\"msg-empty\">No messages yet. Send a message to Admin.</div>';list.scrollTop=list.scrollHeight}\n  catch(e){list.innerHTML='<div class=\"msg-empty\">Unable to load messages. Please check your connection.</div>'}\n}\nasync function sendClientMessage(){\n  const input=document.getElementById('clientMessageInput'), message=input?.value.trim();if(!message)return;\n  const cfg=clientConfig();const payload={feed_id:cfg.feedId,client_id:clientMessageId(),branch_id:messageBranchId(),sender_type:'client',sender_name:'Client',message};\n  const r=await messagesRequest('/rest/v1/client_messages',{method:'POST',headers:{Prefer:'return=minimal'},body:JSON.stringify(payload)});\n  if(!r.ok){alert('Unable to send message: '+(await r.text()));return}\n  input.value='';loadClientMessages();\n}\nfunction escHtml(s){return String(s??'').replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[m]))}\nconst money=n=>'₦'+Math.round(Number(n||0)).toLocaleString('en-NG');\nconst pad=n=>String(n).padStart(2,'0');\nconst dateStr=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());\nconst fmt=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'short',year:'numeric'});\nconst fmtLong=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'long',year:'numeric'});\n\nconst fallback=emptyClientData();\n\nlet data=null;\nlet selectedStart,selectedEnd,filtered=[];\n\nfunction normalizeSale(s){\n  if(Array.isArray(s.items)&&s.items.length){\n    const items=s.items.map(i=>Array.isArray(i)?{product:i[0],qty:Number(i[1]||0),unit:Number(i[2]||0)}:{product:i.product,qty:Number(i.qty||0),unit:Number(i.unit||i.unitPrice||0)});\n    return {...s,items,total:Number(s.total||items.reduce((a,i)=>a+i.qty*i.unit,0))};\n  }\n  return {...s,items:[{product:s.product||'Item',qty:Number(s.qty||0),unit:Number(s.unit||0)}],total:Number(s.total||0)};\n}\nfunction salePaid(s){const total=saleTotal(s);return Math.max(0,Math.min(total,Number(s?.paid||0)));}\nfunction saleOutstanding(s){return Math.max(0,saleTotal(s)-salePaid(s));}\nfunction salePaymentStatus(s){const paid=salePaid(s),total=saleTotal(s);return paid<=0?'Credit':(paid>=total?'Cash':'Partly Credit');}\nfunction normalizeData(){ if(!data) return; data.sales=(data.sales||[]).map(normalizeSale).map(s=>({...s,paid:salePaid(s),outstanding:saleOutstanding(s),payment:salePaymentStatus(s)})); if(!Array.isArray(data.payments)) data.payments=[]; if(!Array.isArray(data.expenses)) data.expenses=[]; if(!Array.isArray(data.products)) data.products=[]; }\n\nfunction getRange(type){\n  const now=new Date(); now.setHours(0,0,0,0);\n  let s=new Date(now),e=new Date(now);\n  if(type==='week') s.setDate(now.getDate()-now.getDay());\n  if(type==='month') s.setDate(1);\n  if(type==='lastmonth'){s.setMonth(now.getMonth()-1);s.setDate(1);e.setDate(0);}\n  return [dateStr(s),dateStr(e)];\n}\nfunction showCustom(show){\n  document.getElementById('customDates').classList.toggle('show',show);\n}\nfunction setPreset(type){\n  if(type==='custom'){\n    showCustom(true);\n    return;\n  }\n  showCustom(false);\n  const [s,e]=getRange(type);\n  document.getElementById('startDate').value=s;\n  document.getElementById('endDate').value=e;\n}\nfunction getSelectedRange(){\n  const type=document.getElementById('periodSelect').value;\n  if(type==='custom'){\n    const s=document.getElementById('startDate').value;\n    const e=document.getElementById('endDate').value;\n    if(!s||!e||s>e){alert('Please choose a valid start and end date.');return null;}\n    return [s,e];\n  }\n  return getRange(type);\n}\nfunction inRange(d){return d>=selectedStart&&d<=selectedEnd;}\nfunction rangeLabel(){\n  return selectedStart===selectedEnd ? fmtNumeric(selectedStart) : fmtNumeric(selectedStart)+' - '+fmtNumeric(selectedEnd);\n}\nfunction fmtNumeric(d){const x=new Date(d+'T00:00:00');return pad(x.getDate())+'/'+pad(x.getMonth()+1)+'/'+x.getFullYear();}\nfunction branchScope(list){return (list||[]).filter(x=>activeClientBranchId==='all'||(Array.isArray(x.branchIds)&&x.branchIds.includes(activeClientBranchId))||String(x.branchId||'')===String(activeClientBranchId));}\nfunction renderClientReport(){const r=data?.clientReport||{};const btn=document.getElementById('clientReportBtn');if(!btn)return;const show=!!(r.visible&&r.published&&r.content);btn.classList.toggle('show',show);btn.onclick=()=>{if(!show)return;const x=r.content||{};const rows=[['Highest-selling product',x.highestSellingProduct],['Lowest-selling product',x.lowestSellingProduct],['Best customer',x.bestCustomer],['Reporting period',x.period],['Total sales',x.totalSales],['Transactions',x.transactions]];let html=rows.filter(z=>z[1]!==undefined&&z[1]!==null&&z[1]!=='').map(z=>`<div class=\"row\"><div class=\"left name\">${escHtml(z[0])}</div><div class=\"amount\">${escHtml(String(z[1]))}</div></div>`).join('');if(x.writtenReport){html+=`<div class=\"detailCard\"><div class=\"name\">Written Report</div><div style=\"white-space:pre-wrap;line-height:1.55;margin-top:8px;font-size:12px\">${escHtml(String(x.writtenReport))}</div></div>`;}html+=`<div class=\"detailCard\"><div class=\"name\">Product Quantities</div><div class=\"meta\">Products sold during ${escHtml(String(x.period||'the reporting period'))}</div><div style=\"margin-top:8px\">${x.productQuantities&&Object.keys(x.productQuantities).length?Object.entries(x.productQuantities).map(([n,q])=>`<div class=\"row\"><div class=\"left name\">${escHtml(n)}</div><div class=\"amount\">${escHtml(String(q))}</div></div>`).join(''):'<div class=\"empty\">No product quantities were recorded.</div>'}</div></div>`;openModal('Business Report',x.period||'Published by Admin',html||'<div class=\"empty\">No report details have been published.</div>')};}function refreshBranchSelect(){\n  const sel=document.getElementById('branchSelect');\n  const label=document.getElementById('branchLabel');\n  if(!sel)return;\n  const branches=data?.branches||[];\n  if(activeClientBranchId!=='all'&&!branches.some(b=>String(b.id)===String(activeClientBranchId)))activeClientBranchId='all';\n  sel.innerHTML='<option value=\"all\">All Branches</option>'+branches.map(b=>`<option value=\"${b.id}\">${b.name}</option>`).join('');\n  sel.value=activeClientBranchId;\n  label.textContent=activeClientBranchId==='all'?'All Branches':(branches.find(b=>String(b.id)===String(activeClientBranchId))?.name||'All Branches');\n}\nfunction clientProductStock(p){const branches=data?.branches||[];if(activeClientBranchId&&activeClientBranchId!=='all'){const br=branches.find(x=>String(x.id)===String(activeClientBranchId));if(br?.stockMode==='shared'&&br.stockSharedWith){const source=branches.find(x=>String(x.id)===String(br.stockSharedWith));if(source?.stockMode==='separate')return Number(p.branchQty?.[source.id]||0)}if(br?.stockMode==='separate')return Number(p.branchQty?.[br.id]||0);return Number(p.qty||0)}let total=Number(p.qty||0);const seen=new Set();branches.filter(b=>b.stockMode==='separate').forEach(b=>{const pool=b.id; if(!seen.has(pool)){total+=Number(p.branchQty?.[pool]||0);seen.add(pool)}});return total}\nfunction render(){\n  if(!onlineMode){ data=emptyClientData(); }\n  if(!data.payments)data.payments=[];\n  normalizeData();\n  const h=data.header||{};\n  document.getElementById('businessName').textContent=data.business||data.businessInfo?.name||'My Business';\n  const headerCustomName=document.getElementById('headerCustomName');\n  const headerSubtitle=document.getElementById('headerSubtitle');\n  const headerReadonly=document.getElementById('headerReadonly');\n  headerCustomName.textContent=h.brand||'';\n  headerSubtitle.textContent=data.businessInfo?.type||h.sub||'';\n  headerCustomName.style.display=h.brand?'block':'none';\n  headerSubtitle.style.display=(data.businessInfo?.type||h.sub)?'block':'none';\n  headerReadonly.textContent=h.readonly||\"OWNER'S VIEW\";\n  headerReadonly.style.display=h.readonly?'inline-block':'none';\n  const installText=h.install||'Chat Admin';\n  installBtn.textContent=installText;\n  installBtn.classList.toggle('show',h.showInstall===true);\n  refreshBranchSelect();\n  renderClientReport();\n\n  filtered=branchScope(data.sales).filter(s=>inRange(s.date));\n  const expenses=branchScope(data.expenses).filter(x=>inRange(x.date));\n  const payments=branchScope(data.payments).filter(x=>inRange(x.date));\n\n  const totalSales=filtered.reduce((a,x)=>a+Number(x.total||0),0);\n  const totalExpenses=expenses.reduce((a,x)=>a+Number(x.amount||0),0);\n  const debtorPayments=payments.reduce((a,x)=>a+Number(x.amount||0),0);\n  const cashReceived=filtered.reduce((a,x)=>a+salePaid(x),0)+debtorPayments;\n  const creditSales=filtered.filter(x=>saleOutstanding(x)>0);\n  const creditSalesTotal=creditSales.reduce((a,x)=>a+saleOutstanding(x),0);\n\n  document.getElementById('totalSales').textContent=money(totalSales);\n  document.getElementById('transactionCount').textContent=filtered.length+' transaction'+(filtered.length===1?'':'s');\n  document.getElementById('totalExpenses').textContent=money(totalExpenses);\n  document.getElementById('cashReceived').textContent=money(cashReceived);\n  document.getElementById('debtorPaymentNote').textContent=payments.length?`${payments.length} debtor${payments.length===1?'':'s'} made payment${payments.length===1?'':'s'}`:'No debtor payments in this period';\n  document.getElementById('creditSalesCount').textContent=creditSales.length+' credit sale'+(creditSales.length===1?'':'s');\n  document.getElementById('creditSalesTotal').textContent=money(creditSalesTotal);\n\n  // Outstanding balances are calculated from all historical credit sales minus all historical payments.\n  const customerBalances={};\n  branchScope(data.sales).filter(x=>saleOutstanding(x)>0&&x.customer).forEach(x=>{\n    customerBalances[x.customer]=(customerBalances[x.customer]||0)+saleOutstanding(x);\n  });\n  branchScope(data.payments).forEach(x=>{\n    customerBalances[x.customer]=(customerBalances[x.customer]||0)-Number(x.amount||0);\n  });\n  Object.keys(customerBalances).forEach(k=>{if(customerBalances[k]<=0)delete customerBalances[k];});\n  const debtTotal=Object.values(customerBalances).reduce((a,b)=>a+b,0);\n  document.getElementById('owingCount').textContent=Object.keys(customerBalances).length+' customer'+(Object.keys(customerBalances).length===1?'':'s')+' owing';\n  document.getElementById('debtTotal').textContent=money(debtTotal);\n\n  const scopedProducts=branchScope(data.products);\n  const low=scopedProducts.filter(p=>clientProductStock(p)<=Number(p.reorder||0));\n  const available=scopedProducts.filter(p=>clientProductStock(p)>Number(p.reorder||0));\n  document.getElementById('lowStockCount').textContent=low.length;\n  document.getElementById('availableStockCount').textContent=available.length;\n\n  document.getElementById('periodLabel').textContent=rangeLabel();\n  document.getElementById('rangeText').textContent='';\n\n  renderSales();\n}\nfunction saleTotal(s){return Number(s.total||s.items.reduce((a,i)=>a+i.qty*i.unit,0));}\nfunction renderSales(showAll=true){\n  const cashCount=filtered.filter(x=>salePaymentStatus(x)==='Cash').length;\n  const partlyCount=filtered.filter(x=>salePaymentStatus(x)==='Partly Credit').length;\n  const creditCount=filtered.filter(x=>salePaymentStatus(x)==='Credit').length;\n  document.getElementById('salesSummary').innerHTML=`${filtered.length} Transactions<br><span><b class=\"green\">${cashCount} Cash</b> • <b class=\"red\">${partlyCount} Partly Credit</b> • <b class=\"red\">${creditCount} Credit</b></span>`;\n  const list=showAll?filtered:filtered.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4);\n  document.getElementById('salesList').innerHTML=list.length?list.map((s,i)=>{\n    const customer=s.customer||'Customer';\n    const customerHtml=`<button class=\"customerBtn\" data-sale-index=\"${filtered.indexOf(s)}\">${customer}</button>`;\n    return `<div class=\"row\">\n      <div class=\"left\"><div>${customerHtml}</div><div class=\"meta\">${fmt(s.date)}</div></div>\n      <div style=\"text-align:right\"><div class=\"amount\">${money(saleTotal(s))}</div><div class=\"meta ${salePaymentStatus(s)==='Cash'?'green':'red'}\">${salePaymentStatus(s)}</div></div>\n    </div>`;\n  }).join(''):'<div class=\"empty\">No sales in this date range.</div>';\n  document.querySelectorAll('.customerBtn').forEach(btn=>btn.onclick=()=>openSaleDetails(Number(btn.dataset.saleIndex)));\n}\nlet modalHistory=[];\nfunction setModal(title,subtitle,body){\n  document.getElementById('modalTitle').textContent=title;\n  document.getElementById('modalSubtitle').textContent=subtitle||'';\n  document.getElementById('modalBody').innerHTML=body;\n  document.getElementById('modal').classList.add('open');\n}\nfunction openModal(title,subtitle,body){\n  if(document.getElementById('modal').classList.contains('open')){\n    modalHistory.push({title:document.getElementById('modalTitle').textContent,subtitle:document.getElementById('modalSubtitle').textContent,body:document.getElementById('modalBody').innerHTML});\n  }\n  setModal(title,subtitle,body);\n}\nfunction backModal(){\n  if(modalHistory.length){const p=modalHistory.pop();setModal(p.title,p.subtitle,p.body);}\n  else closeModal();\n}\nfunction closeModal(){stopClientMessageRealtime();modalHistory=[];document.getElementById('modal').classList.remove('open');}\n\nfunction openExpenses(){\n  const rows=branchScope(data.expenses).filter(x=>inRange(x.date)).sort((a,b)=>b.date.localeCompare(a.date));\n  const total=rows.reduce((a,x)=>a+Number(x.amount||0),0);\n  openModal('Expense Details',`${rows.length} expense record${rows.length===1?'':'s'} • ${fmt(selectedStart)} – ${fmt(selectedEnd)}`,\n    `<div class=\"detailTotal\">${money(total)}</div>`+\n    (rows.length?rows.map(x=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${x.description}</div><div class=\"meta\">${fmtLong(x.date)}</div></div><div class=\"amount\">${money(x.amount)}</div></div>`).join(''):'<div class=\"empty\">No expenses in this date range.</div>')\n  );\n}\nfunction openCash(){\n  const saleReceipts=filtered.reduce((a,x)=>a+salePaid(x),0);\n  const payments=branchScope(data.payments).filter(x=>inRange(x.date));\n  const payTotal=payments.reduce((a,x)=>a+Number(x.amount||0),0);\n  openModal('Amount Received',`${fmt(selectedStart)} – ${fmt(selectedEnd)}`,\n    `<div class=\"detailTotal\">${money(saleReceipts+payTotal)}</div>\n     <div class=\"detailCard\"><div class=\"name\">Payments received with sales</div><div class=\"detailValue\" style=\"margin-top:6px\">${money(saleReceipts)}</div></div>\n     <div class=\"detailCard\"><div class=\"name\">Debtor payments</div><div class=\"detailValue\" style=\"margin-top:6px\">${money(payTotal)}</div>\n     ${payments.length?payments.map(p=>`<div class=\"row\"><div><div class=\"name\">${p.customer}</div><div class=\"meta\">${fmtLong(p.date)}</div></div><div class=\"amount\">${money(p.amount)}</div></div>`).join(''):'<div class=\"empty\">No debtor payments in this period.</div>'}</div>`\n  );\n}\nfunction openDebtors(){\n  const balances={};\n  branchScope(data.sales).filter(x=>saleOutstanding(x)>0&&x.customer).forEach(x=>balances[x.customer]=(balances[x.customer]||0)+saleOutstanding(x));\n  branchScope(data.payments).forEach(x=>balances[x.customer]=(balances[x.customer]||0)-Number(x.amount||0));\n  Object.keys(balances).forEach(k=>{if(balances[k]<=0)delete balances[k];});\n  const names=Object.keys(balances).sort((a,b)=>balances[b]-balances[a]);\n  openModal('Customers Owing',`${names.length} customer${names.length===1?'':'s'} currently owing`,\n    names.length?names.map(name=>`<div class=\"row clickable debtorItem\" data-name=\"${encodeURIComponent(name)}\"><div class=\"left\"><div class=\"name\">${name}</div><div class=\"meta\">Tap to view transactions</div></div><div class=\"amount\">${money(balances[name])}</div></div>`).join(''):'<div class=\"empty\">No outstanding customers.</div>');\n  document.querySelectorAll('.debtorItem').forEach(x=>x.onclick=()=>openDebtorDetails(decodeURIComponent(x.dataset.name)));\n}\nfunction openDebtorDetails(name){\n  const credit=branchScope(data.sales).filter(x=>saleOutstanding(x)>0&&x.customer===name);\n  const payments=branchScope(data.payments).filter(x=>x.customer===name);\n  const owed=credit.reduce((a,x)=>a+saleOutstanding(x),0), paid=payments.reduce((a,x)=>a+Number(x.amount||0),0), balance=Math.max(0,owed-paid);\n  openModal(name,`Outstanding balance: ${money(balance)}`,\n    `<div class=\"detailTotal\">${money(balance)}</div><div class=\"detailCard\"><strong>Credit sales</strong>`+\n    (credit.length?credit.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${fmtLong(x.date)} • ${x.items.length} item${x.items.length===1?'':'s'}</div><div class=\"meta\">${x.items.map(i=>`${i.product} × ${i.qty}`).join(', ')}</div></div><div class=\"amount\">${money(saleTotal(x))}</div></div>`).join(''):'<div class=\"empty\">No credit sales.</div>')+\n    `</div><div class=\"detailCard\"><strong>Payments made</strong>`+\n    (payments.length?payments.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">Payment</div><div class=\"meta\">${fmtLong(x.date)}</div></div><div class=\"amount\">${money(x.amount)}</div></div>`).join(''):'<div class=\"empty\">No recorded payments.</div>')+`</div>`\n  );\n}\nfunction openAvailableStock(){\n  const available=branchScope(data.products).filter(p=>clientProductStock(p)>Number(p.reorder||0)).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||'')));\n  openModal('Available Stock',`${available.length} item${available.length===1?'':'s'}`,\n    available.length?available.map(p=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${p.name}</div><div class=\"meta\">Reorder level: ${p.reorder}</div></div><div class=\"amount\">${clientProductStock(p)}</div></div>`).join(''):'<div class=\"empty\">No available-stock items.</div>');\n}\nfunction showSalesPage(){\n  document.querySelector('main').style.display='none';\n  document.getElementById('salesPage').style.display='block';\n  renderSales(true);\n  window.scrollTo({top:0,behavior:'smooth'});\n}\nfunction hideSalesPage(){\n  document.getElementById('salesPage').style.display='none';\n  document.querySelector('main').style.display='block';\n  window.scrollTo({top:0,behavior:'smooth'});\n}\nfunction openLowStock(){\n  const low=branchScope(data.products).filter(p=>clientProductStock(p)<=Number(p.reorder||0));\n  openModal('Low Stock Items',`${low.length} item${low.length===1?'':'s'}`,\n    low.length?low.map(p=>`<div class=\"row\"><div class=\"name\">${p.name}</div><div class=\"amount\">${clientProductStock(p)}</div></div>`).join(''):'<div class=\"empty\">No low-stock items.</div>');\n}\nfunction openSaleDetails(index){\n  const s=filtered[index]; if(!s)return;\n  openModal(s.customer||'Sale Details',`Transaction • ${fmtLong(s.date)}`,\n    `<div class=\"detailCard\"><div class=\"detailGrid\">\n      <div class=\"detailItem\"><div class=\"detailLabel\">Customer</div><div class=\"detailValue\">${s.customer||'Customer'}</div></div>\n      <div class=\"detailItem\"><div class=\"detailLabel\">Payment Status</div><div class=\"detailValue ${salePaymentStatus(s)==='Cash'?'green':'red'}\">${salePaymentStatus(s)}</div></div>\n    </div></div>\n    <div class=\"detailCard\"><strong>Items Purchased</strong>`+\n    s.items.map(i=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${i.product}</div><div class=\"meta\">Qty: ${i.qty} × ${money(i.unit)}</div></div><div class=\"amount\">${money(i.qty*i.unit)}</div></div>`).join('')+\n    `<div class=\"row\"><div class=\"name\">TOTAL</div><div class=\"amount\">${money(saleTotal(s))}</div></div><div class=\"row\"><div class=\"name\">Amount Received</div><div class=\"amount\">${money(salePaid(s))}</div></div><div class=\"row\"><div class=\"name\">Outstanding</div><div class=\"amount red\">${money(saleOutstanding(s))}</div></div></div>`\n  );\n}\n\ndocument.getElementById('branchSelect').addEventListener('change',e=>{activeClientBranchId=e.target.value||'all';render();});\ndocument.getElementById('periodSelect').addEventListener('change',e=>{\n  const type=e.target.value;\n  if(type==='custom'){showCustom(true);}\n  else {setPreset(type);}\n  const r=getSelectedRange(); if(r){[selectedStart,selectedEnd]=r; render();}\n});\ndocument.getElementById('startDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});\ndocument.getElementById('endDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});\ndocument.getElementById('backModal').onclick=backModal;\ndocument.getElementById('salesCard').onclick=showSalesPage;\ndocument.getElementById('expensesCard').onclick=openExpenses;\ndocument.getElementById('cashCard').onclick=openCash;\ndocument.getElementById('debtCard').onclick=openDebtors;\ndocument.getElementById('lowStockCard').onclick=openLowStock;\ndocument.getElementById('availableStockCard').onclick=openAvailableStock;\ndocument.getElementById('backSalesPage').onclick=hideSalesPage;\ndocument.getElementById('closeModal').onclick=closeModal;\ndocument.getElementById('modal').onclick=e=>{if(e.target.id==='modal')closeModal();};\n\nsetPreset('today');\n[selectedStart,selectedEnd]=getRange('today');\n\nfunction showOfflineNotice(){document.querySelector('.app').style.visibility='hidden';const gate=document.getElementById('connectGate');gate.style.display='flex';document.getElementById('connectGateCard').innerHTML='<div style=\"font-size:19px;font-weight:850\">Network Connection. Check Your Network Data</div>';}\nfunction touchClientActivity(){if(document.querySelector('.app').style.visibility==='hidden'||document.getElementById('connectGate').style.display!=='none')return;const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();if(lock?.hash){lock.lastActiveAt=Date.now();localStorage.setItem(CLIENT_LOCK_KEY,JSON.stringify(lock));}}\n['pointerdown','keydown','touchstart','click'].forEach(ev=>document.addEventListener(ev,touchClientActivity,{passive:true}));\nsetInterval(()=>{const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();if(lock?.hash&&Date.now()-Number(lock.lastActiveAt||0)>=6*60*60*1000&&document.querySelector('.app').style.visibility!=='hidden'){if(onlineTimer)clearInterval(onlineTimer);showConnectGate('unlock');}},60000);\nwindow.addEventListener('offline',()=>{if(savedClientConfig()?.feedId)showOfflineNotice()});\nwindow.addEventListener('online',()=>{const saved=savedClientConfig();if(saved?.feedId){const lock=(()=>{try{return JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){return null}})();if(lock?.hash&&Date.now()-Number(lock.lastActiveAt||0)>=6*60*60*1000)showConnectGate('unlock');else loadOnline({url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:saved.feedId},{saveConfig:false}).then(ok=>{if(!ok)showOfflineNotice()});}});\n\n(function initClientConnection(){\n  try{localStorage.removeItem('trader_v5_data');localStorage.removeItem('tbc_client_v6_connection');localStorage.removeItem('tbc_client_v6_local_password')}catch(e){}\n  if(window.__TBC_PREVIEW_MODE__&&window.__TBC_PREVIEW_DATA__){data=adaptOnlinePayload(window.__TBC_PREVIEW_DATA__);onlineMode=true;hideConnectGate();render();return;}\n  const saved=savedClientConfig();\n  let lock=null;try{lock=JSON.parse(localStorage.getItem(CLIENT_LOCK_KEY))}catch(e){}\n  if(!saved?.feedId){showConnectGate('setup');return;}\n  const SIX_HOURS=6*60*60*1000;\n  if(!navigator.onLine){showOfflineNotice();return;}\n  if(lock?.hash && Date.now()-Number(lock.lastActiveAt||0)>=SIX_HOURS){showConnectGate('unlock');return;}\n  loadOnline({url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:saved.feedId},{saveConfig:false}).then(ok=>{if(!ok)showOfflineNotice();});\n})();\n\n// PWA shell registration: the live business data still comes directly from Supabase.\nif ('serviceWorker' in navigator) {\n  navigator.serviceWorker.register('./sw.js').then(reg=>{\n    // Check for a new deployed Client version whenever the app opens.\n    reg.update().catch(()=>{});\n    if (reg.waiting) reg.waiting.postMessage({type:'SKIP_WAITING'});\n    reg.addEventListener('updatefound',()=>{\n      const worker=reg.installing;\n      if(worker) worker.addEventListener('statechange',()=>{\n        if(worker.state==='installed' && navigator.serviceWorker.controller){\n          worker.postMessage({type:'SKIP_WAITING'});\n        }\n      });\n    });\n  }).catch(()=>{});\n  let refreshing=false;\n  navigator.serviceWorker.addEventListener('controllerchange',()=>{\n    if(refreshing)return;\n    refreshing=true;\n    window.location.reload();\n  });\n}\n<\/script>\n</body>\n</html>";
 const today=(()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`})();
const money=n=>'₦'+Number(n||0).toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2});
const id=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7); const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const iso=d=>new Date(d).toISOString().slice(0,10);
let currentPage='dashboard', currentAdminId='', period='today';
let authSession=null;
const AUTH_SESSION_KEY='tbc_admin_auth_session_v1';
const AUTH_SETUP_VERSION=1;
let db=load();
if(!Array.isArray(db.auditTrail))db.auditTrail=[];if(!Array.isArray(db.reconciliations))db.reconciliations=[];
if(!db.admins.some(a=>a.role==='major')){db.admins.unshift({id:'admin-major',name:'Major Admin',email:'major@tradercontrol.local',role:'major',active:true,businessIds:[],branchIds:[],permissions:rolePermissionDefaults?.('major')||{},permissionsCustomized:false});save();}

async function authHash(value){const data=new TextEncoder().encode(String(value));const digest=await crypto.subtle.digest('SHA-256',data);return Array.from(new Uint8Array(digest)).map(b=>b.toString(16).padStart(2,'0')).join('')}
function authSessionRead(){try{const raw=sessionStorage.getItem(AUTH_SESSION_KEY);return raw?JSON.parse(raw):null}catch(e){return null}}
function authSessionWrite(v){try{sessionStorage.setItem(AUTH_SESSION_KEY,JSON.stringify(v))}catch(e){}}
function authSessionClear(){try{sessionStorage.removeItem(AUTH_SESSION_KEY)}catch(e){}}
function authMajor(){return db.admins.find(a=>a.role==='major'&&a.active)!==undefined?db.admins.find(a=>a.role==='major'&&a.active):null}
function authNeedsSetup(){const m=db.admins.find(a=>a.role==='major');return !m || !m.passwordHash || !m.authVersion}
function authStaff(a){return a&&a.role!=='major'}
function authActiveAdmin(){return db.admins.find(a=>a.id===currentAdminId&&a.active)||null}
function authSetCurrent(a){currentAdminId=a.id;authSession={id:a.id,issuedAt:Date.now()};authSessionWrite(authSession)}
function authGateCard(html){const gate=document.getElementById('authGate'),card=document.getElementById('authGateCard');card.innerHTML=html;gate.style.display='flex'}
function authHide(){document.getElementById('authGate').style.display='none'}
function authError(msg){const e=document.getElementById('authError');if(e){e.textContent=msg;e.classList.add('show')}}
function authClearError(){const e=document.getElementById('authError');if(e){e.textContent='';e.classList.remove('show')}}
function authPasswordMarkup(id,label='Password',value=''){return `<div class="field"><label>${label}</label><div class="password-row"><input id="${id}" type="password" value="${esc(value)}" autocomplete="current-password"><button type="button" class="btn secondary small" data-show-password="${id}">Show</button></div></div>`}
function authSetupView(){authGateCard(`<div class="auth-brand">Trader Business Control</div><div class="auth-sub">First-time security setup — create the Major Admin login before using the application.</div><div class="auth-error" id="authError"></div><div class="field"><label>Major Admin Name</label><input id="authSetupName" value="Major Admin" autocomplete="name"></div><div class="field"><label>Username / Email</label><input id="authSetupUser" value="" autocomplete="username"></div>${authPasswordMarkup('authSetupPass','Create Password')}<div class="field"><label>Confirm Password</label><input id="authSetupPass2" type="password" autocomplete="new-password"></div><div class="auth-actions"><button class="btn" id="authSetupSubmit">Create Major Admin Login</button></div><div class="auth-help">This local version stores only a one-way password hash in the browser's local storage. It is suitable for this single-computer trial, not for multi-user security. Version B will move authentication to a server/database.</div>`);document.getElementById('authSetupSubmit').onclick=async()=>{authClearError();const name=document.getElementById('authSetupName').value.trim()||'Major Admin',user=document.getElementById('authSetupUser').value.trim(),p1=document.getElementById('authSetupPass').value,p2=document.getElementById('authSetupPass2').value;if(!user||!p1||p1.length<6||p1!==p2){authError('Enter a username and a password of at least 6 characters, then confirm it exactly.');return}const m=db.admins.find(a=>a.role==='major')||{id:'admin-major'};Object.assign(m,{name,email:user,role:'major',active:true,passwordHash:await authHash(p1),authVersion:AUTH_SETUP_VERSION,passwordChangedAt:new Date().toISOString(),businessIds:Array.isArray(m.businessIds)?m.businessIds:[],branchIds:Array.isArray(m.branchIds)?m.branchIds:[],permissions:rolePermissionDefaults('major'),permissionsCustomized:false});if(!db.admins.includes(m))db.admins.unshift(m);save();authSetCurrent(m);authHide();render();};}
function authLoginView(){authGateCard(`<div class="auth-brand">Trader Business Control</div><div class="auth-sub">Secure Admin Login</div><div class="auth-error" id="authError"></div><div class="field"><label>Username / Email</label><input id="authLoginUser" autocomplete="username" autofocus></div>${authPasswordMarkup('authLoginPass','Password')}<div class="auth-actions"><button class="btn" id="authLoginSubmit">Login</button></div><div class="auth-help">Staff accounts are limited to the businesses, branches and permissions assigned by the Major Admin.</div>`);document.getElementById('authLoginSubmit').onclick=authDoLogin;document.getElementById('authLoginPass').addEventListener('keydown',e=>{if(e.key==='Enter')authDoLogin()});}
async function authDoLogin(){authClearError();const user=document.getElementById('authLoginUser').value.trim().toLowerCase(),pass=document.getElementById('authLoginPass').value;if(!user||!pass){authError('Enter your username and password.');return}const hash=await authHash(pass);const a=db.admins.find(x=>x.active&&String(x.email||'').toLowerCase()===user&&x.passwordHash===hash);if(!a){authError('Incorrect username or password, or this account is inactive.');return}authSetCurrent(a);if(!a.passwordChangedAt||a.mustChangePassword){authChangePasswordView(true);return}authHide();render();}
function authChangePasswordView(force=false){const a=authActiveAdmin()||db.admins.find(x=>x.id===currentAdminId);authGateCard(`<div class="auth-brand">Trader Business Control</div><h2>${force?'Change Temporary Password':'Change Password'}</h2><p>${force?'Your Major Admin-created temporary password must be changed before you can continue.':'Change the password for '+esc(a?.name||'this account')+'.'}</p><div class="auth-error" id="authError"></div>${authPasswordMarkup('authOldPass','Current Password')}<div class="field"><label>New Password</label><input id="authNewPass" type="password" autocomplete="new-password"></div><div class="field"><label>Confirm New Password</label><input id="authNewPass2" type="password" autocomplete="new-password"></div><div class="auth-actions">${force?'':'<button class="btn secondary" id="authCancelChange">Cancel</button>'}<button class="btn" id="authChangeSubmit">Save New Password</button></div>`);document.getElementById('authChangeSubmit').onclick=async()=>{authClearError();const oldp=document.getElementById('authOldPass').value,np=document.getElementById('authNewPass').value,np2=document.getElementById('authNewPass2').value;if(!a||a.passwordHash!==await authHash(oldp)){authError('Current password is incorrect.');return}if(np.length<6||np!==np2){authError('New password must be at least 6 characters and both entries must match.');return}a.passwordHash=await authHash(np);a.passwordChangedAt=new Date().toISOString();a.mustChangePassword=false;save();authHide();render()};if(!force)document.getElementById('authCancelChange').onclick=()=>{authHide();render()};}
function authLogout(){authSessionClear();authSession=null;currentAdminId='';currentPage='dashboard';document.getElementById('authUserBadge').style.display='none';document.getElementById('changePasswordBtn').style.display='none';document.getElementById('logoutBtn').style.display='none';document.getElementById('sidebar').classList.remove('open');authLoginView()}
function authInit(){const m=db.admins.find(a=>a.role==='major');if(authNeedsSetup()){authSetupView();return}const saved=authSessionRead();if(saved?.id){const a=db.admins.find(x=>x.id===saved.id&&x.active);if(a){authSetCurrent(a);authHide();render();return}}authLoginView()}
const PERMISSION_GROUPS=[
 {title:'Dashboard',items:[['view_dashboard','View dashboard']]},
 {title:'Business Management',items:[['view_businesses','View businesses'],['manage_businesses','Create, edit and manage businesses'],['view_staff','View staff and assignments'],['manage_staff','Add staff, change roles and assign permissions']]},
 {title:'Sales',items:[['view_sales','View sales'],['create_sale','Create sales'],['edit_sale','Edit sales'],['delete_sale','Delete sales']]},
 {title:'Customers and Debtors',items:[['view_customers','View customers'],['manage_customers','Add and edit customers'],['view_payments','View debtor payments'],['record_payment','Record debtor payments'],['delete_payment','Delete debtor payments']]},
 {title:'Expenses',items:[['view_expenses','View expenses'],['create_expense','Record expenses'],['edit_expense','Edit expenses'],['delete_expense','Delete expenses']]},
 {title:'Stock',items:[['view_stock','View stock and balances'],['receive_stock','Receive/add stock'],['adjust_stock','Adjust stock'],['edit_product','Add and edit products'],['delete_product','Delete products']]},
 {title:'Reports and Controls',items:[['view_reports','View reports'],['view_reconciliation','View daily reconciliation'],['manage_reconciliation','Submit/reconcile daily figures'],['view_audit','View audit trail'],['view_messages','View and reply to Client Messages'],['view_clientview','View Client App View']]},
 {title:'Settings',items:[['view_settings','Access settings'],['manage_headers','Manage Client App header'],['manage_data','Clear/reset business data']]}
];
const ALL_PERMISSION_KEYS=PERMISSION_GROUPS.flatMap(g=>g.items.map(x=>x[0]));
function rolePermissionDefaults(role){
 const p=Object.fromEntries(ALL_PERMISSION_KEYS.map(k=>[k,false]));
 const allow=(...keys)=>keys.forEach(k=>p[k]=true);
 if(role==='major') return Object.fromEntries(ALL_PERMISSION_KEYS.map(k=>[k,true]));
 if(role==='owner'||role==='admin') allow('view_dashboard','view_businesses','view_sales','create_sale','edit_sale','view_customers','manage_customers','view_payments','record_payment','view_expenses','create_expense','edit_expense','view_stock','receive_stock','adjust_stock','edit_product','view_reports','view_reconciliation','manage_reconciliation','view_messages','view_clientview','view_settings','manage_headers');
 else if(role==='supervisor') allow('view_dashboard','view_sales','create_sale','edit_sale','view_customers','manage_customers','view_payments','record_payment','view_expenses','create_expense','edit_expense','view_stock','receive_stock','adjust_stock','edit_product','view_reports','view_reconciliation','manage_reconciliation','view_messages','view_clientview');
 else allow('view_dashboard','view_sales','create_sale','view_customers','view_payments','record_payment','view_expenses','create_expense','view_stock','receive_stock');
 return p;
}
function hasPermission(key,admin){const a=admin||db.admins.find(x=>x.id===currentAdminId)||{role:'entry_staff'};if(a.role==='major')return true;const defaults=rolePermissionDefaults(a.role);return a.permissions&&Object.prototype.hasOwnProperty.call(a.permissions,key)?a.permissions[key]===true:defaults[key]===true;}
function pagePermission(page){return ({dashboard:'view_dashboard',businesses:'view_businesses',admins:'view_staff',sales:'view_sales',customers:'view_customers',payments:'view_payments',expenses:'view_expenses',stock:'view_stock',reports:'view_reports',reconciliation:'view_reconciliation',audit:'view_audit',messages:'view_messages',clientview:'view_clientview',settings:'view_settings'})[page]||'view_dashboard';}
function enforcePagePermissions(){const me=db.admins.find(a=>a.id===currentAdminId)||{role:'entry_staff'};document.querySelectorAll('#nav button[data-page]').forEach(btn=>{btn.style.display=hasPermission(pagePermission(btn.dataset.page),me)?'':'none'});if(!hasPermission(pagePermission(currentPage),me)){const first=[...document.querySelectorAll('#nav button[data-page]')].find(btn=>hasPermission(pagePermission(btn.dataset.page),me));currentPage=first?first.dataset.page:'dashboard';}}
function actionPermission(action){const exact={
 'new-business':'manage_businesses','edit-business':'manage_businesses','delete-business':'manage_businesses','toggle-business':'manage_businesses','new-branch':'manage_businesses','edit-branch':'manage_businesses','assign-staff-business':'manage_staff',
 'new-admin':'manage_staff','edit-admin':'manage_staff','delete-admin':'manage_staff','toggle-admin':'manage_staff',
 'new-sale':'create_sale','add-sale-item':'create_sale','remove-sale-item':'create_sale','save-sale-page':'create_sale','save-sale-page-new':'create_sale','edit-sale':'edit_sale','delete-sale':'delete_sale',
 'new-customer':'manage_customers','edit-customer':'manage_customers','new-payment':'record_payment','delete-payment':'delete_payment',
 'new-expense':'create_expense','edit-expense':'edit_expense','delete-expense':'delete_expense',
 'new-product':'edit_product','edit-product':'edit_product','delete-product':'delete_product','adjust-stock':'adjust_stock',
 'new-reconciliation':'manage_reconciliation','save-header':'manage_headers','edit-inline-customer':'manage_customers','save-inline-customer':'manage_customers','new-customer':'manage_customers','edit-inline-payment':'record_payment','save-inline-payment':'record_payment','new-payment':'record_payment','edit-inline-expense':'edit_expense','save-inline-expense':'create_expense','new-expense':'create_expense','clear-header':'manage_headers','clear-data':'manage_data','reset':'manage_data',
 'save-online-config':'view_settings','setup-clear-password':'manage_data','reply-client-message':'view_messages','mark-message-read':'view_messages','refresh-messages':'view_messages','publish-business':'manage_businesses','copy-feed':'view_businesses','export-feed':'view_businesses','test-online':'view_settings','generate-client-report':'view_reports','save-client-report':'view_reports','publish-client-report':'view_reports','export':'view_reports'
};return exact[action]||null;}

function seed(){
 const admins=[{id:'admin-major',name:'Major Admin',email:'major@tradercontrol.local',role:'major',active:true,businessIds:[],branchIds:[]}];
 return {businesses:[],branches:[],admins,products:[],customers:[],sales:[],payments:[],expenses:[],stockMovements:[],auditTrail:[],reconciliations:[],activeBusinessId:''};
}
function load(){
 try{
  const fresh=JSON.parse(localStorage.getItem(KEY));
  if(fresh&&Array.isArray(fresh.businesses)&&Array.isArray(fresh.admins))return fresh;
 }catch(e){}
 let old=null;
 try{old=JSON.parse(localStorage.getItem(LEGACY_KEY))}catch(e){}
 const clean=seed();
 if(old&&Array.isArray(old.admins)){
  clean.admins=old.admins.map(a=>({...a,businessIds:[],branchIds:[]}));
  if(!clean.admins.some(a=>a.role==='major'))clean.admins.unshift({id:'admin-major',name:'Major Admin',email:'major@tradercontrol.local',role:'major',active:true,businessIds:[],branchIds:[]});
 }
 localStorage.setItem(KEY,JSON.stringify(clean));
 try{localStorage.removeItem(LEGACY_KEY)}catch(e){}
 return clean;
}
function save(){localStorage.setItem(KEY,JSON.stringify(db)); const cfg=onlineConfig(); if(cfg.url&&cfg.key&&db.businesses.some(b=>b.id===db.activeBusinessId)){ publishBusiness().catch(e=>console.warn('Auto-sync failed:',e.message)); }}
function auditEvent(action,details='',severity='normal'){if(!Array.isArray(db.auditTrail))db.auditTrail=[];db.auditTrail.unshift({id:id(),businessId:db.activeBusinessId||'',actorId:currentAdminId||'',actorName:db.admins.find(x=>x.id===currentAdminId)?.name||'Unknown',role:db.admins.find(x=>x.id===currentAdminId)?.role||'unknown',action,details:String(details||''),severity,at:new Date().toISOString()});db.auditTrail=db.auditTrail.slice(0,5000)}
function requireMajorApproval(reason){const me=db.admins.find(x=>x.id===currentAdminId);if(me?.role!=='major'){alert('Only Major Admin can approve sensitive corrections.');auditEvent('Sensitive approval denied',reason,'security');save();return false;}const note=prompt('Major Admin approval required. Enter reason for approval:');if(!note||!note.trim())return false;auditEvent('Sensitive correction approved',reason+' — '+note.trim(),'sensitive');return true;}
function biz(){return db.businesses.find(b=>b.id===db.activeBusinessId)||db.businesses[0]||{id:'',name:'',type:'',currency:'NGN',phone:'',address:'',active:false,clientFeedId:'',header:{}}}
function allowedBusiness(bid){const a=db.admins.find(x=>x.id===currentAdminId);return !!(a&&a.active&&(a.role==='major'||a.businessIds.includes(bid)))}
function scoped(list){return list.filter(x=>x.businessId===db.activeBusinessId)}
function cust(idv){return db.customers.find(c=>c.id===idv)||{name:'Walk-in Customer'}}function prod(idv){return db.products.find(p=>p.id===idv)||{name:'Unknown',sell:0}}
function range(){const d=new Date(today), y=d.getFullYear(),m=d.getMonth(),day=d.getDate();if(period==='all')return ['0000-01-01','9999-12-31'];if(period==='today')return [today,today];if(period==='week'){const start=new Date(d);start.setDate(day-d.getDay());return [iso(start),today]}if(period==='month')return [`${y}-${String(m+1).padStart(2,'0')}-01`,today];const pm=new Date(y,m-1,1),end=new Date(y,m,0);return [iso(pm),iso(end)]}
function inRange(date){const r=range();return date>=r[0]&&date<=r[1]}function periodLabel(){const r=range();return r[0]==='0000-01-01'?'All Time':`${r[0]} to ${r[1]}`}
function totals(){
  const ss=scoped(db.sales).filter(s=>inRange(s.date)), ps=scoped(db.payments).filter(p=>inRange(p.date)), es=scoped(db.expenses).filter(e=>inRange(e.date));
  const cash=ss.filter(s=>paymentStatus(s)==='Cash'), credit=ss.filter(s=>saleOutstanding(s)>0);
  const creditTotal=ss.reduce((a,s)=>a+saleOutstanding(s),0), saleTotal=ss.reduce((a,s)=>a+Number(s.total||0),0);
  const amountReceived=ss.reduce((a,s)=>a+Number(s.paid||0),0)+ps.reduce((a,p)=>a+Number(p.amount||0),0);
  const owing=scoped(db.customers).map(c=>({...c,balance:customerOutstanding(c.id)})).filter(c=>c.balance>0);
  return{sales:ss,cashSales:cash,credit,creditTotal,saleTotal,payments:ps.reduce((a,p)=>a+Number(p.amount||0),0),cashReceived:amountReceived,amountReceived,exp:es.reduce((a,e)=>a+e.amount,0),owing}
}
function renderBusinessSelect(){const a=db.admins.find(x=>x.id===currentAdminId);const badge=document.getElementById('authUserBadge');if(badge&&a){badge.innerHTML=`<b>${esc(a.name)}</b><span>• ${esc(({major:'Major Admin',owner:'Business Owner',supervisor:'Supervisor',entry_staff:'Entry Staff',admin:'Legacy Admin'}[a.role]||a.role))}</span>`;badge.style.display='inline-flex';document.getElementById('changePasswordBtn').style.display='inline-block';document.getElementById('logoutBtn').style.display='inline-block';}const list=db.businesses.filter(b=>b.active&&allowedBusiness(b.id));document.getElementById('businessSelect').innerHTML=list.map(b=>`<option value="${b.id}" ${b.id===db.activeBusinessId?'selected':''}>${esc(b.name)}</option>`).join('')||'<option value="">No business created yet</option>';if(!allowedBusiness(db.activeBusinessId)&&list[0])db.activeBusinessId=list[0].id}
function render(){if(!authSession||!authActiveAdmin()){return}renderBusinessSelect();enforcePagePermissions();updateOnlineBadge();document.getElementById('period').value=period;document.getElementById('periodText').textContent=`${biz().name} • ${periodLabel()}`;document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById('page-'+currentPage).classList.add('active');document.querySelectorAll('#nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===currentPage));const titles={dashboard:'Dashboard',businesses:'Businesses',admins:'Admin Access',sales:'Sales',customers:'Customers',payments:'Debtors & Payments',expenses:'Expenses',stock:'Stock',reports:'Reports',reconciliation:'Daily Reconciliation',audit:'Audit Trail',messages:'Client Messages',clientview:'Client App View',settings:'Settings'};document.getElementById('pageTitle').textContent=titles[currentPage];({dashboard:renderDashboard,businesses:renderBusinesses,admins:renderAdmins,sales:renderSales,customers:renderCustomers,payments:renderPayments,expenses:renderExpenses,stock:renderStock,reports:renderReports,reconciliation:renderReconciliation,audit:renderAudit,messages:()=>{document.getElementById('page-messages').innerHTML='<div class="section"><div class="section-body"><div class="status">Loading Client Messages…</div></div></div>';loadAdminMessages()},settings:renderSettings,clientview:renderClientAppView}[currentPage])();save()}
function renderDashboard(){const t=totals(),b=biz();const productTotals={};t.sales.forEach(s=>(s.items||[]).forEach(i=>{const p=db.products.find(p=>p.id===i.productId&&p.businessId===b.id);if(p){const q=Number(i.qty||i.quantity||0);productTotals[p.name]=(productTotals[p.name]||{qty:0,amount:0});productTotals[p.name].qty+=q;productTotals[p.name].amount+=q*Number(i.price||0);}}));const productRows=Object.entries(productTotals).sort((a,b)=>b[1].qty-a[1].qty);document.getElementById('page-dashboard').innerHTML=`<div class="notice"><b>${b.name?('Active business: '+esc(b.name)+' ('+esc(b.type)+'). All data shown below belongs only to this business.'):'No business has been added yet. Select Businesses → Add Business to begin. No sample business or demo records are installed.'}</b></div><div class="cards"><div class="card"><div class="label">Sales</div><div class="value">${money(t.saleTotal)}</div><div class="sub">${t.sales.length} transactions</div></div><div class="card"><div class="label">Amount Received</div><div class="value">${money(t.amountReceived)}</div><div class="sub">Sales payments + debtor payments</div></div><div class="card"><div class="label">Credit Sales</div><div class="value">${money(t.creditTotal)}</div><div class="sub">Outstanding from sales</div></div><div class="card"><div class="label">Expenses</div><div class="value">${money(t.exp)}</div><div class="sub">Expenses in selected period</div></div></div><div class="cards" style="margin-top:10px;grid-template-columns:minmax(0,1fr)"><div class="card"><div class="label">Customers Owing</div><div class="value">${t.owing.length}</div><div class="sub">${money(t.owing.reduce((a,c)=>a+c.balance,0))} outstanding</div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Products Sold in Selected Date Range</h3><span class="status">${esc(periodLabel())}</span></div><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Product</th><th class="right">Quantity Sold</th><th class="right">Sales Amount</th></tr></thead><tbody>${productRows.map(([name,v])=>`<tr><td><b>${esc(name)}</b></td><td class="right">${v.qty}</td><td class="right">${money(v.amount)}</td></tr>`).join('')||'<tr><td colspan="3" class="empty">No product sales in this period.</td></tr>'}</tbody></table></div></div></div><div class="grid2"><div class="section"><div class="section-head"><h3>Recent Sales</h3><button class="btn secondary small" data-go="sales">View All</button></div><div class="section-body"><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Payment</th><th class="right">Amount</th></tr></thead><tbody>${t.sales.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,6).map(s=>`<tr><td>${esc(cust(s.customerId).name)}</td><td>${s.date}</td><td class="${paymentStatus(s)==='Cash'?'green-text':(paymentStatus(s)==='Partly Credit'?'orange-text':'red-text')}">${paymentStatus(s)}</td><td class="right">${money(s.total)}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">No sales in this period.</td></tr>'}</tbody></table></div></div><div class="section"><div class="section-head"><h3>Business Snapshot</h3></div><div class="section-body"><div class="statline"><span class="pill">Products <b>${scoped(db.products).length}</b></span><span class="pill">Low Stock <b>${scoped(db.products).filter(p=>(window.getActiveBranchId?.()||'all')==='all'?productStockAcrossBranches(p)<=Number(p.reorder||0):globalProductStockAt(p,window.getActiveBranchId())<=Number(p.reorder||0)).length}</b></span><span class="pill">Customers <b>${scoped(db.customers).length}</b></span></div><p class="status">Selected business: <b>${esc(b.name||'Not configured')}</b><br>Client Feed ID: <b>${esc(b.clientFeedId||'Create a business first')}</b></p><button class="btn" data-go="businesses">Manage Businesses</button></div></div></div>`}
function renderBusinesses(){document.getElementById('page-businesses').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="bizSearch" placeholder="Search businesses"></div><button class="btn" data-action="new-business">+ Add Business</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Business</th><th>Type</th><th>Contact</th><th>Admins</th><th>Status</th><th>Client Feed</th><th>Actions</th></tr></thead><tbody id="bizBody">${db.businesses.map(b=>{const as=db.admins.filter(a=>a.businessIds.includes(b.id));return `<tr data-search="${esc(b.name+' '+b.type)}"><td><b>${esc(b.name)}</b><br><span class="status">${esc(b.address||'')}</span></td><td>${esc(b.type)}</td><td>${esc(b.phone||'')}</td><td>${as.length}</td><td><span class="tag ${b.active?'active':'off'}">${b.active?'ACTIVE':'INACTIVE'}</span></td><td>${esc(b.clientFeedId)}</td><td><div class="actions"><button class="btn ${b.id===db.activeBusinessId?'green':'secondary'} small" data-action="select-business" data-id="${b.id}">${b.id===db.activeBusinessId?'Selected':'Select'}</button><button class="btn secondary small" data-action="edit-business" data-id="${b.id}">Edit</button><button class="btn ${b.active?'danger':'green'} small" data-action="toggle-business" data-id="${b.id}">${b.active?'Deactivate':'Activate'}</button></div></td></tr>`}).join('')||'<tr><td colspan="7" class="empty">No businesses registered yet. Select Add Business to begin.</td></tr>'}</tbody></table></div></div></div>`;document.getElementById('bizSearch').oninput=e=>document.querySelectorAll('#bizBody tr').forEach(r=>r.style.display=r.dataset.search.toLowerCase().includes(e.target.value.toLowerCase())?'':'none')}
function renderAdmins(){const me=db.admins.find(a=>a.id===currentAdminId);document.getElementById('page-admins').innerHTML=`${me.role==='major'?'<div class="notice"><b>Major Admin access.</b> You can create administrators and assign each administrator to one or more registered businesses.</div>':'<div class="warning"><b>Limited Admin.</b> You can manage only the businesses assigned to your account. Major Admin controls administrator access.</div>'}<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Admins <b>${db.admins.length}</b></span><span class="pill">Major Admins <b>${db.admins.filter(a=>a.role==='major').length}</b></span></div>${me.role==='major'?'<button class="btn" data-action="new-admin">+ Add Admin</button>':''}</div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Admin</th><th>Role</th><th>Assigned Businesses</th><th>Status</th><th>Actions</th></tr></thead><tbody>${db.admins.map(a=>`<tr><td><b>${esc(a.name)}</b><br><span class="status">${esc(a.email)}</span></td><td>${`<span class="tag ${a.role==='major'?'major':'active'}">${esc(({major:'MAJOR ADMIN',owner:'BUSINESS OWNER',supervisor:'SUPERVISOR',entry_staff:'ENTRY STAFF',admin:'LEGACY ADMIN'}[a.role]||a.role.toUpperCase()))}</span>`}</td><td><div class="access-list">${a.businessIds.map(x=>{const b=db.businesses.find(y=>y.id===x);return b?`<span class="access-chip">${esc(b.name)}</span>`:''}).join('')||'<span class="status">No business assigned</span>'}</div></td><td><span class="tag ${a.active?'active':'off'}">${a.active?'ACTIVE':'INACTIVE'}</span></td><td>${me.role==='major'&&a.id!=='admin-major'?`<div class="actions"><button class="btn secondary small" data-action="edit-admin" data-id="${a.id}">Edit Access</button><button class="btn ${a.active?'danger':'green'} small" data-action="toggle-admin" data-id="${a.id}">${a.active?'Deactivate':'Activate'}</button><button class="btn danger small" data-action="delete-admin" data-id="${a.id}">Delete</button><button class="btn danger small" data-action="delete-admin" data-id="${a.id}">Delete</button></div>`:'—'}</td></tr>`).join('')}</tbody></table></div></div></div>`}
function renderSales(){const rows=scoped(db.sales).filter(s=>inRange(s.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-sales').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="salesSearch" placeholder="Search customer"></div><button class="btn" data-action="new-sale">+ New Sale</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Invoice No.</th><th>Transaction Date</th><th>Entry Date</th><th>Payment</th><th>Items</th><th class="right">Sales</th><th class="right">Received</th><th class="right">Credit</th><th>Actions</th></tr></thead><tbody id="salesBody">${rows.map(s=>`<tr data-search="${esc(cust(s.customerId).name)}"><td><b>${esc(cust(s.customerId).name)}</b></td><td>${s.date}</td><td class="${paymentStatus(s)==='Cash'?'green-text':(paymentStatus(s)==='Partly Credit'?'orange-text':'red-text')}">${paymentStatus(s)}</td><td>${s.items.length}</td><td class="right">${money(s.total)}</td><td class="right">${money(s.paid||0)}</td><td class="right">${money(saleOutstanding(s))}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-sale" data-id="${s.id}">Edit</button><button class="btn danger small" data-action="delete-sale" data-id="${s.id}">Delete</button></div></td></tr>`).join('')||'<tr><td colspan="8" class="empty">No sales in this period.</td></tr>'}</tbody></table></div></div></div>`;document.getElementById('salesSearch').oninput=e=>document.querySelectorAll('#salesBody tr').forEach(r=>r.style.display=r.dataset.search?.toLowerCase().includes(e.target.value.toLowerCase())?'':'none')}
function renderCustomers(){const t=totals();document.getElementById('page-customers').innerHTML=`<div class="toolbar"><input class="search" id="customerSearch" placeholder="Search customer"><button class="btn" data-action="new-customer">+ New Customer</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Phone</th><th>Address</th><th class="right">Balance</th><th>Actions</th></tr></thead><tbody id="customerBody">${scoped(db.customers).map(c=>{let o=t.owing.find(x=>x.id===c.id)?.balance||0;return `<tr data-search="${esc(c.name+' '+c.phone)}"><td><b>${esc(c.name)}</b></td><td>${esc(c.phone)}</td><td>${esc(c.address)}</td><td class="right ${o?'red-text':''}">${money(o)}</td><td><button class="btn secondary small" data-action="edit-customer" data-id="${c.id}">Edit</button></td></tr>`}).join('')}</tbody></table></div></div></div>`;document.getElementById('customerSearch').oninput=e=>document.querySelectorAll('#customerBody tr').forEach(r=>r.style.display=r.dataset.search.toLowerCase().includes(e.target.value.toLowerCase())?'':'none')}
function renderPayments(){const rows=scoped(db.payments).filter(p=>inRange(p.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-payments').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Payments <b>${rows.length}</b></span><span class="pill">Received <b>${money(rows.reduce((a,p)=>a+p.amount,0))}</b></span></div><button class="btn" data-action="new-payment">+ Record Payment</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Method</th><th>Note</th><th class="right">Amount</th><th>Actions</th></tr></thead><tbody>${rows.map(p=>`<tr><td>${esc(cust(p.customerId).name)}</td><td>${p.date}</td><td>${esc(p.method)}</td><td>${esc(p.note)}</td><td class="right">${money(p.amount)}</td><td><button class="btn danger small" data-action="delete-payment" data-id="${p.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No payments in this period.</td></tr>'}</tbody></table></div></div></div>`}
function renderExpenses(){const rows=scoped(db.expenses).filter(e=>inRange(e.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-expenses').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Expenses <b>${rows.length}</b></span><span class="pill">Total <b>${money(rows.reduce((a,e)=>a+e.amount,0))}</b></span></div><button class="btn" data-action="new-expense">+ New Expense</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Description</th><th>Date</th><th>Vendor / Person</th><th>Method</th><th class="right">Amount</th><th>Actions</th></tr></thead><tbody>${rows.map(e=>`<tr><td>${esc(e.description)}</td><td>${e.date}</td><td>${esc(e.vendor)}</td><td>${esc(e.method)}</td><td class="right">${money(e.amount)}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-expense" data-id="${e.id}">Edit</button><button class="btn danger small" data-action="delete-expense" data-id="${e.id}">Delete</button></div></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No expenses in this period.</td></tr>'}</tbody></table></div></div></div>`}
function globalBranchStockPool(branchId){const br=db.branches.find(x=>x.id===branchId);if(!br)return {mode:'global',id:''};if(br.stockMode==='shared'&&br.stockSharedWith){const source=db.branches.find(x=>x.id===br.stockSharedWith);if(source?.stockMode==='separate')return {mode:'branch',id:source.id};return {mode:'global',id:''}}if(br.stockMode==='separate')return {mode:'branch',id:br.id};return {mode:'global',id:''}}
function globalProductStockAt(product,branchId){const pool=globalBranchStockPool(branchId);return pool.mode==='branch'?Number(product.branchQty?.[pool.id]??0):Number(product.qty||0)}
function globalAdjustProductStockAt(product,branchId,delta){const pool=globalBranchStockPool(branchId);if(pool.mode==='branch'){if(!product.branchQty)product.branchQty={};product.branchQty[pool.id]=Math.max(0,Number(product.branchQty[pool.id]||0)+Number(delta||0))}else product.qty=Math.max(0,Number(product.qty||0)+Number(delta||0))}
function productStockAcrossBranches(product,businessId=db.activeBusinessId){
  const seen=new Set();let total=0;
  (db.branches||[]).filter(br=>br.businessId===businessId&&br.active!==false).forEach(br=>{
    const pool=globalBranchStockPool(br.id),key=pool.mode==='branch'?'branch:'+pool.id:'global';
    if(seen.has(key))return;seen.add(key);total+=pool.mode==='branch'?Number(product.branchQty?.[pool.id]??0):Number(product.qty||0);
  });return total;
}
function saveNewProductFromStockForm(){
 const branchId=window.getActiveBranchId?.()||'all';if(branchId==='all'){alert('Select a specific branch from the Home screen before saving a product.');return}
 const name=document.getElementById('stockNewName')?.value.trim()||'',unit=document.getElementById('stockNewUnit')?.value.trim()||'',costRaw=document.getElementById('stockNewCost')?.value.trim()||'',sellRaw=document.getElementById('stockNewSell')?.value.trim()||'',qtyRaw=document.getElementById('stockNewQty')?.value.trim()||'0',reorderRaw=document.getElementById('stockNewReorder')?.value.trim()||'0';
 const cost=Number(costRaw),sell=Number(sellRaw),qty=Number(qtyRaw),reorder=Number(reorderRaw);
 if(!name||!unit){alert('Item Name and Unit are required.');return}if(costRaw===''||!Number.isFinite(cost)||cost<0){alert('Enter a valid Cost Price (zero is allowed).');return}if(sellRaw===''||!Number.isFinite(sell)||sell<=0){alert('Enter a Selling Price greater than zero.');return}if(!Number.isFinite(qty)||qty<0||!Number.isFinite(reorder)||reorder<0){alert('Enter valid non-negative quantities.');return}
 if(db.products.some(p=>p.businessId===db.activeBusinessId&&String(p.name||'').trim().toLowerCase()===name.toLowerCase())){alert('This product already exists in this business. Use Edit Product or select the existing product.');return}
 const pool=globalBranchStockPool(branchId),branchRecord=db.branches.find(br=>br.id===branchId),branchIdsForCurrentStock=[branchId];if(branchRecord?.stockMode==='shared'&&branchRecord.stockSharedWith){const sharedSource=db.branches.find(br=>br.id===branchRecord.stockSharedWith);if(sharedSource?.stockMode==='separate')branchIdsForCurrentStock.push(sharedSource.id)}
 const product={id:id(),businessId:db.activeBusinessId,branchIds:branchIdsForCurrentStock,name,unit,cost,sell,reorder,qty:pool.mode==='branch'?0:qty,branchQty:{}};if(pool.mode==='branch')product.branchQty[pool.id]=qty;db.products.push(product);
 if(qty>0){if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:db.activeBusinessId,branchId,productId:product.id,qty,type:'opening_stock',notes:'Opening stock entered when product was created',previousQty:0,resultQty:qty,actorName:db.admins.find(a=>a.id===currentAdminId)?.name||'Current Admin',date:today,createdAt:new Date().toISOString()})}
 ensureBusinessProductName(name);save();render();
}
function stockForCurrentBranch(product){const bid=window.getActiveBranchId?.()||'all';return bid==='all'?productStockAcrossBranches(product):globalProductStockAt(product,bid)}
function renderStock(){
  const bid=window.getActiveBranchId?.()||'all';
  const products=scoped(db.products);const qty=p=>stockForCurrentBranch(p);
  const label=bid==='all'?'All Branches':(branchesFor(db.activeBusinessId).find(x=>x.id===bid)?.name||'Selected Branch');
  const branchId=bid!=='all'?bid:(branchesFor(db.activeBusinessId)[0]?.id||'');
  document.getElementById('page-stock').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Products <b>${products.length}</b></span><span class="pill">Low Stock <b>${products.filter(p=>qty(p)<=Number(p.reorder||0)).length}</b></span><span class="pill">Stock view <b>${esc(label)}</b></span></div></div>
  <div class="section"><div class="section-head"><h3>New Product</h3></div><div class="section-body"><div class="stock-product-form-scroll"><div class="stock-product-fields">
  <div class="field"><label>Item Name *</label><input id="stockNewName" list="stockProductNames" autocomplete="off"><datalist id="stockProductNames">${(biz().productNameList||[]).map(n=>`<option value="${esc(n)}"></option>`).join('')}</datalist></div>
  <div class="field"><label>Unit *</label><input id="stockNewUnit" value="Unit"></div>
  <div class="field"><label>Cost Price *</label><input id="stockNewCost" type="number" min="0" step="0.01"></div>
  <div class="field"><label>Selling Price *</label><input id="stockNewSell" type="number" min="0.01" step="0.01"></div>
  <div class="field"><label>Opening Quantity</label><input id="stockNewQty" type="number" min="0" step="any" value="0"></div>
  <div class="field"><label>Reorder Level</label><input id="stockNewReorder" type="number" min="0" step="any" value="0"></div>
  </div></div><div class="stock-product-actions"><p class="status">Branch: <b>${esc(branchesFor(db.activeBusinessId).find(x=>x.id===branchId)?.name||'Select a branch on the Home screen')}</b></p><button class="btn" data-action="save-new-product-form">Save Product</button></div></div></div>
  <div class="section"><div class="section-head"><h3>Product List</h3><span class="status">${products.length} products</span></div><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Item</th><th>Unit</th><th class="right">Cost</th><th class="right">Selling</th><th class="right">Qty</th><th>Reorder</th><th>Status</th><th>Actions</th></tr></thead><tbody>${products.map(p=>`<tr data-product-row="${p.id}"><td><b>${esc(p.name)}</b></td><td>${esc(p.unit||'')}</td><td class="right">${money(p.cost)}</td><td class="right">${money(p.sell)}</td><td class="right">${qty(p)}</td><td>${Number(p.reorder||0)}</td><td class="${qty(p)<=Number(p.reorder||0)?'red-text':'green-text'}">${qty(p)<=Number(p.reorder||0)?'LOW':'OK'}</td><td><div class="actions"><button class="btn secondary small" data-action="add-stock" data-id="${p.id}">Add</button><button class="btn secondary small" data-action="view-stock-details" data-id="${p.id}">View Details</button><button class="btn small" data-action="edit-latest-stock" data-id="${p.id}">Edit Latest</button></div></td></tr>`).join('')||'<tr><td colspan="8" class="empty">No products have been added yet.</td></tr>'}</tbody></table></div></div></div>`;
}
function stockMovementLabel(m){return ({stock_addition:'Stock added',opening_stock:'Opening stock',branch_opening_stock:'Branch opening stock',sale:'Sale deduction',sale_edit:'Sale correction',sale_deleted:'Sale deleted / stock restored',manual_adjustment:'Legacy stock adjustment',stock_addition_edit:'Stock addition edited'})[m.type]||String(m.type||'Stock movement').replaceAll('_',' ')}
function stockHistoryFor(p){return (db.stockMovements||[]).filter(m=>m.businessId===p.businessId&&m.productId===p.id).slice().sort((a,b)=>String(a.createdAt||a.date||'').localeCompare(String(b.createdAt||b.date||'')))}
function stockBranchId(){const b=window.getActiveBranchId?.()||'all';if(b==='all'){alert('Select a specific branch from the Dashboard before updating stock.');return ''}return b}
function addStock(p){if(!p)return;const branchId=stockBranchId();if(!branchId)return;const current=globalProductStockAt(p,branchId);openModal('Add Stock — '+p.name,`<div class="form-grid"><div class="field full"><label>Product</label><input value="${esc(p.name)}" readonly></div><div class="field"><label>Current Stock</label><input value="${current}" readonly></div><div class="field"><label>Quantity to Add *</label><input id="fAddQty" type="number" min="1" step="any" value="" required></div><div class="field full"><label>Reason / Remarks</label><input id="fStockReason" placeholder="e.g. New delivery, restock invoice"></div></div>`,()=>{const branchNow=stockBranchId();if(!branchNow)return false;const qtyRaw=document.getElementById('fAddQty').value.trim(),n=Number(qtyRaw),reason=document.getElementById('fStockReason').value.trim();if(!qtyRaw||!Number.isFinite(n)||n<=0){alert('Enter a quantity greater than zero.');return false}const before=globalProductStockAt(p,branchNow),at=new Date().toISOString();globalAdjustProductStockAt(p,branchNow,n);if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:p.businessId,branchId:branchNow,productId:p.id,qty:n,type:'stock_addition',notes:reason,previousQty:before,resultQty:before+n,actorName:db.admins.find(a=>a.id===currentAdminId)?.name||'Current Admin',date:today,createdAt:at});auditEvent('Stock added',`${p.name}; quantity ${n}; balance ${before} → ${before+n}; reason ${reason||'Not specified'}`,'normal');save();render();return true})}
function viewStockDetails(p){
 if(!p)return;const tr=document.querySelector(`tr[data-product-row="${p.id}"]`);if(!tr)return;
 const next=tr.nextElementSibling;if(next?.dataset.stockDetailsFor===p.id){next.remove();return}
 document.querySelectorAll('tr[data-stock-details-for]').forEach(r=>r.remove());
 const bid=window.getActiveBranchId?.()||'all';
 const eligible=new Set(['stock_addition','opening_stock','branch_opening_stock','stock_addition_edit']);
 const rows=stockHistoryFor(p).filter(m=>eligible.has(m.type)&&(bid==='all'||!m.branchId||m.branchId===bid||globalBranchStockPool(m.branchId).mode==='global'&&globalBranchStockPool(bid).mode==='global'));
 const body=rows.map(m=>{const q=Number(m.qty||0);const stamp=m.createdAt?new Date(m.createdAt).toLocaleString():String(m.date||'—');const br=branchesFor(p.businessId).find(b=>b.id===m.branchId)?.name||m.branchId||'Shared / legacy';const kind=m.type==='stock_addition_edit'?'Correction to stock update':(m.type==='opening_stock'?'Opening stock':(m.type==='branch_opening_stock'?'Branch opening stock':'Stock added'));return `<tr><td>${esc(stamp)}</td><td>${esc(kind)}<div class="status">${esc(br)}${m.notes?' · '+esc(m.notes):''}</div></td><td class="right">${q>0?'+':''}${q}</td><td class="right">${m.previousQty===undefined?'—':Number(m.previousQty)}</td><td class="right">${m.resultQty===undefined?'—':Number(m.resultQty)}</td><td>${esc(m.actorName||m.editedBy||'—')}</td></tr>`}).join('');
 const detail=document.createElement('tr');detail.dataset.stockDetailsFor=p.id;detail.innerHTML=`<td colspan="8"><div class="section" style="margin:8px 0"><div class="section-head"><h3>Stock Update History — ${esc(p.name)}</h3><button type="button" class="btn secondary small" data-action="close-stock-details" data-id="${p.id}">Close</button></div><div class="section-body"><p class="status">Current stock balance: <b>${stockForCurrentBranch(p)} ${esc(p.unit||'units')}</b>. This list contains stock additions and corrections only, not sales or other stock movements.</p><div class="table-wrap"><table class="table"><thead><tr><th>Date / Time</th><th>Update</th><th class="right">Quantity</th><th class="right">Previous Balance</th><th class="right">Resulting Balance</th><th>Updated By</th></tr></thead><tbody>${body||'<tr><td colspan="6" class="empty">No stock update history is recorded for this product yet.</td></tr>'}</tbody></table></div></div></div></td>`;tr.insertAdjacentElement('afterend',detail);
}
function editLatestStock(p){if(!p)return;const branchId=stockBranchId();if(!branchId)return;const eligible=new Set(['stock_addition','opening_stock','branch_opening_stock']);const entries=stockHistoryFor(p).filter(m=>eligible.has(m.type)&&(!m.branchId||m.branchId===branchId||globalBranchStockPool(m.branchId).mode==='global'&&globalBranchStockPool(branchId).mode==='global'));const latest=entries[entries.length-1];if(!latest){alert('There is no recorded stock-addition entry to edit for this product and stock pool. Use Add to create a stock entry first.');return}const oldQty=Number(latest.qty||0);const createdAtMs=Date.parse(latest.createdAt||latest.date||'');const reasonRequired=!(Number.isFinite(createdAtMs)&&Date.now()-createdAtMs<=2*60*60*1000&&Date.now()>=createdAtMs);openModal('Edit Latest Stock Entry — '+p.name,`<div class="notice">Only the latest stock-addition entry can be edited. Sales and other later movements remain in the history.</div><div class="form-grid"><div class="field full"><label>Product</label><input value="${esc(p.name)}" readonly></div><div class="field"><label>Original Quantity Added</label><input value="${oldQty}" readonly></div><div class="field"><label>Corrected Quantity *</label><input id="fCorrectQty" type="number" min="0" step="any" value="${oldQty}" required></div><div class="field full"><label>Correction Reason <span id="fReasonRequiredLabel">${reasonRequired?'* (required)':'(optional within 2 hours)'}</span></label><input id="fCorrectReason" placeholder="Explain why the entry is corrected" ${reasonRequired?'required':''}></div></div>`,()=>{const raw=document.getElementById('fCorrectQty').value.trim(),corrected=Number(raw),reason=document.getElementById('fCorrectReason').value.trim();if(!raw||!Number.isFinite(corrected)||corrected<0){alert('Enter a valid corrected quantity. Zero is allowed.');return false}if(reasonRequired&&!reason){alert('Enter the reason for correcting this stock entry.');return false}const current=globalProductStockAt(p,branchId),delta=corrected-oldQty,result=current+delta;const soldOrCommitted=Math.max(0,current-Number(latest.resultQty??(Number(latest.previousQty||0)+oldQty)));if(result<0||result<soldOrCommitted){alert(`This correction is blocked. It would make stock negative (${result}). Stock already sold or committed cannot be covered by the corrected quantity.`);return false}const beforeCurrent=current,at=new Date().toISOString();latest.qty=corrected;latest.previousEntryQty=oldQty;latest.editedAt=at;latest.editedBy=db.admins.find(a=>a.id===currentAdminId)?.name||'Current Admin';latest.editReason=reason||'Correction made within 2 hours of stock entry';latest.resultQty=Number(latest.resultQty??(Number(latest.previousQty||0)+corrected));globalAdjustProductStockAt(p,branchId,delta);if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:p.businessId,branchId,productId:p.id,qty:delta,type:'stock_addition_edit',notes:`Corrected latest addition from ${oldQty} to ${corrected}. ${reason}`,previousQty:beforeCurrent,resultQty:result,actorName:db.admins.find(a=>a.id===currentAdminId)?.name||'Current Admin',date:today,createdAt:at,sourceMovementId:latest.id});auditEvent('Latest stock entry edited',`${p.name}; previous addition ${oldQty}; corrected ${corrected}; current balance ${beforeCurrent} → ${result}; reason ${reason||'Within 2-hour correction window'}`,'sensitive');save();render();return true})}
function renderReports(){const t=totals(),b=biz(),r=b.clientReport||{visible:false,published:false,content:null},written=(r.content&&r.content.writtenReport)||'';const sales=(db.sales||[]).filter(s=>s.businessId===b.id&&inRange(s.date));const productTotals={};sales.forEach(s=>(s.items||[]).forEach(i=>{const p=db.products.find(p=>p.id===i.productId);if(p)productTotals[p.name]=(productTotals[p.name]||0)+Number(i.qty||i.quantity||0)}));const ranked=Object.entries(productTotals).sort((x,y)=>y[1]-x[1]);const customerTotals={};sales.forEach(s=>{const c=db.customers.find(c=>c.id===s.customerId);if(c)customerTotals[c.name]=(customerTotals[c.name]||0)+Number(s.total||0)});const best=Object.entries(customerTotals).sort((x,y)=>y[1]-x[1])[0];document.getElementById('page-reports').innerHTML=`<div class="cards"><div class="card"><div class="label">Sales</div><div class="value">${money(t.saleTotal)}</div><div class="sub">${t.sales.length} transactions</div></div><div class="card"><div class="label">Amount Received</div><div class="value">${money(t.amountReceived)}</div><div class="sub">Sales payments + debtor payments</div></div><div class="card"><div class="label">Credit Sales</div><div class="value">${money(t.creditTotal)}</div><div class="sub">${t.credit.length} transactions</div></div><div class="card"><div class="label">Expenses</div><div class="value">${money(t.exp)}</div><div class="sub">Selected period</div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Client Report Publication — ${esc(b.name)}</h3></div><div class="section-body"><p class="status">The structured Report Summary and the Written Report are separate. Review both before publishing.</p><div class="form-grid"><label class="field"><span>Show Report button to Client</span><select id="clientReportVisible"><option value="no" ${r.visible?'':'selected'}>Hide</option><option value="yes" ${r.visible?'selected':''}>Show</option></select></label><label class="field"><span>Publication status</span><select id="clientReportPublished"><option value="no" ${r.published?'':'selected'}>Draft — not published</option><option value="yes" ${r.published?'selected':''}>Published</option></select></label></div><div class="actions" style="margin-top:12px"><button class="btn secondary" data-action="generate-client-report">Generate report draft</button><button class="btn green" data-action="save-client-report">Save report controls</button><button class="btn" data-action="publish-client-report">Publish report</button></div><div class="notice" style="margin-top:12px">${r.published?'A report is currently published.':'No report is currently published.'} ${r.visible?'The Client Report button is enabled.':'The Client Report button is hidden.'}</div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Report Summary — ${esc(b.name)}</h3></div><div class="section-body"><table class="table"><tr><td>Report period</td><td class="right">${periodLabel()}</td></tr><tr><td>Total sales transactions</td><td class="right">${t.sales.length}</td></tr><tr><td>Fully paid sales</td><td class="right">${t.cashSales.length}</td></tr><tr><td>Sales with outstanding balance</td><td class="right">${t.credit.length}</td></tr><tr><td>Total credit sales</td><td class="right">${money(t.creditTotal)}</td></tr><tr><td>Amount received</td><td class="right">${money(t.amountReceived)}</td></tr><tr><td>Debtor payments received</td><td class="right">${money(t.payments)}</td></tr><tr><td>Total expenses</td><td class="right">${money(t.exp)}</td></tr><tr><td>Highest-selling product</td><td class="right">${esc(ranked[0]?.[0]||'—')}</td></tr><tr><td>Lowest-selling product</td><td class="right">${esc(ranked.length?ranked[ranked.length-1][0]:'—')}</td></tr><tr><td>Best customer (sales value)</td><td class="right">${esc(best?.[0]||'—')}</td></tr></table><div class="section" style="margin-top:14px"><div class="section-head"><h3>Products Sold</h3><span class="status">${esc(periodLabel())}</span></div><div class="section-body"><table class="table"><thead><tr><th>Product</th><th class="right">Quantity</th></tr></thead><tbody>${ranked.map(([name,qty])=>`<tr><td>${esc(name)}</td><td class="right">${qty}</td></tr>`).join('')||'<tr><td colspan="2" class="empty">No product sales in this period.</td></tr>'}</tbody></table></div></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Written Report</h3><span class="status">Manual client write-up</span></div><div class="section-body"><p class="status">Write anything you observed while managing this client’s data — explanations, concerns, follow-up notes, recommendations, unusual activity, or other context for the client to read.</p><textarea id="clientWrittenReport" rows="9" placeholder="Write your report here...">${esc(written)}</textarea><div class="actions" style="margin-top:10px"><button class="btn green" data-action="save-written-report">Save Written Report</button></div><div class="notice" style="margin-top:10px">${written?'A written report is saved for this reporting period.':'No written report has been saved yet.'}</div></div></div>`}
function renderReconciliation(){const rows=(db.reconciliations||[]).filter(x=>x.businessId===db.activeBusinessId).sort((a,b)=>b.createdAt.localeCompare(a.createdAt));document.getElementById('page-reconciliation').innerHTML=`<div class="notice">Complete this process at the end of each business day. Differences are preserved in the audit trail; only Major Admin can approve sensitive corrections.</div><div class="section"><div class="section-head"><h3>Daily Reconciliation — ${esc(biz().name)}</h3><button class="btn" data-action="new-reconciliation">+ Start Day-End Reconciliation</button></div><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Type</th><th>Expected</th><th>Actual</th><th>Difference</th><th>Submitted By</th><th>Status</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${esc(r.date)}</td><td>${esc(r.type)}</td><td>${money(r.expected)}</td><td>${money(r.actual)}</td><td class="${r.difference?'red-text':'green-text'}">${money(r.difference)}</td><td>${esc(r.actorName)}</td><td>${esc(r.status)}</td></tr>`).join('')||'<tr><td colspan="7" class="empty">No reconciliations recorded yet.</td></tr>'}</tbody></table></div></div></div>`}
function renderAudit(){const rows=(db.auditTrail||[]).filter(x=>x.businessId===db.activeBusinessId||!x.businessId);const me=db.admins.find(x=>x.id===currentAdminId);const full=me?.role==='major'||me?.role==='owner';document.getElementById('page-audit').innerHTML=`<div class="notice">Audit records are append-only within this app dataset. Full audit history is intended for Business Owner and Major Admin; Supervisors should use relevant operational records.</div><div class="section"><div class="section-head"><h3>${full?'Full Audit Trail':'Relevant Operational Records'}</h3></div><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Date/Time</th><th>User</th><th>Role</th><th>Action</th><th>Details</th><th>Severity</th></tr></thead><tbody>${rows.filter(x=>full||!['security','sensitive'].includes(x.severity)).map(x=>`<tr><td>${esc(new Date(x.at).toLocaleString())}</td><td>${esc(x.actorName)}</td><td>${esc(x.role)}</td><td>${esc(x.action)}</td><td>${esc(x.details)}</td><td>${esc(x.severity)}</td></tr>`).join('')||'<tr><td colspan="6" class="empty">No audit events recorded yet.</td></tr>'}</tbody></table></div></div></div>`}
function onlineConfig(){try{return JSON.parse(localStorage.getItem('tbc_v4_online_config'))||{url:'',key:'',auto:false,status:'Not connected'}}catch(e){return{url:'',key:'',auto:false,status:'Not connected'}}}
function setOnlineConfig(c){localStorage.setItem('tbc_v4_online_config',JSON.stringify(c))}
function snapshotForBusiness(bid){const b=db.businesses.find(x=>x.id===bid);const branches=(db.branches||[]).filter(x=>x.businessId===bid);return{version:8,business:b||null,header:b?.header||null,clientReport:b?.clientReport||{visible:false,published:false,content:null},branches,products:db.products.filter(x=>x.businessId===bid),customers:db.customers.filter(x=>x.businessId===bid),sales:db.sales.filter(x=>x.businessId===bid),payments:db.payments.filter(x=>x.businessId===bid),expenses:db.expenses.filter(x=>x.businessId===bid),stockMovements:(db.stockMovements||[]).filter(x=>x.businessId===bid),reconciliations:(db.reconciliations||[]).filter(x=>x.businessId===bid),generatedAt:new Date().toISOString()}}
async function onlineRequest(path,opts={}){const c=onlineConfig();if(!c.url||!c.key)throw new Error('Supabase URL and anon/publishable key are required.');let base=c.url.trim().replace(/\/$/,'');base=base.replace(/\/dashboard\/.*$/,'').replace(/\/project\/[^/]+.*$/,'');if(!/^https:\/\/[^/]+\.supabase\.co$/.test(base))throw new Error('Project URL format should be https://YOUR-PROJECT-REF.supabase.co');return fetch(base+path,{...opts,headers:{'apikey':c.key.trim(),'Authorization':'Bearer '+c.key.trim(),'Content-Type':'application/json','Accept':'application/json',...(opts.headers||{})}})}
async function testOnline(){const c=onlineConfig();if(!c.url||!c.key)throw new Error('Enter the Supabase Project URL and anon/publishable key first.');const health=await onlineRequest('/auth/v1/health');if(!health.ok)throw new Error('Supabase URL/key check failed ('+health.status+'). Make sure you copied the Project URL, not the dashboard URL, and copied the Publishable/Anon key.');const r=await onlineRequest('/rest/v1/client_feeds?select=feed_id&limit=1');if(!r.ok){let detail='';try{detail=(await r.text()).slice(0,180)}catch(e){}throw new Error('Supabase is reachable, but the database API returned '+r.status+'. '+(detail||'Make sure Data API is enabled and the client_feeds table/policy was created.'));}return true}
async function publishBusiness(){const s=snapshotForBusiness(db.activeBusinessId), b=s.business;if(!b||!b.clientFeedId||!b.name)throw new Error('Create and save a business before publishing a Client Feed.');const r=await onlineRequest('/rest/v1/client_feeds?on_conflict=feed_id',{method:'POST',headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},body:JSON.stringify({feed_id:b.clientFeedId,business_name:b.name,payload:s,updated_at:new Date().toISOString()})});if(!r.ok)throw new Error(await r.text());return true}
function updateOnlineBadge(){const c=onlineConfig();const el=document.getElementById('onlineBadge');if(!el)return;el.textContent=c.url&&c.key?'● Online Ready':'● Not Connected';el.style.background=c.url&&c.key?'#dcfce7':'#e2e8f0';el.style.color=c.url&&c.key?'#166534':'#475569'}
async function autoSync(){const c=onlineConfig();if(!c.auto||!c.url||!c.key)return;try{await publishBusiness();const x=onlineConfig();x.status='Last sync: '+new Date().toLocaleTimeString();setOnlineConfig(x);updateOnlineBadge()}catch(e){const x=onlineConfig();x.status='Sync error: '+e.message;setOnlineConfig(x)}}
let onlineTimer=setInterval(autoSync,5000);
function renderClientAppView(){
  const b=biz(), page=document.getElementById('page-clientview');
  if(!page)return;
  const snap=snapshotForBusiness(db.activeBusinessId);
  const safeJson=JSON.stringify(snap).replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/&/g,'\\u0026');
  page.innerHTML=`<div class="client-view-shell"><div class="client-view-head"><div><h3>Client App View</h3><p>Exact Client App design using the selected business's published feed data.</p></div><div class="client-view-meta"><span class="badge">${esc(b.name)}</span><span class="badge">Feed: ${esc(b.clientFeedId)}</span></div></div><div class="notice client-view-note"><b>Preview:</b> This is a read-only replica of the Client App. It does not create sales, expenses, stock changes, or messages.</div><div class="client-view-frame-wrap"><iframe id="clientAppPreviewFrame" class="client-view-frame" title="Client App View" sandbox="allow-scripts allow-forms allow-modals"></iframe></div></div>`;
  const frame=document.getElementById('clientAppPreviewFrame');
  if(!frame)return;
  const boot='<script>window.__TBC_PREVIEW_DATA__='+safeJson+';window.__TBC_PREVIEW_MODE__=true;<\/script>';
  frame.srcdoc=CLIENT_APP_VIEW_SOURCE.replace('</head>',boot+'</head>');
}

function renderSettings(){const b=biz(),me=db.admins.find(a=>a.id===currentAdminId)||{role:'major'};const cfg=onlineConfig();document.getElementById('page-settings').innerHTML=`<div class="grid2"><div class="section"><div class="section-head"><h3>Current Business</h3></div><div class="section-body"><table class="table"><tr><td>Name</td><td class="right">${esc(b.name)}</td></tr><tr><td>Type</td><td class="right">${esc(b.type)}</td></tr><tr><td>Currency</td><td class="right">${esc(b.currency)}</td></tr><tr><td>Client Feed ID</td><td class="right"><b>${esc(b.clientFeedId)}</b></td></tr><tr><td>Your Access</td><td class="right">${me.role==='major'?'All Businesses':'Assigned Business'}</td></tr></table></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Client App Header Management</h3></div><div class="section-body"><p class="status">Create, adjust, show/hide, or clear the information displayed in the Client App header. Changes are included in the selected business Client Feed.</p><div class="form-grid"><label class="field"><span>Additional Header Name</span><input id="hdrBrand" value="${esc(b.header?.brand??'')}"></label><label class="field"><span>Subtitle</span><input id="hdrSub" value="${esc(b.header?.sub??'')}"></label><label class="field"><span>Read-only Notice</span><input id="hdrReadonly" value="${esc(b.header?.readonly??"OWNER'S VIEW")}"></label><label class="field"><span>Install Button Text</span><input id="hdrInstall" value="${esc(b.header?.install??'Chat Admin')}"></label><label class="field full"><span>Install Button</span><select id="hdrShowInstall"><option value="yes" ${(b.header?.showInstall!==false)?'selected':''}>Show</option><option value="no" ${(b.header?.showInstall===false)?'selected':''}>Hide</option></select></label></div><div class="actions"><button class="btn" data-action="save-header">Save Header</button><button class="btn danger" data-action="clear-header">Clear Header</button></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Online Connection Center</h3></div><div class="section-body"><p class="status">Connect this Admin App to the shared online database. The selected business is published under its own Client Feed ID. No business can read another business's feed.</p><div class="form-grid"><label class="field full">Supabase Project URL<input id="sbUrl" value="${esc(cfg.url)}" placeholder="https://your-project.supabase.co"></label><label class="field full">Supabase Anon Key<input id="sbKey" type="password" value="${esc(cfg.key)}" placeholder="Paste your anon/public key"></label><label class="field"><span>Auto Sync</span><select id="autoSync"><option value="off" ${cfg.auto?'':'selected'}>Off</option><option value="on" ${cfg.auto?'selected':''}>Every 5 seconds</option></select></label></div><div class="actions"><button class="btn primary" data-action="save-online-config">Save Connection</button><button class="btn secondary" data-action="test-online">Test Connection</button><button class="btn secondary" data-action="publish-business">Publish Current Business</button></div><div id="onlineStatus" class="status" style="margin-top:10px">${esc(cfg.status||'Not connected')}</div></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Client Feed</h3></div><div class="section-body"><p class="status">Client Feed ID: <b>${esc(b.clientFeedId||'Create a business first')}</b>. Each business receives its own feed when created.</p><div class="actions"><button class="btn secondary" data-action="copy-feed">Copy Feed ID</button><button class="btn secondary" data-action="export-feed">Export Current Business Feed JSON</button></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Data Export</h3></div><div class="section-body"><p class="status">Export the records currently entered in this app. A new installation starts without sample businesses or demo records.</p><div class="actions"><button class="btn secondary" data-action="export">Export JSON</button></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Major Admin Password</h3></div><div class="section-body"><p class="status">Set a password used specifically to approve Clear All Data operations. Administrator and staff accounts are never removed by the clearing tool. This password is stored as a salted hash in this app's local browser storage.</p><div class="actions"><button class="btn secondary" data-action="setup-clear-password">${clearPasswordConfigured()?'Change Password':'Set Major Admin Password'}</button><span class="badge">${clearPasswordConfigured()?'Password configured':'Setup required'}</span></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Clear All Data</h3></div><div class="section-body"><div class="warning"><b>Permanent action.</b> Each operation requires the Major Admin password and a second confirmation. Major Admin and staff accounts are preserved.</div><p class="status">Choose to clear everything, business records only, or selected categories. For a completely clean start, choose Everything. The app will not create a placeholder business. Cleared data will be republished to each configured Client Feed when online sync is available.</p><button class="btn danger" data-action="clear-data">Clear All Data…</button></div></div></div>${me.role==='major'?`<div class="section" style="margin-top:14px"><div class="section-head"><h3>Staff Permissions</h3></div><div class="section-body"><p class="status">Select a staff member and tick the pages and actions they are allowed to access. Major Admin permissions cannot be reduced here.</p><div class="field" style="max-width:460px;margin-bottom:14px"><label for="permissionStaffSelect">Select Staff</label><select id="permissionStaffSelect"><option value="">Choose staff member</option>${db.admins.filter(a=>a.role!=='major').map(a=>`<option value="${a.id}" ${a.id===permissionStaffId?'selected':''}>${esc(a.name)} — ${esc(a.role)}</option>`).join('')}</select></div><div id="permissionEditor"></div></div></div>`:''}`;if(me.role==='major'){const ps=document.getElementById('permissionStaffSelect');if(ps){ps.addEventListener('change',()=>{permissionStaffId=ps.value;renderPermissionEditor()});renderPermissionEditor()}}}

let permissionStaffId='';
function renderPermissionEditor(){const host=document.getElementById('permissionEditor');if(!host)return;const a=db.admins.find(x=>x.id===permissionStaffId&&x.role!=='major');if(!a){host.innerHTML='<div class="status">Choose a staff member to configure their permissions.</div>';return;}const defaults=rolePermissionDefaults(a.role);const current={...defaults,...(a.permissions||{})};host.innerHTML=`${PERMISSION_GROUPS.map(g=>`<div class="section" style="margin:10px 0"><div class="section-head"><h4>${esc(g.title)}</h4></div><div class="section-body"><div class="form-grid">${g.items.map(([key,label])=>`<label class="field" style="display:flex;align-items:center;gap:9px;flex-direction:row"><input type="checkbox" data-permission="${key}" ${current[key]?'checked':''} style="width:auto;min-width:18px"><span>${esc(label)}</span></label>`).join('')}</div></div></div>`).join('')}<div class="toolbar"><span class="status">Permissions are saved for the selected staff account.</span><button class="btn" id="saveStaffPermissions">Save Permissions</button></div>`;document.getElementById('saveStaffPermissions').onclick=()=>{const permissions={};ALL_PERMISSION_KEYS.forEach(k=>{const el=host.querySelector(`[data-permission="${k}"]`);permissions[k]=!!el?.checked});a.permissions=permissions;a.permissionsCustomized=true;a.permissionsUpdatedAt=new Date().toISOString();auditEvent('Staff permissions updated',`${a.name}; ${ALL_PERMISSION_KEYS.filter(k=>permissions[k]).length} permissions enabled`,'security');save();alert('Staff permissions saved. The selected staff member will now see only their permitted pages and actions.');renderPermissionEditor();if(currentAdminId===a.id)render();};}

function openModal(title,body,saveFn){document.getElementById('modalTitle').textContent=title;document.getElementById('modalBody').innerHTML=body;document.getElementById('modalFoot').innerHTML='<button class="btn secondary" id="cancelModal">Cancel</button><button class="btn" id="saveModal">Save</button>';document.getElementById('modal').classList.add('open');document.getElementById('cancelModal').onclick=closeModal;document.getElementById('saveModal').onclick=async()=>{const b=document.getElementById('saveModal');if(b.disabled)return;b.disabled=true;b.textContent='Saving…';try{const result=await saveFn();if(result!==false)closeModal()}catch(e){alert(e?.message||String(e))}finally{if(document.getElementById('saveModal')){document.getElementById('saveModal').disabled=false;document.getElementById('saveModal').textContent='Save'}}}}function closeModal(){document.getElementById('modal').classList.remove('open')}
function formBusiness(b){b=b||{name:'',type:'',phone:'',address:'',active:true};return `<div class="form-grid"><div class="field"><label>Business Name</label><input id="fName" value="${esc(b.name)}"></div><div class="field"><label>Business Type</label><input id="fType" value="${esc(b.type)}" placeholder="e.g. Electronics Retail"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(b.phone)}"></div><div class="field"><label>Currency</label><input id="fCurrency" value="${esc(b.currency||'NGN')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(b.address)}"></div></div>`}
function formAdmin(a){a=a||{name:'',email:'',active:true,businessIds:[]};return `<div class="form-grid"><div class="field"><label>Admin Name</label><input id="fName" value="${esc(a.name)}"></div><div class="field"><label>Email / Username</label><input id="fEmail" value="${esc(a.email)}"></div><div class="field full"><label>Business Access — select one or more</label><div style="display:grid;gap:8px">${db.businesses.map(b=>`<label style="font-weight:400;color:#182230"><input type="checkbox" class="biz-check" value="${b.id}" ${a.businessIds.includes(b.id)?'checked':''}> ${esc(b.name)} ${!b.active?'(inactive)':''}</label>`).join('')}</div></div></div>`}
function paymentStatus(s){
  const total=Number(s?.total||0), paid=Math.max(0,Math.min(Number(s?.paid||0),total));
  if(total<=0 || paid>=total) return 'Cash';
  if(paid>0) return 'Partly Credit';
  return 'Credit';
}
function saleOutstanding(s){return Math.max(0,Number(s?.total||0)-Number(s?.paid||0));}
function customerOutstanding(customerId){
  if(!customerId) return 0;
  const soldOutstanding=scoped(db.sales).filter(s=>s.customerId===customerId)
    .reduce((a,s)=>a+saleOutstanding(s),0);
  const debtorPayments=scoped(db.payments).filter(p=>p.customerId===customerId)
    .reduce((a,p)=>a+Number(p.amount||0),0);
  return Math.max(0,soldOutstanding-debtorPayments);
}
function customerOptions(sel=''){
  const owing=scoped(db.customers).filter(c=>customerOutstanding(c.id)>0);
  return '<option value="">Select Debtor</option>'+owing.map(c=>`<option value="${c.id}" ${c.id===sel?'selected':''}>${esc(c.name)}</option>`).join('')
}
function productOptions(sel=''){const bid=window.getActiveBranchId?.()||'all';return '<option value="">Select Item</option>'+scoped(db.products).filter(p=>p.id===sel||(bid==='all'?productStockAcrossBranches(p)>0:globalProductStockAt(p,bid)>0)).map(p=>`<option value="${p.id}" ${p.id===sel?'selected':''}>${esc(p.name)} — ${money(p.sell)}</option>`).join('')}
function saleProductOptions(sel='',rowIndex=0){const selected=new Set((saleDraftItems||[]).map((x,i)=>i===rowIndex?'':x.productId).filter(Boolean));const bid=window.getActiveBranchId?.()||'all';return '<option value="">Select Item</option>'+scoped(db.products).filter(p=>(p.id===sel||!selected.has(p.id))&&(p.id===sel||(bid==='all'?productStockAcrossBranches(p)>0:globalProductStockAt(p,bid)>0))).map(p=>`<option value="${p.id}" ${p.id===sel?'selected':''}>${esc(p.name)} — ${money(p.sell)}</option>`).join('')}
function branchOptions(sel=''){const brs=branchesFor(db.activeBusinessId);const locked=typeof activeBranchId!=='undefined'&&activeBranchId!=='all';const preferred=locked?activeBranchId:(sel||((brs.length===1)?brs[0].id:''));const available=locked?brs.filter(b=>String(b.id)===String(activeBranchId)):brs;return '<option value="">Select Branch</option>'+available.map(b=>`<option value="${b.id}" ${String(b.id)===String(preferred)?'selected':''}>${esc(b.name)}</option>`).join('')} function branchSelectAttrs(){return (typeof activeBranchId!=='undefined'&&activeBranchId!=='all')?' disabled title="Locked to the branch selected on the Home screen"':''}

function itemRow(x,i){return `<div class="item-row"><select class="i-prod" data-i="${i}">${productOptions(x.productId)}</select><input class="i-qty" data-i="${i}" type="number" min="1" value="${x.qty}"><input class="i-price" data-i="${i}" type="number" min="0" value="${x.price}"><button type="button" class="remove-item" data-remove="${i}">×</button></div>`}
function saleForm(s){s=s||{customerId:'',date:today,type:'cash',paid:0,items:[{productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0}]};return `<div class="form-grid"><div class="field"><label>Customer</label><select id="fCustomer">${customerOptions(s.customerId)}</select></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${s.date}"></div><div class="field"><label>Payment Status</label><div id="fPaymentStatus" class="status">${paymentStatus(s)}</div></div><div class="field"><label>Initial Payment</label><input id="fPaid" type="number" min="0" value="${s.paid||0}"></div><div class="field full"><label>Sale Items — multiple items supported</label><div id="items">${s.items.map(itemRow).join('')}</div><button type="button" class="btn secondary small" id="addItem">+ Add Item</button></div></div>`}
function collectItems(){return [...document.querySelectorAll('.item-row')].map(r=>{const p=r.querySelector('.i-prod').value,q=Number(r.querySelector('.i-qty').value||0),pr=Number(r.querySelector('.i-price').value||0);return{productId:p,qty:q,price:pr}}).filter(x=>x.productId&&x.qty>0)}
function newSale(existing){openModal(existing?'Edit Sale':'New Sale',saleForm(existing),()=>{const items=collectItems();if(!items.length)return alert('Add at least one item.');const total=items.reduce((a,x)=>a+x.qty*x.price,0);if(existing){Object.assign(existing,{customerId:document.getElementById('fCustomer').value,date:document.getElementById('fDate').value,type:paymentStatus({total,paid:Number(document.getElementById('fPaid').value||0)}).toLowerCase().replace(' ','_'),paid:Number(document.getElementById('fPaid').value||0),items,total})}else db.sales.push({id:id(),businessId:db.activeBusinessId,customerId:document.getElementById('fCustomer').value,date:document.getElementById('fDate').value,type:paymentStatus({total,paid:Number(document.getElementById('fPaid').value||0)}).toLowerCase().replace(' ','_'),paid:Number(document.getElementById('fPaid').value||0),items,total,createdBy:currentAdminId});render();return true})}
function newCustomer(existing){openModal(existing?'Edit Customer':'New Customer',`<div class="form-grid"><div class="field"><label>Name</label><input id="fName" value="${esc(existing?.name||'')}"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(existing?.phone||'')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(existing?.address||'')}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim();if(!name)return false;if(existing)Object.assign(existing,{name,phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value});else db.customers.push({id:id(),businessId:db.activeBusinessId,name,phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value,opening:0});render();return true})}
function newExpense(existing){openModal(existing?'Edit Expense':'New Expense',`<div class="form-grid"><div class="field"><label>Description</label><input id="fDesc" value="${esc(existing?.description||'')}"></div><div class="field"><label>Amount</label><input id="fAmount" type="number" value="${existing?.amount||''}"></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${existing?.date||today}"></div><div class="field"><label>Person / Vendor Paid</label><input id="fVendor" value="${esc(existing?.vendor||'')}"></div><div class="field"><label>Payment Method</label><select id="fMethod"><option>Cash</option><option>Transfer</option><option>Bank</option></select></div><div class="field full"><label>Notes</label><textarea id="fNotes">${esc(existing?.notes||'')}</textarea></div></div>`,()=>{const o={description:document.getElementById('fDesc').value,amount:Number(document.getElementById('fAmount').value||0),date:document.getElementById('fDate').value,vendor:document.getElementById('fVendor').value,method:document.getElementById('fMethod').value,notes:document.getElementById('fNotes').value};if(!o.description||!o.amount)return false;const active=window.getActiveBranchId?.();o.branchId=(active&&active!=='all'?active:(existing?.branchId||branchesFor(db.activeBusinessId)[0]?.id||''));if(existing)Object.assign(existing,o);else db.expenses.push({id:id(),businessId:db.activeBusinessId,...o,createdBy:currentAdminId});render();return true})}
function ensureBusinessProductName(name){const clean=String(name||'').trim();if(!clean)return;const b=biz();if(!Array.isArray(b.productNameList))b.productNameList=[];if(!b.productNameList.some(n=>String(n).trim().toLowerCase()===clean.toLowerCase()))b.productNameList.push(clean)}
function newProduct(existing){const b=biz();const names=Array.isArray(b.productNameList)?b.productNameList:[];const currentBranch=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():(branchesFor(db.activeBusinessId)[0]?.id||''));const currentPool=globalBranchStockPool(currentBranch);const currentQty=existing?(currentPool.mode==='branch'?Number(existing.branchQty?.[currentPool.id]||0):Number(existing.qty||0)):0;openModal(existing?'Edit Product':'New Product',`<div class="form-grid"><div class="field"><label>Item Name</label><input id="fName" list="businessProductNames" value="${esc(existing?.name||'')}"><datalist id="businessProductNames">${names.map(n=>`<option value="${esc(n)}"></option>`).join('')}</datalist></div><div class="field"><label>Unit</label><input id="fUnit" value="${esc(existing?.unit||'Unit')}"></div><div class="field"><label>Cost Price</label><input id="fCost" type="number" value="${existing?.cost||''}"></div><div class="field"><label>Selling Price</label><input id="fSell" type="number" value="${existing?.sell||''}"></div><div class="field"><label>Quantity to add / opening quantity (${esc(branchesFor(db.activeBusinessId).find(x=>x.id===currentBranch)?.name||'Main Branch')})</label><input id="fQty" type="number" min="0" value="${currentQty}"></div><div class="field"><label>Reorder Level</label><input id="fReorder" type="number" value="${existing?.reorder||0}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim();const qty=Math.max(0,Number(document.getElementById('fQty').value||0));const o={name,unit:document.getElementById('fUnit').value,cost:Number(document.getElementById('fCost').value||0),sell:Number(document.getElementById('fSell').value||0),reorder:Number(document.getElementById('fReorder').value||0)};if(!name)return false;const duplicate=db.products.find(p=>p.businessId===db.activeBusinessId&&p.id!==existing?.id&&String(p.name||'').trim().toLowerCase()===name.toLowerCase());if(duplicate){alert('This product already exists in this business. Edit the existing product instead of creating a duplicate.');return false}const pool=globalBranchStockPool(currentBranch);if(existing){Object.assign(existing,o);if(pool.mode==='branch'){if(!existing.branchQty)existing.branchQty={};existing.branchQty[pool.id]=qty;}else existing.qty=qty;}else{const product={id:id(),businessId:db.activeBusinessId,...o,qty:pool.mode==='branch'?0:qty,branchQty:{}};if(pool.mode==='branch')product.branchQty[pool.id]=qty;db.products.push(product)}ensureBusinessProductName(name);render();return true})}
function newPayment(){
 const owedFor=c=>customerOutstanding(c?.id);
 openModal('Record Debtor Payment',`<div class="form-grid"><div class="field"><label>Customer / Debtor</label><select id="fCustomer">${customerOptions()}</select></div><div class="field"><label>Total Amount Owed</label><input id="fOwed" value="₦0" disabled></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${today}"></div><div class="field"><label>Amount Paid</label><input id="fAmount" type="number" min="0" step="0.01"></div><div class="field"><label>Method</label><select id="fMethod"><option>Cash</option><option>Transfer</option><option>Bank Transfer</option></select></div><div class="field full"><label>Note</label><input id="fNote"></div></div>`,()=>{
   const c=scoped(db.customers).find(v=>v.id===document.getElementById('fCustomer').value);
   if(!c){alert('Please select a debtor.');return false}
   // Branch state lives inside the branch-management module's IIFE.
   // Access it through the public getter instead of referencing the IIFE-local
   // variable directly (which caused ReferenceError and made Save appear dead).
   let paymentBranchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():'');
   if(!paymentBranchId){
     paymentBranchId=c.branchId||'';
     if(!paymentBranchId){
       const brs=branchesFor(db.activeBusinessId);
       if(brs.length===1)paymentBranchId=brs[0].id;
     }
     if(!paymentBranchId){alert('Select a specific branch from the Dashboard before recording a debtor payment.');return false}
   }
   const owed=owedFor(c);
   const amount=Number(document.getElementById('fAmount').value||0);
   if(!amount||amount<0){alert('Enter a valid Amount Paid.');return false}
   if(owed<=0){alert('This customer has no outstanding debt.');return false}
   if(amount>owed){alert(`Amount Paid cannot exceed the Total Amount Owed of ${money(owed)}.`);return false}
   const o={id:id(),businessId:db.activeBusinessId,branchId:paymentBranchId,customerId:c.id,date:document.getElementById('fDate').value,amount,method:document.getElementById('fMethod').value,note:document.getElementById('fNote').value,createdBy:currentAdminId};
   db.payments.push(o);save();render();return true
 });
 const sel=document.getElementById('fCustomer'),owed=document.getElementById('fOwed'),amount=document.getElementById('fAmount');
 const updateOwed=()=>{const c=scoped(db.customers).find(v=>v.id===sel.value);const value=owedFor(c);owed.value=money(value);amount.max=String(value);if(Number(amount.value||0)>value)amount.value=value||'';};
 sel?.addEventListener('change',updateOwed);amount?.addEventListener('input',()=>{const c=scoped(db.customers).find(v=>v.id===sel.value);const value=owedFor(c);if(Number(amount.value||0)>value)amount.value=value||'';});updateOwed();
}
function adjustStock(p){const preferred=typeof activeBranchId!=='undefined'&&activeBranchId!=='all'?activeBranchId:'';if(!preferred){alert('Select a specific branch from the Dashboard before adjusting stock.');return}openModal('Adjust Stock — '+p.name,`<div class="form-grid"><div class="field"><label>Current Quantity</label><input id="fCurrentQty" value="${globalProductStockAt(p,preferred)}" disabled></div><div class="field"><label>Adjustment (+/-)</label><input id="fAdj" type="number" value="0"></div><div class="field full"><label>Reason</label><input id="fReason" placeholder="Received, damaged, lost, correction..."></div></div>`,()=>{const branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():preferred);if(!branchId){alert('Create a business branch before adjusting stock.');return false}const n=Number(document.getElementById('fAdj').value||0),reason=document.getElementById('fReason').value.trim();if(!n||!reason){alert('Enter an adjustment and reason.');return false}const current=globalProductStockAt(p,branchId);if(current+n<0){alert('Stock cannot become negative.');return false}globalAdjustProductStockAt(p,branchId,n);if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:db.activeBusinessId,branchId,productId:p.id,qty:n,type:'manual_adjustment',notes:reason,date:today,createdAt:new Date().toISOString()});auditEvent('Stock adjusted',`${p.name}; branch ${(branchesFor(db.activeBusinessId).find(x=>x.id===branchId)?.name||branchId)}; change ${n}; reason ${reason}`,Math.abs(n)>0?'sensitive':'normal');render();return true})}
const CLEAR_PASSWORD_KEY='tbc_major_admin_clear_password_v1';
function clearPasswordConfigured(){try{return !!JSON.parse(localStorage.getItem(CLEAR_PASSWORD_KEY))?.hash}catch(e){return false}}
function toBase64(bytes){return btoa(String.fromCharCode(...new Uint8Array(bytes)))}
function fromBase64(value){return Uint8Array.from(atob(value),c=>c.charCodeAt(0))}
async function deriveClearPassword(password,salt){if(!crypto?.subtle)throw new Error('Secure password verification is not available in this browser. Please open the app in an up-to-date Chrome browser.');const material=await crypto.subtle.importKey('raw',new TextEncoder().encode(password),'PBKDF2',false,['deriveBits']);const bits=await crypto.subtle.deriveBits({name:'PBKDF2',salt,iterations:150000,hash:'SHA-256'},material,256);return toBase64(bits)}
async function storeClearPassword(password){const salt=crypto.getRandomValues(new Uint8Array(16));const hash=await deriveClearPassword(password,salt);localStorage.setItem(CLEAR_PASSWORD_KEY,JSON.stringify({salt:toBase64(salt),hash,iterations:150000,algorithm:'PBKDF2-SHA-256'}))}
async function verifyClearPassword(password){let saved;try{saved=JSON.parse(localStorage.getItem(CLEAR_PASSWORD_KEY))}catch(e){}if(!saved?.salt||!saved?.hash)return false;const hash=await deriveClearPassword(password,fromBase64(saved.salt));return hash===saved.hash}
async function setupClearPassword(){const me=db.admins.find(a=>a.id===currentAdminId);if(!me||me.role!=='major'){alert('Only the Major Admin can set or change this password.');return}const configured=clearPasswordConfigured();openModal(configured?'Change Major Admin Password':'Set Major Admin Password',`<div class="warning">This password is used to approve data-clearing operations. It does not replace an app login.</div><div class="form-grid"><label class="field full"><span>${configured?'Current Password':'Major Admin Confirmation: type MAJOR ADMIN'}</span><input id="clearCurrent" type="${configured?'password':'text'}" autocomplete="current-password" placeholder="${configured?'Enter current password':'Type MAJOR ADMIN'}" required></label><label class="field full"><span>New Password (at least 8 characters)</span><input id="clearNew" type="password" autocomplete="new-password" minlength="8" required></label><label class="field full"><span>Confirm New Password</span><input id="clearConfirm" type="password" autocomplete="new-password" minlength="8" required></label></div>`,async()=>{const current=document.getElementById('clearCurrent').value;const next=document.getElementById('clearNew').value;const confirmNext=document.getElementById('clearConfirm').value;if(configured){if(!await verifyClearPassword(current)){alert('Current password is incorrect.');return false}}else if(current.trim()!=='MAJOR ADMIN'){alert('Type MAJOR ADMIN to confirm you are setting the Major Admin password.');return false}if(next.length<8){alert('Use at least 8 characters for the password.');return false}if(next!==confirmNext){alert('The new passwords do not match.');return false}await storeClearPassword(next);alert('Major Admin password saved.');render();return true})}
function clearCategories(mode){if(mode==='everything')return ['sales','customers','products','payments','expenses','stockMovements','businessSetup'];if(mode==='records')return ['sales','payments','expenses','stockMovements'];return Array.from(document.querySelectorAll('.clear-category:checked')).map(x=>x.value)}
function clearDataDialog(){const me=db.admins.find(a=>a.id===currentAdminId);if(!me||me.role!=='major'){alert('Only the Major Admin can clear data.');return}if(!clearPasswordConfigured()){alert('Set the Major Admin password in Settings before clearing data.');return}openModal('Clear All Data',`<div class="warning"><b>This cannot be undone.</b> Major Admin and staff accounts will be retained. Everything removes all businesses, branches and business records; accounts remain. Add a business when ready. Administrator and staff accounts remain.</div><div style="display:grid;gap:10px;margin-bottom:16px"><label><input type="radio" name="clearScope" value="everything" checked> <b>Everything</b> — clear all business records and setup, then create a blank workspace. Accounts remain.</label><label><input type="radio" name="clearScope" value="records"> <b>Business Records Only</b> — remove sales, debtor payments, expenses and stock history; retain products, quantities and customers.</label><label><input type="radio" name="clearScope" value="selected"> <b>Selected Data Only</b> — choose categories below.</label></div><div id="clearSelectedCategories" class="form-grid" style="margin-bottom:16px;display:none"><label><input class="clear-category" type="checkbox" value="sales"> Sales</label><label><input class="clear-category" type="checkbox" value="customers"> Customers</label><label><input class="clear-category" type="checkbox" value="products"> Products & stock</label><label><input class="clear-category" type="checkbox" value="payments"> Debtor payments</label><label><input class="clear-category" type="checkbox" value="expenses"> Expenses</label><label><input class="clear-category" type="checkbox" value="stockMovements"> Stock history</label></div><div class="form-grid"><label class="field full"><span>Major Admin Password</span><input id="clearApprovalPassword" type="password" autocomplete="current-password" required></label><label class="field full"><span>Type CLEAR to confirm</span><input id="clearFinalConfirm" placeholder="Type CLEAR" autocomplete="off" required></label></div>`,async()=>{const scope=document.querySelector('input[name="clearScope"]:checked')?.value||'everything';const keys=clearCategories(scope);if(scope==='selected'&&!keys.length){alert('Select at least one data category.');return false}const password=document.getElementById('clearApprovalPassword').value;if(!await verifyClearPassword(password)){alert('Major Admin password is incorrect. No data was cleared.');return false}if(document.getElementById('clearFinalConfirm').value.trim()!=='CLEAR'){alert('Type CLEAR exactly to confirm this permanent action.');return false}if(!confirm('FINAL WARNING: The selected data will be permanently removed from this app. Continue?'))return false;await executeClearData(keys);alert('Selected data has been cleared. Administrator and staff accounts were preserved.');render();return true});document.querySelectorAll('input[name="clearScope"]').forEach(r=>r.addEventListener('change',()=>{document.getElementById('clearSelectedCategories').style.display=document.querySelector('input[name="clearScope"]:checked')?.value==='selected'?'grid':'none'}))}
async function executeClearData(keys){const clearSet=new Set(keys);if(clearSet.has('sales'))db.sales=[];if(clearSet.has('payments'))db.payments=[];if(clearSet.has('expenses'))db.expenses=[];if(clearSet.has('stockMovements'))db.stockMovements=[];if(clearSet.has('customers')){const removedIds=new Set(db.customers.map(c=>c.id));db.customers=[];db.sales=(db.sales||[]).filter(s=>!removedIds.has(s.customerId));db.payments=(db.payments||[]).filter(p=>!removedIds.has(p.customerId))}if(clearSet.has('products')){db.products=[];db.stockMovements=[]}if(clearSet.has('businessSetup')){db.businesses=[];db.branches=[];db.products=[];db.customers=[];db.sales=[];db.payments=[];db.expenses=[];db.stockMovements=[];db.activeBusinessId='';db.admins.forEach(a=>{a.businessIds=[];a.branchIds=[]});if(typeof window.resetBranchSelection==='function')window.resetBranchSelection();currentPage='businesses'}save();const cfg=onlineConfig();if(cfg.url&&cfg.key&&typeof publishBusiness==='function'){const original=db.activeBusinessId;for(const b of (db.businesses||[])){db.activeBusinessId=b.id;try{await publishBusiness()}catch(e){console.warn('Could not publish cleared feed for '+b.name+': '+e.message)}}db.activeBusinessId=original;save()}}
function handle(action,el){
 if(action==='setup-clear-password'){setupClearPassword();return}
 if(action==='save-new-product-form'){saveNewProductFromStockForm();return}
 if(action==='close-stock-details'){document.querySelector(`tr[data-stock-details-for="${el.dataset.id}"]`)?.remove();return}
 if(action==='clear-data'){clearDataDialog();return}
 if(action==='save-header'){const b=biz();b.header={brand:document.getElementById('hdrBrand').value.trim(),sub:document.getElementById('hdrSub').value.trim(),readonly:document.getElementById('hdrReadonly').value.trim(),install:document.getElementById('hdrInstall').value.trim()||'Chat Admin',showInstall:document.getElementById('hdrShowInstall').value==='yes'};save();publishBusiness().catch(()=>{});render();return}
 if(action==='refresh-messages'){const b=el;b.disabled=true;b.textContent='Refreshing…';loadAdminMessages().finally(()=>{if(b&&b.isConnected){b.disabled=false;b.textContent='Refresh'}});return}
 if(action==='mark-message-read'){(async()=>{try{const r=await adminMessagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(el.dataset.id),{method:'PATCH',body:JSON.stringify({read_at:new Date().toISOString()})});if(!r.ok)throw new Error(await r.text());await loadAdminMessages();alert('Message marked as read.')}catch(e){alert('Unable to mark message as read: '+e.message)}})();return}
 if(action==='reply-client-message'){replyClientMessage(el.dataset.id).catch(e=>alert(e.message));return}
 if(action==='clear-header'){const b=biz();if(!confirm('Clear all configurable Client App header information for this business? The Business Name will not be changed.'))return;b.header={brand:'',sub:'',readonly:"OWNER'S VIEW",install:'Chat Admin',showInstall:false};save();render();return}
 if(action==='save-online-config'){const url=document.getElementById('sbUrl').value.trim(),key=document.getElementById('sbKey').value.trim(),auto=document.getElementById('autoSync').value==='on';setOnlineConfig({url,key,auto,status:url&&key?'Saved. Ready to connect.':'Not connected'});updateOnlineBadge();render();return}
 if(action==='test-online'){testOnline().then(()=>{const c=onlineConfig();c.status='Connection successful.';setOnlineConfig(c);render()}).catch(e=>{const c=onlineConfig();c.status=e.message;setOnlineConfig(c);render()});return}
 if(action==='publish-business'){publishBusiness().then(()=>{const c=onlineConfig();c.status='Published '+biz().name+' at '+new Date().toLocaleTimeString();setOnlineConfig(c);render()}).catch(e=>{const c=onlineConfig();c.status=e.message;setOnlineConfig(c);render()});return}
 if(action==='copy-feed'){navigator.clipboard?.writeText(biz().clientFeedId);return}
 if(action==='export-feed'){const blob=new Blob([JSON.stringify(snapshotForBusiness(db.activeBusinessId),null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=biz().clientFeedId+'.json';a.click();return}
const x=el.dataset.id;
 if(action==='select-business'){const b=db.businesses.find(b=>b.id===x);if(b?.active&&allowedBusiness(x)){db.activeBusinessId=x;currentPage='dashboard';render()}}
 else if(action==='toggle-business'){const b=db.businesses.find(b=>b.id===x);if(!b)return;b.active=!b.active;if(!b.active&&db.activeBusinessId===x){const alt=db.businesses.find(z=>z.active&&allowedBusiness(z.id)&&z.id!==x);if(alt)db.activeBusinessId=alt.id}render()}
 else if(action==='new-business'||action==='edit-business'){if(db.admins.find(a=>a.id===currentAdminId)?.role!=='major')return alert('Only the Major Admin can manage businesses.');const b=action==='edit-business'?db.businesses.find(b=>b.id===x):null;openModal(b?'Edit Business':'Add Business',formBusiness(b),()=>{const o={name:document.getElementById('fName').value.trim(),type:document.getElementById('fType').value.trim(),phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value,currency:document.getElementById('fCurrency').value||'NGN'};if(!o.name||!o.type)return false;if(b)Object.assign(b,o);else{const nb={id:id(),...o,active:true,clientFeedId:'CLIENT-'+Math.random().toString(36).slice(2,8).toUpperCase(),header:{businessName:o.name,brand:'',sub:o.type,readonly:"OWNER'S VIEW",install:'Chat Admin',showInstall:true},clientReport:{visible:false,published:false,content:null},productNameList:[]};db.businesses.push(nb);db.activeBusinessId=nb.id;db.admins.find(a=>a.role==='major')?.businessIds.push(nb.id)}render();return true})}
 else if(action==='new-admin'||action==='edit-admin'){if(db.admins.find(a=>a.id===currentAdminId)?.role!=='major')return alert('Only the Major Admin can manage Admin Access.');const a=action==='edit-admin'?db.admins.find(a=>a.id===x):null;openModal(a?'Edit Admin Access':'Add Admin',formAdmin(a),()=>{const ids=[...document.querySelectorAll('.biz-check:checked')].map(c=>c.value);if(!ids.length)return alert('Assign at least one business.');const o={name:document.getElementById('fName').value.trim(),email:document.getElementById('fEmail').value.trim()};if(!o.name||!o.email)return false;if(a)Object.assign(a,o,{businessIds:ids});else db.admins.push({id:id(),...o,role:'admin',active:true,businessIds:ids});render();return true})}
 else if(action==='toggle-admin'){const a=db.admins.find(a=>a.id===x);if(a){a.active=!a.active;render()}}
 else if(action==='new-sale')newSale(); else if(action==='edit-sale')newSale(db.sales.find(s=>s.id===x)); else if(action==='delete-sale'){if(confirm('Delete this sale?')){db.sales=db.sales.filter(s=>s.id!==x);render()}}
 else if(action==='new-customer')newCustomer(); else if(action==='edit-customer')newCustomer(db.customers.find(c=>c.id===x));
 else if(action==='new-payment')newPayment(); else if(action==='delete-payment'){if(confirm('Delete this payment?')){db.payments=db.payments.filter(p=>p.id!==x);render()}}
 else if(action==='new-expense')newExpense(); else if(action==='edit-expense')newExpense(db.expenses.find(e=>e.id===x)); else if(action==='delete-expense'){if(confirm('Delete this expense?')){db.expenses=db.expenses.filter(e=>e.id!==x);render()}}
 else if(action==='new-product')newProduct(); else if(action==='edit-product')newProduct(db.products.find(p=>p.id===x)); else if(action==='adjust-stock')adjustStock(db.products.find(p=>p.id===x)); else if(action==='add-stock')addStock(db.products.find(p=>p.id===x)); else if(action==='view-stock-details')viewStockDetails(db.products.find(p=>p.id===x)); else if(action==='edit-latest-stock')editLatestStock(db.products.find(p=>p.id===x));
 else if(action==='export'){const blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='trader_business_control_v3_data.json';a.click()}
 else if(action==='reset'){alert('Demo reset is not available because this build starts without demo data. Use Clear All Data to clear records.');return}
}
document.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b)handle(b.dataset.action,b);const g=e.target.closest('[data-go]');if(g){if(!hasPermission(pagePermission(g.dataset.go))){alert('You do not have permission to access this page.');return}currentPage=g.dataset.go;render()}if(e.target.id==='addItem'){const wrap=document.getElementById('items');const i=wrap.querySelectorAll('.item-row').length;wrap.insertAdjacentHTML('beforeend',itemRow({productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0},i))}if(e.target.dataset.remove!==undefined)e.target.closest('.item-row').remove()});
document.getElementById('nav').addEventListener('click',e=>{const b=e.target.closest('button[data-page]');if(!b)return;if(!hasPermission(pagePermission(b.dataset.page))){alert('You do not have permission to access this page.');return}currentPage=b.dataset.page;document.getElementById('sidebar').classList.remove('open');render()});document.getElementById('businessSelect').addEventListener('change',e=>{const b=db.businesses.find(x=>x.id===e.target.value);if(b&&b.active&&allowedBusiness(b.id)){db.activeBusinessId=b.id;currentPage='dashboard';render()}});document.getElementById('period').addEventListener('change',e=>{period=e.target.value;render()});document.getElementById('closeModal').onclick=closeModal;document.getElementById('menuBtn').onclick=()=>document.getElementById('sidebar').classList.toggle('open');document.getElementById('logoutBtn').onclick=authLogout;document.getElementById('changePasswordBtn').onclick=()=>authChangePasswordView(false);document.addEventListener('change',e=>{if(e.target.id==='fRole'){const p=rolePermissionDefaults(e.target.value);document.querySelectorAll('.staff-perm').forEach(c=>c.checked=!!p[c.value]);}});
document.addEventListener('click',e=>{const b=e.target.closest('[data-show-password]');if(b){const i=document.getElementById(b.dataset.showPassword);if(i){i.type=i.type==='password'?'text':'password';b.textContent=i.type==='password'?'Show':'Hide'}}});
// Do not render until the local authentication gate has succeeded.
authInit();
</script><script>
/* Production feature layer merged into the supplied Admin V4 UI. Visual/CSS baseline is intentionally unchanged. */
(function(){
  // State extensions
  if(!Array.isArray(db.branches)){
    db.branches=[];
    db.businesses.forEach((b)=>db.branches.push({id:'br-'+b.id+'-main',businessId:b.id,name:'Main Branch',address:b.address||'',phone:b.phone||'',active:true}));
  }
  function normalizeProductBranches(){
    (db.products||[]).forEach(p=>{
      // Legacy products without branch assignment remain available in all branches that already exist.
      // Once a product has an explicit branch list, preserve it so new branches can choose their catalogue.
      if(!Array.isArray(p.branchIds)||p.branchIds.length===0){
        p.branchIds=(db.branches||[]).filter(br=>br.businessId===p.businessId&&br.active!==false).map(br=>br.id);
      }
      delete p.branchId;
    });
  }
  normalizeProductBranches();
  db.businesses.forEach(b=>{if(!Array.isArray(b.productNameList))b.productNameList=[];if(!b.header)b.header={businessName:b.name||'',brand:'',sub:b.type||'',readonly:"OWNER'S VIEW",install:'Chat Admin',showInstall:true};if(b.header.readonly==='VIEW ONLY • DATA ENTRY DISABLED'||!String(b.header.readonly||'').trim())b.header.readonly="OWNER'S VIEW";if(b.header.install==='Install Business Control'||!String(b.header.install||'').trim())b.header.install='Chat Admin';(db.products||[]).filter(p=>p.businessId===b.id).forEach(p=>{const n=String(p.name||'').trim();if(n&&!b.productNameList.some(x=>String(x).trim().toLowerCase()===n.toLowerCase()))b.productNameList.push(n)})});
  save();
  var activeBranchId='all';
  // Public read-only accessor for code defined outside this IIFE.
  window.getActiveBranchId=function(){return activeBranchId};
  window.resetBranchSelection=function(){activeBranchId='all'};
  let customFrom=today, customTo=today;

  const oldScoped=scoped;
  window.branchFor=function(id){return db.branches.find(b=>b.id===id)};
  window.branchesFor=function(bid){return (db.branches||[]).filter(b=>b.businessId===bid&&b.active!==false)};
  // Backfill older records that were created before branch support so every branch-scoped record belongs to a branch.
  ['products','customers','sales','payments','expenses','stockMovements'].forEach(key=>{
    (db[key]||[]).forEach(r=>{
      if(!r.branchId){const br=branchesFor(r.businessId)?.[0];if(br)r.branchId=br.id;}
    });
  });
  window.branchAllowed=function(bid){const me=db.admins.find(a=>a.id===currentAdminId);if(me?.role==='major')return activeBranchId==='all'||String(bid||'')===String(activeBranchId);const assigned=new Set(me?.branchIds||[]);if(activeBranchId==='all')return assigned.has(String(bid||''));return assigned.has(String(activeBranchId))&&String(bid||'')===String(activeBranchId)};
  window.scoped=function(list){return list.filter(x=>{if(x.businessId!==db.activeBusinessId)return false;if(activeBranchId==='all')return true;if(Array.isArray(x.branchIds))return x.branchIds.includes(activeBranchId);return branchAllowed(x.branchId);});};
  window.range=function(){
    const d=new Date(today), y=d.getFullYear(),m=d.getMonth(),day=d.getDate();
    if(period==='custom')return [customFrom,customTo];
    if(period==='all')return ['0000-01-01','9999-12-31'];
    if(period==='today')return [today,today];
    if(period==='week'){const start=new Date(d);start.setDate(day-d.getDay());return [iso(start),today]}
    if(period==='month')return [`${y}-${String(m+1).padStart(2,'0')}-01`,today];
    const pm=new Date(y,m-1,1),end=new Date(y,m,0);return [iso(pm),iso(end)]
  };
  window.periodLabel=function(){const r=range();return r[0]==='0000-01-01'?'All Time':`${r[0]} to ${r[1]}`};

  function ensureTopControls(){
    const top=document.querySelector('.top-right'); if(!top)return;
    const bs=document.getElementById('businessSelect');
    if(bs && !document.getElementById('branchSelect')){
      const sel=document.createElement('select'); sel.className='business-select'; sel.id='branchSelect'; sel.title='Branch';
      bs.insertAdjacentElement('afterend',sel);
      sel.addEventListener('change',()=>{activeBranchId=sel.value||'all';render()});
    }
    const periodEl=document.getElementById('period');
    if(periodEl && ![...periodEl.options].some(o=>o.value==='custom')){
      periodEl.insertAdjacentHTML('beforeend','<option value="custom">Custom</option>');
    }
    if(periodEl && !document.getElementById('customDates')){
      const wrap=document.createElement('span');wrap.id='customDates';wrap.style.display='none';wrap.innerHTML='<input id="customFrom" class="period" type="date"><input id="customTo" class="period" type="date"><button id="applyCustom" class="btn secondary small" type="button">Apply</button>';
      periodEl.insertAdjacentElement('afterend',wrap);
      document.getElementById('customFrom').value=customFrom;document.getElementById('customTo').value=customTo;
      document.getElementById('applyCustom').onclick=()=>{customFrom=document.getElementById('customFrom').value||today;customTo=document.getElementById('customTo').value||today;if(customFrom>customTo){const x=customFrom;customFrom=customTo;customTo=x}render()};
    }
    if(document.querySelector('#nav button[data-page="admins"]'))document.querySelector('#nav button[data-page="admins"]').textContent='Staff';
  }

  const baseRenderBusinessSelect=window.renderBusinessSelect;
  window.renderBusinessSelect=function(){
    baseRenderBusinessSelect(); ensureTopControls();
    const me=db.admins.find(a=>a.id===currentAdminId)||{};
    const bsel=document.getElementById('businessSelect'), brsel=document.getElementById('branchSelect');
    if(brsel){let brs=branchesFor(db.activeBusinessId);if(me.role!=='major')brs=brs.filter(b=>(me.branchIds||[]).includes(b.id));if(me.role==='major'){if(activeBranchId!=='all'&&!brs.some(b=>b.id===activeBranchId))activeBranchId='all';brsel.innerHTML='<option value="all">All Branches</option>'+brs.map(b=>`<option value="${b.id}" ${b.id===activeBranchId?'selected':''}>${esc(b.name)}</option>`).join('');}else{if(!brs.some(b=>b.id===activeBranchId))activeBranchId=brs[0]?.id||'';brsel.innerHTML=brs.map(b=>`<option value="${b.id}" ${b.id===activeBranchId?'selected':''}>${esc(b.name)}</option>`).join('')||'<option value="">No branch assigned</option>';brsel.disabled=brs.length<=1;}brsel.value=activeBranchId;}
    const p=document.getElementById('period'); if(p){p.value=period;const c=document.getElementById('customDates');if(c)c.style.display=period==='custom'?'inline-flex':'none';}
  };

  // Business-aware metrics: branch filter now applies everywhere.
  window.totals=function(){
    const ss=scoped(db.sales).filter(s=>inRange(s.date));
    const ps=scoped(db.payments).filter(p=>inRange(p.date));
    const es=scoped(db.expenses).filter(e=>inRange(e.date));
    const cash=ss.filter(s=>paymentStatus(s)==='Cash');
    const credit=ss.filter(s=>saleOutstanding(s)>0);
    const creditTotal=ss.reduce((a,s)=>a+saleOutstanding(s),0);
    const saleTotal=ss.reduce((a,s)=>a+Number(s.total||0),0);
    const amountReceived=ss.reduce((a,s)=>a+Number(s.paid||0),0)+ps.reduce((a,p)=>a+Number(p.amount||0),0);
    const owing=scoped(db.customers).map(c=>({...c,balance:customerOutstanding(c.id)})).filter(c=>c.balance>0);
    return{sales:ss,cashSales:cash,credit,creditTotal,saleTotal,payments:ps.reduce((a,p)=>a+Number(p.amount||0),0),cashReceived:amountReceived,amountReceived,exp:es.reduce((a,e)=>a+e.amount,0),owing};
  };

  function duplicateSale(items,total,paid,type,cid,date){
    const sig=a=>JSON.stringify(a.map(x=>({p:x.productId,q:Number(x.qty),pr:Number(x.price)})).sort((a,b)=>a.p.localeCompare(b.p)));
    const s=db.sales.find(x=>x.businessId===db.activeBusinessId&&branchAllowed(x.branchId)&&x.branchId===activeBranchId&&x.customerId===cid&&x.date===date&&x.type===type&&Number(x.total)===Number(total)&&Number(x.paid)===Number(paid));
    return s&&sig(s.items||[])===sig(items);
  }

  // Replace sale form with the agreed customer/phone/address + Paid Amount/Full-Payment workflow.
  window.saleForm=function(s){
    s=s||{customerId:'',customerName:'',phone:'',address:'',date:today,type:'cash',paid:0,items:[{productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0}]};
    const c=s.customerId?db.customers.find(x=>x.id===s.customerId):null;
    return `<div class="form-grid"><div class="field"><label>Customer Name</label><input id="fCustomerName" value="${esc(c?.name||s.customerName||'')}" placeholder="Walk-in Customer"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(c?.phone||s.phone||'')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(c?.address||s.address||'')}"></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${s.date}"></div><div class="field"><label>Payment Status</label><div id="fPaymentStatus" class="status">Cash</div></div><div class="field full"><label>Paid Amount</label><div style="display:flex;gap:8px;align-items:center"><input id="fPaid" type="number" min="0" value="${s.paid||0}" style="flex:1"><label style="font-weight:400"><input id="fullPay" type="checkbox"> Full-Payment</label></div><div id="saleOutstanding" class="status">Outstanding: ₦0.00</div></div><div class="field full"><label>Sale Items — multiple items supported</label><div id="items">${s.items.map(itemRow).join('')}</div><button type="button" class="btn secondary small" id="addItem">+ Add Item</button></div></div>`
  };

  window.newSale=function(existing){
    openModal(existing?'Edit Sale':'New Sale',saleForm(existing),()=>{
      const items=collectItems(); if(!items.length){alert('Add at least one item.');return false}
      const name=document.getElementById('fCustomerName').value.trim()||'Walk-in Customer',phone=document.getElementById('fPhone').value.trim(),address=document.getElementById('fAddress').value.trim();
      const date=document.getElementById('fDate').value,total=items.reduce((a,x)=>a+x.qty*x.price,0),paidPreview=Number(document.getElementById('fPaid').value||0),type=total<=0||paidPreview>=total?'cash':(paidPreview>0?'partly_credit':'credit');if(activeBranchId==='all'){alert('Select a specific branch before recording a sale.');return false}let paid=Number(document.getElementById('fPaid').value||0);if(document.getElementById('fullPay')?.checked)paid=total;
      if(paidPreview<total&&(name==='Walk-in Customer'||!phone||!address)){alert('Credit or Partly Credit sales require Customer Name, Phone and Address. Walk-in Customer is fully-paid only.');return false}
      const samePhone=phone&&db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone);
      if(samePhone&&name!==samePhone.name&&!existing){alert(`Existing Customer Detected: ${samePhone.name}. Please use the existing customer's details or correct the phone number.`);return false}
      const cid=samePhone?.id||(name==='Walk-in Customer'?'':existing?.customerId||'');
      if(!existing && duplicateSale(items,total,paid,type,cid,date)){if(!confirm('An identical sale already exists for this date, customer, items, amount and payment details. Do you want to save it again?'))return false}
      if(!existing&&name!=='Walk-in Customer'&&!samePhone){db.customers.push({id:id(),businessId:db.activeBusinessId,branchId:activeBranchId,name,phone,address,opening:0})}
      const customer=db.customers.find(c=>c.id===cid)||db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone);const customerId=customer?.id||'';
      if(existing)Object.assign(existing,{customerId:customerId,date,type,paid,items,total,branchId:activeBranchId});else db.sales.push({id:id(),businessId:db.activeBusinessId,branchId:activeBranchId,customerId:customerId,date,type,paid,items,total,createdBy:currentAdminId});
      save();render();return true
    });
    const calc=()=>{const its=collectItems(),tot=its.reduce((a,x)=>a+x.qty*x.price,0),full=document.getElementById('fullPay'),paid=full?.checked?tot:Number(document.getElementById('fPaid')?.value||0);if(full)document.getElementById('fPaid').value=tot;const o=document.getElementById('saleOutstanding');if(o)o.textContent='Outstanding: '+money(Math.max(0,tot-paid));const st=document.getElementById('fPaymentStatus');if(st){const ps=tot<=0||paid>=tot?'Cash':(paid>0?'Partly Credit':'Credit');st.textContent=ps;st.className='status '+(ps==='Cash'?'green-text':(ps==='Partly Credit'?'orange-text':'red-text'));}};
    document.getElementById('items')?.addEventListener('input',calc);document.getElementById('fPaid')?.addEventListener('input',calc);document.getElementById('fullPay')?.addEventListener('change',calc);calc();
  };

  // Customer creation with duplicate-phone protection.
  const oldNewCustomer=window.newCustomer;
  window.newCustomer=function(existing){
    openModal(existing?'Edit Customer':'New Customer',`<div class="form-grid"><div class="field"><label>Name</label><input id="fName" value="${esc(existing?.name||'')}"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(existing?.phone||'')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(existing?.address||'')}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim(),phone=document.getElementById('fPhone').value.trim(),address=document.getElementById('fAddress').value.trim(),branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():'')||existing?.branchId||'';if(!name||!phone||!address){alert('Name, Phone and Address are required.');return false}const dup=db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone&&c.id!==existing?.id);if(dup){alert(`This phone number already belongs to ${dup.name}.`);return false}if(!branchId){alert('Select a specific branch from the Dashboard before saving the customer.');return false}if(existing)Object.assign(existing,{name,phone,address,branchId});else db.customers.push({id:id(),businessId:db.activeBusinessId,branchId,name,phone,address,opening:0});save();render();return true})
  };

  // Staff page replaces the old Admin Access page; staff can be selected and assigned to businesses/branches.
  window.renderAdmins=function(){const me=db.admins.find(a=>a.id===currentAdminId);const major=me?.role==='major';const rows=db.admins.filter(a=>a.role!=='major').map(a=>{const assigns=(a.branchIds||[]).map(idv=>{const br=branchFor(idv),b=br&&db.businesses.find(x=>x.id===br.businessId);return br?`${esc(b?.name||'')} / ${esc(br.name)}`:''}).filter(Boolean).join('<br>');const perms=ALL_PERMISSION_KEYS.filter(k=>hasPermission(k,a)).length;return `<tr><td><b>${esc(a.name)}</b><br><span class="status">${esc(a.email)}</span></td><td>${esc(({owner:'Business Owner',supervisor:'Supervisor',entry_staff:'Entry Staff',admin:'Legacy Admin'}[a.role]||a.role))}</td><td>${assigns||'<span class="status">Not assigned</span>'}</td><td><span class="tag ${a.active?'active':'off'}">${a.active?'ACTIVE':'INACTIVE'}</span><br><span class="status">${perms} permissions</span></td><td>${major?`<div class="actions"><button class="btn secondary small" data-action="edit-admin" data-id="${a.id}">Edit</button><button class="btn secondary small" data-action="reset-staff-password" data-id="${a.id}">Reset Password</button><button class="btn ${a.active?'danger':'green'} small" data-action="toggle-admin" data-id="${a.id}">${a.active?'Deactivate':'Activate'}</button><button class="btn danger small" data-action="delete-admin" data-id="${a.id}">Delete</button></div>`:'—'}</td></tr>`}).join('');document.getElementById('page-admins').innerHTML=`<div class="notice"><b>Staff Security.</b> Create Staff with a temporary password, assign businesses/branches, and choose exact permissions. Staff can change their own password but cannot change their access.</div><div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Staff <b>${db.admins.filter(a=>a.role!=='major').length}</b></span></div>${major?'<button class="btn" data-action="new-admin">+ Add Staff</button>':''}</div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Staff</th><th>Role</th><th>Business / Branch Access</th><th>Status / Permissions</th><th>Actions</th></tr></thead><tbody>${rows||'<tr><td colspan="5" class="empty">No Staff yet.</td></tr>'}</tbody></table></div></div></div>`};

  function staffForm(a){a=a||{name:'',email:'',active:true,branchIds:[],role:'entry_staff',permissions:rolePermissionDefaults('entry_staff')};const p=a.permissions||rolePermissionDefaults(a.role);const groups=PERMISSION_GROUPS.map(g=>`<div class="auth-perm-group"><div class="auth-perm-title">${esc(g.title)}</div>${g.items.map(([k,label])=>`<label class="auth-perm-item"><input type="checkbox" class="staff-perm" value="${k}" ${p[k]?'checked':''}> <span>${esc(label)}</span></label>`).join('')}</div>`).join('');return `<div class="form-grid"><div class="field"><label>Staff Name</label><input id="fName" value="${esc(a.name)}"></div><div class="field"><label>Username / Email</label><input id="fEmail" value="${esc(a.email)}"></div><div class="field full"><label>Permission Template</label><select id="fRole"><option value="entry_staff" ${a.role==='entry_staff'?'selected':''}>Entry Staff</option><option value="supervisor" ${a.role==='supervisor'?'selected':''}>Supervisor</option><option value="owner" ${a.role==='owner'?'selected':''}>Business Owner</option><option value="admin" ${a.role==='admin'?'selected':''}>Legacy Admin</option></select><span class="status">Choose a template, then tick exactly what this Staff member may use.</span></div><div class="field full"><label>${a.id?'Password':'Temporary Password'}</label>${a.id?'<span class="status">The Staff member keeps their current password. Use Reset Password in the Staff list to issue a new temporary password.</span>':'<input id="fTempPass" type="text" autocomplete="new-password" placeholder="Leave blank to generate one">'}</div><div class="field full"><label>Assigned Permissions</label><div class="auth-perms">${groups}</div></div></div>`}
  function assignmentForm(pre){return `<div class="form-grid"><div class="field"><label>Staff</label><select id="assignStaff"><option value="">Select Staff</option>${db.admins.filter(a=>a.role!=='major'&&a.active).map(a=>`<option value="${a.id}">${esc(a.name)} — ${esc(a.email)}</option>`).join('')}</select></div><div class="field"><label>Business</label><select id="assignBusiness"><option value="">Select Business</option>${db.businesses.filter(b=>b.active).map(b=>`<option value="${b.id}" ${b.id===pre?'selected':''}>${esc(b.name)}</option>`).join('')}</select></div><div class="field full"><label>Branches</label><div id="branchChecks" class="section-body" style="padding:10px">Select a business first.</div></div></div>`}
  function openAssignment(pre){openModal('Assign Staff to Business',assignmentForm(pre),()=>{const uid=document.getElementById('assignStaff').value,bid=document.getElementById('assignBusiness').value,ids=[...document.querySelectorAll('.branch-check:checked')].map(x=>x.value);if(!uid||!bid||!ids.length){alert('Select Staff, Business and at least one branch.');return false}const st=db.admins.find(a=>a.id===uid);if(!st)return false;const otherBranches=(st.branchIds||[]).filter(brId=>{const br=branchFor(brId);return br&&br.businessId!==bid});for(const br of ids){const occupied=db.admins.find(a=>a.role!=='major'&&(a.branchIds||[]).includes(br)&&a.id!==uid);if(occupied){alert('One of the selected branches is already assigned to another Staff member. Reassignment must be done by Major Admin.');return false}}st.branchIds=Array.from(new Set([...otherBranches,...ids]));st.businessIds=Array.from(new Set((st.branchIds||[]).map(brId=>branchFor(brId)?.businessId).filter(Boolean)));save();render();return true});const sel=document.getElementById('assignBusiness'),staffSel=document.getElementById('assignStaff');if(pre)sel.value=pre;const draw=()=>{const host=document.getElementById('branchChecks'),st=db.admins.find(a=>a.id===staffSel.value),brs=branchesFor(sel.value);host.innerHTML=brs.map(b=>`<label style="display:block;margin:6px 0"><input class="branch-check" type="checkbox" value="${b.id}" ${(st?.branchIds||[]).includes(b.id)?'checked':''}> ${esc(b.name)}</label>`).join('')||'No branches';};sel.onchange=draw;staffSel.onchange=draw;draw()}

  // Businesses & Branches with visible business list first.
  window.renderBusinesses=function(){const rows=db.businesses.map(b=>{const brs=branchesFor(b.id),staff=db.admins.filter(a=>a.role!=='major'&&(a.branchIds||[]).some(idv=>brs.some(x=>x.id===idv))).map(a=>a.name).join(', ');const branchHtml=brs.map(x=>`<div style="display:flex;align-items:center;gap:6px;margin:3px 0"><span>${esc(x.name)}</span><button class="btn secondary small" data-action="edit-branch" data-id="${x.id}">Edit</button></div>`).join('')||'—';return `<tr><td><b>${esc(b.name)}</b><br><span class="status">${esc(b.address||'')}</span></td><td>${esc(b.type||'')}</td><td>${branchHtml}</td><td>${esc(staff)||'<span class="status">No Staff assigned</span>'}</td><td><div class="actions"><button class="btn ${b.id===db.activeBusinessId?'green':'secondary'} small" data-action="select-business" data-id="${b.id}">${b.id===db.activeBusinessId?'Selected':'Select'}</button><button class="btn secondary small" data-action="edit-business" data-id="${b.id}">Edit</button><button class="btn secondary small" data-action="assign-staff-business" data-id="${b.id}">Assign Staff</button><button class="btn secondary small" data-action="new-branch" data-id="${b.id}">+ Branch</button><button class="btn danger small" data-action="delete-business" data-id="${b.id}">Delete</button></div></td></tr>`}).join('');document.getElementById('page-businesses').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="bizSearch" placeholder="Search businesses"></div><button class="btn" data-action="new-business">+ Add Business</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Business</th><th>Type</th><th>Branches</th><th>Staff</th><th>Actions</th></tr></thead><tbody id="bizBody">${rows||'<tr><td colspan="5" class="empty">No businesses.</td></tr>'}</tbody></table></div></div></div>`;document.getElementById('bizSearch').oninput=e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('#bizBody tr').forEach(r=>{const txt=(r.textContent||'').toLowerCase();r.style.display=txt.includes(q)?'':'none'})}}

  const baseHandle=window.handle;
  window.handle=async function(action,el){
    const x=el?.dataset?.id;
    const acting=db.admins.find(v=>v.id===currentAdminId)||{role:'entry_staff'};
    const required=actionPermission(action);
    if(required&&!hasPermission(required,acting)){alert('Permission denied. Your assigned Staff permissions do not allow this action.');auditEvent('Permission denied',`${action}; required ${required}`,'security');save();return;}
    if(action==='new-payment'){window.newPayment();return}
    if(action==='new-product'){window.newProduct();return}
    if(action==='edit-product'){window.newProduct(db.products.find(p=>p.id===x));return}
    if(action==='new-admin'){openModal('Add Staff',staffForm(),async()=>{const name=document.getElementById('fName').value.trim(),email=document.getElementById('fEmail').value.trim();if(!name||!email){alert('Staff name and username/email are required.');return false}if(db.admins.some(a=>String(a.email||'').toLowerCase()===email.toLowerCase())){alert('A Staff member with this username/email already exists.');return false}const role=document.getElementById('fRole').value;const temp=(document.getElementById('fTempPass').value.trim()||('TBC-'+Math.random().toString(36).slice(2,8)+'!')).slice(0,32);const permissions=Object.fromEntries(ALL_PERMISSION_KEYS.map(k=>[k,!!document.querySelector(`.staff-perm[value="${k}"]`)?.checked]));const a={id:id(),name,email,role,active:true,businessIds:[],branchIds:[],permissions,permissionsCustomized:true,passwordHash:await authHash(temp),authVersion:AUTH_SETUP_VERSION,mustChangePassword:true,passwordChangedAt:null};db.admins.push(a);auditEvent('Staff account created',`${name}; role ${role}; temporary password issued`,'security');save();render();setTimeout(()=>alert(`Staff account created.\n\nUsername: ${email}\nTemporary password: ${temp}\n\nGive these credentials to the Staff member. They must change the password at first login.`),0);return true});return}
    if(action==='edit-admin'){const a=db.admins.find(a=>a.id===x);if(!a)return;openModal('Edit Staff',staffForm(a),()=>{const name=document.getElementById('fName').value.trim(),email=document.getElementById('fEmail').value.trim(),newRole=document.getElementById('fRole').value;if(!name||!email)return false;if(db.admins.some(v=>v.id!==a.id&&String(v.email||'').toLowerCase()===email.toLowerCase())){alert('Another Staff member already uses this username/email.');return false}a.name=name;a.email=email;a.role=newRole;a.permissions=Object.fromEntries(ALL_PERMISSION_KEYS.map(k=>[k,!!document.querySelector(`.staff-perm[value="${k}"]`)?.checked]));a.permissionsCustomized=true;a.mustChangePassword=!!a.mustChangePassword;a.passwordHash=a.passwordHash||'';auditEvent('Staff permissions changed',`${a.name}; role ${newRole}`,'security');save();render();return true});return}
    if(action==='reset-staff-password'){const a=db.admins.find(v=>v.id===x);if(!a||a.role==='major')return;const temp='TBC-'+Math.random().toString(36).slice(2,8)+'!';a.passwordHash=await authHash(temp);a.authVersion=AUTH_SETUP_VERSION;a.mustChangePassword=true;a.passwordChangedAt=null;a.passwordResetAt=new Date().toISOString();auditEvent('Staff password reset',`${a.name}; temporary password issued`,'security');save();render();setTimeout(()=>alert(`Temporary password for ${a.name}: ${temp}\n\nThe Staff member must change it at next login.`),0);return}
    if(action==='delete-admin'){
      const a=db.admins.find(v=>v.id===x); if(!a || a.role==='major') return;
      const ok=confirm(`Delete Staff "${a.name}" permanently?\n\nThis will remove the Staff member from the Staff list and remove all of their business/branch assignments. This action cannot be undone.`);
      if(!ok)return;
      db.admins=db.admins.filter(v=>v.id!==a.id);
      if(currentAdminId===a.id){currentAdminId=db.admins.find(v=>v.role==='major')?.id||db.admins[0]?.id||'';}
      save(); render(); return;
    }
    if(action==='assign-staff-business'){openAssignment(x);return}
    if(action==='edit-business'){const b=db.businesses.find(b=>b.id===x);if(!b)return;openModal('Edit Business',formBusiness(b),()=>{const o={name:document.getElementById('fName').value.trim(),type:document.getElementById('fType').value.trim(),phone:document.getElementById('fPhone').value.trim(),address:document.getElementById('fAddress').value.trim(),currency:document.getElementById('fCurrency').value||'NGN'};if(!o.name||!o.type){alert('Business name and type are required.');return false}if(db.businesses.some(v=>v.id!==b.id&&v.name.toLowerCase()===o.name.toLowerCase())){alert('Another business with this name already exists.');return false}Object.assign(b,o);const brs=branchesFor(b.id);if(brs.length===1&&brs[0].name==='Main Branch'){brs[0].address=o.address;brs[0].phone=o.phone}save();render();return true});return}
    if(action==='edit-branch'){const br=db.branches.find(v=>v.id===x),b=br&&db.businesses.find(v=>v.id===br.businessId);if(!br||!b)return;openModal('Edit Branch',`<div class="form-grid"><div class="field"><label>Business</label><input value="${esc(b.name)}" disabled></div><div class="field"><label>Branch Name</label><input id="fName" value="${esc(br.name)}"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(br.phone||'')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(br.address||'')}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim();if(!name){alert('Branch name is required.');return false}if(db.branches.some(v=>v.id!==br.id&&v.businessId===br.businessId&&v.name.toLowerCase()===name.toLowerCase())){alert('Another branch with this name already exists in this business.');return false}br.name=name;br.phone=document.getElementById('fPhone').value.trim();br.address=document.getElementById('fAddress').value.trim();save();render();return true});return}
    if(action==='delete-business'){const b=db.businesses.find(v=>v.id===x);if(!b)return;if(db.businesses.length<=1){alert('You cannot delete the only remaining business.');return}const ok=confirm(`Delete business "${b.name}" permanently?\n\nThis will remove its branches, staff assignments, sales, customers, payments, expenses, stock and other business records from this Admin dataset. This action cannot be undone.`);if(!ok)return;const branchIds=db.branches.filter(v=>v.businessId===b.id).map(v=>v.id);db.businesses=db.businesses.filter(v=>v.id!==b.id);db.branches=db.branches.filter(v=>v.businessId!==b.id);db.admins.forEach(a=>{a.businessIds=(a.businessIds||[]).filter(idv=>idv!==b.id);a.branchIds=(a.branchIds||[]).filter(idv=>!branchIds.includes(idv))});['products','customers','sales','payments','expenses','stockMovements'].forEach(k=>{if(Array.isArray(db[k]))db[k]=db[k].filter(v=>v.businessId!==b.id&&(!v.branchId||!branchIds.includes(v.branchId)))});if(db.activeBusinessId===b.id){db.activeBusinessId=db.businesses[0]?.id||'';activeBranchId='all';currentPage='businesses'}save();render();return}
    if(action==='new-branch'){
      const b=db.businesses.find(v=>v.id===x);if(!b)return;
      const products=(db.products||[]).filter(p=>p.businessId===b.id);
      const productRows=products.map(p=>`<div class="branch-product-row" style="display:grid;grid-template-columns:minmax(0,1fr) 120px;gap:10px;align-items:center;padding:8px 0;border-bottom:1px solid #e2e8f0"><label style="display:flex;gap:8px;align-items:center"><input type="checkbox" data-branch-product="${p.id}" style="width:auto">${esc(p.name)} <span class="status">(${esc(p.unit||'units')})</span></label><input data-branch-qty="${p.id}" type="number" min="0" step="any" value="0" placeholder="Opening qty" disabled></div>`).join('');
      openModal('Add Branch',`<div class="form-grid"><div class="field"><label>Business</label><input value="${esc(b.name)}" disabled></div><div class="field"><label>Branch Name</label><input id="fName"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(b.address||'')}"></div><div class="field full"><label>Stock arrangement</label><select id="fStockMode"><option value="separate">Separate stock for this branch</option><option value="shared">Share live stock with another branch</option></select></div><div class="field full" id="fStockSourceWrap" style="display:none"><label>Share stock with</label><select id="fStockSource">${branchesFor(b.id).map(br=>`<option value="${br.id}">${esc(br.name)}</option>`).join('')}</select></div><div class="field full" id="fBranchProductsWrap"><label>Products this branch sells and opening quantities</label><p class="status">Tick each product this branch will sell, then enter the quantity physically available in this branch. These quantities will not be copied from other branches.</p>${productRows||'<div class="status">No existing products in this business yet. You can add products later.</div>'}</div></div>`,()=>{
        const name=document.getElementById('fName').value.trim();if(!name)return false;
        if(branchesFor(b.id).some(br=>br.name.trim().toLowerCase()===name.toLowerCase())){alert('A branch with this name already exists in this business.');return false}
        const mode=document.getElementById('fStockMode').value,source=document.getElementById('fStockSource')?.value||'';
        const branchId=id();const chosen=mode==='separate'?[...document.querySelectorAll('[data-branch-product]:checked')].map(el=>el.dataset.branchProduct):products.filter(p=>{const src=mode==='shared'?source:'';return !src||Array.isArray(p.branchIds)&&p.branchIds.includes(src)}).map(p=>p.id);
        const newBranch={id:branchId,businessId:b.id,name,address:document.getElementById('fAddress').value,active:true,stockMode:mode,stockSharedWith:mode==='shared'?source:null,productIds:chosen};
        db.branches.push(newBranch);
        products.forEach(p=>{
          const idsNow=Array.isArray(p.branchIds)?p.branchIds.slice():[];
          if(chosen.includes(p.id)){if(!idsNow.includes(branchId))idsNow.push(branchId)}else{const idx=idsNow.indexOf(branchId);if(idx>=0)idsNow.splice(idx,1)}
          p.branchIds=idsNow;
          if(mode==='separate'){
            if(!p.branchQty)p.branchQty={};
            const qtyEl=document.querySelector(`[data-branch-qty="${p.id}"]`);const q=chosen.includes(p.id)?Math.max(0,Number(qtyEl?.value||0)):0;
            p.branchQty[branchId]=q;
            if(chosen.includes(p.id)&&q>0){if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:b.id,branchId,productId:p.id,qty:q,type:'branch_opening_stock',notes:'Opening quantity at branch creation',date:today,createdAt:new Date().toISOString()})}
          }
        });
        auditEvent('Branch created',`${name}; stock mode ${mode}; ${chosen.length} product(s) assigned${source?'; shares with '+source:''}`);
        save();activeBranchId=branchId;render();return true
      });
      const modeEl=document.getElementById('fStockMode');
      const updateBranchStockMode=()=>{const separate=modeEl.value==='separate';document.getElementById('fStockSourceWrap').style.display=separate?'none':'block';document.getElementById('fBranchProductsWrap').style.display=separate?'block':'none'};
      modeEl.addEventListener('change',updateBranchStockMode);
      document.querySelectorAll('[data-branch-product]').forEach(cb=>cb.addEventListener('change',()=>{const q=document.querySelector(`[data-branch-qty="${cb.dataset.branchProduct}"]`);if(q){q.disabled=!cb.checked;if(!cb.checked)q.value='0'}}));
      updateBranchStockMode();return
    }
    if(action==='new-business'){
      openModal('Add Business',formBusiness(),()=>{const o={name:document.getElementById('fName').value.trim(),type:document.getElementById('fType').value.trim(),phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value,currency:document.getElementById('fCurrency').value||'NGN'};if(!o.name||!o.type)return false;if(db.businesses.some(b=>b.name.toLowerCase()===o.name.toLowerCase())){alert('A business with this name already exists.');return false}const nb={id:id(),...o,active:true,clientFeedId:'CLIENT-'+Math.random().toString(36).slice(2,8).toUpperCase(),header:{businessName:o.name,brand:'',sub:o.type,readonly:"OWNER'S VIEW",install:'Chat Admin',showInstall:true},clientReport:{visible:false,published:false,content:null},productNameList:[]};db.businesses.push(nb);db.branches.push({id:id(),businessId:nb.id,name:'Main Branch',address:o.address,phone:o.phone,active:true});const major=db.admins.find(a=>a.role==='major');if(major)major.businessIds.push(nb.id);db.activeBusinessId=nb.id;activeBranchId='all';save();render();return true});return}
    if(action==='new-sale'){editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;pendingSaleFormState=null;pendingSaleSave=null;salesView='new';currentPage='sales';render();return}
    if(action==='edit-sale'){editingSaleId=x;saleDraftItems=null;saleDraftCustomer=null;pendingSaleFormState=null;pendingSaleSave=null;salesView='new';currentPage='sales';render();return}
    if(action==='back-sales'){document.getElementById('salesListBelow')?.scrollIntoView({behavior:'smooth',block:'start'});return}
    if(action==='add-sale-item'){const n=document.getElementById('nsName'),p=document.getElementById('nsPhone'),a=document.getElementById('nsAddress'),paid=document.getElementById('nsPaid'),full=document.getElementById('nsFull');const currentPaid=Number(paid?.value||0);saleDraftCustomer={name:n?.value||'Walk-in Customer',phone:p?.value||'',address:a?.value||'',type:currentPaid>0?'partly_credit':'credit',paid:currentPaid,full:!!full?.checked};readSalePageItems();saleDraftItems.push({productId:'',itemName:'',qty:1,price:0});render();return}
    if(action==='delete-sale'){
      const sale=db.sales.find(v=>v.id===x);if(!sale)return;
      if(!confirm('Delete this sale? The sold quantities will be returned to stock.'))return;
      const quantities=saleQuantityMap(sale.items||[]);
      Object.keys(quantities).forEach(pid=>{const product=db.products.find(p=>p.id===pid&&p.businessId===sale.businessId);if(!product)return;adjustProductStockAt(product,sale.branchId,Number(quantities[pid]||0));if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:sale.businessId,branchId:sale.branchId||'',productId:pid,qty:Number(quantities[pid]||0),type:'sale_deleted',saleId:sale.id,date:today,createdAt:new Date().toISOString()});});
      db.sales=db.sales.filter(v=>v.id!==x);auditEvent('Sale deleted',`Sale ${sale.id}; stock restored`,'sensitive');save();render();return;
    }
    if(action==='save-sale-page'){saveSalePage(false);return}
    if(action==='save-sale-page-new'){saveSalePage(true);return}
    if(action==='generate-client-report'){const b=biz(),sales=(db.sales||[]).filter(s=>s.businessId===b.id&&inRange(s.date));const qty={},custTotals={};sales.forEach(s=>{(s.items||[]).forEach(i=>{const p=db.products.find(p=>p.id===i.productId);if(p)qty[p.name]=(qty[p.name]||0)+Number(i.qty||i.quantity||0)});const cu=db.customers.find(c=>c.id===s.customerId);if(cu)custTotals[cu.name]=(custTotals[cu.name]||0)+Number(s.total||0)});const ranked=Object.entries(qty).sort((x,y)=>y[1]-x[1]),best=Object.entries(custTotals).sort((x,y)=>y[1]-x[1])[0],old=b.clientReport?.content||{};b.clientReport={...(b.clientReport||{}),visible:document.getElementById('clientReportVisible')?.value==='yes',published:false,content:{...old,period:periodLabel(),highestSellingProduct:ranked[0]?`${ranked[0][0]} (${ranked[0][1]} units)`:'No product sales',lowestSellingProduct:ranked.length?`${ranked[ranked.length-1][0]} (${ranked[ranked.length-1][1]} units)`:'No product sales',bestCustomer:best?`${best[0]} (${money(best[1])})`:'No customer sales',totalSales:money(sales.reduce((sum,s)=>sum+Number(s.total||0),0)),transactions:sales.length,productQuantities:qty,generatedAt:new Date().toISOString()}};auditEvent('Client report generated',`Draft for ${periodLabel()}`);save();render();alert('Report draft generated. Review it before publishing.');return}
    if(action==='save-client-report'){const b=biz();b.clientReport={...(b.clientReport||{}),visible:document.getElementById('clientReportVisible')?.value==='yes',published:!!b.clientReport?.published};auditEvent('Client report controls saved','Visibility updated');save();render();return}
    if(action==='save-written-report'){const b=biz();const text=String(document.getElementById('clientWrittenReport')?.value||'').trim();b.clientReport={...(b.clientReport||{}),content:{...((b.clientReport&&b.clientReport.content)||{}),period:periodLabel(),writtenReport:text,updatedAt:new Date().toISOString()}};auditEvent('Written client report saved',text?'Narrative updated':'Narrative cleared');save();render();alert(text?'Written report saved.':'Written report cleared.');return}
    if(action==='publish-client-report'){const b=biz();if(!b.clientReport?.content){alert('Generate a report draft first.');return}if(!confirm('Publish this report to the Client App?'))return;b.clientReport.visible=document.getElementById('clientReportVisible')?.value==='yes';b.clientReport.published=true;b.clientReport.publishedAt=new Date().toISOString();auditEvent('Client report published',`Published report for ${b.clientReport.content.period}`);save();render();return}
    if(action==='new-reconciliation'){const date=prompt('Business date (YYYY-MM-DD)',today);if(!date)return;const type=prompt('Reconciliation type: Cash, Stock or Customer Balances','Cash');if(!type)return;const expected=Number(prompt('Expected amount/value', '0'));if(!Number.isFinite(expected))return;const actual=Number(prompt('Actual counted amount/value','0'));if(!Number.isFinite(actual))return;const difference=actual-expected;const me=db.admins.find(v=>v.id===currentAdminId)||{};const rec={id:id(),businessId:db.activeBusinessId,date,type,expected,actual,difference,actorId:currentAdminId,actorName:me.name||'Unknown',status:Math.abs(difference)>0?'Pending review':'Reconciled',createdAt:new Date().toISOString()};db.reconciliations.push(rec);auditEvent('Daily reconciliation submitted',`${type}; expected ${expected}; actual ${actual}; difference ${difference}`,Math.abs(difference)>0?'sensitive':'normal');save();render();if(Math.abs(difference)>0&&confirm('A difference was found. Does this require a sensitive correction?')){if(requireMajorApproval(`${type} reconciliation difference ${difference}`)){rec.status='Major Admin approved';rec.approvedBy=currentAdminId;rec.approvedAt=new Date().toISOString();save();render()}}return}

    if(action==='remove-sale-item'){readSalePageItems();saleDraftItems.splice(Number(x),1);if(!saleDraftItems.length)saleDraftItems.push({productId:'',itemName:'',qty:1,price:0});render();return}
    if(action==='select-business'){const b=db.businesses.find(b=>b.id===x);if(b?.active&&allowedBusiness(x)){db.activeBusinessId=x;activeBranchId='all';currentPage='dashboard';salesView='list';render()}return}
    const actingAdmin=db.admins.find(v=>v.id===currentAdminId)||{role:'entry_staff'};const actingRole=actingAdmin.role||'entry_staff';const requiredPermission=actionPermission(action);if(requiredPermission&&!hasPermission(requiredPermission,actingAdmin)){alert('Permission denied. Your assigned staff permissions do not allow this action.');auditEvent('Permission denied',`${action}; required ${requiredPermission}`,'security');save();return}
    const destructive=['delete-sale','delete-expense','delete-customer','delete-payment','delete-product','delete-business','clear-data'];
    if(destructive.includes(action)&&actingRole==='entry_staff'){alert('Entry Staff cannot delete or clear records. Ask a Supervisor or Major Admin.');auditEvent('Permission denied',action,'security');save();return}
    if(['delete-business','delete-admin','new-admin','edit-admin','clear-data'].includes(action)&&actingRole!=='major'){alert('Only Major Admin can perform this administrative action.');auditEvent('Permission denied',action,'security');save();return}
    // Fall back to the original handler for all other actions.
    return baseHandle(action,el);
  };

  // Sales list remains the existing visual baseline; New Sale uses the supplied full-page layout.
  let salesView='list';
  let editingSaleId=null;
  let saleDraftItems=null;
  let saleDraftCustomer=null;
  // Preserves the complete sale form while missing products are registered one at a time.
  let pendingSaleFormState=null;
  let pendingSaleSave=null;
  let saleCommitInProgress=false;
  function saleProductOptions(sel='',rowIndex=0){const selected=new Set((saleDraftItems||[]).map((x,i)=>i===rowIndex?'':x.productId).filter(Boolean));const bid=window.getActiveBranchId?.()||'all';return scoped(db.products).filter(p=>(p.id===sel||!selected.has(p.id))&&(p.id===sel||(bid==='all'?productStockAcrossBranches(p)>0:globalProductStockAt(p,bid)>0))).map(p=>`<option value="${esc(p.name)}"></option>`).join('')}
  function findBusinessProductByName(name){const clean=String(name||'').trim().toLowerCase();return clean?scoped(db.products).find(p=>String(p.name||'').trim().toLowerCase()===clean)||null:null}
  function saleProductAvailable(product,branchId){if(!product)return false;const bid=branchId||window.getActiveBranchId?.()||'all';if(bid==='all')return productStockAcrossBranches(product)>0;const oldSale=editingSaleId?db.sales.find(v=>v.id===editingSaleId):null;const prior=oldSale?.branchId===bid?Number(saleQuantityMap(oldSale.items||[])[product.id]||0):0;return globalProductStockAt(product,bid)+prior>0}
  function updateSaleProductRow(index,{resolve=true,alertDuplicate=false}={}){const row=document.querySelector(`.ns-item-row[data-i="${index}"]`);if(!row)return;const input=row.querySelector('.ns-prod-name');const name=(input?.value||'').trim();const existing=findBusinessProductByName(name);const selectedElsewhere=(saleDraftItems||[]).some((it,i)=>i!==index&&existing&&it.productId===existing.id);const saveBtn=row.querySelector('.ns-save-product');if(existing&&selectedElsewhere&&resolve){if(alertDuplicate)alert('This product is already selected in this sale. Choose another product.');input.value='';row.dataset.productId='';const price=row.querySelector('.ns-price');if(price)price.value='0';if(saleDraftItems[index]){saleDraftItems[index].productId='';saleDraftItems[index].itemName='';saleDraftItems[index].price=0;}if(saveBtn)saveBtn.hidden=true;return;}if(resolve&&existing&&saleProductAvailable(existing,(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():(editingSaleId?db.sales.find(v=>v.id===editingSaleId)?.branchId:'')))){const previousId=row.dataset.productId||'';row.dataset.productId=existing.id;if(saleDraftItems[index]){saleDraftItems[index].productId=existing.id;saleDraftItems[index].itemName=existing.name;}const price=row.querySelector('.ns-price');if(price&&previousId!==existing.id){price.value=String(Number(existing.sell||0));if(saleDraftItems[index])saleDraftItems[index].price=Number(existing.sell||0);}}else{const previousId=row.dataset.productId||'';row.dataset.productId='';if(previousId){const price=row.querySelector('.ns-price');if(price)price.value='0';if(saleDraftItems[index])saleDraftItems[index].price=0;}if(saleDraftItems[index]){saleDraftItems[index].productId='';saleDraftItems[index].itemName=name;}}if(saveBtn)saveBtn.hidden=!(name&&!existing);}



  function salePageCustomerState(){
    const phone=(document.getElementById('nsPhone')?.value||'').trim();
    const hit=db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone);
    const note=document.getElementById('nsCustomerNote');
    if(hit){
      const n=document.getElementById('nsName'),a=document.getElementById('nsAddress');
      if(n)n.value=hit.name; if(a)a.value=hit.address||'';
      if(note){note.textContent=`Existing Customer Detected: ${hit.name}`;note.style.display='block'}
      return hit;
    }
    if(note)note.style.display=phone?'block':'none';
    if(note&&phone)note.textContent='New phone number — a customer record will be created after a successful sale.';
    return null;
  }
  function renderSaleRows(){
    const host=document.getElementById('nsItems'); if(!host)return;
    const items=saleDraftItems||[{productId:'',itemName:'',qty:1,price:0}];
    saleDraftItems=items;
    host.innerHTML=items.map((x,i)=>{const selectedProduct=scoped(db.products).find(p=>p.id===x.productId);const itemName=selectedProduct?.name||x.itemName||'';return `<div class="ns-item-row" data-i="${i}" data-product-id="${esc(x.productId||'')}"><input class="ns-prod-name" data-i="${i}" list="nsProducts-${i}" value="${esc(itemName)}" placeholder="Enter or select item" autocomplete="off"><datalist id="nsProducts-${i}">${saleProductOptions(x.productId,i)}</datalist><input class="ns-qty" data-i="${i}" type="number" min="1" value="${x.qty||1}"><input class="ns-price" data-i="${i}" type="number" min="0" value="${x.price||0}"><div class="ns-total">${money((x.qty||0)*(x.price||0))}</div><div class="ns-row-actions"><button type="button" class="btn danger small ns-remove" data-i="${i}" aria-label="Remove item">×</button><button type="button" class="btn secondary small ns-save-product" data-i="${i}" ${itemName&&!selectedProduct?'':'hidden'}>Save Product</button></div></div>`}).join('');
    items.forEach((x,i)=>updateSaleProductRow(i,{resolve:true}));
    updateSalePageTotals();
  }
  function readSalePageItems(){
    saleDraftItems=[...document.querySelectorAll('.ns-item-row')].map(r=>({productId:r.dataset.productId||'',itemName:r.querySelector('.ns-prod-name')?.value.trim()||'',qty:Number(r.querySelector('.ns-qty').value||0),price:Number(r.querySelector('.ns-price').value||0)}));
  }
  function updateSalePageTotals(){
    readSalePageItems();
    const total=saleDraftItems.reduce((a,x)=>a+(x.qty*x.price),0);
    const gt=document.getElementById('nsGrandTotal'),out=document.getElementById('nsOutstanding'),paid=document.getElementById('nsPaid'),full=document.getElementById('nsFull');
    if(gt)gt.textContent=money(total);
    if(full&&full.checked&&paid)paid.value=total;
    const pv=Math.max(0,Math.min(Number(paid?.value||0),total));
    if(out)out.textContent=money(Math.max(0,total-pv));
    const status=document.getElementById('nsPaymentStatus');
    if(status){
      const st=total<=0||pv>=total?'Cash':(pv>0?'Partly Credit':'Credit');
      status.textContent=st;
      status.className='status '+(st==='Cash'?'green-text':(st==='Partly Credit'?'orange-text':'red-text'));
    }
    document.querySelectorAll('.ns-item-row').forEach((r,i)=>{const x=saleDraftItems[i];const t=r.querySelector('.ns-total');if(t)t.textContent=money((x?.qty||0)*(x?.price||0));});
  }
  function salePageTemplate(existing){
    const s=existing||{date:today,type:saleDraftCustomer?.type||'cash',paid:saleDraftCustomer?.paid||0};
    const c=existing?cust(existing.customerId):(saleDraftCustomer||null);
    const st=!existing&&pendingSaleFormState?pendingSaleFormState:{};
    if(existing){saleDraftItems=(existing.items||[]).map(x=>({...x}));}
    else if(!Array.isArray(saleDraftItems)||!saleDraftItems.length){saleDraftItems=[{productId:'',itemName:'',qty:1,price:0}];}
    const field=(key,fallback='')=>st[key]!==undefined?st[key]:fallback;
    const fullChecked=field('full',false)?'checked':'';
    return `<div class="sale-page"><div class="sale-head"><p class="status" style="margin:0">Record a sale for ${esc(biz().name)}</p><button class="btn secondary" data-action="back-sales">↓ Sales List</button></div><div class="section"><div class="section-body"><div class="ns-customer-scroll"><div class="ns-customer-row"><div class="field"><label>Customer Name</label><input id="nsName" value="${esc(field('name',c?.name||'Walk-in Customer'))}" placeholder="Customer"></div><div class="field"><label>Phone</label><input id="nsPhone" value="${esc(field('phone',c?.phone||''))}" placeholder="Phone"></div><div class="field"><label>Address</label><input id="nsAddress" value="${esc(field('address',c?.address||''))}" placeholder="Address"></div><div class="field"><label>Date</label><input id="nsDate" type="date" value="${esc(field('date',s.date||today))}"></div>${invoiceFieldMarkup(field('invoiceNo',s.invoiceNo||''))}</div></div><!-- Payment Status is calculated and stored internally; it is not shown on the New Sale screen. --><div id="nsCustomerNote" class="notice" style="display:none;margin-top:12px"></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Items</h3><button class="btn secondary small" data-action="add-sale-item">+ Add Item</button></div><div class="section-body"><div class="ns-item-head"><div>Item</div><div>Quantity</div><div>Unit Cost</div><div>Total</div><div>Actions</div></div><div id="nsItems"></div><div class="sale-summary-scroll"><div class="sale-summary"><div class="sale-summary-top"><div class="summary-pair grand-total-pair"><span>Grand Total</span><b id="nsGrandTotal">₦0</b></div><div class="summary-pair paid-pair"><label for="nsPaid">Paid Amount</label><input id="nsPaid" type="number" min="0" value="${Number(field('paid',s.paid||0))}"></div><label class="checkline summary-full-check"><input id="nsFull" type="checkbox" ${fullChecked}> Full-Payment</label></div><div class="sale-summary-bottom"><div></div><div class="outstanding"><span>Outstanding Amount</span><b id="nsOutstanding">₦0</b></div><div></div></div></div></div></div></div><div class="actions sale-actions"><button class="btn green" data-action="save-sale-page">Save Sale</button><button class="btn secondary" data-action="save-sale-page-new">Save & New</button></div></div>`;
  }
  function salesListSectionMarkup(searchId='salesSearchBelow',bodyId='salesBodyBelow'){
    const rows=scoped(db.sales).filter(s=>inRange(s.date));
    return `<div class="section sales-list-below" id="salesListBelow" style="margin-top:24px"><div class="section-head"><h3>Sales List</h3><span class="status" id="salesRowsCount">${rows.length} sale(s)</span></div><div class="section-body">
      <div class="sales-filter-grid">
        <div class="field"><label>Filter</label><select id="salesFilter"><option value="all" selected>All</option><option value="invoiceNo">Invoice No.</option><option value="entryDate">Entry Date</option><option value="transactionDate">Transaction Date</option><option value="payment">Payment</option><option value="items">No. of Items</option><option value="salesAmount">Sales Amount</option><option value="receivedAmount">Received Amount</option><option value="creditAmount">Credit Amount</option></select></div>
        <div class="field" id="salesOption2Wrap" style="display:none"><label>Option 2</label><select id="salesOption2"></select></div>
        <div class="field" id="salesOption3Wrap" style="display:none"><label>Option 3</label><input id="salesOption3" placeholder="Enter value"></div>
        <div class="field"><label>Search Customer</label><input id="${searchId}" class="search" placeholder="Search customer"></div>
        <div class="field"><label>Order</label><select id="salesOrder"><option value="desc" selected>Descending</option><option value="asc">Ascending</option></select></div>
      </div>
      <div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Invoice No.</th><th>Transaction Date</th><th>Entry Date</th><th>Payment</th><th>Items</th><th class="right">Sales</th><th class="right">Received</th><th class="right">Credit</th><th>Actions</th></tr></thead>
      <tbody id="${bodyId}"></tbody></table></div></div></div>`;
  }
  function bindSalesListSearch(searchId='salesSearchBelow',bodyId='salesBodyBelow'){
    const search=document.getElementById(searchId);if(!search)return;
    search.oninput=e=>document.querySelectorAll(`#${bodyId} tr`).forEach(r=>r.style.display=r.dataset.search?.toLowerCase().includes(e.target.value.toLowerCase())?'':'none');
  }
  function renderNewSalePage(){
    document.getElementById('page-sales').innerHTML=salePageTemplate(editingSaleId?db.sales.find(s=>s.id===editingSaleId):null)+salesListSectionMarkup();
    bindSalesListSearch();
    renderSaleRows();
    populateInvoiceForNewSale();
    document.querySelectorAll('.invoice-step').forEach(btn=>btn.onclick=()=>changeInvoiceInput(Number(btn.dataset.invoiceStep||0)));
    document.getElementById('nsInvoiceNo')?.addEventListener('input',()=>captureSalePageForm());
    const phone=document.getElementById('nsPhone'),paid=document.getElementById('nsPaid'),full=document.getElementById('nsFull');
    phone?.addEventListener('input',salePageCustomerState);phone?.addEventListener('blur',salePageCustomerState);
    paid?.addEventListener('input',updateSalePageTotals);full?.addEventListener('change',updateSalePageTotals);
    document.getElementById('nsItems')?.addEventListener('input',e=>{
      if(e.target.matches('.ns-prod-name')){
        const idx=Number(e.target.dataset.i);if(!saleDraftItems[idx])return;saleDraftItems[idx].itemName=e.target.value.trim();
        updateSaleProductRow(idx,{resolve:true});readSalePageItems();updateSalePageTotals();return;
      }
      if(e.target.matches('.ns-qty')){
        const idx=Number(e.target.dataset.i);readSalePageItems();const item=saleDraftItems[idx];
        if(item?.productId){const product=db.products.find(p=>p.id===item.productId&&p.businessId===db.activeBusinessId);const oldSale=editingSaleId?db.sales.find(v=>v.id===editingSaleId):null;const branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():(oldSale?.branchId||''))||(branchesFor(db.activeBusinessId)[0]?.id||'');const prior=oldSale?.branchId===branchId?Number(saleQuantityMap(oldSale.items||[])[item.productId]||0):0;const available=product?Math.max(0,productStockAt(product,branchId)+prior):0;const requested=Number(e.target.value||0);if(requested>available){alert(`Only ${available} ${product?.unit||'units'} of ${product?.name||'this product'} are available in the selected Dashboard branch.`);item.qty=available;e.target.value=String(available);}}
      }
      updateSalePageTotals();
    });
    document.getElementById('nsItems')?.addEventListener('change',e=>{
      if(e.target.matches('.ns-prod-name')){
        const idx=Number(e.target.dataset.i);updateSaleProductRow(idx,{resolve:true,alertDuplicate:true});readSalePageItems();renderSaleRows();return;
      }
      updateSalePageTotals();
    });
    document.getElementById('nsItems')?.addEventListener('click',e=>{
      const btn=e.target.closest('.ns-save-product');if(!btn)return;const idx=Number(btn.dataset.i);const row=btn.closest('.ns-item-row');const name=(row?.querySelector('.ns-prod-name')?.value||'').trim();if(!name)return;
      const existing=findBusinessProductByName(name);if(existing){alert('This product already exists in this business. Select the existing product instead of creating a duplicate.');updateSaleProductRow(idx,{resolve:true,alertDuplicate:true});return;}
      if(!window.getActiveBranchId?.()||window.getActiveBranchId()==='all'){alert('Select a specific branch from the Dashboard before saving a new product.');return;}
      window.newProduct(null,name,idx);
    });
    updateSalePageTotals();
  }
  function renderSalesList(){
    const rows=scoped(db.sales).filter(s=>inRange(s.date)).sort((a,b)=>b.date.localeCompare(a.date));
    document.getElementById('page-sales').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="salesSearch" placeholder="Search customer"></div><button class="btn" data-action="new-sale">+ New Sale</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Invoice No.</th><th>Transaction Date</th><th>Entry Date</th><th>Payment</th><th>Items</th><th class="right">Sales</th><th class="right">Received</th><th class="right">Credit</th><th>Actions</th></tr></thead><tbody id="salesBody">${rows.map(s=>{const st=paymentStatus(s);return `<tr data-search="${esc((cust(s.customerId).name||'')+' '+(s.invoiceNo||''))}"><td><b>${esc(cust(s.customerId).name)}</b></td><td><b>${esc(s.invoiceNo||'—')}</b></td><td>${esc(s.date||'')}</td><td>${esc((s.entryDate||s.createdAt||s.date||'').toString().replace('T',' ').slice(0,19))}</td><td class="${st==='Cash'?'green-text':(st==='Partly Credit'?'orange-text':'red-text')}">${st}</td><td>${s.items.length}</td><td class="right">${money(s.total)}</td><td class="right">${money(s.paid||0)}</td><td class="right">${money(saleOutstanding(s))}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-sale" data-id="${s.id}">Edit</button><button class="btn danger small" data-action="delete-sale" data-id="${s.id}">Delete</button></div></td></tr>`}).join('')||'<tr><td colspan="10" class="empty">No sales in this period.</td></tr>'}</tbody></table></div></div></div>`;
    document.getElementById('salesSearch').oninput=e=>document.querySelectorAll('#salesBody tr').forEach(r=>r.style.display=r.dataset.search?.toLowerCase().includes(e.target.value.toLowerCase())?'':'none');
  }

  function saleQuantityMap(items){const map={};(items||[]).forEach(it=>{const pid=it.productId;if(pid)map[pid]=(map[pid]||0)+Number(it.qty||0)});return map;}
  function branchStockPool(branchId){const br=db.branches.find(x=>x.id===branchId);if(!br)return {mode:'global',id:''};if(br.stockMode==='shared'&&br.stockSharedWith){const source=db.branches.find(x=>x.id===br.stockSharedWith);if(source?.stockMode==='separate')return {mode:'branch',id:source.id};return {mode:'global',id:''}}if(br.stockMode==='separate')return {mode:'branch',id:br.id};return {mode:'global',id:''}}
function productStockAt(product,branchId){const pool=branchStockPool(branchId);if(pool.mode==='branch')return Number(product.branchQty?.[pool.id]??0);return Number(product.qty||0)}
function adjustProductStockAt(product,branchId,delta){const pool=branchStockPool(branchId);if(pool.mode==='branch'){if(!product.branchQty)product.branchQty={};product.branchQty[pool.id]=Number(product.branchQty[pool.id]||0)+Number(delta||0)}else product.qty=Number(product.qty||0)+Number(delta||0)}
function validateSaleStock(items,oldSale,branchId){const next=saleQuantityMap(items),prior=saleQuantityMap(oldSale?.items||[]);for(const pid of Object.keys(next)){const product=db.products.find(p=>p.id===pid&&p.businessId===db.activeBusinessId);if(!product){alert('One of the selected stock items could not be found. Please select the item again.');return false;}const available=productStockAt(product,branchId)+(oldSale?.branchId===branchId?Number(prior[pid]||0):0);if(next[pid]>available){alert(`Insufficient stock for ${product.name}. Available: ${available} ${product.unit||'units'}; requested: ${next[pid]}.`);return false;}}return true;}
  function applySaleStockChange(oldSale,newItems,savedSaleId,branchId){const prior=saleQuantityMap(oldSale?.items||[]),next=saleQuantityMap(newItems||[]),ids=new Set([...Object.keys(prior),...Object.keys(next)]);ids.forEach(pid=>{const product=db.products.find(p=>p.id===pid&&p.businessId===db.activeBusinessId);if(!product)return;const oldBranch=oldSale?.branchId||branchId||'',newBranch=branchId||oldBranch;const oldQty=Number(prior[pid]||0),newQty=Number(next[pid]||0);if(oldSale&&oldBranch!==newBranch){if(oldQty)adjustProductStockAt(product,oldBranch,oldQty);if(newQty)adjustProductStockAt(product,newBranch,-newQty)}else{const delta=oldQty-newQty;if(delta)adjustProductStockAt(product,newBranch,delta)}if(oldQty!==newQty||oldBranch!==newBranch){if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:db.activeBusinessId,branchId:newBranch,productId:pid,qty:oldQty-newQty,type:oldSale?'sale_edit':'sale',saleId:savedSaleId,date:today,createdAt:new Date().toISOString()});}})}

  function captureSalePageForm(){
    return {name:document.getElementById('nsName')?.value??'Walk-in Customer',phone:document.getElementById('nsPhone')?.value??'',address:document.getElementById('nsAddress')?.value??'',date:document.getElementById('nsDate')?.value||today,invoiceNo:document.getElementById('nsInvoiceNo')?.value??'',paid:Number(document.getElementById('nsPaid')?.value||0),full:!!document.getElementById('nsFull')?.checked};
  }
  function findFirstMissingSaleProduct(){
    readSalePageItems();
    for(let i=0;i<saleDraftItems.length;i++){
      const item=saleDraftItems[i],name=String(item.itemName||'').trim();
      if(!name)return {invalid:true,index:i,message:`Enter a product name on item row ${i+1}, or remove that row.`};
      const existing=db.products.find(p=>p.businessId===db.activeBusinessId&&String(p.name||'').trim().toLowerCase()===name.toLowerCase());
      if(existing){item.productId=existing.id;item.itemName=existing.name;continue;}
      item.productId='';
      return {index:i,name};
    }
    const ids=saleDraftItems.map(x=>x.productId).filter(Boolean);
    if(new Set(ids).size!==ids.length)return {invalid:true,message:'The same product cannot be added more than once to a sale.'};
    return null;
  }
  function openNextMissingSaleProduct(asNew){
    const missing=findFirstMissingSaleProduct();
    if(!missing)return false;
    if(missing.invalid){if(pendingSaleSave)pendingSaleSave.running=false;alert(missing.message);return true;}
    const branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():(editingSaleId?db.sales.find(v=>v.id===editingSaleId)?.branchId:''));
    if(!branchId){if(pendingSaleSave)pendingSaleSave.running=false;alert('Select a specific branch from the Dashboard before registering missing products or recording the sale. Your pending sale details have been retained.');return true;}
    if(pendingSaleSave){pendingSaleSave.running=true;pendingSaleSave.asNew=asNew;pendingSaleSave.awaitingProduct=missing.name;}
    window.newProduct(null,missing.name,missing.index);
    const cancel=document.getElementById('cancelModal');
    if(cancel&&pendingSaleSave)cancel.addEventListener('click',()=>{if(pendingSaleSave)pendingSaleSave.running=false;},{once:true});
    return true;
  }
  function saveSalePage(asNew){
    if(saleCommitInProgress||pendingSaleSave?.running){alert('This sale is already being processed. Please wait for the current step to finish.');return;}
    readSalePageItems();
    pendingSaleFormState=captureSalePageForm();
    if(!pendingSaleSave)pendingSaleSave={asNew:!!asNew,running:false,startedAt:new Date().toISOString()};
    else pendingSaleSave.asNew=!!asNew;
    pendingSaleSave.running=true;
    if(openNextMissingSaleProduct(!!asNew))return;
    return commitSalePage(!!asNew);
  }
  function commitSalePage(asNew){
    const fail=message=>{if(pendingSaleSave)pendingSaleSave.running=false;alert(message);return false;};
    if(saleCommitInProgress)return fail('This sale is already being saved.');
    saleCommitInProgress=true;
    try{
      readSalePageItems();
      pendingSaleFormState=captureSalePageForm();
      const {name:rawName,phone:rawPhone,address:rawAddress,date,invoiceNo,paid,full}=pendingSaleFormState;
      const name=String(rawName||'').trim(),phone=String(rawPhone||'').trim(),address=String(rawAddress||'').trim();
      const branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():(editingSaleId?db.sales.find(v=>v.id===editingSaleId)?.branchId:''));
      const items=saleDraftItems.filter(x=>x.productId&&Number(x.qty)>0);
      if(!items.length)return fail('Add at least one complete item before saving the sale.');
      if(items.length!==saleDraftItems.length)return fail('Complete every item row or remove any blank rows before saving.');
      if(new Set(items.map(x=>x.productId)).size!==items.length)return fail('The same product cannot be added more than once to a sale.');
      if(items.some(x=>!Number.isFinite(Number(x.qty))||Number(x.qty)<=0||!Number.isFinite(Number(x.price))||Number(x.price)<0))return fail('Check every item quantity and price. Quantity must be greater than zero and price cannot be negative.');
      const total=items.reduce((a,x)=>a+Number(x.qty)*Number(x.price),0);
      const effectivePaid=full?total:Number(paid||0);
      const type=total<=0||effectivePaid>=total?'cash':(effectivePaid>0?'partly_credit':'credit');
      if(effectivePaid<0||effectivePaid>total)return fail('Paid Amount cannot be less than ₦0 or greater than the Grand Total.');
      const hasOutstanding=effectivePaid<total;
      const cleanInvoice=String(invoiceNo||'').trim();
      if(!cleanInvoice)return fail('Invoice No. is required. Enter an Invoice No. before saving the sale.');
      const invoicePart=invoiceParts(cleanInvoice);
      if(!invoicePart)return fail('Invoice No. must end with a number, for example INV-0001.');
      const invoiceDuplicate=db.sales.find(v=>v.businessId===db.activeBusinessId&&String(v.invoiceNo||'').trim().toLowerCase()===cleanInvoice.toLowerCase()&&v.id!==editingSaleId);
      if(invoiceDuplicate)return fail(`Invoice No. ${cleanInvoice} is already in use. Choose the next invoice number.`);
      if(hasOutstanding&&(!phone||!name||name==='Walk-in Customer'||!address))return fail('Credit or Partly Credit sales require Customer Name, Phone and Address.');
      if(!phone&&name!=='Walk-in Customer'&&(!name||!address))return fail('Enter the customer Name, Phone and Address, or use Walk-in Customer for a fully paid sale.');
      if(!branchId)return fail('Select a specific branch from the Dashboard before recording the sale.');
      // Final product and stock validation occurs immediately before any sale/customer write.
      const normalizedItems=items.map(x=>({productId:x.productId,qty:Number(x.qty),price:Number(x.price)}));
      const oldRecord=editingSaleId?db.sales.find(v=>v.id===editingSaleId):null;
      const oldSale=oldRecord?{...oldRecord,items:(oldRecord.items||[]).map(item=>({...item}))}:null;
      for(const item of normalizedItems){
        const p=db.products.find(p=>p.id===item.productId&&p.businessId===db.activeBusinessId);
        if(!p)return fail('A product is no longer available in this business. Your pending sale has been retained; check the product list and try again.');
      }
      if(!validateSaleStock(normalizedItems,oldSale,branchId)){if(pendingSaleSave)pendingSaleSave.running=false;return false;}
      if(editingSaleId&&!oldRecord)return fail('The sale being edited could not be found. No new sale was recorded.');
      let customer=db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone&&phone);
      let newCustomerRecord=null;
      if(customer){
        const sameEntered=customer.name===name&&((customer.address||'')===address);
        if(!sameEntered&&!confirm(`This phone number belongs to ${customer.name}. Use the existing customer details instead?`)){if(pendingSaleSave)pendingSaleSave.running=false;return false;}
      } else if(phone){newCustomerRecord={id:id(),businessId:db.activeBusinessId,branchId,name,phone,address,opening:0};customer=newCustomerRecord;}
      // Prevent a duplicate transaction on retry. Use a unique invoice number when recording a genuinely separate sale with identical details.
      const duplicate=db.sales.find(s=>{if(editingSaleId&&s.id===editingSaleId)return false;if(s.businessId!==db.activeBusinessId||s.date!==date||String(s.invoiceNo||'')!==String(invoiceNo||'')||s.type!==type||Number(s.total)!==Number(total)||Number(s.paid||0)!==Number(effectivePaid)||s.customerId!==(customer?.id||''))return false;return JSON.stringify((s.items||[]).map(x=>({productId:x.productId,qty:Number(x.qty),price:Number(x.price)})))===JSON.stringify(normalizedItems)});
      if(duplicate)return fail('An identical sale is already recorded. The sale was not saved again. If this is a separate transaction, enter a distinct Invoice No. and retry.');
      // Apply the sale and stock movements as one in-memory transaction. Roll back all touched state if any write fails.
      const salesBefore=db.sales.slice(),customersBefore=db.customers.slice(),auditBefore=Array.isArray(db.auditTrail)?db.auditTrail.slice():null,movementsBefore=Array.isArray(db.stockMovements)?db.stockMovements.length:null;
      const stockBefore=db.products.map(p=>({p,qty:p.qty,branchQty:p.branchQty?{...p.branchQty}:null}));
      const priorPending=pendingSaleSave;
      try{
        if(newCustomerRecord)db.customers.push(newCustomerRecord);
        let savedSaleId;
        if(editingSaleId){const s=db.sales.find(v=>v.id===editingSaleId);Object.assign(s,{customerId:customer?.id||'',date,invoiceNo,type,paid:effectivePaid,items:normalizedItems,total,branchId,entryDate:s.entryDate||new Date().toISOString()});savedSaleId=s.id;}
        else {savedSaleId=id();db.sales.push({id:savedSaleId,businessId:db.activeBusinessId,branchId,customerId:customer?.id||'',date,invoiceNo,type,paid:effectivePaid,items:normalizedItems,total,createdBy:currentAdminId,entryDate:new Date().toISOString(),createdAt:new Date().toISOString(),submissionKey:priorPending?.startedAt||new Date().toISOString()});}
        applySaleStockChange(oldSale,normalizedItems,savedSaleId,branchId);
        if(!editingSaleId)seedInvoiceSequence(cleanInvoice);
        auditEvent(editingSaleId?'Sale edited':'Sale recorded',`Sale ${savedSaleId}; total ${total}; branch ${branchId}; invoice ${cleanInvoice}`);
        save();
      }catch(txError){
        db.sales=salesBefore;db.customers=customersBefore;stockBefore.forEach(x=>{x.p.qty=x.qty;if(x.branchQty)x.p.branchQty={...x.branchQty};else delete x.p.branchQty;});
        if(movementsBefore!==null&&Array.isArray(db.stockMovements))db.stockMovements.length=movementsBefore;
        if(auditBefore!==null)db.auditTrail=auditBefore;
        if(pendingSaleSave)pendingSaleSave.running=false;
        throw txError;
      }
      pendingSaleSave=null;pendingSaleFormState=null;saleCommitInProgress=false;
      if(asNew){editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;salesView='new';render();}else{editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;pendingSaleFormState=null;salesView='new';render();document.getElementById('salesListBelow')?.scrollIntoView({behavior:'smooth',block:'start'});}
      return true;
    }catch(err){if(pendingSaleSave)pendingSaleSave.running=false;alert('The sale could not be completed. Your pending details have been retained. '+(err?.message||String(err)));return false;}
    finally{saleCommitInProgress=false;}
  }


  async function adminMessagesRequest(path,opts={}){
    const c=onlineConfig();if(!c.url||!c.key)throw new Error('Connect the Admin App to Supabase first.');
    let base=c.url.trim().replace(/\/$/,'').replace(/\/dashboard\/.*$/,'').replace(/\/project\/[^/]+.*$/,'');
    const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),10000);
    try{return await fetch(base+path,{...opts,signal:controller.signal,headers:{apikey:c.key.trim(),Authorization:'Bearer '+c.key.trim(),'Content-Type':'application/json',Accept:'application/json',...(opts.headers||{})}})}
    catch(e){if(e.name==='AbortError')throw new Error('Supabase request timed out after 10 seconds. Check the Admin connection settings.');throw e}
    finally{clearTimeout(timer)}
  }
  async function loadAdminMessages(){
    const el=document.getElementById('page-messages');if(!el)return;
    const b=biz();
    try{
      // Fetch the complete message rows first, then normalize/filter locally. This avoids losing messages when an older
      // database row uses client_key/body/sender instead of the newer client_id/message/sender_type names.
      const r=await adminMessagesRequest('/rest/v1/client_messages?select=*&order=created_at.desc');
      if(!r.ok)throw new Error(await r.text());
      const raw=await r.json();
      const normalize=x=>({id:x.id,feed_id:x.feed_id||x.feedId||'',business_id:x.business_id||x.businessId||'',client_id:x.client_id||x.client_key||'',branch_id:x.branch_id||x.branchId||null,sender_type:x.sender_type||(String(x.sender||'').toLowerCase().includes('admin')?'admin':'client'),sender_name:x.sender_name||x.client_name||x.sender||'',message:x.message||x.body||'',created_at:x.created_at,read_at:x.read_at||null,reply_to:x.reply_to||null});
      const all=raw.map(normalize);
      const rows=all.filter(x=>x.feed_id===String(b.clientFeedId)||x.business_id===String(b.id));
      const unread=rows.filter(x=>x.sender_type==='client'&&!x.read_at).length;
      const mismatch=all.length>0&&rows.length===0;
      el.innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Messages <b>${rows.length}</b></span><span class="pill">Unread <b>${unread}</b></span></div><button class="btn secondary" data-action="refresh-messages">Refresh</button></div>${mismatch?`<div class="warning">Messages exist in Supabase, but none match this business's Client Feed ID (${esc(b.clientFeedId)}). The Admin App is showing the available diagnostic instead of staying on Loading.</div>`:''}<div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Sender</th><th>Message</th><th>Branch</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody>${rows.length?rows.map(x=>`<tr><td>${esc(x.sender_type==='client'?'Client':(x.sender_name||'Admin'))}</td><td style="white-space:normal;min-width:220px">${esc(x.message)}</td><td>${esc(branchFor(x.branch_id)?.name||x.branch_id||'All Branches')}</td><td>${x.created_at?new Date(x.created_at).toLocaleString():''}</td><td>${x.sender_type==='client'?(x.read_at?'Read':'<b class="red-text">Unread</b>'):'Sent'}</td><td><button class="btn small" data-action="reply-client-message" data-id="${x.id}">Reply</button>${x.sender_type==='client'&&!x.read_at?` <button class="btn secondary small" data-action="mark-message-read" data-id="${x.id}">Mark Read</button>`:''}</td></tr>`).join(''):'<tr><td colspan="6" class="empty">No client messages for this business.</td></tr>'}</tbody></table></div></div></div>`;
      // Bind Reply buttons directly. This bypasses the global delegated handler so the button
      // remains responsive even when other page-level handlers or dynamic re-renders are involved.
      el.querySelectorAll('button[data-action="reply-client-message"]').forEach(btn=>{
        btn.addEventListener('click',ev=>{
          ev.preventDefault();
          ev.stopPropagation();
          const id=btn.dataset.id;
          openModal('Reply to Client','<div class="status">Loading the client message…</div>',async()=>false);
          replyClientMessage(id).catch(e=>{closeModal();alert('Unable to open reply: '+(e?.message||String(e)))})
        });
      });
    }catch(e){el.innerHTML=`<div class="toolbar"><button class="btn secondary" data-action="refresh-messages">Refresh</button></div><div class="warning">Unable to load Client Messages. ${esc(e.message)}</div>`}
  }
  let adminMessagePoll=null;
  function startAdminMessagePolling(){
    if(adminMessagePoll)clearInterval(adminMessagePoll);
    adminMessagePoll=setInterval(()=>{if(currentPage==='messages')loadAdminMessages()},5000);
  }
  startAdminMessagePolling();

  async function replyClientMessage(id){
    const r0=await adminMessagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(id)+'&select=*');
    if(!r0.ok)throw new Error(await r0.text());
    const rows=await r0.json();
    const raw=rows[0];
    if(!raw)throw new Error('The selected client message could not be found. Refresh the messages list and try again.');
    const m={
      id:raw.id,
      feed_id:raw.feed_id||raw.feedId||null,
      business_id:raw.business_id||raw.businessId||null,
      client_id:raw.client_id||raw.client_key||null,
      client_key:raw.client_key||raw.client_id||null,
      branch_id:raw.branch_id||raw.branchId||null,
      client_name:raw.client_name||raw.sender_name||raw.sender||'Client',
      message:raw.message||raw.body||''
    };
    openModal('Reply to Client',`<div class="form-grid"><div class="field full"><label>Client Message</label><textarea disabled>${esc(m.message)}</textarea></div><div class="field full"><label>Reply</label><textarea id="adminReply" placeholder="Type your reply…"></textarea></div></div>`,async()=>{
      const text=document.getElementById('adminReply').value.trim();
      if(!text){alert('Please enter a reply.');return false}
      const adminName=db.admins.find(x=>x.id===currentAdminId)?.name||'Admin';
      const payload={
        feed_id:m.feed_id,
        client_id:m.client_id,
        branch_id:m.branch_id,
        sender_type:'admin',
        sender_name:adminName,
        message:text,
        reply_to:m.id
      };
      const r=await adminMessagesRequest('/rest/v1/client_messages',{method:'POST',headers:{Prefer:'return=minimal'},body:JSON.stringify(payload)});
      if(!r.ok){alert('Unable to send reply: '+await r.text());return false}
      const mark=await adminMessagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(m.id),{method:'PATCH',body:JSON.stringify({read_at:new Date().toISOString()})});
      if(!mark.ok){alert('Reply sent, but the original message could not be marked as read: '+await mark.text())}
      await loadAdminMessages();
      alert('Reply sent successfully.');
      return true
    });
  }
  // Final render router: keep each requested combined page alive after saves and navigation.
  const baseRender=window.render;
  window.render=function(){
    ensureTopControls();
    if(currentPage==='sales'&&salesView==='new'){
      document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
      document.getElementById('page-sales').classList.add('active');
      document.querySelectorAll('#nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page==='sales'));
      document.getElementById('pageTitle').textContent='Sales';
      document.getElementById('periodText').textContent=`${biz().name} • ${periodLabel()}`;
      renderNewSalePage();
    }else if(currentPage==='customers'){
      document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
      document.getElementById('page-customers').classList.add('active');
      document.querySelectorAll('#nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page==='customers'));
      document.getElementById('pageTitle').textContent='Customers';
      document.getElementById('periodText').textContent=`${biz().name} • ${periodLabel()}`;
      renderCustomers();
    }else if(currentPage==='payments'){
      document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
      document.getElementById('page-payments').classList.add('active');
      document.querySelectorAll('#nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page==='payments'));
      document.getElementById('pageTitle').textContent='Debtors & Payments';
      document.getElementById('periodText').textContent=`${biz().name} • ${periodLabel()}`;
      renderPayments();
    }else if(currentPage==='expenses'){
      document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));
      document.getElementById('page-expenses').classList.add('active');
      document.querySelectorAll('#nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page==='expenses'));
      document.getElementById('pageTitle').textContent='Expenses';
      document.getElementById('periodText').textContent=`${biz().name} • ${periodLabel()}`;
      renderExpenses();
    }else{
      baseRender();
    }
    ensureTopControls();
    if(currentPage==='messages')loadAdminMessages();
    const bsel=document.getElementById('branchSelect');if(bsel){const brs=branchesFor(db.activeBusinessId);bsel.innerHTML='<option value="all">All Branches</option>'+brs.map(b=>`<option value="${b.id}">${esc(b.name)}</option>`).join('');bsel.value=activeBranchId;}
    const p=document.getElementById('period');if(p)p.value=period;const c=document.getElementById('customDates');if(c)c.style.display=period==='custom'?'inline-flex':'none';
    const title=document.getElementById('pageTitle');if(title&&currentPage==='admins')title.textContent='Staff';
  };

  // Replace date change listener by adding a second listener; the latest state wins.
  const pe=document.getElementById('period');if(pe)pe.addEventListener('change',e=>{period=e.target.value;if(period==='custom'){ensureTopControls();const c=document.getElementById('customDates');if(c)c.style.display='inline-flex'}else render()});

  // Make saves persist and sync the selected business feed when configured.
  const originalSave=window.save;
  window.save=function(){originalSave();if(typeof publishBusiness==='function'){publishBusiness().catch(()=>{})}};


  // Agreed expense structure: no Category field.
  window.renderExpenses=function(){const rows=scoped(db.expenses).filter(e=>inRange(e.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-expenses').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Expenses <b>${rows.length}</b></span><span class="pill">Total <b>${money(rows.reduce((a,e)=>a+e.amount,0))}</b></span></div><button class="btn" data-action="new-expense">+ New Expense</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Paid To</th><th>Payment Method</th><th>Actions</th></tr></thead><tbody>${rows.map(e=>`<tr><td>${e.date}</td><td>${esc(e.description)}</td><td class="right">${money(e.amount)}</td><td>${esc(e.vendor||'')}</td><td>${esc(e.method||'')}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-expense" data-id="${e.id}">Edit</button><button class="btn danger small" data-action="delete-expense" data-id="${e.id}">Delete</button></div></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No expenses in this period.</td></tr>'}</tbody></table></div></div></div>`}
  window.newExpense=function(existing){openModal(existing?'Edit Expense':'New Expense',`<div class="form-grid"><div class="field"><label>Description</label><input id="fDesc" value="${esc(existing?.description||'')}"></div><div class="field"><label>Amount</label><input id="fAmount" type="number" value="${existing?.amount||''}"></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${existing?.date||today}"></div><div class="field"><label>Paid To</label><input id="fVendor" value="${esc(existing?.vendor||'')}"></div><div class="field"><label>Payment Method</label><select id="fMethod"><option ${existing?.method==='Cash'?'selected':''}>Cash</option><option ${existing?.method==='Transfer'?'selected':''}>Transfer</option><option ${existing?.method==='POS'?'selected':''}>POS</option></select></div><div class="field full"><label>Notes</label><textarea id="fNotes">${esc(existing?.notes||'')}</textarea></div></div>`,()=>{const branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():'')||existing?.branchId||'';const o={description:document.getElementById('fDesc').value.trim(),amount:Number(document.getElementById('fAmount').value||0),date:document.getElementById('fDate').value,branchId,vendor:document.getElementById('fVendor').value.trim(),method:document.getElementById('fMethod').value,notes:document.getElementById('fNotes').value};if(!o.description||!o.amount)return false;if(!branchId){alert('Select a specific branch from the Dashboard before recording the expense.');return false}if(existing)Object.assign(existing,o);else db.expenses.push({id:id(),businessId:db.activeBusinessId,...o,createdBy:currentAdminId});save();render();return true})}
  // Branch-aware stock entry: Category is intentionally not part of the New Stock form.
  window.newProduct=function(existing,prefillName='',saleRowIndex=null){const b=biz();if(!Array.isArray(b.productNameList))b.productNameList=[];const branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():'');if(!branchId){alert('Select a specific branch from the Dashboard before creating or adjusting stock.');return}const pool=globalBranchStockPool(branchId);const qtyNow=existing?(pool.mode==='branch'?Number(existing.branchQty?.[pool.id]||0):Number(existing.qty||0)):0;const initialName=existing?.name||prefillName||'';openModal(existing?'Edit Product':'New Product',`<div class="form-grid"><div class="field"><label>Item Name</label><input id="fName" list="businessProductNames" value="${esc(initialName)}" ${prefillName&&!existing?'readonly':''}><datalist id="businessProductNames">${b.productNameList.map(n=>`<option value="${esc(n)}"></option>`).join('')}</datalist></div><div class="field"><label>Unit</label><input id="fUnit" value="${esc(existing?.unit||'Unit')}"></div><div class="field"><label>Cost Price</label><input id="fCost" type="number" min="0" step="0.01" value="${existing?.cost??''}"></div><div class="field"><label>Selling Price *</label><input id="fSell" type="number" min="0.01" step="0.01" value="${existing?.sell??''}" required></div><div class="field"><label>Quantity (${esc(branchesFor(db.activeBusinessId).find(x=>x.id===branchId)?.name||'Main Branch')}) *</label><input id="fQty" type="number" min="0" step="1" value="${existing?qtyNow:''}" required></div><div class="field"><label>Reorder Level</label><input id="fReorder" type="number" min="0" value="${existing?.reorder||0}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim();const unit=document.getElementById('fUnit').value.trim();const costRaw=document.getElementById('fCost').value.trim();const sellRaw=document.getElementById('fSell').value.trim();const qtyRaw=document.getElementById('fQty').value.trim();const cost=Number(costRaw),sell=Number(sellRaw),qty=Number(qtyRaw);if(!name){alert('Item Name is required.');return false}if(!unit){alert('Unit is required.');return false}if(costRaw===''||!Number.isFinite(cost)||cost<0){alert('Enter a valid Cost Price (zero is allowed).');return false}if(sellRaw===''||!Number.isFinite(sell)||sell<=0){alert('Enter a Selling Price greater than zero.');return false}if(qtyRaw===''||!Number.isFinite(qty)||qty<0||(saleRowIndex!==null&&qty<=0)){alert(saleRowIndex!==null?'Enter a Quantity greater than zero when adding a product from New Sale.':'Enter a valid Quantity. Zero is allowed when setting up a product without opening stock.');return false}const duplicate=db.products.find(p=>p.businessId===db.activeBusinessId&&p.id!==existing?.id&&String(p.name||'').trim().toLowerCase()===name.toLowerCase());if(duplicate){alert('This product already exists in this business. Select the existing product instead of creating a duplicate.');return false}const o={name,unit,cost,sell,reorder:Math.max(0,Number(document.getElementById('fReorder').value||0))};const branchRecord=db.branches.find(br=>br.id===branchId);const branchIdsForCurrentStock=[branchId];if(branchRecord?.stockMode==='shared'&&branchRecord.stockSharedWith){const sharedSource=db.branches.find(br=>br.id===branchRecord.stockSharedWith);if(sharedSource?.stockMode==='separate')branchIdsForCurrentStock.push(sharedSource.id)}let savedProduct;if(existing){const assigned=Array.from(new Set([...(Array.isArray(existing.branchIds)?existing.branchIds:[]),...branchIdsForCurrentStock]));Object.assign(existing,o,{branchIds:assigned});if(pool.mode==='branch'){if(!existing.branchQty)existing.branchQty={};existing.branchQty[pool.id]=qty}else existing.qty=qty;savedProduct=existing}else{savedProduct={id:id(),businessId:db.activeBusinessId,branchIds:branchIdsForCurrentStock,...o,qty:pool.mode==='branch'?0:qty,branchQty:{}};if(pool.mode==='branch')savedProduct.branchQty[pool.id]=qty;db.products.push(savedProduct);if(qty>0){if(!Array.isArray(db.stockMovements))db.stockMovements=[];db.stockMovements.push({id:id(),businessId:db.activeBusinessId,branchId,productId:savedProduct.id,qty,type:'opening_stock',notes:'Opening stock entered when product was created',previousQty:0,resultQty:qty,actorName:db.admins.find(a=>a.id===currentAdminId)?.name||'Current Admin',date:today,createdAt:new Date().toISOString()})}}if(!b.productNameList.some(n=>String(n).trim().toLowerCase()===name.toLowerCase()))b.productNameList.push(name);if(saleRowIndex!==null&&Array.isArray(saleDraftItems)&&saleDraftItems[saleRowIndex]){saleDraftItems[saleRowIndex].productId=savedProduct.id;saleDraftItems[saleRowIndex].itemName=savedProduct.name;saleDraftItems[saleRowIndex].price=Number(savedProduct.sell||0)}save();render();if(pendingSaleSave){setTimeout(()=>{if(pendingSaleSave){pendingSaleSave.running=false;saveSalePage(pendingSaleSave.asNew)}},0)}return true})}


  // Sales navigation opens New Sale directly. The sales list remains reachable through Back to Sales.
  document.getElementById('nav')?.addEventListener('click',function(e){const b=e.target.closest('button[data-page="sales"]');if(!b)return;e.stopImmediatePropagation();if(pendingSaleSave){salesView='new';currentPage='sales';document.getElementById('sidebar').classList.remove('open');render();return;}salesView='new';editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;pendingSaleFormState=null;pendingSaleSave=null;currentPage='sales';document.getElementById('sidebar').classList.remove('open');render()},true);
  document.addEventListener('click',function(e){const r=e.target.closest('.ns-remove');if(r){readSalePageItems();saleDraftItems.splice(Number(r.dataset.i),1);if(!saleDraftItems.length)saleDraftItems.push({productId:'',itemName:'',qty:1,price:0});render();}});


  // === Combined inline forms + filtered sales list (requested UI revision) ===
  let inlineCustomerEditId=null, inlinePaymentEditId=null, inlineExpenseEditId=null;

  function inlineCustomerForm(){
    const c=inlineCustomerEditId?db.customers.find(x=>x.id===inlineCustomerEditId):null;
    return `<div class="section"><div class="section-head"><h3>${c?'Edit Customer':'New Customer'}</h3>${c?'<button class="btn secondary small" data-action="cancel-inline-customer">Cancel</button>':''}</div><div class="section-body">
      <div class="inline-form-row">
        <div class="field"><label>Name *</label><input id="icName" value="${esc(c?.name||'')}"></div>
        <div class="field"><label>Phone</label><input id="icPhone" value="${esc(c?.phone||'')}"></div>
        <div class="field"><label>Address</label><input id="icAddress" value="${esc(c?.address||'')}"></div>
      </div>
      <div class="inline-form-actions customer-save-row"><button class="btn green" data-action="save-inline-customer">Save Customer</button></div>
    </div></div>`;
  }
  function renderCustomers(){
    const t=totals(), rows=scoped(db.customers);
    document.getElementById('page-customers').innerHTML=inlineCustomerForm()+`<div class="section" style="margin-top:14px"><div class="section-head"><h3>Customers</h3><span class="status">${rows.length} customer(s)</span></div><div class="section-body"><div class="toolbar"><input class="search" id="customerSearch" placeholder="Search customer"></div><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Phone</th><th>Address</th><th class="right">Balance</th><th>Actions</th></tr></thead><tbody id="customerBody">${rows.map(c=>{let o=t.owing.find(x=>x.id===c.id)?.balance||0;return `<tr data-search="${esc((c.name||'')+' '+(c.phone||'')+' '+(c.address||''))}"><td><b>${esc(c.name)}</b></td><td>${esc(c.phone)}</td><td>${esc(c.address)}</td><td class="right ${o?'red-text':''}">${money(o)}</td><td><button class="btn secondary small" data-action="edit-inline-customer" data-id="${c.id}">Edit</button></td></tr>`}).join('')||'<tr><td colspan="5" class="empty">No customers yet.</td></tr>'}</tbody></table></div></div></div>`;
    document.getElementById('customerSearch').oninput=e=>document.querySelectorAll('#customerBody tr').forEach(r=>r.style.display=(r.dataset.search||'').toLowerCase().includes(e.target.value.toLowerCase())?'':'none');
  }

  function inlinePaymentForm(){
    const p=inlinePaymentEditId?db.payments.find(x=>x.id===inlinePaymentEditId):null;
    const customerOptionsHtml=customerOptions();
    const selected=p?.customerId||'';
    const opts=customerOptionsHtml.replace(/<option value="([^"]*)"/g,(m,v)=>m+(v===selected?' selected':''));
    return `<div class="section"><div class="section-head"><h3>${p?'Edit Debtor Payment':'Record Debtor Payment'}</h3>${p?'<button class="btn secondary small" data-action="cancel-inline-payment">Cancel</button>':''}</div><div class="section-body">
      <div class="inline-five-row">
        <div class="field"><label>Customer / Debtor *</label><select id="ipCustomer">${opts}</select></div>
        <div class="field"><label>Total Amount Owed</label><input id="ipOwed" value="₦0" disabled></div>
        <div class="field"><label>Date *</label><input id="ipDate" type="date" value="${esc(p?.date||today)}"></div>
        <div class="field"><label>Amount Paid *</label><input id="ipAmount" type="number" min="0" step="0.01" value="${p?.amount??''}"></div>
        <div class="field"><label>Method *</label><select id="ipMethod">${['Cash','Transfer','Bank Transfer'].map(x=>`<option ${p?.method===x?'selected':''}>${x}</option>`).join('')}</select></div>
      </div>
      <div class="inline-note-row"><div class="field"><label>Note</label><input id="ipNote" value="${esc(p?.note||'')}"></div><div></div><div class="inline-form-actions"><button class="btn green" data-action="save-inline-payment">Save Payment</button></div></div>
    </div></div>`;
  }
  function renderPayments(){
    const rows=scoped(db.payments).filter(p=>inRange(p.date)).sort((a,b)=>b.date.localeCompare(a.date));
    document.getElementById('page-payments').innerHTML=inlinePaymentForm()+`<div class="section" style="margin-top:14px"><div class="section-head"><h3>Debtors &amp; Payments</h3><span class="status">${rows.length} payment(s) • ${money(rows.reduce((a,p)=>a+Number(p.amount||0),0))} received</span></div><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Method</th><th>Note</th><th class="right">Amount</th><th>Actions</th></tr></thead><tbody>${rows.map(p=>`<tr><td>${esc(cust(p.customerId).name)}</td><td>${esc(p.date)}</td><td>${esc(p.method||'')}</td><td>${esc(p.note||'')}</td><td class="right">${money(p.amount)}</td><td><button class="btn secondary small" data-action="edit-inline-payment" data-id="${p.id}">Edit</button> <button class="btn danger small" data-action="delete-payment" data-id="${p.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No payments in this period.</td></tr>'}</tbody></table></div></div></div>`;
    const sel=document.getElementById('ipCustomer'), owed=document.getElementById('ipOwed');
    const update=()=>{const c=scoped(db.customers).find(v=>v.id===sel?.value);if(owed)owed.value=money(customerOutstanding(c?.id));};
    sel?.addEventListener('change',update); update();
  }

  function inlineExpenseForm(){
    const e=inlineExpenseEditId?db.expenses.find(x=>x.id===inlineExpenseEditId):null;
    return `<div class="section"><div class="section-head"><h3>${e?'Edit Expense':'New Expense'}</h3>${e?'<button class="btn secondary small" data-action="cancel-inline-expense">Cancel</button>':''}</div><div class="section-body">
      <div class="inline-five-row">
        <div class="field"><label>Description *</label><input id="ieDesc" value="${esc(e?.description||'')}"></div>
        <div class="field"><label>Amount *</label><input id="ieAmount" type="number" min="0" step="0.01" value="${e?.amount??''}"></div>
        <div class="field"><label>Date *</label><input id="ieDate" type="date" value="${esc(e?.date||today)}"></div>
        <div class="field"><label>Person / Vendor</label><input id="ieVendor" value="${esc(e?.vendor||'')}"></div>
        <div class="field"><label>Payment Method</label><select id="ieMethod">${['Cash','Transfer','Bank','POS'].map(x=>`<option ${e?.method===x?'selected':''}>${x}</option>`).join('')}</select></div>
      </div>
      <div class="inline-note-row"><div class="field"><label>Note</label><input id="ieNotes" value="${esc(e?.notes||'')}"></div><div></div><div class="inline-form-actions"><button class="btn green" data-action="save-inline-expense">Save Expense</button></div></div>
    </div></div>`;
  }
  function renderExpenses(){
    const rows=scoped(db.expenses).filter(e=>inRange(e.date)).sort((a,b)=>b.date.localeCompare(a.date));
    document.getElementById('page-expenses').innerHTML=inlineExpenseForm()+`<div class="section" style="margin-top:14px"><div class="section-head"><h3>Expenses</h3><span class="status">${rows.length} expense(s) • ${money(rows.reduce((a,e)=>a+Number(e.amount||0),0))}</span></div><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Paid To</th><th>Payment Method</th><th>Actions</th></tr></thead><tbody>${rows.map(e=>`<tr><td>${esc(e.date)}</td><td>${esc(e.description)}</td><td class="right">${money(e.amount)}</td><td>${esc(e.vendor||'')}</td><td>${esc(e.method||'')}</td><td><button class="btn secondary small" data-action="edit-inline-expense" data-id="${e.id}">Edit</button> <button class="btn danger small" data-action="delete-expense" data-id="${e.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No expenses in this period.</td></tr>'}</tbody></table></div></div></div>`;
  }

  function saveInlineCustomer(){
    const name=document.getElementById('icName')?.value.trim(); if(!name){alert('Customer name is required.');return}
    const phone=document.getElementById('icPhone')?.value.trim()||'',address=document.getElementById('icAddress')?.value.trim()||'';
    if(inlineCustomerEditId){const c=db.customers.find(x=>x.id===inlineCustomerEditId);if(c)Object.assign(c,{name,phone,address});}
    else db.customers.push({id:id(),businessId:db.activeBusinessId,name,phone,address,opening:0});
    save();inlineCustomerEditId=null;render();
  }
  function saveInlinePayment(){
    const customerId=document.getElementById('ipCustomer')?.value||'',date=document.getElementById('ipDate')?.value||today,amount=Number(document.getElementById('ipAmount')?.value||0),method=document.getElementById('ipMethod')?.value||'Cash',note=document.getElementById('ipNote')?.value||'';
    const c=scoped(db.customers).find(x=>x.id===customerId); if(!c){alert('Please select a debtor.');return}
    const branchId=(window.getActiveBranchId?.()&&window.getActiveBranchId()!=='all'?window.getActiveBranchId():(c.branchId||branchesFor(db.activeBusinessId)[0]?.id||''));
    if(!branchId){alert('Select a specific branch from the Dashboard before recording a debtor payment.');return}
    const oldPayment=inlinePaymentEditId?db.payments.find(x=>x.id===inlinePaymentEditId):null;
    const owed=customerOutstanding(c.id)+(oldPayment&&oldPayment.customerId===c.id?Number(oldPayment.amount||0):0);
    if(!Number.isFinite(amount)||amount<=0){alert('Enter a valid Amount Paid.');return}
    if(owed<=0){alert('This customer has no outstanding debt.');return}
    if(amount>owed){alert(`Amount Paid cannot exceed the Total Amount Owed of ${money(owed)}.`);return}
    if(inlinePaymentEditId){const p=oldPayment;if(p)Object.assign(p,{customerId,date,amount,method,note,branchId});}
    else db.payments.push({id:id(),businessId:db.activeBusinessId,branchId,customerId,date,amount,method,note,createdBy:currentAdminId});
    save();inlinePaymentEditId=null;render();
  }
  function saveInlineExpense(){
    const description=document.getElementById('ieDesc')?.value.trim(),amount=Number(document.getElementById('ieAmount')?.value||0),date=document.getElementById('ieDate')?.value||today,vendor=document.getElementById('ieVendor')?.value.trim()||'',method=document.getElementById('ieMethod')?.value||'Cash',notes=document.getElementById('ieNotes')?.value||'';
    if(!description||!Number.isFinite(amount)||amount<=0){alert('Description and a valid Amount are required.');return}
    const active=window.getActiveBranchId?.();const branchId=(active&&active!=='all'?active:(inlineExpenseEditId?db.expenses.find(x=>x.id===inlineExpenseEditId)?.branchId:branchesFor(db.activeBusinessId)[0]?.id||''));if(!branchId){alert('Select a specific branch from the Dashboard before recording the expense.');return}
    const o={description,amount,date,vendor,method,notes,branchId};
    if(inlineExpenseEditId){const e=db.expenses.find(x=>x.id===inlineExpenseEditId);if(e)Object.assign(e,o);}
    else db.expenses.push({id:id(),businessId:db.activeBusinessId,...o,createdBy:currentAdminId});
    save();inlineExpenseEditId=null;render();
  }

  function invoiceParts(value){
    const raw=String(value||'').trim();
    const m=raw.match(/^(.*?)(\d+)$/);
    return m?{prefix:m[1],number:Number(m[2]),width:m[2].length,raw}:null;
  }
  function invoiceSequenceState(){
    if(!db.invoiceSequences||typeof db.invoiceSequences!=='object')db.invoiceSequences={};
    const key=db.activeBusinessId;
    let state=db.invoiceSequences[key];
    if(state&&Number.isFinite(Number(state.next)))return state;
    const existing=scoped(db.sales).map(s=>invoiceParts(s.invoiceNo)).filter(Boolean);
    if(!existing.length)return null;
    const seed=existing.slice().sort((a,b)=>b.number-a.number)[0];
    state={prefix:seed.prefix,width:seed.width,next:seed.number+1};
    db.invoiceSequences[key]=state;
    return state;
  }
  function nextInvoiceNumber(){
    const st=invoiceSequenceState();
    if(!st)return '';
    return st.prefix+String(st.next).padStart(st.width,'0');
  }
  function seedInvoiceSequence(invoiceNo){
    const part=invoiceParts(invoiceNo); if(!part)return false;
    if(!db.invoiceSequences||typeof db.invoiceSequences!=='object')db.invoiceSequences={};
    const key=db.activeBusinessId;
    const current=db.invoiceSequences[key];
    if(!current){db.invoiceSequences[key]={prefix:part.prefix,width:part.width,next:part.number+1};return true;}
    if(current.prefix===part.prefix){current.width=Math.max(Number(current.width||0),part.width);current.next=Math.max(Number(current.next||0),part.number+1);return true;}
    return false;
  }
  function changeInvoiceInput(delta){
    const el=document.getElementById('nsInvoiceNo');if(!el)return;
    const current=invoiceParts(el.value.trim());
    if(!current){const next=nextInvoiceNumber();if(next){el.value=next;captureSalePageForm();}return;}
    const value=Math.max(0,current.number+delta);
    el.value=current.prefix+String(value).padStart(current.width,'0');
    captureSalePageForm();
  }
  function invoiceFieldMarkup(value){
    return `<div class="field"><label>Invoice No. *</label><div class="invoice-control"><button type="button" class="btn secondary small invoice-step" data-invoice-step="-1" aria-label="Decrease invoice number">−</button><input id="nsInvoiceNo" value="${esc(value)}" placeholder="Invoice" inputmode="text" required><button type="button" class="btn secondary small invoice-step" data-invoice-step="1" aria-label="Increase invoice number">+</button></div></div>`;
  }
  function populateInvoiceForNewSale(){
    const el=document.getElementById('nsInvoiceNo');
    if(!el||editingSaleId)return;
    if(String(el.value||'').trim())return;
    const next=nextInvoiceNumber();
    if(next)el.value=next;
  }
  function renderSalesRows(searchId='salesSearchBelow',bodyId='salesBodyBelow'){
    const tbody=document.getElementById(bodyId);if(!tbody)return;
    const customerQuery=(document.getElementById(searchId)?.value||'').trim().toLowerCase();
    const filter=document.getElementById('salesFilter')?.value||'all';
    const option2=document.getElementById('salesOption2')?.value||'';
    const option3=(document.getElementById('salesOption3')?.value||'').trim().toLowerCase();
    const order=document.getElementById('salesOrder')?.value||'desc';
    let rows=scoped(db.sales).filter(s=>inRange(s.date));
    const entryDate=s=>String(s.entryDate||s.createdAt||s.date||'').slice(0,10);
    const num=v=>Number(v||0);
    const fieldValue=s=>({invoiceNo:String(s.invoiceNo||''),entryDate:entryDate(s),transactionDate:String(s.date||''),payment:paymentStatus(s),items:(s.items||[]).length,salesAmount:num(s.total),receivedAmount:num(s.paid),creditAmount:num(saleOutstanding(s))}[filter]);
    if(customerQuery)rows=rows.filter(s=>String(cust(s.customerId).name||'').toLowerCase().includes(customerQuery));
    if(filter==='invoiceNo'&&option2&&option3){
      const q=option3;
      rows=rows.filter(s=>String(s.invoiceNo||'').toLowerCase().includes(q));
    }else if((filter==='entryDate'||filter==='transactionDate')&&option2&&option3){
      const key=filter==='entryDate'?'entryDate':'transactionDate';
      const val=option3;
      rows=rows.filter(s=>{
        const actual=String(fieldValue(s));
        if(option2==='on')return actual===val;
        if(option2==='before')return actual<val;
        if(option2==='after')return actual>val;
        if(option2==='onOrBefore')return actual<=val;
        if(option2==='onOrAfter')return actual>=val;
        return actual===val;
      });
    }else if(filter==='payment'&&option2&&option3){rows=rows.filter(s=>String(fieldValue(s)).toLowerCase()===option3);}
    else if(['items','salesAmount','receivedAmount','creditAmount'].includes(filter)&&option2&&option3){
      const n=Number(option3);if(Number.isFinite(n)){rows=rows.filter(s=>{const v=num(fieldValue(s));if(option2==='equals')return v===n;if(option2==='gt')return v>n;if(option2==='lt')return v<n;if(option2==='gte')return v>=n;if(option2==='lte')return v<=n;if(option2==='between'){const b=Number((document.getElementById('salesOption3')?.value||'').split(',')[1]);return Number.isFinite(b)&&v>=Math.min(n,b)&&v<=Math.max(n,b);}return true;});}}
    const sortKey=filter==='all'?'entryDate':filter;
    const valueForSort=s=>sortKey==='entryDate'?entryDate(s):fieldValue(s);
    rows.sort((a,b)=>{const av=valueForSort(a),bv=valueForSort(b);let c;if(typeof av==='number'&&typeof bv==='number')c=av-bv;else c=String(av).localeCompare(String(bv),undefined,{numeric:true,sensitivity:'base'});if(c===0)c=entryDate(a).localeCompare(entryDate(b));return order==='asc'?c:-c;});
    document.getElementById('salesRowsCount')?.replaceChildren(document.createTextNode(`${rows.length} sale(s)`));
    tbody.innerHTML=rows.map(s=>{const st=paymentStatus(s);return `<tr><td><b>${esc(cust(s.customerId).name)}</b></td><td><b>${esc(s.invoiceNo||'—')}</b></td><td>${esc(s.date||'')}</td><td>${esc(entryDate(s))}</td><td class="${st==='Cash'?'green-text':(st==='Partly Credit'?'orange-text':'red-text')}">${st}</td><td>${(s.items||[]).length}</td><td class="right">${money(s.total)}</td><td class="right">${money(s.paid||0)}</td><td class="right">${money(saleOutstanding(s))}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-sale" data-id="${s.id}">Edit</button><button class="btn danger small" data-action="delete-sale" data-id="${s.id}">Delete</button></div></td></tr>`}).join('')||'<tr><td colspan="10" class="empty">No sales match the selected filters.</td></tr>';
  }
  function configureSalesFilterControls(){
    const filterEl=document.getElementById('salesFilter'),o2w=document.getElementById('salesOption2Wrap'),o3w=document.getElementById('salesOption3Wrap'),o2=document.getElementById('salesOption2'),o3=document.getElementById('salesOption3');
    if(!filterEl)return;
    const set=(items,inputType,placeholder)=>{o2.innerHTML=items.map(x=>`<option value="${x[0]}">${x[1]}</option>`).join('');o3.outerHTML=inputType==='select'?'<select id="salesOption3"></select>':`<input id="salesOption3" placeholder="${placeholder||'Enter value'}">`;};
    const rebuild=()=>{
      const f=filterEl.value;
      o2w.style.display=f==='all'?'none':'block';o3w.style.display=f==='all'?'none':'block';
      if(f==='invoiceNo'){o2.innerHTML='<option value="hierarchy">Invoice No. Hierarchy</option>';const values=[...new Set(scoped(db.sales).map(s=>String(s.invoiceNo||'').trim()).filter(Boolean))].sort((a,b)=>a.localeCompare(b,undefined,{numeric:true}));document.getElementById('salesOption3').outerHTML=`<select id="salesOption3"><option value="">${values.length?'Select Invoice No.':'No invoices yet'}</option>${values.map(v=>`<option value="${esc(v)}">${esc(v)}</option>`).join('')}</select>`;}
      else if(f==='entryDate'||f==='transactionDate'){o2.innerHTML='<option value="on">On</option><option value="before">Before</option><option value="after">After</option><option value="onOrBefore">On or Before</option><option value="onOrAfter">On or After</option>';document.getElementById('salesOption3').outerHTML='<input id="salesOption3" type="date">';}
      else if(f==='payment'){o2.innerHTML='<option value="equals">Equals</option>';document.getElementById('salesOption3').outerHTML='<select id="salesOption3"><option value="">Select Payment</option><option>Cash</option><option>Partly Credit</option><option>Credit</option></select>';}
      else {o2.innerHTML='<option value="equals">Equals</option><option value="gt">Greater Than</option><option value="lt">Less Than</option><option value="gte">Greater Than or Equal</option><option value="lte">Less Than or Equal</option><option value="between">Between</option>';document.getElementById('salesOption3').outerHTML='<input id="salesOption3" type="text" inputmode="decimal" placeholder="Enter value; Between: min,max">';}
      bindSalesFilterEvents();renderSalesRows();
    };
    filterEl.onchange=rebuild;rebuild();
  }
  function bindSalesFilterEvents(){
    ['salesSearchBelow','salesFilter','salesOption2','salesOption3','salesOrder'].forEach(id=>{const el=document.getElementById(id);if(el){el.oninput=renderSalesRows;el.onchange=renderSalesRows;}});
  }
  bindSalesListSearch=function(searchId='salesSearchBelow',bodyId='salesBodyBelow'){
    configureSalesFilterControls();
    bindSalesFilterEvents();
    renderSalesRows(searchId,bodyId);
  };
  const baseHandleRequested=handle;
  handle=async function(action,el){
    const x=el?.dataset?.id;
    const acting=db.admins.find(v=>v.id===currentAdminId)||{role:'entry_staff'};
    const required=actionPermission(action);
    if(required&&!hasPermission(required,acting)){alert('Permission denied. Your assigned Staff permissions do not allow this action.');auditEvent('Permission denied',`${action}; required ${required}`,'security');save();return;}
    if(action==='edit-inline-customer'){inlineCustomerEditId=x;render();return}
    if(action==='cancel-inline-customer'){inlineCustomerEditId=null;render();return}
    if(action==='save-inline-customer'){saveInlineCustomer();return}
    if(action==='edit-inline-payment'){inlinePaymentEditId=x;render();return}
    if(action==='cancel-inline-payment'){inlinePaymentEditId=null;render();return}
    if(action==='save-inline-payment'){saveInlinePayment();return}
    if(action==='edit-inline-expense'){inlineExpenseEditId=x;render();return}
    if(action==='cancel-inline-expense'){inlineExpenseEditId=null;render();return}
    if(action==='save-inline-expense'){saveInlineExpense();return}
    if(action==='new-customer'){inlineCustomerEditId=null;render();return}
    if(action==='new-payment'){inlinePaymentEditId=null;render();return}
    if(action==='new-expense'){inlineExpenseEditId=null;render();return}
    return baseHandleRequested(action,el);
  };

  // Keep all three management pages on the same combined page after saving.
  document.getElementById('nav')?.addEventListener('click',function(e){
    const b=e.target.closest('button[data-page]');
    if(!b)return;
    if(b.dataset.page==='customers')inlineCustomerEditId=null;
    if(b.dataset.page==='payments')inlinePaymentEditId=null;
    if(b.dataset.page==='expenses')inlineExpenseEditId=null;
  },true);

  // Initialize branch-aware view.
  render();
})();
</script></body></html>
