<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Trader Business Control — Admin App V3</title><style>
:root{--nav:#172033;--nav2:#202b42;--bg:#f4f6fa;--card:#fff;--text:#182230;--muted:#6b7280;--line:#e5e7eb;--accent:#2563eb;--green:#16a34a;--red:#dc2626;--orange:#ea580c;--shadow:0 5px 18px rgba(20,30,50,.07)}*{box-sizing:border-box}body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{cursor:pointer}.app{display:flex;min-height:100vh}.sidebar{width:245px;background:var(--nav);color:#fff;padding:20px 14px;position:fixed;inset:0 auto 0 0;z-index:10}.brand{font-size:19px;font-weight:800;padding:8px 10px 20px}.brand small{display:block;color:#9ca9bf;font-size:11px;margin-top:4px}.nav button{width:100%;border:0;background:transparent;color:#cbd5e1;text-align:left;padding:11px 13px;border-radius:9px;margin:2px 0}.nav button.active,.nav button:hover{background:var(--nav2);color:#fff}.nav .sep{height:1px;background:#334057;margin:12px 5px}.main{margin-left:245px;width:calc(100% - 245px);padding:22px;max-width:1500px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:12px}.title h1{margin:0;font-size:25px}.title p{margin:5px 0 0;color:var(--muted);font-size:13px}.top-right{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.badge{padding:7px 10px;border-radius:20px;background:#fff;border:1px solid var(--line);font-size:12px}.badge.demo{color:#9a3412;background:#fff7ed;border-color:#fed7aa}.period,.business-select{padding:9px 10px;border:1px solid var(--line);border-radius:8px;background:#fff}.business-select{min-width:210px;font-weight:700}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:18px}.card,.section{background:var(--card);border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow)}.card{padding:17px}.label{color:var(--muted);font-size:12px}.value{font-size:25px;font-weight:800;margin-top:7px}.sub{font-size:12px;color:var(--muted);margin-top:6px}.grid2{display:grid;grid-template-columns:1.4fr 1fr;gap:15px}.section{overflow:hidden}.section-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px}.section-head h3{margin:0;font-size:15px}.section-body{padding:15px 17px}.table-wrap{overflow:auto}.table{width:100%;border-collapse:collapse;font-size:13px}.table th,.table td{padding:11px 9px;border-bottom:1px solid var(--line);text-align:left;white-space:nowrap}.table th{color:var(--muted);font-size:11px;text-transform:uppercase}.right{text-align:right!important}.btn{border:0;border-radius:8px;padding:9px 12px;background:var(--accent);color:#fff;font-weight:700;font-size:12px}.btn.secondary{background:#eef2f7;color:#263244}.btn.danger{background:#fee2e2;color:#991b1b}.btn.green{background:#dcfce7;color:#166534}.btn.small{padding:6px 9px}.actions{display:flex;gap:6px;flex-wrap:wrap}.toolbar{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:14px}.toolbar-left,.toolbar-right{display:flex;gap:8px;flex-wrap:wrap}.search{padding:9px 11px;border:1px solid var(--line);border-radius:8px;min-width:220px;background:#fff}.statline{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:13px}.pill{padding:8px 11px;background:#f8fafc;border:1px solid var(--line);border-radius:8px;font-size:12px}.pill b{font-size:13px}.status{font-size:12px;color:var(--muted);padding:12px 0}.green-text{color:var(--green)}.red-text{color:var(--red)}.orange-text{color:var(--orange)}.page{display:none}.page.active{display:block}.empty{padding:35px;text-align:center;color:var(--muted)}.notice{padding:11px 13px;background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:9px;font-size:12px;margin-bottom:15px}.warning{padding:11px 13px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;border-radius:9px;font-size:12px;margin-bottom:15px}.modal-back{display:none;position:fixed;inset:0;background:rgba(15,23,42,.52);z-index:30;align-items:center;justify-content:center;padding:15px}.modal-back.open{display:flex}.modal{width:min(760px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.2)}.modal-head{padding:15px 18px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}.modal-head h3{margin:0;font-size:16px}.modal-body{padding:18px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:11px;color:var(--muted);font-weight:700}.field input,.field select,.field textarea{padding:10px;border:1px solid #d8dee8;border-radius:8px;background:#fff}.field textarea{min-height:80px;resize:vertical}.modal-foot{padding:13px 18px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}.item-row{display:grid;grid-template-columns:1.4fr .6fr .8fr 36px;gap:7px;align-items:center;margin-bottom:7px}.item-row input,.item-row select{padding:9px;border:1px solid var(--line);border-radius:7px}.remove-item{border:0;background:#fee2e2;color:#991b1b;border-radius:7px;height:34px}.mobile-menu{display:none}.tag{display:inline-block;padding:4px 7px;border-radius:12px;font-size:10px;font-weight:700}.tag.active{background:#dcfce7;color:#166534}.tag.off{background:#fee2e2;color:#991b1b}.tag.major{background:#dbeafe;color:#1d4ed8}.access-list{display:flex;gap:5px;flex-wrap:wrap}.access-chip{background:#eef2ff;color:#3730a3;border-radius:12px;padding:4px 8px;font-size:10px}
@media(max-width:1050px){.cards{grid-template-columns:repeat(2,1fr)}.grid2{grid-template-columns:1fr}.business-select{min-width:160px}}@media(max-width:700px){.sidebar{transform:translateX(-100%);transition:.2s}.sidebar.open{transform:translateX(0)}.main{margin-left:0;width:100%;padding:14px}.mobile-menu{display:inline-block}.top{align-items:flex-start}.top-right{justify-content:flex-end}.cards{grid-template-columns:1fr 1fr}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.item-row{grid-template-columns:1fr 1fr}.item-row .wide{grid-column:1/-1}}
.status{color:#64748b;line-height:1.5}.badge{padding:5px 9px;border-radius:999px;font-size:11px;font-weight:700}.client-view-shell{background:#fff;border:1px solid var(--line);border-radius:13px;box-shadow:var(--shadow);overflow:hidden}.client-view-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap}.client-view-head h3{margin:0;font-size:16px}.client-view-head p{margin:5px 0 0;color:var(--muted);font-size:12px}.client-view-meta{display:flex;gap:7px;flex-wrap:wrap}.client-view-frame-wrap{background:#eef2f2;padding:18px;display:flex;justify-content:center;min-height:650px}.client-view-frame{width:min(520px,100%);height:760px;border:1px solid #d9e0e2;border-radius:18px;background:#f4f7f7;box-shadow:0 10px 30px rgba(15,23,42,.12)}.client-view-note{margin:14px 17px 0}@media(max-width:700px){.client-view-frame-wrap{padding:10px}.client-view-frame{height:calc(100vh - 220px);min-height:560px}.client-view-head{align-items:flex-start}}</style><style>.sale-page{max-width:1100px}.sale-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.ns-item-head,.ns-item-row{display:grid;grid-template-columns:minmax(220px,1.8fr) minmax(110px,.7fr) minmax(140px,1fr) minmax(120px,1fr) 44px;gap:10px;align-items:center}.ns-item-head{font-size:12px;font-weight:700;color:#64748b;text-transform:uppercase;padding:0 8px 8px}.ns-item-row{padding:8px;border-top:1px solid #e2e8f0}.ns-total{font-weight:700;text-align:right}.sale-summary{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:20px;padding-top:18px;border-top:1px solid #e2e8f0}.sale-summary>div:first-child{font-size:18px;font-weight:700;display:flex;flex-direction:column;gap:6px}.sale-summary>div:first-child b{font-size:24px}.payment-box{display:flex;flex-direction:column;gap:10px}.checkline{display:flex;align-items:center;gap:8px;font-weight:600}.checkline input{width:auto}.outstanding{font-size:18px;margin-top:8px}.sale-actions{margin-top:14px;justify-content:flex-start}.notice{border:1px solid #cbd5e1;background:#f8fafc;border-radius:10px;padding:10px;color:#334155}@media(max-width:720px){.ns-item-head{display:none}.ns-item-row{grid-template-columns:1fr 1fr;}.ns-item-row .ns-prod{grid-column:1/-1}.ns-item-row .ns-total{text-align:left}.sale-summary{grid-template-columns:1fr}.sale-head{align-items:flex-start;flex-direction:column}}</style></head><body><div class="app"><aside class="sidebar" id="sidebar"><div class="brand">Trader Business Control<small>ADMIN APP V3 • MULTI-BUSINESS</small></div><div class="nav" id="nav"><button data-page="dashboard" class="active">Dashboard</button><button data-page="businesses">Businesses</button><button data-page="admins">Admin Access</button><div class="sep"></div><button data-page="sales">Sales</button><button data-page="customers">Customers</button><button data-page="payments">Debtor Payments</button><button data-page="expenses">Expenses</button><button data-page="stock">Stock</button><button data-page="reports">Reports</button><button data-page="messages">Client Messages</button><button data-page="clientview">Client App View</button><button data-page="settings">Settings</button></div></aside><main class="main"><div class="top"><div class="title"><button class="btn secondary mobile-menu" id="menuBtn">☰</button><h1 id="pageTitle">Dashboard</h1><p id="periodText">Business overview</p></div><div class="top-right"><span class="badge demo" id="onlineBadge">● Local Demo</span><select class="business-select" id="adminSelect"></select><select class="business-select" id="businessSelect"></select><select class="period" id="period"><option value="today">Today</option><option value="week">This Week</option><option value="month">This Month</option><option value="lastmonth">Last Month</option><option value="all">All Time</option></select></div></div><section class="page active" id="page-dashboard"></section><section class="page" id="page-businesses"></section><section class="page" id="page-admins"></section><section class="page" id="page-sales"></section><section class="page" id="page-customers"></section><section class="page" id="page-payments"></section><section class="page" id="page-expenses"></section><section class="page" id="page-stock"></section><section class="page" id="page-reports"></section><section class="page" id="page-messages"></section><section class="page" id="page-clientview"></section><section class="page" id="page-settings"></section></main></div><div class="modal-back" id="modal"><div class="modal"><div class="modal-head"><h3 id="modalTitle"></h3><button class="btn secondary small" id="closeModal">Close</button></div><div class="modal-body" id="modalBody"></div><div class="modal-foot" id="modalFoot"></div></div></div>
<script>
'use strict';
const KEY='tbc_admin_v3_multibusiness';
const CLIENT_APP_VIEW_SOURCE="<!doctype html>\n<html lang=\"en\">\n<head>\n<script src=\"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2\"><\/script>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#0f766e\">\n<meta name=\"description\" content=\"Trader Business Control — read-only business dashboard\">\n<meta name=\"mobile-web-app-capable\" content=\"yes\">\n<meta name=\"application-name\" content=\"Business Control\">\n<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\">\n<meta name=\"apple-mobile-web-app-title\" content=\"Business Control\">\n<link rel=\"manifest\" href=\"manifest.webmanifest\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"16x16\" href=\"favicon-16.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"favicon-32.png\">\n<link rel=\"icon\" type=\"image/png\" sizes=\"48x48\" href=\"favicon-48.png\">\n<link rel=\"icon\" href=\"favicon.ico\">\n<link rel=\"apple-touch-icon\" sizes=\"180x180\" href=\"icons/icon-180.png\">\n<title>Trader Business Control — Client</title>\n<style>\n*,*::before,*::after{box-sizing:border-box}\nhtml{width:100%;min-width:0;overflow-x:hidden;-webkit-text-size-adjust:100%;text-size-adjust:100%;background:#f4f7f7}\nbody{margin:0;width:100%;min-width:0;min-height:100vh;overflow-x:hidden;background:#f4f7f7;font-family:system-ui,-apple-system,Segoe UI,sans-serif;color:#17202a}\n.app{width:100%;max-width:520px;min-width:0;margin:0 auto;min-height:100vh;padding-bottom:max(28px,env(safe-area-inset-bottom));visibility:hidden;overflow-x:hidden}\n.dashboardHeader{width:100%;min-width:0;background:#0f766e;color:#fff;padding:20px 16px 22px;padding-top:max(20px,env(safe-area-inset-top));border-radius:0 0 22px 22px;overflow:hidden}\n.brand{font-size:20px;font-weight:800}.sub{font-size:12px;opacity:.82;margin-top:3px}\n.headerMeta{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:3px}.headerMeta .sub{margin-top:0}.headerActionRow{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:11px}.headerActionRow .readonly{margin-top:0}.headerActionRow .installBtn{margin-top:0;margin-left:0;}\n.installBtn{display:none;border:1px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:10px;padding:8px 11px;font-size:11px;font-weight:800;cursor:pointer}.installBtn.show{display:block;width:max-content}.readonly{display:inline-block;margin-top:11px;background:rgba(255,255,255,.14);border-radius:99px;padding:6px 10px;font-size:10px;font-weight:800}\nmain.dashboard{width:100%;min-width:0;padding:14px}\n.panel,.card,.list{min-width:0;background:#fff;border:1px solid #e1e7e9;border-radius:16px;box-shadow:0 2px 10px rgba(15,23,42,.05)}\n.panel{padding:13px;margin-bottom:14px}\n.rangeTitle,.sectionTitle{display:flex;justify-content:space-between;align-items:center}\n.rangeTitle strong,.sectionTitle h2{font-size:15px;margin:0}.rangeTitle span,.sectionTitle span{font-size:11px;color:#68737d}\nselect,input{width:100%;margin-top:7px;padding:11px;border:1px solid #dce3e6;border-radius:10px;background:#fff;font-size:16px}\n.customDates{display:none;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}\n.customDates.show{display:grid}\n.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;min-width:0}\n.card{padding:14px;min-width:0;overflow:hidden}\n.value{font-size:clamp(16px,5vw,21px);font-weight:850;line-height:1.15;margin-top:5px;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.subvalue{font-size:11px;line-height:1.3;color:#68737d;margin-top:4px;overflow-wrap:anywhere}\n.green{color:#047857}.red{color:#b91c1c}.teal{color:#0f766e}\n.clickable{cursor:pointer}.clickable:active{transform:scale(.99)}\n.hint{font-size:10px;color:#0f766e;margin-top:7px}\n.sectionTitle{margin:18px 2px 9px;min-width:0}\n.fullCard{margin-bottom:9px}\n.list{overflow:hidden}\n.row{display:flex;justify-content:space-between;gap:12px;padding:13px;border-bottom:1px solid #e7ecee}\n.row:last-child{border-bottom:0}\n.left{min-width:0}.name{font-size:13px;font-weight:750}.meta{font-size:11px;color:#68737d;margin-top:3px}.amount{font-weight:800;white-space:nowrap}\n.link{border:0;background:none;color:#0f766e;font-weight:800;font-size:12px;padding:0;cursor:pointer}\n.empty{text-align:center;padding:22px;color:#68737d;font-size:13px}\n.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.48);z-index:20;align-items:flex-end}\n.modal.open{display:flex}\n.sheet{width:100%;max-width:520px;margin:auto;background:#fff;border-radius:20px 20px 0 0;max-height:88vh;overflow:auto;padding:16px}\n.sheetHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}\n.close,.backBtn{border:0;background:#eef2f3;border-radius:50%;width:40px;height:40px;cursor:pointer}.backBtn{border-radius:10px;width:auto;padding:0 12px;font-weight:800;color:#0f766e}\n.detailTotal{font-size:23px;font-weight:850;margin:7px 0 12px}\n.detailCard{border:1px solid #e1e7e9;border-radius:13px;padding:12px;margin-bottom:8px}\n.detailGrid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:9px}\n.detailItem{background:#f7f9f9;border-radius:9px;padding:9px}.detailLabel{font-size:10px;color:#68737d}.detailValue{font-size:13px;font-weight:750;margin-top:2px}\n.customerBtn{border:0;background:none;padding:0;color:#0f766e;font:inherit;font-weight:800;text-align:left;cursor:pointer}.salesSummary{font-size:12px;font-weight:800;color:#17202a;margin:-3px 2px 9px}.salesSummary span{display:block;margin-top:3px;font-weight:700}\n.stockCards{grid-template-columns:1fr 1fr}.salesPage{margin-top:18px}.salesPage .sectionTitle{margin-top:0}.businessMetaExtra{display:block;margin-top:3px;font-size:11px;opacity:.82}\n@media(max-width:360px){\n  .dashboardHeader{padding-left:13px;padding-right:13px;padding-bottom:19px;border-radius:0 0 18px 18px}\n  main.dashboard{padding:10px}\n  .panel,.card{border-radius:14px}\n  .panel{padding:11px}\n  .cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}\n  .card{padding:11px}\n  .rangeTitle strong,.sectionTitle h2{font-size:14px}\n  .rangeTitle span,.sectionTitle span{font-size:10px}\n  .label{font-size:11px;line-height:1.2}\n  .value{font-size:16px}\n  .subvalue{font-size:10px}\n  .hint{font-size:9px;line-height:1.25}\n  .customDates{grid-template-columns:1fr 1fr}\n}\n@media(orientation:landscape) and (max-height:600px){\n  .dashboardHeader{padding-top:max(12px,env(safe-area-inset-top));padding-bottom:14px}\n  main.dashboard{padding:10px 12px 14px}\n  .panel{padding:11px;margin-bottom:10px}\n  .sectionTitle{margin-top:12px}\n  .card{padding:11px}\n  .cards{gap:8px}\n}\n@media(min-width:521px){\n  .app{box-shadow:0 0 28px rgba(15,23,42,.06)}\n}\n.contact-modal{padding:12px}.msg-list{display:flex;flex-direction:column;gap:8px;max-height:48vh;overflow:auto;padding:4px 2px}.msg{max-width:88%;padding:9px 11px;border-radius:12px;font-size:12px;line-height:1.4}.msg.client{align-self:flex-end;background:#e6fffb;border:1px solid #b7eee7}.msg.admin{align-self:flex-start;background:#f3f4f6;border:1px solid #e5e7eb}.msg-meta{font-size:9px;color:#68737d;margin-top:4px}.msg-compose{display:flex;gap:7px;margin-top:10px}.msg-compose textarea{flex:1;min-height:62px;resize:none;border:1px solid #dce3e6;border-radius:10px;padding:9px;font:inherit;font-size:12px}.msg-send{border:0;background:#0f766e;color:#fff;border-radius:10px;padding:9px 12px;font-weight:800}.msg-empty{text-align:center;color:#68737d;padding:18px;font-size:12px}</style>\n</head>\n<body>\n<div class=\"app\">\n<header class=\"dashboardHeader\">\n  <div class=\"brand\" id=\"businessName\">Connecting…</div>\n  <div class=\"headerMeta\">\n    <div class=\"sub\" id=\"headerCustomName\"></div>\n    <div class=\"sub\" id=\"headerSubtitle\"></div>\n  </div>\n  <div class=\"headerActionRow\">\n    <div class=\"readonly\" id=\"headerReadonly\" style=\"display:none\"></div>\n    <button id=\"installBtn\" class=\"installBtn\" type=\"button\">Contact Admin</button>\n  </div>\n</header>\n\n<main class=\"dashboard\">\n<section class=\"panel\">\n  <div class=\"rangeTitle\"><strong>Report Period</strong><span id=\"periodLabel\">01/09/2026 - 22/09/2026</span></div>\n  <select id=\"periodSelect\">\n    <option value=\"today\">Today</option>\n    <option value=\"week\">This Week</option>\n    <option value=\"month\">This Month</option>\n    <option value=\"lastmonth\">Last Month</option>\n    <option value=\"custom\">Custom</option>\n  </select>\n  <div class=\"rangeTitle\" style=\"margin-top:10px\"><strong>Branch</strong><span id=\"branchLabel\">All Branches</span></div>\n  <select id=\"branchSelect\"></select>\n  <div class=\"customDates\" id=\"customDates\">\n    <label style=\"font-size:11px;color:#68737d\">Start Date<input id=\"startDate\" type=\"date\"></label>\n    <label style=\"font-size:11px;color:#68737d\">End Date<input id=\"endDate\" type=\"date\"></label>\n  </div>\n</section>\n\n<div class=\"sectionTitle\"><h2>Business Overview</h2><span id=\"rangeText\"></span></div>\n<section class=\"cards\">\n  <div class=\"card clickable\" id=\"salesCard\">\n    <div class=\"label\">Total Sale</div>\n    <div class=\"value\" id=\"totalSales\">₦0</div>\n    <div class=\"subvalue\" id=\"transactionCount\">0 transactions</div>\n    <div class=\"hint\">Tap to view sales details</div>\n  </div>\n\n  <div class=\"card clickable\" id=\"expensesCard\">\n    <div class=\"label\">Expenses</div>\n    <div class=\"value\" id=\"totalExpenses\">₦0</div>\n    <div class=\"hint\">Tap to view expense details</div>\n  </div>\n\n  <div class=\"card clickable\" id=\"cashCard\">\n    <div class=\"label\">Cash Received</div>\n    <div class=\"value teal\" id=\"cashReceived\">₦0</div>\n    <div class=\"subvalue\" id=\"debtorPaymentNote\"></div>\n    <div class=\"hint\">Tap to view cash details</div>\n  </div>\n\n  <div class=\"card\" id=\"creditSalesCard\">\n    <div class=\"label\">Total Credit Sales</div>\n    <div class=\"subvalue\" id=\"creditSalesCount\">0 credit sales</div>\n    <div class=\"value red\" id=\"creditSalesTotal\">₦0</div>\n  </div>\n</section>\n\n<section class=\"card clickable fullCard\" id=\"debtCard\">\n  <div class=\"label\">Customers Owing</div>\n  <div class=\"subvalue\" id=\"owingCount\">0 customers owing</div>\n  <div class=\"value red\" id=\"debtTotal\">₦0</div>\n  <div class=\"hint\">Tap to view debtors list</div>\n</section>\n\n<div class=\"sectionTitle\"><h2>Stock</h2></div>\n<section class=\"cards stockCards\">\n  <div class=\"card clickable\" id=\"availableStockCard\">\n    <div class=\"label\">Available Stock</div>\n    <div class=\"value\" id=\"availableStockCount\">0</div>\n    <div class=\"hint\">Tap to view available-stock items</div>\n  </div>\n  <div class=\"card clickable\" id=\"lowStockCard\">\n    <div class=\"label\">Low Stock Items</div>\n    <div class=\"value\" id=\"lowStockCount\">0</div>\n    <div class=\"hint\">Tap to view low-stock items</div>\n  </div>\n</section>\n\n\n</main>\n<section id=\"salesPage\" class=\"salesPage\" style=\"display:none;padding:14px\">\n  <div class=\"sectionTitle\"><h2>Sales Details</h2><button class=\"link\" id=\"backSalesPage\">← Back</button></div>\n  <div class=\"salesSummary\" id=\"salesSummary\">0 Transactions<br><span><b class=\"green\">0 Cash</b> • <b class=\"red\">0 Credit</b></span></div>\n  <section class=\"list\" id=\"salesList\"></section>\n</section>\n</div>\n\n<div class=\"modal\" id=\"modal\">\n  <div class=\"sheet\">\n    <div class=\"sheetHead\">\n      <div style=\"display:flex;align-items:center;gap:8px\"><button class=\"backBtn\" id=\"backModal\">← Back</button><div><strong id=\"modalTitle\">Details</strong><div class=\"meta\" id=\"modalSubtitle\"></div></div></div>\n      <button class=\"close\" id=\"closeModal\">✕</button>\n    </div>\n    <div id=\"modalBody\"></div>\n  </div>\n</div>\n\n\n<div id=\"connectGate\" style=\"display:flex;min-height:100vh;align-items:center;justify-content:center;padding:24px;text-align:center;color:#68737d;font-size:14px\">Connecting to Sabrity…</div>\n\n<script>\nconst KEY='trader_v5_data';\nconst CLIENT_CONFIG_KEY='tbc_client_v6_connection';\nconst SUPABASE_URL='https://qgaocesvzqpqkecjotly.supabase.co';\nconst SUPABASE_PUBLISHABLE_KEY='sb_publishable_PTtJexVGkqdkV4QrlFMJsg_32iXPcWo';\nconst DEFAULT_FEED_ID='CLIENT-BUILD-001';\nlet onlineMode=false;\nlet onlineTimer=null;\nlet deferredInstallPrompt=null;\nlet activeClientBranchId='all';\nconst installBtn=document.getElementById('installBtn');\nconst installHelp=document.getElementById('installHelp');\nlet installEligibilityTimer=null;\ninstallBtn.addEventListener('click',()=>openContactAdmin());\nfunction normalizeUrl(u){return String(u||'').trim().replace(/\\/$/,'').replace(/\\/rest\\/v1$/,'');}\nfunction getFeedId(){\n  const params=new URLSearchParams(location.search);\n  const fromUrl=(params.get('feed')||params.get('feed_id')||'').trim();\n  return fromUrl || DEFAULT_FEED_ID;\n}\nfunction clientConfig(){return {url:SUPABASE_URL,key:SUPABASE_PUBLISHABLE_KEY,feedId:getFeedId()};}\nfunction showConnectGate(){}\nfunction hideConnectGate(){document.getElementById('connectGate').style.display='none';document.querySelector('.app').style.visibility='visible';}\nasync function fetchOnlineSnapshot(cfg){\n  if(window.__TBC_PREVIEW_MODE__ && window.__TBC_PREVIEW_DATA__) return window.__TBC_PREVIEW_DATA__;\n  const base=normalizeUrl(cfg.url);\n  if(!base||!cfg.key||!cfg.feedId) throw new Error('Client connection is not configured.');\n  const url=base+'/rest/v1/client_feeds?select=payload,business_name,updated_at&feed_id=eq.'+encodeURIComponent(cfg.feedId)+'&limit=1';\n  const r=await fetch(url,{headers:{'apikey':cfg.key,'Authorization':'Bearer '+cfg.key,'Accept':'application/json'}});\n  if(!r.ok){let t='';try{t=await r.text()}catch(e){};throw new Error(r.status+': '+(t||'Connection failed'));}\n  const rows=await r.json();\n  if(!rows.length) throw new Error('This Client Feed ID was not found.');\n  return rows[0].payload;\n}\nfunction adaptOnlinePayload(p){\n  if(typeof p==='string'){ try{ p=JSON.parse(p); }catch(e){ p={}; } }\n  p=p||{};\n  const branches=(p.branches||[]).map(b=>({id:b.id,name:b.name||'Branch',address:b.address||''}));\n  const customerMap={};(p.customers||[]).forEach(c=>customerMap[c.id]=c.name);\n  const productMap={};(p.products||[]).forEach(x=>productMap[x.id]=x);\n  const sales=(p.sales||[]).map(s=>({id:s.id,branchId:s.branchId||'',date:s.date,customer:customerMap[s.customerId]||'Customer',payment:String(s.type||s.payment_type||'cash').toLowerCase()==='cash'?'Cash':'Credit',items:(s.items||[]).map(i=>({product:productMap[i.productId]?.name||i.product||'Item',qty:Number(i.quantity??i.qty??0),unit:Number(i.unitPrice??i.unit??0)})),total:Number(s.total||0)}));\n  const payments=(p.payments||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.paymentDate||x.date,customer:customerMap[x.customerId]||'Customer',amount:Number(x.amount||0)}));\n  const expenses=(p.expenses||[]).map(x=>({id:x.id,branchId:x.branchId||'',date:x.expenseDate||x.date,description:x.description||'Expense',amount:Number(x.amount||0)}));\n  const products=(p.products||[]).map(x=>({id:x.id,branchId:x.branchId||'',branchIds:Array.isArray(x.branchIds)?x.branchIds:[],name:x.name,qty:Number(x.qty??x.quantity??0),reorder:Number(x.reorder??x.reorderLevel??0),cost:Number(x.costPrice??x.cost??0)}));\n  const business=p.business||{};\n  return {business:business.name||p.business_name||'',businessInfo:{name:business.name||p.business_name||'',type:business.type||'',phone:business.phone||'',address:business.address||'',currency:business.currency||'NGN'},businessId:business.id||p.business_id||'',header:p.header||null,branches,products,sales,payments,expenses};\n}\n\nasync function loadOnline(){\n  const cfg=clientConfig();\n  try{\n    const snap=await fetchOnlineSnapshot(cfg);\n    if(!window.__TBC_PREVIEW_MODE__) localStorage.setItem(CLIENT_CONFIG_KEY,JSON.stringify(cfg));\n    data=adaptOnlinePayload(snap);\n    onlineMode=true;\n    hideConnectGate();\n    render();\n    return true;\n  }\n  catch(e){onlineMode=false;console.error('Client App View load error:',e);return false;}\n}\nasync function connectClient(){return loadOnline();}\n\nlet clientMessagesChannel=null;\nfunction stopClientMessageRealtime(){if(clientMessagesChannel){try{clientMessagesChannel.unsubscribe()}catch(e){} clientMessagesChannel=null}}\nfunction startClientMessageRealtime(){\n  if(window.__TBC_PREVIEW_MODE__) return;\n  stopClientMessageRealtime();\n  const cfg=clientConfig();\n  if(!cfg.url||!cfg.key||!cfg.feedId||!window.supabase)return;\n  const cid=clientMessageId();\n  clientMessagesChannel=window.supabase.createClient(cfg.url,cfg.key).channel('client-messages-'+cid)\n    .on('postgres_changes',{event:'INSERT',schema:'public',table:'client_messages',filter:'feed_id=eq.'+cfg.feedId},payload=>{\n      const row=payload?.new||{};\n      if(row.client_id===cid){loadClientMessages()}\n    })\n    .subscribe((status,err)=>{if(status==='CHANNEL_ERROR'||status==='TIMED_OUT')console.error('Client message realtime:',status,err)})\n}\nconst CLIENT_MESSAGE_ID_KEY='tbc_client_message_id';\nfunction clientMessageId(){let x=localStorage.getItem(CLIENT_MESSAGE_ID_KEY);if(!x){x='client-'+(crypto.randomUUID?crypto.randomUUID():(Date.now().toString(36)+Math.random().toString(36).slice(2)));localStorage.setItem(CLIENT_MESSAGE_ID_KEY,x)}return x}\nfunction messageBranchId(){return activeClientBranchId==='all'?(data?.branches?.[0]?.id||null):activeClientBranchId}\nasync function messagesRequest(path,opts={}){\n  const cfg=clientConfig();const base=normalizeUrl(cfg.url);\n  if(!base||!cfg.key||!cfg.feedId)throw new Error('Client connection is not configured.');\n  return fetch(base+path,{...opts,headers:{apikey:cfg.key,Authorization:'Bearer '+cfg.key,'Content-Type':'application/json',Accept:'application/json',...(opts.headers||{})}})\n}\nasync function fetchClientMessages(){\n  const cfg=clientConfig();\n  const url='/rest/v1/client_messages?select=id,sender_type,sender_name,message,created_at,read_at,reply_to&feed_id=eq.'+encodeURIComponent(cfg.feedId)+'&client_id=eq.'+encodeURIComponent(clientMessageId())+'&order=created_at.asc';\n  const r=await messagesRequest(url);if(!r.ok)throw new Error(await r.text());return await r.json()\n}\nfunction openContactAdmin(){\n  openModal('Contact Admin','',false);\n  const body=document.getElementById('modalBody');\n  body.innerHTML='<div class=\"contact-modal\"><div id=\"msgList\" class=\"msg-list\"><div class=\"msg-empty\">Loading conversation…</div></div><div class=\"msg-compose\"><textarea id=\"clientMessageInput\" maxlength=\"2000\" placeholder=\"Type your message to Admin…\"></textarea><button class=\"msg-send\" id=\"sendClientMessage\">Send</button></div></div>';\n  loadClientMessages();\n  startClientMessageRealtime();\n  document.getElementById('sendClientMessage').onclick=sendClientMessage;\n}\nasync function loadClientMessages(){\n  const list=document.getElementById('msgList');if(!list)return;\n  try{const rows=await fetchClientMessages();const unreadAdmin=rows.filter(x=>x.sender_type==='admin'&&!x.read_at);if(unreadAdmin.length){await Promise.all(unreadAdmin.map(x=>messagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(x.id),{method:'PATCH',body:JSON.stringify({read_at:new Date().toISOString()})}))) }list.innerHTML=rows.length?rows.map(x=>`<div class=\"msg ${x.sender_type==='client'?'client':'admin'}\"><div>${escHtml(x.message)}</div><div class=\"msg-meta\">${x.sender_type==='client'?'You':'Admin'} • ${new Date(x.created_at).toLocaleString()}</div></div>`).join(''):'<div class=\"msg-empty\">No messages yet. Send a message to Admin.</div>';list.scrollTop=list.scrollHeight}\n  catch(e){list.innerHTML='<div class=\"msg-empty\">Unable to load messages. Please check your connection.</div>'}\n}\nasync function sendClientMessage(){\n  const input=document.getElementById('clientMessageInput'), message=input?.value.trim();if(!message)return;\n  const cfg=clientConfig();const payload={feed_id:cfg.feedId,client_id:clientMessageId(),branch_id:messageBranchId(),sender_type:'client',sender_name:'Client',message};\n  const r=await messagesRequest('/rest/v1/client_messages',{method:'POST',headers:{Prefer:'return=minimal'},body:JSON.stringify(payload)});\n  if(!r.ok){alert('Unable to send message: '+(await r.text()));return}\n  input.value='';loadClientMessages();\n}\nfunction escHtml(s){return String(s??'').replace(/[&<>\"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#039;'}[m]))}\nconst money=n=>'₦'+Math.round(Number(n||0)).toLocaleString('en-NG');\nconst pad=n=>String(n).padStart(2,'0');\nconst dateStr=d=>d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());\nconst fmt=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'short',year:'numeric'});\nconst fmtLong=d=>new Date(d+'T00:00:00').toLocaleDateString('en-NG',{day:'numeric',month:'long',year:'numeric'});\n\nconst fallback={\n  business:'',\n  businessInfo:{name:'',type:'',phone:'',address:'',currency:'NGN'},\n  products:[\n    {name:'Cement',qty:18,reorder:25,cost:6500},\n    {name:'Paint',qty:42,reorder:10,cost:8500},\n    {name:'Iron Rod',qty:14,reorder:20,cost:12000},\n    {name:'PVC Pipe',qty:30,reorder:15,cost:7000},\n    {name:'Plumbing Fittings',qty:9,reorder:12,cost:3200},\n    {name:'Ceiling Board',qty:16,reorder:8,cost:6800},\n    {name:'Electrical Cable',qty:11,reorder:15,cost:9200},\n    {name:'Adhesive',qty:6,reorder:10,cost:4500}\n  ],\n  sales:[\n    {date:'2026-09-02',customer:'Bello Stores',payment:'Credit',items:[{product:'Cement',qty:20,unit:8500},{product:'Iron Rod',qty:10,unit:15000}]},\n    {date:'2026-09-05',customer:'Adeyemi Trading',payment:'Credit',items:[{product:'Iron Rod',qty:35,unit:15000},{product:'PVC Pipe',qty:12,unit:7000}]},\n    {date:'2026-09-08',customer:'John Ventures',payment:'Cash',items:[{product:'PVC Pipe',qty:18,unit:7000},{product:'Paint',qty:4,unit:8500}]},\n    {date:'2026-09-12',customer:'Adeyemi Trading',payment:'Credit',items:[{product:'Cement',qty:25,unit:8500},{product:'Paint',qty:8,unit:8500}]},\n    {date:'2026-09-15',customer:'Bello Stores',payment:'Credit',items:[{product:'Paint',qty:8,unit:8500},{product:'PVC Pipe',qty:10,unit:7000}]},\n    {date:'2026-09-17',customer:'Kingsway Shop',payment:'Cash',items:[{product:'Cement',qty:10,unit:8500}]},\n    {date:'2026-09-18',customer:'John Ventures',payment:'Cash',items:[{product:'Iron Rod',qty:8,unit:15000},{product:'PVC Pipe',qty:10,unit:7000}]},\n    {date:'2026-09-20',customer:'Bello Stores',payment:'Credit',items:[{product:'Cement',qty:15,unit:8500},{product:'Iron Rod',qty:20,unit:15000},{product:'Paint',qty:6,unit:8500}]},\n    {date:'2026-09-21',customer:'Apex Builders',payment:'Cash',items:[{product:'PVC Pipe',qty:25,unit:7000},{product:'Paint',qty:10,unit:8500}]},\n    {date:'2026-09-22',customer:'Royal Homes',payment:'Credit',items:[{product:'Cement',qty:30,unit:8500},{product:'Iron Rod',qty:15,unit:15000}]},\n    {date:'2026-09-20',customer:'Midas Enterprises',payment:'Cash',items:[{product:'Cement',qty:8,unit:8500},{product:'PVC Pipe',qty:10,unit:7000}]},\n    {date:'2026-09-20',customer:'Topline Hardware',payment:'Credit',items:[{product:'Iron Rod',qty:12,unit:15000},{product:'Plumbing Fittings',qty:4,unit:4200}]},\n    {date:'2026-09-19',customer:'Sunrise Stores',payment:'Cash',items:[{product:'Paint',qty:12,unit:8500},{product:'Adhesive',qty:3,unit:4500}]},\n    {date:'2026-09-18',customer:'Midas Enterprises',payment:'Credit',items:[{product:'Ceiling Board',qty:6,unit:9000},{product:'Electrical Cable',qty:5,unit:12000}]},\n    {date:'2026-09-16',customer:'Topline Hardware',payment:'Cash',items:[{product:'Cement',qty:18,unit:8500},{product:'Paint',qty:5,unit:8500}]},\n    {date:'2026-09-14',customer:'Unity Projects',payment:'Credit',items:[{product:'Iron Rod',qty:20,unit:15000},{product:'PVC Pipe',qty:15,unit:7000},{product:'Adhesive',qty:4,unit:4500}]},\n    {date:'2026-09-11',customer:'Sunrise Stores',payment:'Cash',items:[{product:'Cement',qty:10,unit:8500},{product:'Ceiling Board',qty:4,unit:9000}]},\n    {date:'2026-09-07',customer:'Midas Enterprises',payment:'Credit',items:[{product:'Paint',qty:10,unit:8500},{product:'Electrical Cable',qty:6,unit:12000}]},\n    {date:'2026-09-01',customer:'Unity Projects',payment:'Cash',items:[{product:'PVC Pipe',qty:20,unit:7000},{product:'Plumbing Fittings',qty:6,unit:4200}]},\n    {date:'2026-08-25',customer:'Topline Hardware',payment:'Credit',items:[{product:'Cement',qty:25,unit:8500},{product:'Iron Rod',qty:8,unit:15000}]},\n    {date:'2026-08-28',customer:'Delta Traders',payment:'Credit',items:[{product:'Cement',qty:12,unit:8500}]},\n    {date:'2026-08-30',customer:'John Ventures',payment:'Cash',items:[{product:'Paint',qty:5,unit:8500}]}\n  ],\n  expenses:[\n    {date:'2026-09-04',description:'Transport',amount:18000},\n    {date:'2026-09-10',description:'Shop power',amount:12000},\n    {date:'2026-09-16',description:'Loading',amount:8000},\n    {date:'2026-09-18',description:'Diesel and generator fuel',amount:28500},\n    {date:'2026-09-20',description:'Packaging and nylon',amount:9500},\n    {date:'2026-09-21',description:'Local delivery transport',amount:14000},\n    {date:'2026-09-22',description:'Store cleaning and supplies',amount:6500},\n    {date:'2026-09-13',description:'Minor equipment repair',amount:22000},\n    {date:'2026-09-08',description:'Water and sanitation',amount:5500}\n  ],\n  payments:[\n    {date:'2026-09-18',customer:'Bello Stores',amount:100000},\n    {date:'2026-09-20',customer:'Adeyemi Trading',amount:50000},\n    {date:'2026-09-21',customer:'Topline Hardware',amount:120000},\n    {date:'2026-09-22',customer:'Royal Homes',amount:90000},\n    {date:'2026-09-19',customer:'Midas Enterprises',amount:75000},\n    {date:'2026-09-15',customer:'Unity Projects',amount:100000},\n    {date:'2026-09-12',customer:'Bello Stores',amount:80000}\n  ]\n};\n\nlet data=null;\nlet selectedStart,selectedEnd,filtered=[];\n\nfunction normalizeSale(s){\n  if(Array.isArray(s.items)&&s.items.length){\n    const items=s.items.map(i=>Array.isArray(i)?{product:i[0],qty:Number(i[1]||0),unit:Number(i[2]||0)}:{product:i.product,qty:Number(i.qty||0),unit:Number(i.unit||i.unitPrice||0)});\n    return {...s,items,total:Number(s.total||items.reduce((a,i)=>a+i.qty*i.unit,0))};\n  }\n  return {...s,items:[{product:s.product||'Item',qty:Number(s.qty||0),unit:Number(s.unit||0)}],total:Number(s.total||0)};\n}\nfunction normalizeData(){ if(!data) return; data.sales=(data.sales||[]).map(normalizeSale); if(!Array.isArray(data.payments)) data.payments=[]; if(!Array.isArray(data.expenses)) data.expenses=[]; if(!Array.isArray(data.products)) data.products=[]; }\n\nfunction getRange(type){\n  const now=new Date(); now.setHours(0,0,0,0);\n  let s=new Date(now),e=new Date(now);\n  if(type==='week') s.setDate(now.getDate()-now.getDay());\n  if(type==='month') s.setDate(1);\n  if(type==='lastmonth'){s.setMonth(now.getMonth()-1);s.setDate(1);e.setDate(0);}\n  return [dateStr(s),dateStr(e)];\n}\nfunction showCustom(show){\n  document.getElementById('customDates').classList.toggle('show',show);\n}\nfunction setPreset(type){\n  if(type==='custom'){\n    showCustom(true);\n    return;\n  }\n  showCustom(false);\n  const [s,e]=getRange(type);\n  document.getElementById('startDate').value=s;\n  document.getElementById('endDate').value=e;\n}\nfunction getSelectedRange(){\n  const type=document.getElementById('periodSelect').value;\n  if(type==='custom'){\n    const s=document.getElementById('startDate').value;\n    const e=document.getElementById('endDate').value;\n    if(!s||!e||s>e){alert('Please choose a valid start and end date.');return null;}\n    return [s,e];\n  }\n  return getRange(type);\n}\nfunction inRange(d){return d>=selectedStart&&d<=selectedEnd;}\nfunction rangeLabel(){\n  return selectedStart===selectedEnd ? fmtNumeric(selectedStart) : fmtNumeric(selectedStart)+' - '+fmtNumeric(selectedEnd);\n}\nfunction fmtNumeric(d){const x=new Date(d+'T00:00:00');return pad(x.getDate())+'/'+pad(x.getMonth()+1)+'/'+x.getFullYear();}\nfunction branchScope(list){return (list||[]).filter(x=>activeClientBranchId==='all'||(Array.isArray(x.branchIds)&&x.branchIds.includes(activeClientBranchId))||String(x.branchId||'')===String(activeClientBranchId));}\nfunction refreshBranchSelect(){\n  const sel=document.getElementById('branchSelect');\n  const label=document.getElementById('branchLabel');\n  if(!sel)return;\n  const branches=data?.branches||[];\n  if(activeClientBranchId!=='all'&&!branches.some(b=>String(b.id)===String(activeClientBranchId)))activeClientBranchId='all';\n  sel.innerHTML='<option value=\"all\">All Branches</option>'+branches.map(b=>`<option value=\"${b.id}\">${b.name}</option>`).join('');\n  sel.value=activeClientBranchId;\n  label.textContent=activeClientBranchId==='all'?'All Branches':(branches.find(b=>String(b.id)===String(activeClientBranchId))?.name||'All Branches');\n}\nfunction render(){\n  if(!onlineMode && !window.__TBC_PREVIEW_MODE__){ data=JSON.parse(localStorage.getItem(KEY)||'null')||fallback; }\n  if(window.__TBC_PREVIEW_MODE__ && window.__TBC_PREVIEW_DATA__){ data=adaptOnlinePayload(window.__TBC_PREVIEW_DATA__); onlineMode=true; }\n  if(!data.payments)data.payments=[];\n  normalizeData();\n  const h=data.header||{};\n  document.getElementById('businessName').textContent=data.business||data.businessInfo?.name||'My Business';\n  const headerCustomName=document.getElementById('headerCustomName');\n  const headerSubtitle=document.getElementById('headerSubtitle');\n  const headerReadonly=document.getElementById('headerReadonly');\n  headerCustomName.textContent=h.brand||'';\n  headerSubtitle.textContent=h.sub||'';\n  headerCustomName.style.display=h.brand?'block':'none';\n  headerSubtitle.style.display=h.sub?'block':'none';\n  headerReadonly.textContent=h.readonly||'';\n  headerReadonly.style.display=h.readonly?'inline-block':'none';\n  const installText=h.install||'Contact Admin';\n  installBtn.textContent=installText;\n  installBtn.classList.toggle('show',h.showInstall===true);\n  refreshBranchSelect();\n\n  filtered=branchScope(data.sales).filter(s=>inRange(s.date));\n  const expenses=branchScope(data.expenses).filter(x=>inRange(x.date));\n  const payments=branchScope(data.payments).filter(x=>inRange(x.date));\n\n  const totalSales=filtered.reduce((a,x)=>a+Number(x.total||0),0);\n  const totalExpenses=expenses.reduce((a,x)=>a+Number(x.amount||0),0);\n  const debtorPayments=payments.reduce((a,x)=>a+Number(x.amount||0),0);\n  const cashSales=filtered.filter(x=>x.payment==='Cash').reduce((a,x)=>a+Number(x.total||0),0);\n  const creditSales=filtered.filter(x=>x.payment==='Credit');\n  const creditSalesTotal=creditSales.reduce((a,x)=>a+Number(x.total||0),0);\n  const cashReceived=cashSales+debtorPayments;\n\n  document.getElementById('totalSales').textContent=money(totalSales);\n  document.getElementById('transactionCount').textContent=filtered.length+' transaction'+(filtered.length===1?'':'s');\n  document.getElementById('totalExpenses').textContent=money(totalExpenses);\n  document.getElementById('cashReceived').textContent=money(cashReceived);\n  document.getElementById('debtorPaymentNote').textContent=payments.length?`${payments.length} debtor${payments.length===1?'':'s'} made payment${payments.length===1?'':'s'}`:'No debtor payments in this period';\n  document.getElementById('creditSalesCount').textContent=creditSales.length+' credit sale'+(creditSales.length===1?'':'s');\n  document.getElementById('creditSalesTotal').textContent=money(creditSalesTotal);\n\n  // Outstanding balances are calculated from all historical credit sales minus all historical payments.\n  const customerBalances={};\n  branchScope(data.sales).filter(x=>x.payment==='Credit'&&x.customer).forEach(x=>{\n    customerBalances[x.customer]=(customerBalances[x.customer]||0)+Number(x.total||0);\n  });\n  branchScope(data.payments).forEach(x=>{\n    customerBalances[x.customer]=(customerBalances[x.customer]||0)-Number(x.amount||0);\n  });\n  Object.keys(customerBalances).forEach(k=>{if(customerBalances[k]<=0)delete customerBalances[k];});\n  const debtTotal=Object.values(customerBalances).reduce((a,b)=>a+b,0);\n  document.getElementById('owingCount').textContent=Object.keys(customerBalances).length+' customer'+(Object.keys(customerBalances).length===1?'':'s')+' owing';\n  document.getElementById('debtTotal').textContent=money(debtTotal);\n\n  const scopedProducts=branchScope(data.products);\n  const low=scopedProducts.filter(p=>Number(p.qty||0)<=Number(p.reorder||0));\n  const available=scopedProducts.filter(p=>Number(p.qty||0)>Number(p.reorder||0));\n  document.getElementById('lowStockCount').textContent=low.length;\n  document.getElementById('availableStockCount').textContent=available.length;\n\n  document.getElementById('periodLabel').textContent=rangeLabel();\n  document.getElementById('rangeText').textContent='';\n\n  renderSales();\n}\nfunction saleTotal(s){return Number(s.total||s.items.reduce((a,i)=>a+i.qty*i.unit,0));}\nfunction renderSales(showAll=true){\n  const cashCount=filtered.filter(x=>x.payment==='Cash').length;\n  const creditCount=filtered.filter(x=>x.payment==='Credit').length;\n  document.getElementById('salesSummary').innerHTML=`${filtered.length} Transactions<br><span><b class=\"green\">${cashCount} Cash</b> • <b class=\"red\">${creditCount} Credit</b></span>`;\n  const list=showAll?filtered:filtered.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4);\n  document.getElementById('salesList').innerHTML=list.length?list.map((s,i)=>{\n    const customer=s.customer||'Customer';\n    const customerHtml=`<button class=\"customerBtn\" data-sale-index=\"${filtered.indexOf(s)}\">${customer}</button>`;\n    return `<div class=\"row\">\n      <div class=\"left\"><div>${customerHtml}</div><div class=\"meta\">${fmt(s.date)}</div></div>\n      <div style=\"text-align:right\"><div class=\"amount\">${money(saleTotal(s))}</div><div class=\"meta ${s.payment==='Cash'?'green':'red'}\">${s.payment}</div></div>\n    </div>`;\n  }).join(''):'<div class=\"empty\">No sales in this date range.</div>';\n  document.querySelectorAll('.customerBtn').forEach(btn=>btn.onclick=()=>openSaleDetails(Number(btn.dataset.saleIndex)));\n}\nlet modalHistory=[];\nfunction setModal(title,subtitle,body){\n  document.getElementById('modalTitle').textContent=title;\n  document.getElementById('modalSubtitle').textContent=subtitle||'';\n  document.getElementById('modalBody').innerHTML=body;\n  document.getElementById('modal').classList.add('open');\n}\nfunction openModal(title,subtitle,body){\n  if(document.getElementById('modal').classList.contains('open')){\n    modalHistory.push({title:document.getElementById('modalTitle').textContent,subtitle:document.getElementById('modalSubtitle').textContent,body:document.getElementById('modalBody').innerHTML});\n  }\n  setModal(title,subtitle,body);\n}\nfunction backModal(){\n  if(modalHistory.length){const p=modalHistory.pop();setModal(p.title,p.subtitle,p.body);}\n  else closeModal();\n}\nfunction closeModal(){modalHistory=[];document.getElementById('modal').classList.remove('open');}\n\nfunction openExpenses(){\n  const rows=branchScope(data.expenses).filter(x=>inRange(x.date)).sort((a,b)=>b.date.localeCompare(a.date));\n  const total=rows.reduce((a,x)=>a+Number(x.amount||0),0);\n  openModal('Expense Details',`${rows.length} expense record${rows.length===1?'':'s'} • ${fmt(selectedStart)} – ${fmt(selectedEnd)}`,\n    `<div class=\"detailTotal\">${money(total)}</div>`+\n    (rows.length?rows.map(x=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${x.description}</div><div class=\"meta\">${fmtLong(x.date)}</div></div><div class=\"amount\">${money(x.amount)}</div></div>`).join(''):'<div class=\"empty\">No expenses in this date range.</div>')\n  );\n}\nfunction openCash(){\n  const cashSales=filtered.filter(x=>x.payment==='Cash');\n  const payments=branchScope(data.payments).filter(x=>inRange(x.date));\n  const cashSaleTotal=cashSales.reduce((a,x)=>a+Number(x.total||0),0);\n  const payTotal=payments.reduce((a,x)=>a+Number(x.amount||0),0);\n  openModal('Cash Received',`${fmt(selectedStart)} – ${fmt(selectedEnd)}`,\n    `<div class=\"detailTotal\">${money(cashSaleTotal+payTotal)}</div>\n     <div class=\"detailCard\"><div class=\"name\">Cash sales</div><div class=\"detailValue\" style=\"margin-top:6px\">${money(cashSaleTotal)}</div></div>\n     <div class=\"detailCard\"><div class=\"name\">Debtor payments</div><div class=\"detailValue\" style=\"margin-top:6px\">${money(payTotal)}</div>\n     ${payments.length?payments.map(p=>`<div class=\"row\"><div><div class=\"name\">${p.customer}</div><div class=\"meta\">${fmtLong(p.date)}</div></div><div class=\"amount\">${money(p.amount)}</div></div>`).join(''):'<div class=\"empty\">No debtor payments in this period.</div>'}</div>`\n  );\n}\nfunction openDebtors(){\n  const balances={};\n  branchScope(data.sales).filter(x=>x.payment==='Credit'&&x.customer).forEach(x=>balances[x.customer]=(balances[x.customer]||0)+saleTotal(x));\n  branchScope(data.payments).forEach(x=>balances[x.customer]=(balances[x.customer]||0)-Number(x.amount||0));\n  Object.keys(balances).forEach(k=>{if(balances[k]<=0)delete balances[k];});\n  const names=Object.keys(balances).sort((a,b)=>balances[b]-balances[a]);\n  openModal('Customers Owing',`${names.length} customer${names.length===1?'':'s'} currently owing`,\n    names.length?names.map(name=>`<div class=\"row clickable debtorItem\" data-name=\"${encodeURIComponent(name)}\"><div class=\"left\"><div class=\"name\">${name}</div><div class=\"meta\">Tap to view transactions</div></div><div class=\"amount\">${money(balances[name])}</div></div>`).join(''):'<div class=\"empty\">No outstanding customers.</div>');\n  document.querySelectorAll('.debtorItem').forEach(x=>x.onclick=()=>openDebtorDetails(decodeURIComponent(x.dataset.name)));\n}\nfunction openDebtorDetails(name){\n  const credit=branchScope(data.sales).filter(x=>x.payment==='Credit'&&x.customer===name);\n  const payments=branchScope(data.payments).filter(x=>x.customer===name);\n  const owed=credit.reduce((a,x)=>a+saleTotal(x),0), paid=payments.reduce((a,x)=>a+Number(x.amount||0),0), balance=owed-paid;\n  openModal(name,`Outstanding balance: ${money(balance)}`,\n    `<div class=\"detailTotal\">${money(balance)}</div><div class=\"detailCard\"><strong>Credit sales</strong>`+\n    (credit.length?credit.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${fmtLong(x.date)} • ${x.items.length} item${x.items.length===1?'':'s'}</div><div class=\"meta\">${x.items.map(i=>`${i.product} × ${i.qty}`).join(', ')}</div></div><div class=\"amount\">${money(saleTotal(x))}</div></div>`).join(''):'<div class=\"empty\">No credit sales.</div>')+\n    `</div><div class=\"detailCard\"><strong>Payments made</strong>`+\n    (payments.length?payments.sort((a,b)=>b.date.localeCompare(a.date)).map(x=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">Payment</div><div class=\"meta\">${fmtLong(x.date)}</div></div><div class=\"amount\">${money(x.amount)}</div></div>`).join(''):'<div class=\"empty\">No recorded payments.</div>')+`</div>`\n  );\n}\nfunction openAvailableStock(){\n  const available=branchScope(data.products).filter(p=>Number(p.qty||0)>Number(p.reorder||0)).sort((a,b)=>String(a.name||'').localeCompare(String(b.name||'')));\n  openModal('Available Stock',`${available.length} item${available.length===1?'':'s'}`,\n    available.length?available.map(p=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${p.name}</div><div class=\"meta\">Reorder level: ${p.reorder}</div></div><div class=\"amount\">${p.qty}</div></div>`).join(''):'<div class=\"empty\">No available-stock items.</div>');\n}\nfunction showSalesPage(){\n  document.querySelector('main').style.display='none';\n  document.getElementById('salesPage').style.display='block';\n  renderSales(true);\n  window.scrollTo({top:0,behavior:'smooth'});\n}\nfunction hideSalesPage(){\n  document.getElementById('salesPage').style.display='none';\n  document.querySelector('main').style.display='block';\n  window.scrollTo({top:0,behavior:'smooth'});\n}\nfunction openLowStock(){\n  const low=branchScope(data.products).filter(p=>Number(p.qty||0)<=Number(p.reorder||0));\n  openModal('Low Stock Items',`${low.length} item${low.length===1?'':'s'}`,\n    low.length?low.map(p=>`<div class=\"row\"><div class=\"name\">${p.name}</div><div class=\"amount\">${p.qty}</div></div>`).join(''):'<div class=\"empty\">No low-stock items.</div>');\n}\nfunction openSaleDetails(index){\n  const s=filtered[index]; if(!s)return;\n  openModal(s.customer||'Sale Details',`Transaction • ${fmtLong(s.date)}`,\n    `<div class=\"detailCard\"><div class=\"detailGrid\">\n      <div class=\"detailItem\"><div class=\"detailLabel\">Customer</div><div class=\"detailValue\">${s.customer||'Customer'}</div></div>\n      <div class=\"detailItem\"><div class=\"detailLabel\">Payment</div><div class=\"detailValue ${s.payment==='Cash'?'green':'red'}\">${s.payment}</div></div>\n    </div></div>\n    <div class=\"detailCard\"><strong>Items Purchased</strong>`+\n    s.items.map(i=>`<div class=\"row\"><div class=\"left\"><div class=\"name\">${i.product}</div><div class=\"meta\">Qty: ${i.qty} × ${money(i.unit)}</div></div><div class=\"amount\">${money(i.qty*i.unit)}</div></div>`).join('')+\n    `<div class=\"row\"><div class=\"name\">TOTAL</div><div class=\"amount\">${money(saleTotal(s))}</div></div></div>`\n  );\n}\n\ndocument.getElementById('branchSelect').addEventListener('change',e=>{activeClientBranchId=e.target.value||'all';render();});\ndocument.getElementById('periodSelect').addEventListener('change',e=>{\n  const type=e.target.value;\n  if(type==='custom'){showCustom(true);}\n  else {setPreset(type);}\n  const r=getSelectedRange(); if(r){[selectedStart,selectedEnd]=r; render();}\n});\ndocument.getElementById('startDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});\ndocument.getElementById('endDate').addEventListener('change',()=>{const r=getSelectedRange();if(r){[selectedStart,selectedEnd]=r;render();}});\ndocument.getElementById('backModal').onclick=backModal;\ndocument.getElementById('salesCard').onclick=showSalesPage;\ndocument.getElementById('expensesCard').onclick=openExpenses;\ndocument.getElementById('cashCard').onclick=openCash;\ndocument.getElementById('debtCard').onclick=openDebtors;\ndocument.getElementById('lowStockCard').onclick=openLowStock;\ndocument.getElementById('availableStockCard').onclick=openAvailableStock;\ndocument.getElementById('backSalesPage').onclick=hideSalesPage;\ndocument.getElementById('closeModal').onclick=closeModal;\ndocument.getElementById('modal').onclick=e=>{if(e.target.id==='modal')closeModal();};\n\nsetPreset('today');\n[selectedStart,selectedEnd]=getRange('today');\n\n(function initClientConnection(){\n  const cfg=clientConfig();\n  if(cfg){\n    loadOnline().then(ok=>{\n      if(ok){hideConnectGate();if(onlineTimer)clearInterval(onlineTimer);onlineTimer=setInterval(()=>loadOnline(),5000);}\n      else { showConnectGate(); }\n    });\n  }else{showConnectGate();}\n})();\n\n// PWA shell registration: the live business data still comes directly from Supabase.\nif ('serviceWorker' in navigator) {\n  navigator.serviceWorker.register('./sw.js').then(reg=>{\n    // Check for a new deployed Client version whenever the app opens.\n    reg.update().catch(()=>{});\n    if (reg.waiting) reg.waiting.postMessage({type:'SKIP_WAITING'});\n    reg.addEventListener('updatefound',()=>{\n      const worker=reg.installing;\n      if(worker) worker.addEventListener('statechange',()=>{\n        if(worker.state==='installed' && navigator.serviceWorker.controller){\n          worker.postMessage({type:'SKIP_WAITING'});\n        }\n      });\n    });\n  }).catch(()=>{});\n  let refreshing=false;\n  navigator.serviceWorker.addEventListener('controllerchange',()=>{\n    if(refreshing)return;\n    refreshing=true;\n    window.location.reload();\n  });\n}\n<\/script>\n</body>\n</html>";
 const today=(()=>{const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`})();
const money=n=>'₦'+Number(n||0).toLocaleString('en-NG',{minimumFractionDigits:2,maximumFractionDigits:2});
const id=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,7); const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
const iso=d=>new Date(d).toISOString().slice(0,10);
let currentPage='dashboard', currentAdminId='admin-major', period='today';
let db=load();
function seed(){
 const businesses=[
  {id:'biz-build',name:'Sunrise Building Materials',type:'Building Materials',currency:'NGN',phone:'0803 100 2000',address:'Yenagoa, Bayelsa',active:true,clientFeedId:'CLIENT-BUILD-001',header:{businessName:'Sunrise Building Materials',brand:'',sub:'Business Control • Owner View',readonly:'VIEW ONLY • DATA ENTRY DISABLED',install:'Install Business Control',showInstall:true}},
  {id:'biz-electro',name:'ABC Electronics',type:'Electronics Retail',currency:'NGN',phone:'0803 300 4000',address:'Port Harcourt, Rivers',active:true,clientFeedId:'CLIENT-ELEC-002',header:{businessName:'ABC Electronics',brand:'',sub:'Business Control • Owner View',readonly:'VIEW ONLY • DATA ENTRY DISABLED',install:'Install Business Control',showInstall:true}},
  {id:'biz-metal',name:'Chief Metal Works',type:'Metal Fabrication',currency:'NGN',phone:'0803 500 6000',address:'Lagos, Nigeria',active:true,clientFeedId:'CLIENT-METAL-003',header:{businessName:'Chief Metal Works',brand:'',sub:'Business Control • Owner View',readonly:'VIEW ONLY • DATA ENTRY DISABLED',install:'Install Business Control',showInstall:true}}
 ];
 const admins=[{id:'admin-major',name:'Major Admin',email:'major@tradercontrol.local',role:'major',active:true,businessIds:businesses.map(b=>b.id)},{id:'admin-john',name:'John Admin',email:'john@tradercontrol.local',role:'admin',active:true,businessIds:['biz-build','biz-metal']},{id:'admin-mary',name:'Mary Admin',email:'mary@tradercontrol.local',role:'admin',active:true,businessIds:['biz-electro']}];
 const products=[] , customers=[], sales=[], payments=[], expenses=[];
 const addBiz=(bid,items,custs)=>{items.forEach(x=>products.push({id:id(),businessId:bid,name:x[0],category:x[1],unit:x[2],cost:x[3],sell:x[4],qty:x[5],reorder:x[6]}));custs.forEach(x=>customers.push({id:id(),businessId:bid,name:x[0],phone:x[1],address:x[2],opening:0}));};
 addBiz('biz-build',[['Cement','Building Materials','Bag',7800,9500,84,30],['Iron Rod 12mm','Building Materials','Length',7200,8500,28,35],['Paint 20L','Paint','Bucket',31000,38500,18,10],['PVC Pipe','Plumbing','Length',4200,5600,61,20],['Plumbing Fittings','Plumbing','Pack',8500,11000,13,15],['Ceiling Board','Building Materials','Sheet',6200,7600,42,20],['Electrical Cable','Electrical','Roll',58000,68000,7,10],['Adhesive','Finishing','Pack',1800,2500,9,12]],[['Bello Stores','0803 111 2200','Onitsha'],['Adeyemi Trading','0805 222 3311','Awka'],['John Ventures','0810 333 4422','Nnewi'],['Kingsway Shop','0806 444 5533','Onitsha'],['Midas Enterprises','0812 555 6644','Awka'],['Topline Hardware','0807 666 7755','Nnewi']]);
 addBiz('biz-electro',[['Samsung 43" TV','Television','Unit',270000,315000,9,3],['Android Phone','Phones','Unit',105000,135000,16,5],['Phone Charger','Accessories','Piece',3500,5000,28,10],['Extension Box','Accessories','Piece',6500,9000,12,5],['Bluetooth Speaker','Audio','Unit',42000,55000,6,3]],[['Bright Stores','0804 101 2020','Port Harcourt'],['Grace Ventures','0805 303 4040','Rumuokoro'],['Mighty Phones','0806 505 6060','Choba']]);
 addBiz('biz-metal',[['Metal Door','Fabrication','Unit',120000,180000,8,3],['Steel Gate','Fabrication','Unit',250000,380000,4,2],['Window Protector','Fabrication','Unit',28000,45000,19,6],['Angle Bar','Steel','Length',9500,12000,40,12],['Metal Furniture Set','Furniture','Set',185000,280000,3,2]],[['Royal Homes','0807 707 8080','Lagos'],['Apex Builders','0808 909 1010','Ikeja'],['Unity Projects','0810 111 1212','Lekki']]);
 function sale(bid,cid,date,type,arr,paid=0){const items=arr.map(a=>{let p=products.find(x=>x.businessId===bid&&x.name===a[0]);return {productId:p.id,qty:a[1],price:a[2]??p.sell}});const total=items.reduce((s,x)=>s+x.qty*x.price,0);sales.push({id:id(),businessId:bid,customerId:cid,date,type,items,paid:paid,total,createdBy:'admin-major'});}
 let c=customers.filter(x=>x.businessId==='biz-build');sale('biz-build',c[0].id,'2026-09-22','cash',[['Cement',20],['Iron Rod 12mm',4]]);sale('biz-build',c[1].id,'2026-09-21','credit',[['Paint 20L',4],['PVC Pipe',10]],50000);sale('biz-build',c[2].id,'2026-09-18','credit',[['Cement',30],['Ceiling Board',12]]);sale('biz-build',c[3].id,'2026-09-12','cash',[['Plumbing Fittings',3]]);sale('biz-build',c[4].id,'2026-08-27','credit',[['Electrical Cable',3]],0);sale('biz-build',c[5].id,'2026-08-15','credit',[['Cement',40]],100000);
 c=customers.filter(x=>x.businessId==='biz-electro');sale('biz-electro',c[0].id,'2026-09-22','cash',[['Samsung 43" TV',1],['Phone Charger',2]]);sale('biz-electro',c[1].id,'2026-09-19','credit',[['Android Phone',3]],100000);sale('biz-electro',c[2].id,'2026-09-10','cash',[['Bluetooth Speaker',2],['Extension Box',2]]);
 c=customers.filter(x=>x.businessId==='biz-metal');sale('biz-metal',c[0].id,'2026-09-22','credit',[['Metal Door',2],['Window Protector',4]],100000);sale('biz-metal',c[1].id,'2026-09-20','cash',[['Steel Gate',1]]);sale('biz-metal',c[2].id,'2026-09-08','credit',[['Metal Furniture Set',1],['Angle Bar',8]],50000);
 const cust=(bid,name)=>customers.find(x=>x.businessId===bid&&x.name===name).id;
 payments.push({id:id(),businessId:'biz-build',customerId:cust('biz-build','Adeyemi Trading'),date:'2026-09-22',amount:80000,method:'Bank Transfer',note:'Part payment',createdBy:'admin-john'});
 payments.push({id:id(),businessId:'biz-build',customerId:cust('biz-build','Topline Hardware'),date:'2026-09-18',amount:60000,method:'Cash',note:'Debt payment',createdBy:'admin-john'});
 payments.push({id:id(),businessId:'biz-metal',customerId:cust('biz-metal','Royal Homes'),date:'2026-09-22',amount:120000,method:'Transfer',note:'Project payment',createdBy:'admin-john'});
 expenses.push({id:id(),businessId:'biz-build',description:'Diesel / generator fuel',category:'Utilities',amount:85000,date:'2026-09-20',vendor:'Fuel Station',method:'Cash',notes:'Weekly fuel',createdBy:'admin-john'},{id:id(),businessId:'biz-build',description:'Local delivery',category:'Transport',amount:32000,date:'2026-09-15',vendor:'Driver',method:'Cash',notes:'Customer deliveries',createdBy:'admin-john'},{id:id(),businessId:'biz-electro',description:'Store cleaning',category:'Maintenance',amount:12000,date:'2026-09-14',vendor:'Cleaner',method:'Cash',notes:'',createdBy:'admin-major'},{id:id(),businessId:'biz-metal',description:'Welding rods',category:'Production',amount:54000,date:'2026-09-19',vendor:'Steel Supplier',method:'Transfer',notes:'Fabrication materials',createdBy:'admin-john'});
 return {businesses,admins,products,customers,sales,payments,expenses,activeBusinessId:'biz-build'};
}
function load(){try{const x=JSON.parse(localStorage.getItem(KEY));if(x&&x.businesses&&x.admins)return x}catch(e){}const x=seed();localStorage.setItem(KEY,JSON.stringify(x));return x}
function save(){localStorage.setItem(KEY,JSON.stringify(db)); const cfg=onlineConfig(); if(cfg.url&&cfg.key){ publishBusiness().catch(e=>console.warn('Auto-sync failed:',e.message)); }}
function biz(){return db.businesses.find(b=>b.id===db.activeBusinessId)||db.businesses[0]}
function allowedBusiness(bid){const a=db.admins.find(x=>x.id===currentAdminId);return !!(a&&a.active&&(a.role==='major'||a.businessIds.includes(bid)))}
function scoped(list){return list.filter(x=>x.businessId===db.activeBusinessId)}
function cust(idv){return db.customers.find(c=>c.id===idv)||{name:'Walk-in Customer'}}function prod(idv){return db.products.find(p=>p.id===idv)||{name:'Unknown',sell:0}}
function range(){const d=new Date(today), y=d.getFullYear(),m=d.getMonth(),day=d.getDate();if(period==='all')return ['0000-01-01','9999-12-31'];if(period==='today')return [today,today];if(period==='week'){const start=new Date(d);start.setDate(day-d.getDay());return [iso(start),today]}if(period==='month')return [`${y}-${String(m+1).padStart(2,'0')}-01`,today];const pm=new Date(y,m-1,1),end=new Date(y,m,0);return [iso(pm),iso(end)]}
function inRange(date){const r=range();return date>=r[0]&&date<=r[1]}function periodLabel(){const r=range();return r[0]==='0000-01-01'?'All Time':`${r[0]} to ${r[1]}`}
function totals(){
  const ss=scoped(db.sales).filter(s=>inRange(s.date)), ps=scoped(db.payments).filter(p=>inRange(p.date)), es=scoped(db.expenses).filter(e=>inRange(e.date));
  const cash=ss.filter(s=>paymentStatus(s)==='Cash'), credit=ss.filter(s=>saleOutstanding(s)>0);
  const creditTotal=ss.reduce((a,s)=>a+saleOutstanding(s),0), saleTotal=ss.reduce((a,s)=>a+Number(s.total||0),0);
  const amountReceived=ss.reduce((a,s)=>a+Number(s.paid||0),0)+ps.reduce((a,p)=>a+Number(p.amount||0),0);
  const owing=scoped(db.customers).map(c=>({...c,balance:customerOutstanding(c.id)})).filter(c=>c.balance>0);
  return{sales:ss,cashSales:cash,credit,creditTotal,saleTotal,payments:ps.reduce((a,p)=>a+Number(p.amount||0),0),cashReceived:amountReceived,amountReceived,exp:es.reduce((a,e)=>a+e.amount,0),owing}
}
function renderBusinessSelect(){const as=db.admins.filter(a=>a.active);document.getElementById('adminSelect').innerHTML=as.map(a=>`<option value="${a.id}" ${a.id===currentAdminId?'selected':''}>${esc(a.name)}${a.role==='major'?' • Major Admin':''}</option>`).join('');const a=db.admins.find(x=>x.id===currentAdminId);const list=db.businesses.filter(b=>b.active&&allowedBusiness(b.id));document.getElementById('businessSelect').innerHTML=list.map(b=>`<option value="${b.id}" ${b.id===db.activeBusinessId?'selected':''}>${esc(b.name)}</option>`).join('')||'<option>No access</option>';if(!allowedBusiness(db.activeBusinessId)&&list[0])db.activeBusinessId=list[0].id}
function render(){renderBusinessSelect();updateOnlineBadge();document.getElementById('period').value=period;document.getElementById('periodText').textContent=`${biz().name} • ${periodLabel()}`;document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById('page-'+currentPage).classList.add('active');document.querySelectorAll('#nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===currentPage));const titles={dashboard:'Dashboard',businesses:'Businesses',admins:'Admin Access',sales:'Sales',customers:'Customers',payments:'Debtor Payments',expenses:'Expenses',stock:'Stock',reports:'Reports',messages:'Client Messages',clientview:'Client App View',settings:'Settings'};document.getElementById('pageTitle').textContent=titles[currentPage];({dashboard:renderDashboard,businesses:renderBusinesses,admins:renderAdmins,sales:renderSales,customers:renderCustomers,payments:renderPayments,expenses:renderExpenses,stock:renderStock,reports:renderReports,messages:()=>{document.getElementById('page-messages').innerHTML='<div class="section"><div class="section-body"><div class="status">Loading Client Messages…</div></div></div>';loadAdminMessages()},settings:renderSettings,clientview:renderClientAppView}[currentPage])();save()}
function renderDashboard(){const t=totals(),b=biz();document.getElementById('page-dashboard').innerHTML=`<div class="notice"><b>Active business:</b> ${esc(b.name)} (${esc(b.type)}). All data shown below belongs only to this business.</div><div class="cards"><div class="card"><div class="label">Sales</div><div class="value">${money(t.saleTotal)}</div><div class="sub">${t.sales.length} transactions</div></div><div class="card"><div class="label">Amount Received</div><div class="value">${money(t.amountReceived)}</div><div class="sub">Sales payments + debtor payments</div></div><div class="card"><div class="label">Credit Sales</div><div class="value">${money(t.creditTotal)}</div><div class="sub">Outstanding from sales</div></div><div class="card"><div class="label">Customers Owing</div><div class="value">${t.owing.length}</div><div class="sub">${money(t.owing.reduce((a,c)=>a+c.balance,0))} outstanding</div></div></div><div class="grid2"><div class="section"><div class="section-head"><h3>Recent Sales</h3><button class="btn secondary small" data-go="sales">View All</button></div><div class="section-body"><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Payment</th><th class="right">Amount</th></tr></thead><tbody>${t.sales.slice().sort((a,b)=>b.date.localeCompare(a.date)).slice(0,6).map(s=>`<tr><td>${esc(cust(s.customerId).name)}</td><td>${s.date}</td><td class="${paymentStatus(s)==='Cash'?'green-text':(paymentStatus(s)==='Partly Credit'?'orange-text':'red-text')}">${paymentStatus(s)}</td><td class="right">${money(s.total)}</td></tr>`).join('')||'<tr><td colspan="4" class="empty">No sales in this period.</td></tr>'}</tbody></table></div></div><div class="section"><div class="section-head"><h3>Business Snapshot</h3></div><div class="section-body"><div class="statline"><span class="pill">Products <b>${scoped(db.products).length}</b></span><span class="pill">Low Stock <b>${scoped(db.products).filter(p=>p.qty<=p.reorder).length}</b></span><span class="pill">Customers <b>${scoped(db.customers).length}</b></span></div><p class="status">Selected business: <b>${esc(b.name)}</b><br>Client Feed ID: <b>${esc(b.clientFeedId)}</b></p><button class="btn" data-go="businesses">Manage Businesses</button></div></div></div>`}
function renderBusinesses(){document.getElementById('page-businesses').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="bizSearch" placeholder="Search businesses"></div><button class="btn" data-action="new-business">+ Add Business</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Business</th><th>Type</th><th>Contact</th><th>Admins</th><th>Status</th><th>Client Feed</th><th>Actions</th></tr></thead><tbody id="bizBody">${db.businesses.map(b=>{const as=db.admins.filter(a=>a.businessIds.includes(b.id));return `<tr data-search="${esc(b.name+' '+b.type)}"><td><b>${esc(b.name)}</b><br><span class="status">${esc(b.address||'')}</span></td><td>${esc(b.type)}</td><td>${esc(b.phone||'')}</td><td>${as.length}</td><td><span class="tag ${b.active?'active':'off'}">${b.active?'ACTIVE':'INACTIVE'}</span></td><td>${esc(b.clientFeedId)}</td><td><div class="actions"><button class="btn ${b.id===db.activeBusinessId?'green':'secondary'} small" data-action="select-business" data-id="${b.id}">${b.id===db.activeBusinessId?'Selected':'Select'}</button><button class="btn secondary small" data-action="edit-business" data-id="${b.id}">Edit</button><button class="btn ${b.active?'danger':'green'} small" data-action="toggle-business" data-id="${b.id}">${b.active?'Deactivate':'Activate'}</button></div></td></tr>`}).join('')}</tbody></table></div></div></div>`;document.getElementById('bizSearch').oninput=e=>document.querySelectorAll('#bizBody tr').forEach(r=>r.style.display=r.dataset.search.toLowerCase().includes(e.target.value.toLowerCase())?'':'none')}
function renderAdmins(){const me=db.admins.find(a=>a.id===currentAdminId);document.getElementById('page-admins').innerHTML=`${me.role==='major'?'<div class="notice"><b>Major Admin access.</b> You can create administrators and assign each administrator to one or more registered businesses.</div>':'<div class="warning"><b>Limited Admin.</b> You can manage only the businesses assigned to your account. Major Admin controls administrator access.</div>'}<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Admins <b>${db.admins.length}</b></span><span class="pill">Major Admins <b>${db.admins.filter(a=>a.role==='major').length}</b></span></div>${me.role==='major'?'<button class="btn" data-action="new-admin">+ Add Admin</button>':''}</div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Admin</th><th>Role</th><th>Assigned Businesses</th><th>Status</th><th>Actions</th></tr></thead><tbody>${db.admins.map(a=>`<tr><td><b>${esc(a.name)}</b><br><span class="status">${esc(a.email)}</span></td><td>${a.role==='major'?'<span class="tag major">MAJOR ADMIN</span>':'Admin'}</td><td><div class="access-list">${a.businessIds.map(x=>{const b=db.businesses.find(y=>y.id===x);return b?`<span class="access-chip">${esc(b.name)}</span>`:''}).join('')||'<span class="status">No business assigned</span>'}</div></td><td><span class="tag ${a.active?'active':'off'}">${a.active?'ACTIVE':'INACTIVE'}</span></td><td>${me.role==='major'&&a.id!=='admin-major'?`<div class="actions"><button class="btn secondary small" data-action="edit-admin" data-id="${a.id}">Edit Access</button><button class="btn ${a.active?'danger':'green'} small" data-action="toggle-admin" data-id="${a.id}">${a.active?'Deactivate':'Activate'}</button><button class="btn danger small" data-action="delete-admin" data-id="${a.id}">Delete</button><button class="btn danger small" data-action="delete-admin" data-id="${a.id}">Delete</button></div>`:'—'}</td></tr>`).join('')}</tbody></table></div></div></div>`}
function renderSales(){const rows=scoped(db.sales).filter(s=>inRange(s.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-sales').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="salesSearch" placeholder="Search customer"></div><button class="btn" data-action="new-sale">+ New Sale</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Payment</th><th>Items</th><th class="right">Sales</th><th class="right">Received</th><th class="right">Credit</th><th>Actions</th></tr></thead><tbody id="salesBody">${rows.map(s=>`<tr data-search="${esc(cust(s.customerId).name)}"><td><b>${esc(cust(s.customerId).name)}</b></td><td>${s.date}</td><td class="${paymentStatus(s)==='Cash'?'green-text':(paymentStatus(s)==='Partly Credit'?'orange-text':'red-text')}">${paymentStatus(s)}</td><td>${s.items.length}</td><td class="right">${money(s.total)}</td><td class="right">${money(s.paid||0)}</td><td class="right">${money(saleOutstanding(s))}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-sale" data-id="${s.id}">Edit</button><button class="btn danger small" data-action="delete-sale" data-id="${s.id}">Delete</button></div></td></tr>`).join('')||'<tr><td colspan="8" class="empty">No sales in this period.</td></tr>'}</tbody></table></div></div></div>`;document.getElementById('salesSearch').oninput=e=>document.querySelectorAll('#salesBody tr').forEach(r=>r.style.display=r.dataset.search?.toLowerCase().includes(e.target.value.toLowerCase())?'':'none')}
function renderCustomers(){const t=totals();document.getElementById('page-customers').innerHTML=`<div class="toolbar"><input class="search" id="customerSearch" placeholder="Search customer"><button class="btn" data-action="new-customer">+ New Customer</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Phone</th><th>Address</th><th class="right">Balance</th><th>Actions</th></tr></thead><tbody id="customerBody">${scoped(db.customers).map(c=>{let o=t.owing.find(x=>x.id===c.id)?.balance||0;return `<tr data-search="${esc(c.name+' '+c.phone)}"><td><b>${esc(c.name)}</b></td><td>${esc(c.phone)}</td><td>${esc(c.address)}</td><td class="right ${o?'red-text':''}">${money(o)}</td><td><button class="btn secondary small" data-action="edit-customer" data-id="${c.id}">Edit</button></td></tr>`}).join('')}</tbody></table></div></div></div>`;document.getElementById('customerSearch').oninput=e=>document.querySelectorAll('#customerBody tr').forEach(r=>r.style.display=r.dataset.search.toLowerCase().includes(e.target.value.toLowerCase())?'':'none')}
function renderPayments(){const rows=scoped(db.payments).filter(p=>inRange(p.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-payments').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Payments <b>${rows.length}</b></span><span class="pill">Received <b>${money(rows.reduce((a,p)=>a+p.amount,0))}</b></span></div><button class="btn" data-action="new-payment">+ Record Payment</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Method</th><th>Note</th><th class="right">Amount</th><th>Actions</th></tr></thead><tbody>${rows.map(p=>`<tr><td>${esc(cust(p.customerId).name)}</td><td>${p.date}</td><td>${esc(p.method)}</td><td>${esc(p.note)}</td><td class="right">${money(p.amount)}</td><td><button class="btn danger small" data-action="delete-payment" data-id="${p.id}">Delete</button></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No payments in this period.</td></tr>'}</tbody></table></div></div></div>`}
function renderExpenses(){const rows=scoped(db.expenses).filter(e=>inRange(e.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-expenses').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Expenses <b>${rows.length}</b></span><span class="pill">Total <b>${money(rows.reduce((a,e)=>a+e.amount,0))}</b></span></div><button class="btn" data-action="new-expense">+ New Expense</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Description</th><th>Category</th><th>Date</th><th>Vendor / Person</th><th>Method</th><th class="right">Amount</th><th>Actions</th></tr></thead><tbody>${rows.map(e=>`<tr><td>${esc(e.description)}</td><td>${esc(e.category)}</td><td>${e.date}</td><td>${esc(e.vendor)}</td><td>${esc(e.method)}</td><td class="right">${money(e.amount)}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-expense" data-id="${e.id}">Edit</button><button class="btn danger small" data-action="delete-expense" data-id="${e.id}">Delete</button></div></td></tr>`).join('')||'<tr><td colspan="7" class="empty">No expenses in this period.</td></tr>'}</tbody></table></div></div></div>`}
function renderStock(){document.getElementById('page-stock').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Products <b>${scoped(db.products).length}</b></span><span class="pill">Low Stock <b>${scoped(db.products).filter(p=>p.qty<=p.reorder).length}</b></span></div><button class="btn" data-action="new-product">+ New Product</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Item</th><th>Category</th><th>Unit</th><th class="right">Cost</th><th class="right">Selling</th><th class="right">Qty</th><th>Reorder</th><th>Status</th><th>Actions</th></tr></thead><tbody>${scoped(db.products).map(p=>`<tr><td><b>${esc(p.name)}</b></td><td>${esc(p.category)}</td><td>${esc(p.unit)}</td><td class="right">${money(p.cost)}</td><td class="right">${money(p.sell)}</td><td class="right">${p.qty}</td><td>${p.reorder}</td><td class="${p.qty<=p.reorder?'red-text':'green-text'}">${p.qty<=p.reorder?'LOW':'OK'}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-product" data-id="${p.id}">Edit</button><button class="btn small" data-action="adjust-stock" data-id="${p.id}">Adjust</button></div></td></tr>`).join('')}</tbody></table></div></div></div>`}
function renderReports(){const t=totals();document.getElementById('page-reports').innerHTML=`<div class="cards"><div class="card"><div class="label">Sales</div><div class="value">${money(t.saleTotal)}</div><div class="sub">${t.sales.length} transactions</div></div><div class="card"><div class="label">Credit Sales</div><div class="value">${money(t.creditTotal)}</div><div class="sub">${t.credit.length} transactions</div></div><div class="card"><div class="label">Amount Received</div><div class="value">${money(t.amountReceived)}</div><div class="sub">Sales payments + debtor payments</div></div><div class="card"><div class="label">Customers Owing</div><div class="value">${t.owing.length}</div><div class="sub">${money(t.owing.reduce((a,c)=>a+c.balance,0))} outstanding</div></div></div><div class="section"><div class="section-head"><h3>Report Summary — ${esc(biz().name)}</h3></div><div class="section-body"><table class="table"><tr><td>Report period</td><td class="right">${periodLabel()}</td></tr><tr><td>Total sales transactions</td><td class="right">${t.sales.length}</td></tr><tr><td>Fully paid sales</td><td class="right">${t.cashSales.length}</td></tr><tr><td>Sales with outstanding balance</td><td class="right">${t.credit.length}</td></tr><tr><td>Total credit sales</td><td class="right">${money(t.creditTotal)}</td></tr><tr><td>Amount received</td><td class="right">${money(t.amountReceived)}</td></tr><tr><td>Debtor payments received</td><td class="right">${money(t.payments)}</td></tr><tr><td>Total expenses</td><td class="right">${money(t.exp)}</td></tr></table></div></div>`}
function onlineConfig(){try{return JSON.parse(localStorage.getItem('tbc_v4_online_config'))||{url:'',key:'',auto:false,status:'Not connected'}}catch(e){return{url:'',key:'',auto:false,status:'Not connected'}}}
function setOnlineConfig(c){localStorage.setItem('tbc_v4_online_config',JSON.stringify(c))}
function snapshotForBusiness(bid){const b=db.businesses.find(x=>x.id===bid);const branches=(db.branches||[]).filter(x=>x.businessId===bid);return{version:6,business:b,header:b?.header||null,branches,products:db.products.filter(x=>x.businessId===bid),customers:db.customers.filter(x=>x.businessId===bid),sales:db.sales.filter(x=>x.businessId===bid),payments:db.payments.filter(x=>x.businessId===bid),expenses:db.expenses.filter(x=>x.businessId===bid),stockMovements:(db.stockMovements||[]).filter(x=>x.businessId===bid),generatedAt:new Date().toISOString()}}
async function onlineRequest(path,opts={}){const c=onlineConfig();if(!c.url||!c.key)throw new Error('Supabase URL and anon/publishable key are required.');let base=c.url.trim().replace(/\/$/,'');base=base.replace(/\/dashboard\/.*$/,'').replace(/\/project\/[^/]+.*$/,'');if(!/^https:\/\/[^/]+\.supabase\.co$/.test(base))throw new Error('Project URL format should be https://YOUR-PROJECT-REF.supabase.co');return fetch(base+path,{...opts,headers:{'apikey':c.key.trim(),'Authorization':'Bearer '+c.key.trim(),'Content-Type':'application/json','Accept':'application/json',...(opts.headers||{})}})}
async function testOnline(){const c=onlineConfig();if(!c.url||!c.key)throw new Error('Enter the Supabase Project URL and anon/publishable key first.');const health=await onlineRequest('/auth/v1/health');if(!health.ok)throw new Error('Supabase URL/key check failed ('+health.status+'). Make sure you copied the Project URL, not the dashboard URL, and copied the Publishable/Anon key.');const r=await onlineRequest('/rest/v1/client_feeds?select=feed_id&limit=1');if(!r.ok){let detail='';try{detail=(await r.text()).slice(0,180)}catch(e){}throw new Error('Supabase is reachable, but the database API returned '+r.status+'. '+(detail||'Make sure Data API is enabled and the client_feeds table/policy was created.'));}return true}
async function publishBusiness(){const s=snapshotForBusiness(db.activeBusinessId), b=s.business;const r=await onlineRequest('/rest/v1/client_feeds?on_conflict=feed_id',{method:'POST',headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},body:JSON.stringify({feed_id:b.clientFeedId,business_name:b.name,payload:s,updated_at:new Date().toISOString()})});if(!r.ok)throw new Error(await r.text());return true}
function updateOnlineBadge(){const c=onlineConfig();const el=document.getElementById('onlineBadge');if(!el)return;el.textContent=c.url&&c.key?'● Online Ready':'● Local Demo';el.style.background=c.url&&c.key?'#dcfce7':'#e2e8f0';el.style.color=c.url&&c.key?'#166534':'#475569'}
async function autoSync(){const c=onlineConfig();if(!c.auto||!c.url||!c.key)return;try{await publishBusiness();const x=onlineConfig();x.status='Last sync: '+new Date().toLocaleTimeString();setOnlineConfig(x);updateOnlineBadge()}catch(e){const x=onlineConfig();x.status='Sync error: '+e.message;setOnlineConfig(x)}}
let onlineTimer=setInterval(autoSync,5000);
function renderClientAppView(){
  const b=biz(), page=document.getElementById('page-clientview');
  if(!page)return;
  const snap=snapshotForBusiness(db.activeBusinessId);
  const safeJson=JSON.stringify(snap).replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/&/g,'\\u0026');
  page.innerHTML=`<div class="client-view-shell"><div class="client-view-head"><div><h3>Client App View</h3><p>Exact Client App design using the selected business's published feed data.</p></div><div class="client-view-meta"><span class="badge">${esc(b.name)}</span><span class="badge">Feed: ${esc(b.clientFeedId)}</span></div></div><div class="notice client-view-note"><b>Preview:</b> This is a read-only replica of the Client App. It does not create sales, expenses, stock changes, or messages.</div><div class="client-view-frame-wrap"><iframe id="clientAppPreviewFrame" class="client-view-frame" title="Client App View" sandbox="allow-scripts allow-forms allow-modals"></iframe></div></div>`;
  const frame=document.getElementById('clientAppPreviewFrame');
  if(!frame)return;
  const boot='<script>window.__TBC_PREVIEW_DATA__='+safeJson+';window.__TBC_PREVIEW_MODE__=true;<\/script>';
  frame.srcdoc=CLIENT_APP_VIEW_SOURCE.replace('</head>',boot+'</head>');
}

function renderSettings(){const b=biz(),me=db.admins.find(a=>a.id===currentAdminId);const cfg=onlineConfig();document.getElementById('page-settings').innerHTML=`<div class="grid2"><div class="section"><div class="section-head"><h3>Current Business</h3></div><div class="section-body"><table class="table"><tr><td>Name</td><td class="right">${esc(b.name)}</td></tr><tr><td>Type</td><td class="right">${esc(b.type)}</td></tr><tr><td>Currency</td><td class="right">${esc(b.currency)}</td></tr><tr><td>Client Feed ID</td><td class="right"><b>${esc(b.clientFeedId)}</b></td></tr><tr><td>Your Access</td><td class="right">${me.role==='major'?'All Businesses':'Assigned Business'}</td></tr></table></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Client App Header Management</h3></div><div class="section-body"><p class="status">Create, adjust, show/hide, or clear the information displayed in the Client App header. Changes are included in the selected business Client Feed.</p><div class="form-grid"><label class="field"><span>Additional Header Name</span><input id="hdrBrand" value="${esc(b.header?.brand??'')}"></label><label class="field"><span>Subtitle</span><input id="hdrSub" value="${esc(b.header?.sub??'')}"></label><label class="field"><span>Read-only Notice</span><input id="hdrReadonly" value="${esc(b.header?.readonly??'')}"></label><label class="field"><span>Install Button Text</span><input id="hdrInstall" value="${esc(b.header?.install??'Contact Admin')}"></label><label class="field full"><span>Install Button</span><select id="hdrShowInstall"><option value="yes" ${(b.header?.showInstall!==false)?'selected':''}>Show</option><option value="no" ${(b.header?.showInstall===false)?'selected':''}>Hide</option></select></label></div><div class="actions"><button class="btn" data-action="save-header">Save Header</button><button class="btn danger" data-action="clear-header">Clear Header</button></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Online Connection Center</h3></div><div class="section-body"><p class="status">Connect this Admin App to the shared online database. The selected business is published under its own Client Feed ID. No business can read another business's feed.</p><div class="form-grid"><label class="field full">Supabase Project URL<input id="sbUrl" value="${esc(cfg.url)}" placeholder="https://your-project.supabase.co"></label><label class="field full">Supabase Anon Key<input id="sbKey" type="password" value="${esc(cfg.key)}" placeholder="Paste your anon/public key"></label><label class="field"><span>Auto Sync</span><select id="autoSync"><option value="off" ${cfg.auto?'':'selected'}>Off</option><option value="on" ${cfg.auto?'selected':''}>Every 5 seconds</option></select></label></div><div class="actions"><button class="btn primary" data-action="save-online-config">Save Connection</button><button class="btn secondary" data-action="test-online">Test Connection</button><button class="btn secondary" data-action="publish-business">Publish Current Business</button></div><div id="onlineStatus" class="status" style="margin-top:10px">${esc(cfg.status||'Not connected')}</div></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Client Feed</h3></div><div class="section-body"><p class="status">Client Feed ID: <b>${esc(b.clientFeedId)}</b>. The Corrected V6 Client should use this ID to read only this business's published snapshot.</p><div class="actions"><button class="btn secondary" data-action="copy-feed">Copy Feed ID</button><button class="btn secondary" data-action="export-feed">Export Current Business Feed JSON</button></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Local Demo Data</h3></div><div class="section-body"><p class="status">Browser demo data remains available when no online database is configured.</p><div class="actions"><button class="btn secondary" data-action="export">Export JSON</button><button class="btn danger" data-action="reset">Reset Demo Data</button></div></div></div>`}
function openModal(title,body,saveFn){document.getElementById('modalTitle').textContent=title;document.getElementById('modalBody').innerHTML=body;document.getElementById('modalFoot').innerHTML='<button class="btn secondary" id="cancelModal">Cancel</button><button class="btn" id="saveModal">Save</button>';document.getElementById('modal').classList.add('open');document.getElementById('cancelModal').onclick=closeModal;document.getElementById('saveModal').onclick=async()=>{const b=document.getElementById('saveModal');if(b.disabled)return;b.disabled=true;b.textContent='Saving…';try{const result=await saveFn();if(result!==false)closeModal()}catch(e){alert(e?.message||String(e))}finally{if(document.getElementById('saveModal')){document.getElementById('saveModal').disabled=false;document.getElementById('saveModal').textContent='Save'}}}}function closeModal(){document.getElementById('modal').classList.remove('open')}
function formBusiness(b){b=b||{name:'',type:'',phone:'',address:'',active:true};return `<div class="form-grid"><div class="field"><label>Business Name</label><input id="fName" value="${esc(b.name)}"></div><div class="field"><label>Business Type</label><input id="fType" value="${esc(b.type)}" placeholder="e.g. Electronics Retail"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(b.phone)}"></div><div class="field"><label>Currency</label><input id="fCurrency" value="${esc(b.currency||'NGN')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(b.address)}"></div></div>`}
function formAdmin(a){a=a||{name:'',email:'',active:true,businessIds:[]};return `<div class="form-grid"><div class="field"><label>Admin Name</label><input id="fName" value="${esc(a.name)}"></div><div class="field"><label>Email / Username</label><input id="fEmail" value="${esc(a.email)}"></div><div class="field full"><label>Business Access — select one or more</label><div style="display:grid;gap:8px">${db.businesses.map(b=>`<label style="font-weight:400;color:#182230"><input type="checkbox" class="biz-check" value="${b.id}" ${a.businessIds.includes(b.id)?'checked':''}> ${esc(b.name)} ${!b.active?'(inactive)':''}</label>`).join('')}</div></div></div>`}
function paymentStatus(s){
  const total=Number(s?.total||0), paid=Math.max(0,Math.min(Number(s?.paid||0),total));
  if(total<=0 || paid>=total) return 'Cash';
  if(paid>0) return 'Partly Credit';
  return 'Credit';
}
function saleOutstanding(s){return Math.max(0,Number(s?.total||0)-Number(s?.paid||0));}
function customerOutstanding(customerId){
  if(!customerId) return 0;
  const soldOutstanding=scoped(db.sales).filter(s=>s.customerId===customerId)
    .reduce((a,s)=>a+saleOutstanding(s),0);
  const debtorPayments=scoped(db.payments).filter(p=>p.customerId===customerId)
    .reduce((a,p)=>a+Number(p.amount||0),0);
  return Math.max(0,soldOutstanding-debtorPayments);
}
function customerOptions(sel=''){
  const owing=scoped(db.customers).filter(c=>customerOutstanding(c.id)>0);
  return '<option value="">Select Debtor</option>'+owing.map(c=>`<option value="${c.id}" ${c.id===sel?'selected':''}>${esc(c.name)}</option>`).join('')
}
function productOptions(sel=''){return scoped(db.products).map(p=>`<option value="${p.id}" ${p.id===sel?'selected':''}>${esc(p.name)} — ${money(p.sell)}</option>`).join('')}
function branchOptions(sel=''){const brs=branchesFor(db.activeBusinessId);const locked=typeof activeBranchId!=='undefined'&&activeBranchId!=='all';const preferred=locked?activeBranchId:(sel||((brs.length===1)?brs[0].id:''));const available=locked?brs.filter(b=>String(b.id)===String(activeBranchId)):brs;return '<option value="">Select Branch</option>'+available.map(b=>`<option value="${b.id}" ${String(b.id)===String(preferred)?'selected':''}>${esc(b.name)}</option>`).join('')} function branchSelectAttrs(){return (typeof activeBranchId!=='undefined'&&activeBranchId!=='all')?' disabled title="Locked to the branch selected on the Home screen"':''}

function itemRow(x,i){return `<div class="item-row"><select class="i-prod" data-i="${i}">${productOptions(x.productId)}</select><input class="i-qty" data-i="${i}" type="number" min="1" value="${x.qty}"><input class="i-price" data-i="${i}" type="number" min="0" value="${x.price}"><button type="button" class="remove-item" data-remove="${i}">×</button></div>`}
function saleForm(s){s=s||{customerId:'',date:today,type:'cash',paid:0,items:[{productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0}]};return `<div class="form-grid"><div class="field"><label>Customer</label><select id="fCustomer">${customerOptions(s.customerId)}</select></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${s.date}"></div><div class="field"><label>Payment Status</label><div id="fPaymentStatus" class="status">${paymentStatus(s)}</div></div><div class="field"><label>Initial Payment</label><input id="fPaid" type="number" min="0" value="${s.paid||0}"></div><div class="field full"><label>Sale Items — multiple items supported</label><div id="items">${s.items.map(itemRow).join('')}</div><button type="button" class="btn secondary small" id="addItem">+ Add Item</button></div></div>`}
function collectItems(){return [...document.querySelectorAll('.item-row')].map(r=>{const p=r.querySelector('.i-prod').value,q=Number(r.querySelector('.i-qty').value||0),pr=Number(r.querySelector('.i-price').value||0);return{productId:p,qty:q,price:pr}}).filter(x=>x.productId&&x.qty>0)}
function newSale(existing){openModal(existing?'Edit Sale':'New Sale',saleForm(existing),()=>{const items=collectItems();if(!items.length)return alert('Add at least one item.');const total=items.reduce((a,x)=>a+x.qty*x.price,0);if(existing){Object.assign(existing,{customerId:document.getElementById('fCustomer').value,date:document.getElementById('fDate').value,type:paymentStatus({total,paid:Number(document.getElementById('fPaid').value||0)}).toLowerCase().replace(' ','_'),paid:Number(document.getElementById('fPaid').value||0),items,total})}else db.sales.push({id:id(),businessId:db.activeBusinessId,customerId:document.getElementById('fCustomer').value,date:document.getElementById('fDate').value,type:paymentStatus({total,paid:Number(document.getElementById('fPaid').value||0)}).toLowerCase().replace(' ','_'),paid:Number(document.getElementById('fPaid').value||0),items,total,createdBy:currentAdminId});render();return true})}
function newCustomer(existing){openModal(existing?'Edit Customer':'New Customer',`<div class="form-grid"><div class="field"><label>Name</label><input id="fName" value="${esc(existing?.name||'')}"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(existing?.phone||'')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(existing?.address||'')}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim();if(!name)return false;if(existing)Object.assign(existing,{name,phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value});else db.customers.push({id:id(),businessId:db.activeBusinessId,name,phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value,opening:0});render();return true})}
function newExpense(existing){openModal(existing?'Edit Expense':'New Expense',`<div class="form-grid"><div class="field"><label>Description</label><input id="fDesc" value="${esc(existing?.description||'')}"></div><div class="field"><label>Category</label><input id="fCat" value="${esc(existing?.category||'')}"></div><div class="field"><label>Amount</label><input id="fAmount" type="number" value="${existing?.amount||''}"></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${existing?.date||today}"></div><div class="field"><label>Person / Vendor Paid</label><input id="fVendor" value="${esc(existing?.vendor||'')}"></div><div class="field"><label>Payment Method</label><select id="fMethod"><option>Cash</option><option>Transfer</option><option>Bank</option></select></div><div class="field full"><label>Notes</label><textarea id="fNotes">${esc(existing?.notes||'')}</textarea></div></div>`,()=>{const o={description:document.getElementById('fDesc').value,category:document.getElementById('fCat').value,amount:Number(document.getElementById('fAmount').value||0),date:document.getElementById('fDate').value,vendor:document.getElementById('fVendor').value,method:document.getElementById('fMethod').value,notes:document.getElementById('fNotes').value};if(!o.description||!o.amount)return false;if(existing)Object.assign(existing,o);else db.expenses.push({id:id(),businessId:db.activeBusinessId,...o,createdBy:currentAdminId});render();return true})}
function newProduct(existing){openModal(existing?'Edit Product':'New Product',`<div class="form-grid"><div class="field"><label>Item Name</label><input id="fName" value="${esc(existing?.name||'')}"></div><div class="field"><label>Category</label><input id="fCat" value="${esc(existing?.category||'')}"></div><div class="field"><label>Unit</label><input id="fUnit" value="${esc(existing?.unit||'Unit')}"></div><div class="field"><label>Cost Price</label><input id="fCost" type="number" value="${existing?.cost||''}"></div><div class="field"><label>Selling Price</label><input id="fSell" type="number" value="${existing?.sell||''}"></div><div class="field"><label>Quantity</label><input id="fQty" type="number" value="${existing?.qty||0}"></div><div class="field"><label>Reorder Level</label><input id="fReorder" type="number" value="${existing?.reorder||0}"></div></div>`,()=>{const o={name:document.getElementById('fName').value,category:document.getElementById('fCat').value,unit:document.getElementById('fUnit').value,cost:Number(document.getElementById('fCost').value||0),sell:Number(document.getElementById('fSell').value||0),qty:Number(document.getElementById('fQty').value||0),reorder:Number(document.getElementById('fReorder').value||0)};if(!o.name)return false;if(existing)Object.assign(existing,o);else db.products.push({id:id(),businessId:db.activeBusinessId,...o});render();return true})}
function newPayment(){
 const owedFor=c=>customerOutstanding(c?.id);
 openModal('Record Debtor Payment',`<div class="form-grid"><div class="field"><label>Customer / Debtor</label><select id="fCustomer">${customerOptions()}</select></div><div class="field"><label>Total Amount Owed</label><input id="fOwed" value="₦0" disabled></div><div class="field"><label>Business Branch</label><select id="fBranch"${branchSelectAttrs()}>${branchOptions('')}</select></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${today}"></div><div class="field"><label>Amount Paid</label><input id="fAmount" type="number" min="0" step="0.01"></div><div class="field"><label>Method</label><select id="fMethod"><option>Cash</option><option>Transfer</option><option>Bank Transfer</option></select></div><div class="field full"><label>Note</label><input id="fNote"></div></div>`,()=>{
   const c=scoped(db.customers).find(v=>v.id===document.getElementById('fCustomer').value);
   if(!c){alert('Please select a debtor.');return false}
   // Branch state lives inside the branch-management module's IIFE.
   // Access it through the public getter instead of referencing the IIFE-local
   // variable directly (which caused ReferenceError and made Save appear dead).
   let paymentBranchId=document.getElementById('fBranch')?.value||'';
   if(!paymentBranchId){
     paymentBranchId=c.branchId||'';
     if(!paymentBranchId){
       const brs=branchesFor(db.activeBusinessId);
       if(brs.length===1)paymentBranchId=brs[0].id;
     }
     if(!paymentBranchId){alert('Select a specific branch before recording a debtor payment.');return false}
   }
   const owed=owedFor(c);
   const amount=Number(document.getElementById('fAmount').value||0);
   if(!amount||amount<0){alert('Enter a valid Amount Paid.');return false}
   if(owed<=0){alert('This customer has no outstanding debt.');return false}
   if(amount>owed){alert(`Amount Paid cannot exceed the Total Amount Owed of ${money(owed)}.`);return false}
   const o={id:id(),businessId:db.activeBusinessId,branchId:paymentBranchId,customerId:c.id,date:document.getElementById('fDate').value,amount,method:document.getElementById('fMethod').value,note:document.getElementById('fNote').value,createdBy:currentAdminId};
   db.payments.push(o);save();render();return true
 });
 const sel=document.getElementById('fCustomer'),owed=document.getElementById('fOwed'),amount=document.getElementById('fAmount');
 const updateOwed=()=>{const c=scoped(db.customers).find(v=>v.id===sel.value);const value=owedFor(c);owed.value=money(value);amount.max=String(value);if(Number(amount.value||0)>value)amount.value=value||'';};
 sel?.addEventListener('change',updateOwed);amount?.addEventListener('input',()=>{const c=scoped(db.customers).find(v=>v.id===sel.value);const value=owedFor(c);if(Number(amount.value||0)>value)amount.value=value||'';});updateOwed();
}
function adjustStock(p){openModal('Adjust Stock — '+p.name,`<div class="form-grid"><div class="field"><label>Business Branch</label><select id="fBranch"${branchSelectAttrs()}>${branchOptions('')}</select></div><div class="field"><label>Current Quantity</label><input value="${p.qty}" disabled></div><div class="field"><label>Adjustment (+/-)</label><input id="fAdj" type="number" value="0"></div><div class="field full"><label>Reason</label><input id="fReason" placeholder="Received, damaged, lost, correction..."></div></div>`,()=>{const branchId=document.getElementById('fBranch').value;if(!branchId){alert('Select a Business Branch before adjusting stock.');return false}const n=Number(document.getElementById('fAdj').value||0);if(!n)return false;activeBranchId=branchId;p.qty=Math.max(0,p.qty+n);render();return true})}
function handle(action,el){
 if(action==='save-header'){const b=biz();b.header={brand:document.getElementById('hdrBrand').value.trim(),sub:document.getElementById('hdrSub').value.trim(),readonly:document.getElementById('hdrReadonly').value.trim(),install:document.getElementById('hdrInstall').value.trim()||'Contact Admin',showInstall:document.getElementById('hdrShowInstall').value==='yes'};save();publishBusiness().catch(()=>{});render();return}
 if(action==='refresh-messages'){const b=el;b.disabled=true;b.textContent='Refreshing…';loadAdminMessages().finally(()=>{if(b&&b.isConnected){b.disabled=false;b.textContent='Refresh'}});return}
 if(action==='mark-message-read'){(async()=>{try{const r=await adminMessagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(el.dataset.id),{method:'PATCH',body:JSON.stringify({read_at:new Date().toISOString()})});if(!r.ok)throw new Error(await r.text());await loadAdminMessages();alert('Message marked as read.')}catch(e){alert('Unable to mark message as read: '+e.message)}})();return}
 if(action==='reply-client-message'){replyClientMessage(el.dataset.id).catch(e=>alert(e.message));return}
 if(action==='clear-header'){const b=biz();if(!confirm('Clear all configurable Client App header information for this business? The Business Name will not be changed.'))return;b.header={brand:'',sub:'',readonly:'',install:'Contact Admin',showInstall:false};save();render();return}
 if(action==='save-online-config'){const url=document.getElementById('sbUrl').value.trim(),key=document.getElementById('sbKey').value.trim(),auto=document.getElementById('autoSync').value==='on';setOnlineConfig({url,key,auto,status:url&&key?'Saved. Ready to connect.':'Not connected'});updateOnlineBadge();render();return}
 if(action==='test-online'){testOnline().then(()=>{const c=onlineConfig();c.status='Connection successful.';setOnlineConfig(c);render()}).catch(e=>{const c=onlineConfig();c.status=e.message;setOnlineConfig(c);render()});return}
 if(action==='publish-business'){publishBusiness().then(()=>{const c=onlineConfig();c.status='Published '+biz().name+' at '+new Date().toLocaleTimeString();setOnlineConfig(c);render()}).catch(e=>{const c=onlineConfig();c.status=e.message;setOnlineConfig(c);render()});return}
 if(action==='copy-feed'){navigator.clipboard?.writeText(biz().clientFeedId);return}
 if(action==='export-feed'){const blob=new Blob([JSON.stringify(snapshotForBusiness(db.activeBusinessId),null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=biz().clientFeedId+'.json';a.click();return}
const x=el.dataset.id;
 if(action==='select-business'){const b=db.businesses.find(b=>b.id===x);if(b?.active&&allowedBusiness(x)){db.activeBusinessId=x;currentPage='dashboard';render()}}
 else if(action==='toggle-business'){const b=db.businesses.find(b=>b.id===x);if(!b)return;b.active=!b.active;if(!b.active&&db.activeBusinessId===x){const alt=db.businesses.find(z=>z.active&&allowedBusiness(z.id)&&z.id!==x);if(alt)db.activeBusinessId=alt.id}render()}
 else if(action==='new-business'||action==='edit-business'){if(db.admins.find(a=>a.id===currentAdminId)?.role!=='major')return alert('Only the Major Admin can manage businesses.');const b=action==='edit-business'?db.businesses.find(b=>b.id===x):null;openModal(b?'Edit Business':'Add Business',formBusiness(b),()=>{const o={name:document.getElementById('fName').value.trim(),type:document.getElementById('fType').value.trim(),phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value,currency:document.getElementById('fCurrency').value||'NGN'};if(!o.name||!o.type)return false;if(b)Object.assign(b,o);else{const nb={id:id(),...o,active:true,clientFeedId:'CLIENT-'+Math.random().toString(36).slice(2,8).toUpperCase(),header:{businessName:o.name,brand:'',sub:'Business Control • Owner View',readonly:'VIEW ONLY • DATA ENTRY DISABLED',install:'Install Business Control',showInstall:true}};db.businesses.push(nb);db.activeBusinessId=nb.id;db.admins.find(a=>a.id==='admin-major').businessIds.push(nb.id)}render();return true})}
 else if(action==='new-admin'||action==='edit-admin'){if(db.admins.find(a=>a.id===currentAdminId)?.role!=='major')return alert('Only the Major Admin can manage Admin Access.');const a=action==='edit-admin'?db.admins.find(a=>a.id===x):null;openModal(a?'Edit Admin Access':'Add Admin',formAdmin(a),()=>{const ids=[...document.querySelectorAll('.biz-check:checked')].map(c=>c.value);if(!ids.length)return alert('Assign at least one business.');const o={name:document.getElementById('fName').value.trim(),email:document.getElementById('fEmail').value.trim()};if(!o.name||!o.email)return false;if(a)Object.assign(a,o,{businessIds:ids});else db.admins.push({id:id(),...o,role:'admin',active:true,businessIds:ids});render();return true})}
 else if(action==='toggle-admin'){const a=db.admins.find(a=>a.id===x);if(a){a.active=!a.active;render()}}
 else if(action==='new-sale')newSale(); else if(action==='edit-sale')newSale(db.sales.find(s=>s.id===x)); else if(action==='delete-sale'){if(confirm('Delete this sale?')){db.sales=db.sales.filter(s=>s.id!==x);render()}}
 else if(action==='new-customer')newCustomer(); else if(action==='edit-customer')newCustomer(db.customers.find(c=>c.id===x));
 else if(action==='new-payment')newPayment(); else if(action==='delete-payment'){if(confirm('Delete this payment?')){db.payments=db.payments.filter(p=>p.id!==x);render()}}
 else if(action==='new-expense')newExpense(); else if(action==='edit-expense')newExpense(db.expenses.find(e=>e.id===x)); else if(action==='delete-expense'){if(confirm('Delete this expense?')){db.expenses=db.expenses.filter(e=>e.id!==x);render()}}
 else if(action==='new-product')newProduct(); else if(action==='edit-product')newProduct(db.products.find(p=>p.id===x)); else if(action==='adjust-stock')adjustStock(db.products.find(p=>p.id===x));
 else if(action==='export'){const blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='trader_business_control_v3_data.json';a.click()}
 else if(action==='reset'){if(confirm('Reset all demo data?')){db=seed();render()}}
}
document.addEventListener('click',e=>{const b=e.target.closest('[data-action]');if(b)handle(b.dataset.action,b);const g=e.target.closest('[data-go]');if(g){currentPage=g.dataset.go;render()}if(e.target.id==='addItem'){const wrap=document.getElementById('items');const i=wrap.querySelectorAll('.item-row').length;wrap.insertAdjacentHTML('beforeend',itemRow({productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0},i))}if(e.target.dataset.remove!==undefined)e.target.closest('.item-row').remove()});
document.getElementById('nav').addEventListener('click',e=>{const b=e.target.closest('button[data-page]');if(!b)return;currentPage=b.dataset.page;document.getElementById('sidebar').classList.remove('open');render()});document.getElementById('adminSelect').addEventListener('change',e=>{currentAdminId=e.target.value;const list=db.businesses.filter(b=>b.active&&allowedBusiness(b.id));if(list.length&&!allowedBusiness(db.activeBusinessId))db.activeBusinessId=list[0].id;currentPage='dashboard';render()});document.getElementById('businessSelect').addEventListener('change',e=>{const b=db.businesses.find(x=>x.id===e.target.value);if(b&&b.active&&allowedBusiness(b.id)){db.activeBusinessId=b.id;currentPage='dashboard';render()}});document.getElementById('period').addEventListener('change',e=>{period=e.target.value;render()});document.getElementById('closeModal').onclick=closeModal;document.getElementById('menuBtn').onclick=()=>document.getElementById('sidebar').classList.toggle('open');
render();
</script><script>
/* Production feature layer merged into the supplied Admin V4 UI. Visual/CSS baseline is intentionally unchanged. */
(function(){
  // State extensions
  if(!Array.isArray(db.branches)){
    db.branches=[];
    db.businesses.forEach((b)=>db.branches.push({id:'br-'+b.id+'-main',businessId:b.id,name:'Main Branch',address:b.address||'',phone:b.phone||'',active:true}));
  }
  function normalizeProductBranches(){
    (db.products||[]).forEach(p=>{
      const ids=(db.branches||[]).filter(br=>br.businessId===p.businessId&&br.active!==false).map(br=>br.id);
      p.branchIds=Array.from(new Set([...(Array.isArray(p.branchIds)?p.branchIds:[]),...ids]));
      delete p.branchId;
    });
  }
  normalizeProductBranches();
  save();
  var activeBranchId='all';
  // Public read-only accessor for code defined outside this IIFE.
  window.getActiveBranchId=function(){return activeBranchId};
  let customFrom=today, customTo=today;

  const oldScoped=scoped;
  window.branchFor=function(id){return db.branches.find(b=>b.id===id)};
  window.branchesFor=function(bid){return (db.branches||[]).filter(b=>b.businessId===bid&&b.active!==false)};
  // Backfill older records that were created before branch support so every branch-scoped record belongs to a branch.
  ['products','customers','sales','payments','expenses','stockMovements'].forEach(key=>{
    (db[key]||[]).forEach(r=>{
      if(!r.branchId){const br=branchesFor(r.businessId)?.[0];if(br)r.branchId=br.id;}
    });
  });
  window.branchAllowed=function(bid){return activeBranchId==='all'||String(bid||'')===String(activeBranchId)};
  window.scoped=function(list){return list.filter(x=>{if(x.businessId!==db.activeBusinessId)return false;if(activeBranchId==='all')return true;if(Array.isArray(x.branchIds))return x.branchIds.includes(activeBranchId);return branchAllowed(x.branchId);});};
  window.range=function(){
    const d=new Date(today), y=d.getFullYear(),m=d.getMonth(),day=d.getDate();
    if(period==='custom')return [customFrom,customTo];
    if(period==='all')return ['0000-01-01','9999-12-31'];
    if(period==='today')return [today,today];
    if(period==='week'){const start=new Date(d);start.setDate(day-d.getDay());return [iso(start),today]}
    if(period==='month')return [`${y}-${String(m+1).padStart(2,'0')}-01`,today];
    const pm=new Date(y,m-1,1),end=new Date(y,m,0);return [iso(pm),iso(end)]
  };
  window.periodLabel=function(){const r=range();return r[0]==='0000-01-01'?'All Time':`${r[0]} to ${r[1]}`};

  function ensureTopControls(){
    const top=document.querySelector('.top-right'); if(!top)return;
    const bs=document.getElementById('businessSelect');
    if(bs && !document.getElementById('branchSelect')){
      const sel=document.createElement('select'); sel.className='business-select'; sel.id='branchSelect'; sel.title='Branch';
      bs.insertAdjacentElement('afterend',sel);
      sel.addEventListener('change',()=>{activeBranchId=sel.value;currentPage='dashboard';render()});
    }
    const periodEl=document.getElementById('period');
    if(periodEl && ![...periodEl.options].some(o=>o.value==='custom')){
      periodEl.insertAdjacentHTML('beforeend','<option value="custom">Custom</option>');
    }
    if(periodEl && !document.getElementById('customDates')){
      const wrap=document.createElement('span');wrap.id='customDates';wrap.style.display='none';wrap.innerHTML='<input id="customFrom" class="period" type="date"><input id="customTo" class="period" type="date"><button id="applyCustom" class="btn secondary small" type="button">Apply</button>';
      periodEl.insertAdjacentElement('afterend',wrap);
      document.getElementById('customFrom').value=customFrom;document.getElementById('customTo').value=customTo;
      document.getElementById('applyCustom').onclick=()=>{customFrom=document.getElementById('customFrom').value||today;customTo=document.getElementById('customTo').value||today;if(customFrom>customTo){const x=customFrom;customFrom=customTo;customTo=x}render()};
    }
    if(document.querySelector('#nav button[data-page="admins"]'))document.querySelector('#nav button[data-page="admins"]').textContent='Staff';
  }

  const baseRenderBusinessSelect=window.renderBusinessSelect;
  window.renderBusinessSelect=function(){
    baseRenderBusinessSelect(); ensureTopControls();
    const bsel=document.getElementById('businessSelect'), brsel=document.getElementById('branchSelect');
    if(brsel){const brs=branchesFor(db.activeBusinessId); if(activeBranchId!=='all'&&!brs.some(b=>b.id===activeBranchId))activeBranchId='all';brsel.innerHTML='<option value="all">All Branches</option>'+brs.map(b=>`<option value="${b.id}" ${b.id===activeBranchId?'selected':''}>${esc(b.name)}</option>`).join('');brsel.value=activeBranchId;}
    const p=document.getElementById('period'); if(p){p.value=period;const c=document.getElementById('customDates');if(c)c.style.display=period==='custom'?'inline-flex':'none';}
  };

  // Business-aware metrics: branch filter now applies everywhere.
  window.totals=function(){
    const ss=scoped(db.sales).filter(s=>inRange(s.date));
    const ps=scoped(db.payments).filter(p=>inRange(p.date));
    const es=scoped(db.expenses).filter(e=>inRange(e.date));
    const cash=ss.filter(s=>paymentStatus(s)==='Cash');
    const credit=ss.filter(s=>saleOutstanding(s)>0);
    const creditTotal=ss.reduce((a,s)=>a+saleOutstanding(s),0);
    const saleTotal=ss.reduce((a,s)=>a+Number(s.total||0),0);
    const amountReceived=ss.reduce((a,s)=>a+Number(s.paid||0),0)+ps.reduce((a,p)=>a+Number(p.amount||0),0);
    const owing=scoped(db.customers).map(c=>({...c,balance:customerOutstanding(c.id)})).filter(c=>c.balance>0);
    return{sales:ss,cashSales:cash,credit,creditTotal,saleTotal,payments:ps.reduce((a,p)=>a+Number(p.amount||0),0),cashReceived:amountReceived,amountReceived,exp:es.reduce((a,e)=>a+e.amount,0),owing};
  };

  function duplicateSale(items,total,paid,type,cid,date){
    const sig=a=>JSON.stringify(a.map(x=>({p:x.productId,q:Number(x.qty),pr:Number(x.price)})).sort((a,b)=>a.p.localeCompare(b.p)));
    const s=db.sales.find(x=>x.businessId===db.activeBusinessId&&branchAllowed(x.branchId)&&x.branchId===activeBranchId&&x.customerId===cid&&x.date===date&&x.type===type&&Number(x.total)===Number(total)&&Number(x.paid)===Number(paid));
    return s&&sig(s.items||[])===sig(items);
  }

  // Replace sale form with the agreed customer/phone/address + Paid Amount/Full-Payment workflow.
  window.saleForm=function(s){
    s=s||{customerId:'',customerName:'',phone:'',address:'',date:today,type:'cash',paid:0,items:[{productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0}]};
    const c=s.customerId?db.customers.find(x=>x.id===s.customerId):null;
    return `<div class="form-grid"><div class="field"><label>Customer Name</label><input id="fCustomerName" value="${esc(c?.name||s.customerName||'')}" placeholder="Walk-in Customer"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(c?.phone||s.phone||'')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(c?.address||s.address||'')}"></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${s.date}"></div><div class="field"><label>Payment Status</label><div id="fPaymentStatus" class="status">Cash</div></div><div class="field full"><label>Paid Amount</label><div style="display:flex;gap:8px;align-items:center"><input id="fPaid" type="number" min="0" value="${s.paid||0}" style="flex:1"><label style="font-weight:400"><input id="fullPay" type="checkbox"> Full-Payment</label></div><div id="saleOutstanding" class="status">Outstanding: ₦0.00</div></div><div class="field full"><label>Sale Items — multiple items supported</label><div id="items">${s.items.map(itemRow).join('')}</div><button type="button" class="btn secondary small" id="addItem">+ Add Item</button></div></div>`
  };

  window.newSale=function(existing){
    openModal(existing?'Edit Sale':'New Sale',saleForm(existing),()=>{
      const items=collectItems(); if(!items.length){alert('Add at least one item.');return false}
      const name=document.getElementById('fCustomerName').value.trim()||'Walk-in Customer',phone=document.getElementById('fPhone').value.trim(),address=document.getElementById('fAddress').value.trim();
      const date=document.getElementById('fDate').value,total=items.reduce((a,x)=>a+x.qty*x.price,0),paidPreview=Number(document.getElementById('fPaid').value||0),type=total<=0||paidPreview>=total?'cash':(paidPreview>0?'partly_credit':'credit');if(activeBranchId==='all'){alert('Select a specific branch before recording a sale.');return false}let paid=Number(document.getElementById('fPaid').value||0);if(document.getElementById('fullPay')?.checked)paid=total;
      if(paidPreview<total&&(name==='Walk-in Customer'||!phone||!address)){alert('Credit or Partly Credit sales require Customer Name, Phone and Address. Walk-in Customer is fully-paid only.');return false}
      const samePhone=phone&&db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone);
      if(samePhone&&name!==samePhone.name&&!existing){alert(`Existing Customer Detected: ${samePhone.name}. Please use the existing customer's details or correct the phone number.`);return false}
      const cid=samePhone?.id||(name==='Walk-in Customer'?'':existing?.customerId||'');
      if(!existing && duplicateSale(items,total,paid,type,cid,date)){if(!confirm('An identical sale already exists for this date, customer, items, amount and payment details. Do you want to save it again?'))return false}
      if(!existing&&name!=='Walk-in Customer'&&!samePhone){db.customers.push({id:id(),businessId:db.activeBusinessId,branchId:activeBranchId,name,phone,address,opening:0})}
      const customer=db.customers.find(c=>c.id===cid)||db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone);const customerId=customer?.id||'';
      if(existing)Object.assign(existing,{customerId:customerId,date,type,paid,items,total,branchId:activeBranchId});else db.sales.push({id:id(),businessId:db.activeBusinessId,branchId:activeBranchId,customerId:customerId,date,type,paid,items,total,createdBy:currentAdminId});
      save();render();return true
    });
    const calc=()=>{const its=collectItems(),tot=its.reduce((a,x)=>a+x.qty*x.price,0),full=document.getElementById('fullPay'),paid=full?.checked?tot:Number(document.getElementById('fPaid')?.value||0);if(full)document.getElementById('fPaid').value=tot;const o=document.getElementById('saleOutstanding');if(o)o.textContent='Outstanding: '+money(Math.max(0,tot-paid));const st=document.getElementById('fPaymentStatus');if(st){const ps=tot<=0||paid>=tot?'Cash':(paid>0?'Partly Credit':'Credit');st.textContent=ps;st.className='status '+(ps==='Cash'?'green-text':(ps==='Partly Credit'?'orange-text':'red-text'));}};
    document.getElementById('items')?.addEventListener('input',calc);document.getElementById('fPaid')?.addEventListener('input',calc);document.getElementById('fullPay')?.addEventListener('change',calc);calc();
  };

  // Customer creation with duplicate-phone protection.
  const oldNewCustomer=window.newCustomer;
  window.newCustomer=function(existing){
    openModal(existing?'Edit Customer':'New Customer',`<div class="form-grid"><div class="field"><label>Name</label><input id="fName" value="${esc(existing?.name||'')}"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(existing?.phone||'')}"></div><div class="field"><label>Business Branch</label><select id="fBranch"${branchSelectAttrs()}>${branchOptions(existing?.branchId)}</select></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(existing?.address||'')}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim(),phone=document.getElementById('fPhone').value.trim(),address=document.getElementById('fAddress').value.trim(),branchId=document.getElementById('fBranch').value;if(!name||!phone||!address){alert('Name, Phone and Address are required.');return false}const dup=db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone&&c.id!==existing?.id);if(dup){alert(`This phone number already belongs to ${dup.name}.`);return false}if(!branchId){alert('Select a Business Branch before saving the customer.');return false}if(existing)Object.assign(existing,{name,phone,address,branchId});else db.customers.push({id:id(),businessId:db.activeBusinessId,branchId,name,phone,address,opening:0});save();render();return true})
  };

  // Staff page replaces the old Admin Access page; staff can be selected and assigned to businesses/branches.
  window.renderAdmins=function(){
    const me=db.admins.find(a=>a.id===currentAdminId);const major=me?.role==='major';
    const rows=db.admins.filter(a=>a.role!=='major').map(a=>{const assigns=(a.branchIds||[]).map(idv=>{const br=branchFor(idv),b=br&&db.businesses.find(x=>x.id===br.businessId);return br?`${esc(b?.name||'')} / ${esc(br.name)}`:''}).filter(Boolean).join('<br>');return `<tr><td><b>${esc(a.name)}</b><br><span class="status">${esc(a.email)}</span></td><td>Staff</td><td>${assigns||'<span class="status">Not assigned</span>'}</td><td><span class="tag ${a.active?'active':'off'}">${a.active?'ACTIVE':'INACTIVE'}</span></td><td>${major?`<div class="actions"><button class="btn secondary small" data-action="edit-admin" data-id="${a.id}">Edit</button><button class="btn ${a.active?'danger':'green'} small" data-action="toggle-admin" data-id="${a.id}">${a.active?'Deactivate':'Activate'}</button><button class="btn danger small" data-action="delete-admin" data-id="${a.id}">Delete</button></div>`:'—'}</td></tr>`}).join('');
    document.getElementById('page-admins').innerHTML=`<div class="notice"><b>Staff List.</b> Create Staff first, then assign an existing Staff member to a Business and one or more branches.</div><div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Staff <b>${db.admins.filter(a=>a.role!=='major').length}</b></span></div>${major?'<button class="btn" data-action="new-admin">+ Add Staff</button>':''}</div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Staff</th><th>Role</th><th>Business / Branch Access</th><th>Status</th><th>Actions</th></tr></thead><tbody>${rows||'<tr><td colspan="5" class="empty">No Staff yet.</td></tr>'}</tbody></table></div></div></div>`;
  };

  function staffForm(a){a=a||{name:'',email:'',active:true,branchIds:[]};return `<div class="form-grid"><div class="field"><label>Staff Name</label><input id="fName" value="${esc(a.name)}"></div><div class="field"><label>Email / Username</label><input id="fEmail" value="${esc(a.email)}"></div></div>`}
  function assignmentForm(pre){return `<div class="form-grid"><div class="field"><label>Staff</label><select id="assignStaff"><option value="">Select Staff</option>${db.admins.filter(a=>a.role!=='major'&&a.active).map(a=>`<option value="${a.id}">${esc(a.name)} — ${esc(a.email)}</option>`).join('')}</select></div><div class="field"><label>Business</label><select id="assignBusiness"><option value="">Select Business</option>${db.businesses.filter(b=>b.active).map(b=>`<option value="${b.id}" ${b.id===pre?'selected':''}>${esc(b.name)}</option>`).join('')}</select></div><div class="field full"><label>Branches</label><div id="branchChecks" class="section-body" style="padding:10px">Select a business first.</div></div></div>`}
  function openAssignment(pre){openModal('Assign Staff to Business',assignmentForm(pre),()=>{const uid=document.getElementById('assignStaff').value,bid=document.getElementById('assignBusiness').value,ids=[...document.querySelectorAll('.branch-check:checked')].map(x=>x.value);if(!uid||!bid||!ids.length){alert('Select Staff, Business and at least one branch.');return false}for(const br of ids){const occupied=db.admins.find(a=>a.role!=='major'&&(a.branchIds||[]).includes(br)&&a.id!==uid);if(occupied){alert('One of the selected branches is already assigned to another Staff member. Reassignment must be done by Major Admin.');return false}}const st=db.admins.find(a=>a.id===uid);st.branchIds=Array.from(new Set([...(st.branchIds||[]),...ids]));st.businessIds=Array.from(new Set([...(st.businessIds||[]),bid]));save();render();return true});const sel=document.getElementById('assignBusiness');const draw=()=>{const host=document.getElementById('branchChecks'),brs=branchesFor(sel.value);host.innerHTML=brs.map(b=>`<label style="display:block;margin:6px 0"><input class="branch-check" type="checkbox" value="${b.id}"> ${esc(b.name)}</label>`).join('')||'No branches';};sel.onchange=draw;draw()}

  // Businesses & Branches with visible business list first.
  window.renderBusinesses=function(){const rows=db.businesses.map(b=>{const brs=branchesFor(b.id),staff=db.admins.filter(a=>a.role!=='major'&&(a.branchIds||[]).some(idv=>brs.some(x=>x.id===idv))).map(a=>a.name).join(', ');const branchHtml=brs.map(x=>`<div style="display:flex;align-items:center;gap:6px;margin:3px 0"><span>${esc(x.name)}</span><button class="btn secondary small" data-action="edit-branch" data-id="${x.id}">Edit</button></div>`).join('')||'—';return `<tr><td><b>${esc(b.name)}</b><br><span class="status">${esc(b.address||'')}</span></td><td>${esc(b.type||'')}</td><td>${branchHtml}</td><td>${esc(staff)||'<span class="status">No Staff assigned</span>'}</td><td><div class="actions"><button class="btn ${b.id===db.activeBusinessId?'green':'secondary'} small" data-action="select-business" data-id="${b.id}">${b.id===db.activeBusinessId?'Selected':'Select'}</button><button class="btn secondary small" data-action="edit-business" data-id="${b.id}">Edit</button><button class="btn secondary small" data-action="assign-staff-business" data-id="${b.id}">Assign Staff</button><button class="btn secondary small" data-action="new-branch" data-id="${b.id}">+ Branch</button><button class="btn danger small" data-action="delete-business" data-id="${b.id}">Delete</button></div></td></tr>`}).join('');document.getElementById('page-businesses').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="bizSearch" placeholder="Search businesses"></div><button class="btn" data-action="new-business">+ Add Business</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Business</th><th>Type</th><th>Branches</th><th>Staff</th><th>Actions</th></tr></thead><tbody id="bizBody">${rows||'<tr><td colspan="5" class="empty">No businesses.</td></tr>'}</tbody></table></div></div></div>`;document.getElementById('bizSearch').oninput=e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('#bizBody tr').forEach(r=>{const txt=(r.textContent||'').toLowerCase();r.style.display=txt.includes(q)?'':'none'})}}

  const baseHandle=window.handle;
  window.handle=function(action,el){
    const x=el?.dataset?.id;
    if(action==='new-payment'){window.newPayment();return}
    if(action==='new-product'){window.newProduct();return}
    if(action==='edit-product'){window.newProduct(db.products.find(p=>p.id===x));return}
    if(action==='new-admin'){openModal('Add Staff',staffForm(),()=>{const name=document.getElementById('fName').value.trim(),email=document.getElementById('fEmail').value.trim();if(!name||!email)return false;if(db.admins.some(a=>a.email.toLowerCase()===email.toLowerCase())){alert('A Staff member with this email already exists.');return false}db.admins.push({id:id(),name,email,role:'admin',active:true,businessIds:[],branchIds:[]});save();render();return true});return}
    if(action==='edit-admin'){const a=db.admins.find(a=>a.id===x);if(!a)return;openModal('Edit Staff',staffForm(a),()=>{a.name=document.getElementById('fName').value.trim();a.email=document.getElementById('fEmail').value.trim();if(!a.name||!a.email)return false;save();render();return true});return}
    if(action==='delete-admin'){
      const a=db.admins.find(v=>v.id===x); if(!a || a.role==='major') return;
      const ok=confirm(`Delete Staff "${a.name}" permanently?\n\nThis will remove the Staff member from the Staff list and remove all of their business/branch assignments. This action cannot be undone.`);
      if(!ok)return;
      db.admins=db.admins.filter(v=>v.id!==a.id);
      if(currentAdminId===a.id){currentAdminId=db.admins.find(v=>v.role==='major')?.id||db.admins[0]?.id||'';}
      save(); render(); return;
    }
    if(action==='assign-staff-business'){openAssignment(x);return}
    if(action==='edit-business'){const b=db.businesses.find(b=>b.id===x);if(!b)return;openModal('Edit Business',formBusiness(b),()=>{const o={name:document.getElementById('fName').value.trim(),type:document.getElementById('fType').value.trim(),phone:document.getElementById('fPhone').value.trim(),address:document.getElementById('fAddress').value.trim(),currency:document.getElementById('fCurrency').value||'NGN'};if(!o.name||!o.type){alert('Business name and type are required.');return false}if(db.businesses.some(v=>v.id!==b.id&&v.name.toLowerCase()===o.name.toLowerCase())){alert('Another business with this name already exists.');return false}Object.assign(b,o);const brs=branchesFor(b.id);if(brs.length===1&&brs[0].name==='Main Branch'){brs[0].address=o.address;brs[0].phone=o.phone}save();render();return true});return}
    if(action==='edit-branch'){const br=db.branches.find(v=>v.id===x),b=br&&db.businesses.find(v=>v.id===br.businessId);if(!br||!b)return;openModal('Edit Branch',`<div class="form-grid"><div class="field"><label>Business</label><input value="${esc(b.name)}" disabled></div><div class="field"><label>Branch Name</label><input id="fName" value="${esc(br.name)}"></div><div class="field"><label>Phone</label><input id="fPhone" value="${esc(br.phone||'')}"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(br.address||'')}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim();if(!name){alert('Branch name is required.');return false}if(db.branches.some(v=>v.id!==br.id&&v.businessId===br.businessId&&v.name.toLowerCase()===name.toLowerCase())){alert('Another branch with this name already exists in this business.');return false}br.name=name;br.phone=document.getElementById('fPhone').value.trim();br.address=document.getElementById('fAddress').value.trim();save();render();return true});return}
    if(action==='delete-business'){const b=db.businesses.find(v=>v.id===x);if(!b)return;if(db.businesses.length<=1){alert('You cannot delete the only remaining business.');return}const ok=confirm(`Delete business "${b.name}" permanently?\n\nThis will remove its branches, staff assignments, sales, customers, payments, expenses, stock and other business records from this Admin dataset. This action cannot be undone.`);if(!ok)return;const branchIds=db.branches.filter(v=>v.businessId===b.id).map(v=>v.id);db.businesses=db.businesses.filter(v=>v.id!==b.id);db.branches=db.branches.filter(v=>v.businessId!==b.id);db.admins.forEach(a=>{a.businessIds=(a.businessIds||[]).filter(idv=>idv!==b.id);a.branchIds=(a.branchIds||[]).filter(idv=>!branchIds.includes(idv))});['products','customers','sales','payments','expenses','stockMovements'].forEach(k=>{if(Array.isArray(db[k]))db[k]=db[k].filter(v=>v.businessId!==b.id&&(!v.branchId||!branchIds.includes(v.branchId)))});if(db.activeBusinessId===b.id){db.activeBusinessId=db.businesses[0]?.id||'';activeBranchId='all';currentPage='businesses'}save();render();return}
    if(action==='new-branch'){const b=db.businesses.find(b=>b.id===x);openModal('Add Branch',`<div class="form-grid"><div class="field"><label>Business</label><input value="${esc(b?.name||'')}" disabled></div><div class="field"><label>Branch Name</label><input id="fName"></div><div class="field full"><label>Address</label><input id="fAddress" value="${esc(b?.address||'')}"></div></div>`,()=>{const name=document.getElementById('fName').value.trim();if(!name)return false;const newBranch={id:id(),businessId:b.id,name,address:document.getElementById('fAddress').value,active:true};db.branches.push(newBranch);(db.products||[]).filter(p=>p.businessId===b.id).forEach(p=>{p.branchIds=Array.from(new Set([...(Array.isArray(p.branchIds)?p.branchIds:[]),newBranch.id]));delete p.branchId});save();render();return true});return}
    if(action==='new-business'){
      openModal('Add Business',formBusiness(),()=>{const o={name:document.getElementById('fName').value.trim(),type:document.getElementById('fType').value.trim(),phone:document.getElementById('fPhone').value,address:document.getElementById('fAddress').value,currency:document.getElementById('fCurrency').value||'NGN'};if(!o.name||!o.type)return false;if(db.businesses.some(b=>b.name.toLowerCase()===o.name.toLowerCase())){alert('A business with this name already exists.');return false}const nb={id:id(),...o,active:true,clientFeedId:'CLIENT-'+Math.random().toString(36).slice(2,8).toUpperCase(),header:{businessName:o.name,brand:'',sub:'Business Control • Owner View',readonly:'VIEW ONLY • DATA ENTRY DISABLED',install:'Install Business Control',showInstall:true}};db.businesses.push(nb);db.branches.push({id:id(),businessId:nb.id,name:'Main Branch',address:o.address,phone:o.phone,active:true});const major=db.admins.find(a=>a.role==='major');if(major)major.businessIds.push(nb.id);db.activeBusinessId=nb.id;activeBranchId='all';save();render();return true});return}
    if(action==='new-sale'){editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;salesView='new';currentPage='sales';render();return}
    if(action==='edit-sale'){editingSaleId=x;saleDraftItems=null;saleDraftCustomer=null;salesView='new';currentPage='sales';render();return}
    if(action==='back-sales'){editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;salesView='list';currentPage='sales';render();return}
    if(action==='add-sale-item'){const n=document.getElementById('nsName'),p=document.getElementById('nsPhone'),a=document.getElementById('nsAddress'),paid=document.getElementById('nsPaid'),full=document.getElementById('nsFull');const currentPaid=Number(paid?.value||0);saleDraftCustomer={name:n?.value||'Walk-in Customer',phone:p?.value||'',address:a?.value||'',type:currentPaid>0?'partly_credit':'credit',paid:currentPaid,full:!!full?.checked};readSalePageItems();saleDraftItems.push({productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0});render();return}
    if(action==='save-sale-page'){saveSalePage(false);return}
    if(action==='save-sale-page-new'){saveSalePage(true);return}
    if(action==='remove-sale-item'){readSalePageItems();saleDraftItems.splice(Number(x),1);if(!saleDraftItems.length)saleDraftItems.push({productId:'',qty:1,price:0});render();return}
    if(action==='select-business'){const b=db.businesses.find(b=>b.id===x);if(b?.active&&allowedBusiness(x)){db.activeBusinessId=x;activeBranchId='all';currentPage='dashboard';salesView='list';render()}return}
    // Fall back to the original handler for all other actions.
    return baseHandle(action,el);
  };

  // Sales list remains the existing visual baseline; New Sale uses the supplied full-page layout.
  let salesView='list';
  let editingSaleId=null;
  let saleDraftItems=null;
  let saleDraftCustomer=null;

  function salePageCustomerState(){
    const phone=(document.getElementById('nsPhone')?.value||'').trim();
    const hit=db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone);
    const note=document.getElementById('nsCustomerNote');
    if(hit){
      const n=document.getElementById('nsName'),a=document.getElementById('nsAddress');
      if(n)n.value=hit.name; if(a)a.value=hit.address||'';
      if(note){note.textContent=`Existing Customer Detected: ${hit.name}`;note.style.display='block'}
      return hit;
    }
    if(note)note.style.display=phone?'block':'none';
    if(note&&phone)note.textContent='New phone number — a customer record will be created after a successful sale.';
    return null;
  }
  function renderSaleRows(){
    const host=document.getElementById('nsItems'); if(!host)return;
    const items=saleDraftItems||[{productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0}];
    saleDraftItems=items;
    host.innerHTML=items.map((x,i)=>`<div class="ns-item-row" data-i="${i}"><select class="ns-prod" data-i="${i}">${productOptions(x.productId)}</select><input class="ns-qty" data-i="${i}" type="number" min="1" value="${x.qty||1}"><input class="ns-price" data-i="${i}" type="number" min="0" value="${x.price||0}"><div class="ns-total">${money((x.qty||0)*(x.price||0))}</div><button type="button" class="btn danger small ns-remove" data-i="${i}">×</button></div>`).join('');
    updateSalePageTotals();
  }
  function readSalePageItems(){
    saleDraftItems=[...document.querySelectorAll('.ns-item-row')].map(r=>({productId:r.querySelector('.ns-prod').value,qty:Number(r.querySelector('.ns-qty').value||0),price:Number(r.querySelector('.ns-price').value||0)}));
  }
  function updateSalePageTotals(){
    readSalePageItems();
    const total=saleDraftItems.reduce((a,x)=>a+(x.qty*x.price),0);
    const gt=document.getElementById('nsGrandTotal'),out=document.getElementById('nsOutstanding'),paid=document.getElementById('nsPaid'),full=document.getElementById('nsFull');
    if(gt)gt.textContent=money(total);
    if(full&&full.checked&&paid)paid.value=total;
    const pv=Math.max(0,Math.min(Number(paid?.value||0),total));
    if(out)out.textContent=money(Math.max(0,total-pv));
    const status=document.getElementById('nsPaymentStatus');
    if(status){
      const st=total<=0||pv>=total?'Cash':(pv>0?'Partly Credit':'Credit');
      status.textContent=st;
      status.className='status '+(st==='Cash'?'green-text':(st==='Partly Credit'?'orange-text':'red-text'));
    }
    document.querySelectorAll('.ns-item-row').forEach((r,i)=>{const x=saleDraftItems[i];const t=r.querySelector('.ns-total');if(t)t.textContent=money((x?.qty||0)*(x?.price||0));});
  }
  function salePageTemplate(existing){
    const s=existing||{date:today,type:saleDraftCustomer?.type||'cash',paid:saleDraftCustomer?.paid||0};
    const c=existing?cust(existing.customerId):(saleDraftCustomer||null);
    if(existing){
      saleDraftItems=(existing.items||[]).map(x=>({...x}));
    }else if(!Array.isArray(saleDraftItems)||!saleDraftItems.length){
      saleDraftItems=[{productId:scoped(db.products)[0]?.id||'',qty:1,price:scoped(db.products)[0]?.sell||0}];
    }
    return `<div class="sale-page"><div class="sale-head"><div><h2 style="margin:0">New Sale</h2><p class="status">Record a sale for ${esc(biz().name)}</p></div><button class="btn secondary" data-action="back-sales">← Back to Sales</button></div><div class="section"><div class="section-body"><div class="form-grid"><div class="field"><label>Customer Name</label><input id="nsName" value="${esc(c?.name||'Walk-in Customer')}"></div><div class="field"><label>Phone</label><input id="nsPhone" value="${esc(c?.phone||'')}"></div><div class="field"><label>Address</label><input id="nsAddress" value="${esc(c?.address||'')}"></div><div class="field"><label>Payment Status</label><div id="nsPaymentStatus" class="status" style="font-weight:700">Cash</div></div><div class="field"><label>Business Branch</label><select id="nsBranch"${branchSelectAttrs()}>${branchOptions(editingSaleId?db.sales.find(v=>v.id===editingSaleId)?.branchId:'')}</select></div></div><div id="nsCustomerNote" class="notice" style="display:none;margin-top:12px"></div></div></div><div class="section" style="margin-top:14px"><div class="section-head"><h3>Items</h3><button class="btn secondary small" data-action="add-sale-item">+ Add Item</button></div><div class="section-body"><div class="ns-item-head"><div>Item</div><div>Quantity</div><div>Unit Cost</div><div>Total</div><div></div></div><div id="nsItems"></div><div class="sale-summary"><div><span>Grand Total</span><b id="nsGrandTotal">₦0</b></div><div class="payment-box"><label class="checkline"><input id="nsFull" type="checkbox"> Full-Payment</label><label class="field"><span>Paid Amount</span><input id="nsPaid" type="number" min="0" value="${Number(s.paid||0)}"></label><div class="outstanding">Outstanding: <b id="nsOutstanding">₦0</b></div></div></div></div></div><div class="actions sale-actions"><button class="btn green" data-action="save-sale-page">Save Sale</button><button class="btn secondary" data-action="save-sale-page-new">Save & New</button></div></div>`;
  }
  function renderNewSalePage(){
    document.getElementById('page-sales').innerHTML=salePageTemplate(editingSaleId?db.sales.find(s=>s.id===editingSaleId):null);
    renderSaleRows();
    const phone=document.getElementById('nsPhone'),paid=document.getElementById('nsPaid'),full=document.getElementById('nsFull');
    phone?.addEventListener('input',salePageCustomerState);phone?.addEventListener('blur',salePageCustomerState);
    paid?.addEventListener('input',updateSalePageTotals);full?.addEventListener('change',updateSalePageTotals);
    document.getElementById('nsItems')?.addEventListener('input',updateSalePageTotals);
    document.getElementById('nsItems')?.addEventListener('change',e=>{
      if(e.target.matches('.ns-prod')){
        const row=e.target.closest('.ns-item-row');
        const product=scoped(db.products).find(p=>p.id===e.target.value);
        const price=row?.querySelector('.ns-price');
        if(product&&price){price.value=Number(product.sell||0);}
      }
      updateSalePageTotals();
    });
    updateSalePageTotals();
  }
  function renderSalesList(){
    const rows=scoped(db.sales).filter(s=>inRange(s.date)).sort((a,b)=>b.date.localeCompare(a.date));
    document.getElementById('page-sales').innerHTML=`<div class="toolbar"><div class="toolbar-left"><input class="search" id="salesSearch" placeholder="Search customer"></div><button class="btn" data-action="new-sale">+ New Sale</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Customer</th><th>Date</th><th>Payment</th><th>Items</th><th class="right">Sales</th><th class="right">Received</th><th class="right">Credit</th><th>Actions</th></tr></thead><tbody id="salesBody">${rows.map(s=>{const st=paymentStatus(s);return `<tr data-search="${esc(cust(s.customerId).name)}"><td><b>${esc(cust(s.customerId).name)}</b></td><td>${s.date}</td><td class="${st==='Cash'?'green-text':(st==='Partly Credit'?'orange-text':'red-text')}">${st}</td><td>${s.items.length}</td><td class="right">${money(s.total)}</td><td class="right">${money(s.paid||0)}</td><td class="right">${money(saleOutstanding(s))}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-sale" data-id="${s.id}">Edit</button><button class="btn danger small" data-action="delete-sale" data-id="${s.id}">Delete</button></div></td></tr>`}).join('')||'<tr><td colspan="8" class="empty">No sales in this period.</td></tr>'}</tbody></table></div></div></div>`;
    document.getElementById('salesSearch').oninput=e=>document.querySelectorAll('#salesBody tr').forEach(r=>r.style.display=r.dataset.search?.toLowerCase().includes(e.target.value.toLowerCase())?'':'none');
  }

  function saveSalePage(asNew){
    readSalePageItems();
    const name=document.getElementById('nsName')?.value.trim(),phone=document.getElementById('nsPhone')?.value.trim(),address=document.getElementById('nsAddress')?.value.trim(),date=(editingSaleId?db.sales.find(v=>v.id===editingSaleId)?.date:today)||today,paid=Number(document.getElementById('nsPaid')?.value||0),branchId=document.getElementById('nsBranch')?.value||'';
    const items=saleDraftItems.filter(x=>x.productId&&x.qty>0);
    if(!items.length){alert('Add at least one item.');return}
    const total=items.reduce((a,x)=>a+x.qty*x.price,0);
    const type=total<=0||paid>=total?'cash':(paid>0?'partly_credit':'credit');
    if(paid<0||paid>total){alert('Paid Amount cannot be less than ₦0 or greater than the Grand Total.');return}
    let customer=db.customers.find(c=>c.businessId===db.activeBusinessId&&c.phone===phone&&phone);
    const hasOutstanding=paid<total;
    if(hasOutstanding&&(!phone||!name||name==='Walk-in Customer'||!address)){
      alert('Credit or Partly Credit sales require Customer Name, Phone and Address.');
      return;
    }
    if(!phone&&name!=='Walk-in Customer'&&(!name||!address)){
      alert('Enter the customer Name, Phone and Address, or use Walk-in Customer for a fully paid sale.');
      return;
    }
    if(customer){
      const sameEntered=customer.name===name&&((customer.address||'')===address);
      if(!sameEntered){if(!confirm(`This phone number belongs to ${customer.name}. Use the existing customer details instead?`))return;}
    } else if(phone){
      customer={id:id(),businessId:db.activeBusinessId,branchId,name,phone,address,opening:0};db.customers.push(customer);
    }
    if(!customer&&type==='cash') customer=null;
    const normalizedItems=items.map(x=>({productId:x.productId,qty:x.qty,price:x.price}));
    if(!branchId){alert('Select a Business Branch before recording the sale.');return}
    const duplicate=db.sales.find(s=>{if(editingSaleId&&s.id===editingSaleId)return false; if(s.businessId!==db.activeBusinessId||s.date!==date||s.type!==type||Number(s.total)!==Number(total)||Number(s.paid||0)!==Number(paid)||s.customerId!==(customer?.id||''))return false;return JSON.stringify((s.items||[]).map(x=>({productId:x.productId,qty:x.qty,price:x.price})))===JSON.stringify(normalizedItems)});
    if(duplicate&&!confirm('An identical sale already exists. Do you want to save this exact same sale again?'))return;
    if(editingSaleId){const s=db.sales.find(v=>v.id===editingSaleId);if(s)Object.assign(s,{customerId:customer?.id||'',date,type,paid,items:normalizedItems,total,branchId});}
    else db.sales.push({id:id(),businessId:db.activeBusinessId,branchId,customerId:customer?.id||'',date,type,paid,items:normalizedItems,total,createdBy:currentAdminId});
    save();
    if(asNew){editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;salesView='new';render();}else{editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;salesView='list';render();}
  }


  async function adminMessagesRequest(path,opts={}){
    const c=onlineConfig();if(!c.url||!c.key)throw new Error('Connect the Admin App to Supabase first.');
    let base=c.url.trim().replace(/\/$/,'').replace(/\/dashboard\/.*$/,'').replace(/\/project\/[^/]+.*$/,'');
    const controller=new AbortController();const timer=setTimeout(()=>controller.abort(),10000);
    try{return await fetch(base+path,{...opts,signal:controller.signal,headers:{apikey:c.key.trim(),Authorization:'Bearer '+c.key.trim(),'Content-Type':'application/json',Accept:'application/json',...(opts.headers||{})}})}
    catch(e){if(e.name==='AbortError')throw new Error('Supabase request timed out after 10 seconds. Check the Admin connection settings.');throw e}
    finally{clearTimeout(timer)}
  }
  async function loadAdminMessages(){
    const el=document.getElementById('page-messages');if(!el)return;
    const b=biz();
    try{
      // Fetch the complete message rows first, then normalize/filter locally. This avoids losing messages when an older
      // database row uses client_key/body/sender instead of the newer client_id/message/sender_type names.
      const r=await adminMessagesRequest('/rest/v1/client_messages?select=*&order=created_at.desc');
      if(!r.ok)throw new Error(await r.text());
      const raw=await r.json();
      const normalize=x=>({id:x.id,feed_id:x.feed_id||x.feedId||'',business_id:x.business_id||x.businessId||'',client_id:x.client_id||x.client_key||'',branch_id:x.branch_id||x.branchId||null,sender_type:x.sender_type||(String(x.sender||'').toLowerCase().includes('admin')?'admin':'client'),sender_name:x.sender_name||x.client_name||x.sender||'',message:x.message||x.body||'',created_at:x.created_at,read_at:x.read_at||null,reply_to:x.reply_to||null});
      const all=raw.map(normalize);
      const rows=all.filter(x=>x.feed_id===String(b.clientFeedId)||x.business_id===String(b.id));
      const unread=rows.filter(x=>x.sender_type==='client'&&!x.read_at).length;
      const mismatch=all.length>0&&rows.length===0;
      el.innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Messages <b>${rows.length}</b></span><span class="pill">Unread <b>${unread}</b></span></div><button class="btn secondary" data-action="refresh-messages">Refresh</button></div>${mismatch?`<div class="warning">Messages exist in Supabase, but none match this business's Client Feed ID (${esc(b.clientFeedId)}). The Admin App is showing the available diagnostic instead of staying on Loading.</div>`:''}<div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Sender</th><th>Message</th><th>Branch</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody>${rows.length?rows.map(x=>`<tr><td>${esc(x.sender_type==='client'?'Client':(x.sender_name||'Admin'))}</td><td style="white-space:normal;min-width:220px">${esc(x.message)}</td><td>${esc(branchFor(x.branch_id)?.name||x.branch_id||'All Branches')}</td><td>${x.created_at?new Date(x.created_at).toLocaleString():''}</td><td>${x.sender_type==='client'?(x.read_at?'Read':'<b class="red-text">Unread</b>'):'Sent'}</td><td><button class="btn small" data-action="reply-client-message" data-id="${x.id}">Reply</button>${x.sender_type==='client'&&!x.read_at?` <button class="btn secondary small" data-action="mark-message-read" data-id="${x.id}">Mark Read</button>`:''}</td></tr>`).join(''):'<tr><td colspan="6" class="empty">No client messages for this business.</td></tr>'}</tbody></table></div></div></div>`;
      // Bind Reply buttons directly. This bypasses the global delegated handler so the button
      // remains responsive even when other page-level handlers or dynamic re-renders are involved.
      el.querySelectorAll('button[data-action="reply-client-message"]').forEach(btn=>{
        btn.addEventListener('click',ev=>{
          ev.preventDefault();
          ev.stopPropagation();
          const id=btn.dataset.id;
          openModal('Reply to Client','<div class="status">Loading the client message…</div>',async()=>false);
          replyClientMessage(id).catch(e=>{closeModal();alert('Unable to open reply: '+(e?.message||String(e)))})
        });
      });
    }catch(e){el.innerHTML=`<div class="toolbar"><button class="btn secondary" data-action="refresh-messages">Refresh</button></div><div class="warning">Unable to load Client Messages. ${esc(e.message)}</div>`}
  }
  let adminMessagePoll=null;
  function startAdminMessagePolling(){
    if(adminMessagePoll)clearInterval(adminMessagePoll);
    adminMessagePoll=setInterval(()=>{if(currentPage==='messages')loadAdminMessages()},5000);
  }
  startAdminMessagePolling();

  async function replyClientMessage(id){
    const r0=await adminMessagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(id)+'&select=*');
    if(!r0.ok)throw new Error(await r0.text());
    const rows=await r0.json();
    const raw=rows[0];
    if(!raw)throw new Error('The selected client message could not be found. Refresh the messages list and try again.');
    const m={
      id:raw.id,
      feed_id:raw.feed_id||raw.feedId||null,
      business_id:raw.business_id||raw.businessId||null,
      client_id:raw.client_id||raw.client_key||null,
      client_key:raw.client_key||raw.client_id||null,
      branch_id:raw.branch_id||raw.branchId||null,
      client_name:raw.client_name||raw.sender_name||raw.sender||'Client',
      message:raw.message||raw.body||''
    };
    openModal('Reply to Client',`<div class="form-grid"><div class="field full"><label>Client Message</label><textarea disabled>${esc(m.message)}</textarea></div><div class="field full"><label>Reply</label><textarea id="adminReply" placeholder="Type your reply…"></textarea></div></div>`,async()=>{
      const text=document.getElementById('adminReply').value.trim();
      if(!text){alert('Please enter a reply.');return false}
      const adminName=db.admins.find(x=>x.id===currentAdminId)?.name||'Admin';
      const payload={
        feed_id:m.feed_id,
        client_id:m.client_id,
        branch_id:m.branch_id,
        sender_type:'admin',
        sender_name:adminName,
        message:text,
        reply_to:m.id
      };
      const r=await adminMessagesRequest('/rest/v1/client_messages',{method:'POST',headers:{Prefer:'return=minimal'},body:JSON.stringify(payload)});
      if(!r.ok){alert('Unable to send reply: '+await r.text());return false}
      const mark=await adminMessagesRequest('/rest/v1/client_messages?id=eq.'+encodeURIComponent(m.id),{method:'PATCH',body:JSON.stringify({read_at:new Date().toISOString()})});
      if(!mark.ok){alert('Reply sent, but the original message could not be marked as read: '+await mark.text())}
      await loadAdminMessages();
      alert('Reply sent successfully.');
      return true
    });
  }
  // Extend render to keep the original arrangement but support the new controls and labels.
  const baseRender=window.render;
  window.render=function(){ensureTopControls();if(currentPage==='sales'&&salesView==='new'){
      document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));document.getElementById('page-sales').classList.add('active');document.querySelectorAll('#nav button[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page==='sales'));document.getElementById('pageTitle').textContent='New Sale';document.getElementById('periodText').textContent=`${biz().name} • ${periodLabel()}`;renderNewSalePage();
    }else{baseRender();}ensureTopControls();
    if(currentPage==='messages')loadAdminMessages();
    const bsel=document.getElementById('branchSelect');if(bsel){const brs=branchesFor(db.activeBusinessId);bsel.innerHTML='<option value="all">All Branches</option>'+brs.map(b=>`<option value="${b.id}">${esc(b.name)}</option>`).join('');bsel.value=activeBranchId;}
    const p=document.getElementById('period');if(p)p.value=period;const c=document.getElementById('customDates');if(c)c.style.display=period==='custom'?'inline-flex':'none';
    const title=document.getElementById('pageTitle');if(title&&currentPage==='admins')title.textContent='Staff';
  };

  // Replace date change listener by adding a second listener; the latest state wins.
  const pe=document.getElementById('period');if(pe)pe.addEventListener('change',e=>{period=e.target.value;if(period==='custom'){ensureTopControls();const c=document.getElementById('customDates');if(c)c.style.display='inline-flex'}else render()});

  // Make saves persist and sync the selected business feed when configured.
  const originalSave=window.save;
  window.save=function(){originalSave();if(typeof publishBusiness==='function'){publishBusiness().catch(()=>{})}};


  // Agreed expense structure: no Category field.
  window.renderExpenses=function(){const rows=scoped(db.expenses).filter(e=>inRange(e.date)).sort((a,b)=>b.date.localeCompare(a.date));document.getElementById('page-expenses').innerHTML=`<div class="toolbar"><div class="statline" style="margin:0"><span class="pill">Expenses <b>${rows.length}</b></span><span class="pill">Total <b>${money(rows.reduce((a,e)=>a+e.amount,0))}</b></span></div><button class="btn" data-action="new-expense">+ New Expense</button></div><div class="section"><div class="section-body"><div class="table-wrap"><table class="table"><thead><tr><th>Date</th><th>Description</th><th>Amount</th><th>Paid To</th><th>Payment Method</th><th>Actions</th></tr></thead><tbody>${rows.map(e=>`<tr><td>${e.date}</td><td>${esc(e.description)}</td><td class="right">${money(e.amount)}</td><td>${esc(e.vendor||'')}</td><td>${esc(e.method||'')}</td><td><div class="actions"><button class="btn secondary small" data-action="edit-expense" data-id="${e.id}">Edit</button><button class="btn danger small" data-action="delete-expense" data-id="${e.id}">Delete</button></div></td></tr>`).join('')||'<tr><td colspan="6" class="empty">No expenses in this period.</td></tr>'}</tbody></table></div></div></div>`}
  window.newExpense=function(existing){openModal(existing?'Edit Expense':'New Expense',`<div class="form-grid"><div class="field"><label>Description</label><input id="fDesc" value="${esc(existing?.description||'')}"></div><div class="field"><label>Amount</label><input id="fAmount" type="number" value="${existing?.amount||''}"></div><div class="field"><label>Date</label><input id="fDate" type="date" value="${existing?.date||today}"></div><div class="field"><label>Business Branch</label><select id="fBranch"${branchSelectAttrs()}>${branchOptions(existing?.branchId)}</select></div><div class="field"><label>Paid To</label><input id="fVendor" value="${esc(existing?.vendor||'')}"></div><div class="field"><label>Payment Method</label><select id="fMethod"><option ${existing?.method==='Cash'?'selected':''}>Cash</option><option ${existing?.method==='Transfer'?'selected':''}>Transfer</option><option ${existing?.method==='POS'?'selected':''}>POS</option></select></div><div class="field full"><label>Notes</label><textarea id="fNotes">${esc(existing?.notes||'')}</textarea></div></div>`,()=>{const branchId=document.getElementById('fBranch').value;const o={description:document.getElementById('fDesc').value.trim(),amount:Number(document.getElementById('fAmount').value||0),date:document.getElementById('fDate').value,branchId,vendor:document.getElementById('fVendor').value.trim(),method:document.getElementById('fMethod').value,notes:document.getElementById('fNotes').value};if(!o.description||!o.amount)return false;if(!branchId){alert('Select a Business Branch before recording the expense.');return false}if(existing)Object.assign(existing,o);else db.expenses.push({id:id(),businessId:db.activeBusinessId,...o,createdBy:currentAdminId});save();render();return true})}
  // Branch-aware stock entry: Category is intentionally not part of the New Stock form.
  window.newProduct=function(existing){openModal(existing?'Edit Product':'New Product',`<div class="form-grid"><div class="field"><label>Item Name</label><input id="fName" value="${esc(existing?.name||'')}"></div><div class="field"><label>Unit</label><input id="fUnit" value="${esc(existing?.unit||'Unit')}"></div><div class="field"><label>Cost Price</label><input id="fCost" type="number" value="${existing?.cost||''}"></div><div class="field"><label>Selling Price</label><input id="fSell" type="number" value="${existing?.sell||''}"></div><div class="field"><label>Quantity</label><input id="fQty" type="number" value="${existing?.qty||0}"></div><div class="field"><label>Reorder Level</label><input id="fReorder" type="number" value="${existing?.reorder||0}"></div></div>`,()=>{
    const o={name:document.getElementById('fName').value.trim(),unit:document.getElementById('fUnit').value.trim(),cost:Number(document.getElementById('fCost').value||0),sell:Number(document.getElementById('fSell').value||0),qty:Number(document.getElementById('fQty').value||0),reorder:Number(document.getElementById('fReorder').value||0)};
    if(!o.name)return false;
    const branchIds=branchesFor(db.activeBusinessId).map(br=>br.id);
    if(existing)Object.assign(existing,o,{branchIds:Array.from(new Set([...(Array.isArray(existing.branchIds)?existing.branchIds:[]),...branchIds]))});
    else db.products.push({id:id(),businessId:db.activeBusinessId,branchIds,...o});
    save();render();return true
  })}



  // Sales navigation: always open the existing Sales list; New Sale is opened only by its button.
  document.getElementById('nav')?.addEventListener('click',function(e){const b=e.target.closest('button[data-page="sales"]');if(!b)return;e.stopImmediatePropagation();salesView='list';editingSaleId=null;saleDraftItems=null;saleDraftCustomer=null;currentPage='sales';document.getElementById('sidebar').classList.remove('open');render()},true);
  document.addEventListener('click',function(e){const r=e.target.closest('.ns-remove');if(r){readSalePageItems();saleDraftItems.splice(Number(r.dataset.i),1);if(!saleDraftItems.length)saleDraftItems.push({productId:'',qty:1,price:0});render();}});

  // Initialize branch-aware view.
  render();
})();
</script></body></html>
