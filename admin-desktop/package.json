{
  "name": "shopwatch-admin",
  "version": "1.0.0",
  "description": "Windows desktop wrapper for the ShopWatch Admin App",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.shopwatch.admin",
    "productName": "ShopWatch Admin",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "admin/**/*",
      "admin_main.js",
      "IMPLEMENTATION_NOTES.txt",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ShopWatch-Admin-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShopWatch Admin",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
